#!/usr/bin/env python3
"""Copy an observation ledger out of the private `data/` tree into the world-readable
`public-data/` tree, through an explicit field ALLOWLIST.

WHY THIS TOOL EXISTS AT ALL
`data/` is gitignored and must stay so: it is where the operator's own device capture lives,
and the whole project is built on nobody but him being observed. But step0c's frame rule
requires the REJECTION LEDGER to be published — "the sites without header bidding are named
separately, their absence is a result too" — and a dataset nobody can fetch cannot be cited,
audited, or diffed. Those two requirements are not in conflict; they are about two different
kinds of row:

  data/         OBSERVATIONS OF HIS DEVICE. Advertising ids, bid requests carrying his
                profile, anything read off the phone. Never published, no exceptions.
  public-data/  OBSERVATIONS OF THE PUBLIC WEB, made by a throwaway browser profile with no
                history: which domain answered what, which ad wrapper its page carries, from
                which of our own vantages. Nothing here is about a person.

ALLOWLIST, NOT DENYLIST
A denylist is a promise about fields that do not exist yet. Every schema bump adds columns,
and the ones that leak are exactly the ones nobody thought to exclude. So the copy names what
it KEEPS; anything a future schema adds is dropped by default and has to be argued into the
list. The dropped field names are counted and printed, so a schema that grows is visible here
rather than silent.

The published copy also carries a header naming its source, its rule, and its licence, so it
travels as a dataset rather than as a file.
"""

import argparse
import collections
import importlib.machinery
import importlib.util
import json
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PUB = os.path.join(REPO, "public-data")


def _load(name):
    path = os.path.join(REPO, "tools", name)
    spec = importlib.util.spec_from_file_location(
        name.replace("-", "_"), path,
        loader=importlib.machinery.SourceFileLoader(name.replace("-", "_"), path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


SB = _load("adint-frame-stageb")
BC = _load("adint-body-census")

# ── the allowlists, per ledger kind ───────────────────────────────────────────────────
# Read these as the dataset's schema: what is published IS this list.

FRAME_FIELDS = [
    # what was asked
    "stageb_schema", "schema", "ts", "rank", "domain", "url", "final_url",
    # what came back
    "http_status", "content_type", "load_s", "settle_used_s", "recheck_settle_s",
    "recheck_verdict",
    # the verdict and the evidence for it
    "stageb_verdict", "verdict", "wrapper_evidence", "globals", "adfox", "other_wrappers",
    "audit_bucket", "other_stacks", "source_ledger",
    # where WE stood — a verdict is a claim from a vantage, never from nowhere
    "vantage", "browser_egress_ip", "shell_egress_ip", "vantage_verified",
    "vantage_read_age_s",
    # our own failures, kept as data
    "error", "scroll_err", "frames_err",
]

# `adfox_hb` is NOT in the list. It is the publisher's own bidder roster and would be a fine
# thing to publish, but it is a nested blob whose shape we do not control, and this tool's
# whole point is that unreviewed structure does not cross the boundary. Publishing it is a
# deliberate later step with its own read-through, not a default.

PAIRED_FIELDS = [
    # the load: what was asked, when, from where, under which window
    "schema", "kind", "load_id", "pair_id", "ts", "hour_utc", "url", "final_url", "arm",
    "arm_note", "run_idx", "window_s", "profile_age_s", "observed_s", "wrapper_timeout_ms",
    "roster", "placements", "adfox", "pbjs", "http_status",
    # the vantage, per §2.5 — a row that cannot prove its own path is not evidence
    "egress_ip", "egress_ip_direct", "egress_ip_proxied", "proxy_env", "browser_used_proxy",
    "vantage_verified", "browser_egress_ip",
    # the request: who was asked and what came back. WITHOUT this the dataset is a row count
    # and nothing else — the first cut of this list dropped `bidder`, `host`, `floor` and the
    # price, i.e. published a file from which no finding could be checked. An allowlist that
    # is too tight does not leak, it just makes the publication pointless; both failures are
    # worth avoiding and only one of them is loud.
    "bidder", "host", "match_by", "method", "resource_type", "status",
    "t_request_s", "t_response_s", "req_openrtb", "req_adfox", "floor",
    "post_response_abort", "abort_reason", "bid_evidence",
    "outcome", "outcomes", "is_bid_candidate", "evidence_strength",
    "window_shorter_than_wrapper", "answered_after_wrapper_deadline", "bidder_latency_ms",
    "n_candidates", "error",
]

# `req_body` IS DELIBERATELY ABSENT, AND THIS PARAGRAPH IS THE REASON.
#
# Schema 6 keeps the bid request's payload, because that payload is what the project exists
# to read. It is also, precisely and by design, A DESCRIPTION OF ONE REAL PERSON: his device,
# his segments, his identity graph, his consent state, whatever the exchange was told about
# him. Publishing the outcome columns tells a reader what the market did. Publishing the
# bodies hands them the operator's own advertising profile.
#
# The allowlist already excludes it by construction — anything not named here does not cross.
# That is not enough on its own: "it is safe because nobody added it" is a property of the
# current list, not of the design, and the next person widening this file for a good reason
# will not know. So `selftest` asserts the absence directly, and any deliberate publication
# of request payloads has to delete that gate and mean it.
#
# `detail` is the parsed answer, and it is the only NESTED thing that crosses. It is not
# allowlisted whole: a nested blob whose shape we do not control is exactly what an allowlist
# exists to stop. These sub-keys are named, and anything else inside `detail` is dropped the
# same way a new top-level column would be.
# `bids_raw` is deliberately NOT here: it is a fragment of the response body, and bodies do
# not cross. Everything else is structure ABOUT the answer — did it carry a seatbid, how many
# bytes, did the network fault — which is what makes an outcome checkable by someone else.
NESTED = {"detail": ["prices", "currency", "at", "seatbids", "bids", "reason",
                     "has_seatbid", "has_bids_key", "seatbid", "bytes", "net_fault",
                     "location"]}

# The census: what each exchange ASKS ABOUT THE PERSON, as key-path shapes and counts.
# This ledger is publishable for the same reason the one it was read from is not — every
# field below is a name, a count or a shape CLASS, and there is no field that could carry a
# value. `adint-body-census` is built that way; this list re-asserts it on the way out rather
# than trusting it, which is the whole point of an allowlist. In particular `shapes` crosses
# and nothing resembling `req_body`, `req_url_full` or a raw parameter value does.
CENSUS_FIELDS = [
    "census_schema", "source", "host", "state", "half", "path", "bucket", "shapes",
    "n_req", "n_loads", "distinct_values", "distinct_values_saturated",
    # `empty_slot` is the finding-bearing state — a field asked for on every request and
    # never answered is neither an absent field nor a carried one — so it must survive.
    "empty_slot",
    "host_n_req", "host_n_read", "host_n_candidate", "host_n_unclassified",
    "host_n_url_maybe_cut", "host_n_loads",
]

# THE CONTROL. A plain-curl fetch of the same URL from inside the same vantage, taken
# after the pair, whose only job is to split an arm's `no answer` into "this link could
# not carry this page" and "this host was unreachable". Its own allowlist, deliberately
# small: the control is an instrument reading, and everything it may say about the world
# is a status code, a duration, and the address it reached.
#
# `after_s` and `ua_from_browser` are on the list ON PURPOSE — they are the control's
# LIMITATIONS, not its results. The control is taken after the load, not during it, and
# publishing the gap is what stops a reader treating it as simultaneous; the UA flag says
# whether the control asked the same question the browser did. A published instrument that
# hides its own error bars is worse than an unpublished one.
CONTROL_FIELDS = [
    "kind", "pair_id", "run", "arm", "url", "ts",
    "http_code", "seconds", "remote_ip", "rc", "error",
    "after_s", "max_time_s", "ua_from_browser",
]

KINDS = {"frame": FRAME_FIELDS, "paired": PAIRED_FIELDS, "census": CENSUS_FIELDS,
         "control": CONTROL_FIELDS}

HEADER = """# {name}
#
# SOURCE     {src} (produced by {tool})
# RULE       {rule}
# LICENCE    CC0 1.0 — public domain dedication. Cite it, fork it, contradict it.
# PUBLISHED  by tools/adint-publish through an explicit field allowlist ({nkept} fields).
#            Fields not on that list are dropped, including ones added by later schemas.
# NOT HERE   anything observed from the operator's own device. That tree is `data/` and it
#            is gitignored; this file is observations of the PUBLIC WEB made by a throwaway
#            browser profile with no history.
# BLINDNESS  a passive read of what a wrapper hands the browser. A server-side auction is not
#            observable from here at all, so an absence in this file is an absence in OUR
#            view, never a fact about the publisher's business.
"""


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--kind", choices=sorted(KINDS), required=False)
    ap.add_argument("--rule", default="see docs/step0c-hb-ru-market-study-2026-08-18.md")
    ap.add_argument("--out", default=None)
    ap.add_argument("--test", action="store_true")
    ap.add_argument("source", nargs="?")
    args = ap.parse_args()

    if args.test:
        return selftest()
    if not args.source or not args.kind:
        print("usage: adint-publish --kind {frame,paired,census,control} <data/…jsonl>",
              file=sys.stderr)
        return 2

    return publish(args.source, args.kind, args.out, args.rule)


def publish(source, kind, out=None, rule="see docs/step0c-hb-ru-market-study-2026-08-18.md"):
    keep = KINDS[kind]
    os.makedirs(PUB, exist_ok=True)
    out = out or os.path.join(PUB, os.path.basename(source))

    dropped = collections.Counter()
    n = 0
    rows = []
    redone = collections.Counter()
    # THE EXPORT BOUNDARY. Inside this repo every reader re-derives a verdict written under an
    # older classifier schema; a stranger who downloads this file has no such loader and reads
    # `stageb_verdict` as gospel. So a frame ledger is re-derived HERE, once, on the way out —
    # the last point at which the code that wrote a verdict is still knowable.
    src_rows = None
    if kind == "frame":
        src_rows, redone, _schemas, _dupes = SB.load_rows(source)
    with open(source, encoding="utf-8") as fh:
        for i, line in enumerate(fh):
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            r = json.loads(line)
            if src_rows is not None:
                r = src_rows[len(rows)]
            for k in r:
                if k not in keep and k not in NESTED:
                    dropped[k] += 1
            row = {k: r[k] for k in keep if k in r}
            for parent, subkeys in NESTED.items():
                blob = r.get(parent)
                if isinstance(blob, dict):
                    kept = {k: blob[k] for k in subkeys if k in blob}
                    for k in blob:
                        if k not in subkeys:
                            dropped[f"{parent}.{k}"] += 1
                    if kept:
                        row[parent] = kept
                elif blob is not None:
                    dropped[parent] += 1
            rows.append(row)
            n += 1

    with open(out, "w", encoding="utf-8") as fh:
        fh.write(HEADER.format(
            name=os.path.basename(out), src=os.path.basename(source),
            tool={"frame": "tools/adint-frame-stageb",
                  "control": "tools/adint-paired-run"}.get(kind, "tools/adint-hb-capture"),
            rule=rule, nkept=len(keep)))
        fh.write(f"# ROWS       {n}\n")
        if redone:
            fh.write("# RE-DERIVED " + SB.schema_note(redone, collections.Counter()).split(
                "): ", 1)[-1] + "\n")
            fh.write("#            Rows written under an older classifier schema carry the\n"
                     "#            verdict THIS code gives their stored probe fields, not the\n"
                     "#            one recorded at walk time. The raw fields are untouched.\n")
        if dropped:
            fh.write("# DROPPED    " + ", ".join(
                f"{k}({v})" for k, v in sorted(dropped.items())) + "\n")
        fh.write("#\n")
        for r in rows:
            fh.write(json.dumps(r, ensure_ascii=False) + "\n")

    print(f"{n} row(s) -> {out}")
    if redone:
        print("re-derived on the way out: " + " ".join(f"{k}={v}" for k, v in sorted(redone.items())))
    if dropped:
        print("dropped (not on the allowlist): "
              + ", ".join(f"{k}×{v}" for k, v in sorted(dropped.items())))
    return 0


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    # The property that matters: a field NOBODY anticipated must not cross. This is the exact
    # failure a denylist has — it passes on any column invented after it was written.
    row = {"domain": "x.ru", "stageb_verdict": "admit",
           "device_ifa": "SHOULD-NEVER-CROSS",
           "a_column_invented_next_month": "also never"}
    kept = {k: row[k] for k in FRAME_FIELDS if k in row}
    check("an unanticipated field is dropped by default",
          sorted(kept), ["domain", "stageb_verdict"])
    # THE REQUEST PAYLOAD MUST NOT CROSS. Asserted by name, not left to the allowlist's
    # default-deny: the default is what protects it today, and this gate is what makes
    # publishing it a deliberate act rather than a widening nobody reviewed.
    check("the bid request body is NOT published", "req_body" in PAIRED_FIELDS, False)
    check("nor its length, which leaks profile size", "req_body_bytes" in PAIRED_FIELDS, False)
    # SCHEMA 7: the QUERY STRING is the same class of evidence. A GET-based exchange carries
    # the profile in the url, so an allowlist that stops `req_body` and lets `req_url_full`
    # through stops nothing — it just moves the leak to the other half of the request.
    check("nor the full query string, which is the profile for a GET exchange",
          "req_url_full" in PAIRED_FIELDS, False)
    check("nor its length", "req_url_bytes" in PAIRED_FIELDS, False)
    paired = {"bidder": "adriver", "outcome": "no-bid",
              "req_body": '{"user":{"buyeruid":"REAL-PERSON","ext":{"segments":[1,2]}}}',
              "req_body_bytes": 61, "req_body_truncated": False,
              "req_url_full": "https://ssp.example/rtb?uid=REAL-PERSON&seg=1,2",
              "req_url_bytes": 47, "req_url_truncated": False}
    kept_p = {k: paired[k] for k in PAIRED_FIELDS if k in paired}
    check("a schema-6 row publishes its outcome and not the payload",
          sorted(kept_p), ["bidder", "outcome"])
    check("no published field's VALUE carries the payload either",
          any("REAL-PERSON" in str(v) for v in kept_p.values()), False)

    # THE CENSUS ALLOWLIST. It exists to publish "which fields does this exchange ask for",
    # and it must not become a way to publish what was in them.
    for bad in ("req_body", "req_body_bytes", "req_url_full", "req_url_bytes",
                "value", "values", "raw", "sample"):
        check("the census allowlist has no `%s`" % bad, bad in CENSUS_FIELDS, False)
    census_row = {"host": "ssp.example", "path": "user.buyeruid", "shapes": ["hex:32"],
                  "bucket": "identity", "n_loads": 23, "distinct_values": 3,
                  "empty_slot": False,
                  "req_body": '{"user":{"buyeruid":"REAL-PERSON"}}',
                  "req_url_full": "https://ssp.example/rtb?uid=REAL-PERSON",
                  "value": "REAL-PERSON", "a_column_invented_next_month": "REAL-PERSON"}
    kept_c = {k: census_row[k] for k in CENSUS_FIELDS if k in census_row}
    check("a census row publishes the shape and the counts, never the payload",
          sorted(kept_c), ["bucket", "distinct_values", "empty_slot", "host", "n_loads",
                           "path", "shapes"])
    check("no published census field's VALUE carries the payload either",
          any("REAL-PERSON" in str(v) for v in kept_c.values()), False)
    # The state that carries the finding must survive the boundary, or the dataset says less
    # than the printout it came from.
    check("`empty_slot` crosses", "empty_slot" in CENSUS_FIELDS, True)

    # THE LEAK CHECK, AS A GATE. Every check above asserts a FIELD NAME, and the leak that
    # actually happened was in the CONTENT of an allowed field: the census publishes key
    # paths and hostnames, and both can embed an identifier. So this one takes the tokens
    # that were on the wire and asserts none of them survive into the export — the same
    # diff that found 349 of them in the first published census, run every time.
    import re as _re
    import urllib.parse as _up

    def _wire_values(body, url):
        """Every VALUE the wire carried, and every id-shaped segment of the hostname.

        Not every token: a census publishes key NAMES on purpose, so asserting that no wire
        token survives would fail on `top100_session_id` — the very field the study reports.
        The rule the export actually has to keep is narrower and is the one that was broken:
        nothing that appeared as a VALUE, and no identifier hiding inside a name.
        """
        vals = set()

        def walk(o):
            if isinstance(o, dict):
                for k, v in o.items():
                    # A KEY can be an identifier. Names are fine to publish; ids are not,
                    # wherever they sit.
                    if _re.fullmatch(r"[0-9a-f]{12,}|[0-9]{12,}", str(k), _re.I):
                        vals.add(str(k))
                    walk(v)
            elif isinstance(o, list):
                for v in o:
                    walk(v)
            elif isinstance(o, str) and len(o) >= 12:
                vals.add(o)
        try:
            walk(json.loads(body))
        except Exception:
            pass
        parts = _up.urlsplit(url)
        for _k, v in _up.parse_qsl(parts.query, keep_blank_values=True):
            if len(v) >= 12:
                vals.add(v)
        for seg in _re.split(r"[.-]", parts.hostname or ""):
            if _re.fullmatch(r"[0-9a-f]{12,}|[0-9]{12,}", seg, _re.I):
                vals.add(seg)
        return vals

    _wire_body = ('{"top100_session_id":{"1914484777455681117":"x"},'
                  '"user":{"buyeruid":"8f14e45fceea167a5a36dedd4bea2543"}}')
    _wire_url = "https://2-6a871d048f403bcd46b18008.id.example/rtb?uid=REALPERSONTOKEN123"
    _census_rows = list(BC.emit_rows(BC.census([
        {"kind": "request", "load_id": "L1", "host": "2-6a871d048f403bcd46b18008.id.example",
         "req_body": _wire_body, "req_url_full": _wire_url}]), "x.jsonl"))
    _exported = json.dumps([{k: r[k] for k in CENSUS_FIELDS if k in r}
                            for r in _census_rows])
    _wv = _wire_values(_wire_body, _wire_url)
    check("the leak check has values to look for (an empty needle asserts nothing)",
          len(_wv) >= 4, True)
    check("no VALUE from the wire, and no id inside a name, survives into the census",
          sorted(t for t in _wv if t in _exported), [])

    check("an advertising id is not on the frame allowlist",
          "device_ifa" in FRAME_FIELDS, False)
    # THE EXPORT BOUNDARY IS THE LAST PLACE THE RULE OF d28dbde CAN BE APPLIED. Everything
    # inside this repo re-derives a stale verdict at read time; a stranger who downloads the
    # published file has no such loader and will read `stageb_verdict` as written. So a frame
    # ledger must not cross carrying a verdict from a retired classifier.
    import tempfile as _tf
    _d = _tf.mkdtemp()
    _src = os.path.join(_d, "frame-stageb-t-2026-01-01.jsonl")
    with open(_src, "w") as fh:
        fh.write(json.dumps({"domain": "adserving.ru", "rank": 1, "vantage": "t",
                             "stageb_verdict": "admit", "stageb_schema": 1,
                             "http_status": 200, "content_type": "text/html",
                             "adfox": {"ya": True, "adfoxCode": True, "hb_settings": False,
                                       "ya_context": True},
                             "adfox_hb": {"present": False}, "prebid": [], "globals": [],
                             "browser_egress_ip": "1.2.3.4"}) + "\n")
    _out = os.path.join(_d, "out.jsonl")
    _rc = publish(_src, "frame", _out, rule="t")
    _pub = [json.loads(l) for l in open(_out) if not l.startswith("#")]
    check("a stale verdict does not cross the export boundary",
          [(r["stageb_verdict"], r["stageb_schema"]) for r in _pub],
          [("ad-serving-only", SB.SCHEMA)])
    check("and the published header says the verdicts were re-derived",
          "RE-DERIVED" in open(_out).read(), True)

    # The nested projection must behave like the top-level allowlist: named keys cross, and a
    # sub-key nobody anticipated does not.
    blob = {"prices": [{"value": 1.23}], "currency": "RUB", "raw_body": "NEVER"}
    kept = {k: blob[k] for k in NESTED["detail"] if k in blob}
    check("a named sub-key of `detail` crosses", sorted(kept), ["currency", "prices"])
    check("an unanticipated sub-key of `detail` does not", "raw_body" in kept, False)
    check("a RAW BODY fragment is never allowlisted, even a named one",
          "bids_raw" in NESTED["detail"], False)
    # …and the other failure mode: an allowlist so tight the publication cannot be checked.
    for f in ("bidder", "host", "outcome", "floor", "t_response_s"):
        check(f"the paired dataset keeps `{f}`, or no finding in it can be re-checked",
              f in PAIRED_FIELDS, True)
    for f in ("ifa", "device_ifa", "gaid", "idfa", "imei", "msisdn", "user", "user_data",
              "eids", "cookies", "post_data", "body", "request_body", "response_body"):
        if f in FRAME_FIELDS or f in PAIRED_FIELDS:
            ok = False
            print(f"FAIL an identity/body field is on an allowlist: {f}")
    print("ok   no identity or body field appears on either allowlist")
    # The vantage must survive the copy: a verdict published without the standpoint it was
    # taken from is exactly the row §2.5 says must be discarded.
    for f in ("vantage", "browser_egress_ip", "vantage_verified"):
        check(f"the vantage column `{f}` is published", f in FRAME_FIELDS, True)
    check("the pair key is published", "pair_id" in PAIRED_FIELDS, True)
    check("the window is published", "window_s" in PAIRED_FIELDS, True)
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
