#!/usr/bin/env python3
"""Run one CELL of the step0c schedule: the same sites, in the same randomised order, from
both vantages, paired site by site.

    tools/adint-paired-run --frame ref/ru-frame-stageB-nl-direct-<date>.tsv \
        --replicates 1 --window 45 --seed 20260819

WHY A RUNNER AND NOT TWO SHELLS
§2.4 requires the pair to be SIMULTANEOUS — "the same site at the same minute" — because on
a market where floors move, same-hour-but-not-same-minute is not a pair. Two independent
walks cannot deliver that, and the reason is §3's own finding: the arms differ in CHANNEL.
The RU arm rides HSDPA and takes two to three times as long per load as the datacenter arm,
so two lists started together drift apart monotonically, and by the tail of a 20-site walk
the "pair" is an hour apart. **The schedule's simultaneity requirement and its channel
design are in tension, and nothing in the data would say so** — both rows would carry
honest timestamps and a later reader would join them on a key that quietly means "the same
position in two walks that diverged".

So the pair is a BARRIER: both arms are launched on one site at once and the next site does
not start until both have returned. The fast arm idles; that idle time is the price of the
pair actually being one. The realised skew is measured and printed per pair — a pair is a
claim about simultaneity, and a claim carries its number.

ORDER
Site order is randomised per run from a seed that is recorded in the run log (§2.4), and
BOTH arms receive the identical order — the pair key is positional, so a differing order
would not mismatch loudly, it would silently pair different sites. The order is written to
the log before the run, so it is checkable afterwards rather than trusted.

VANTAGES
The RU arm runs inside the `ruvantage` netns (Note3 USB tether, MTS). A netns is used rather
than a routing rule because Chromium cannot bind a socket to an interface, so an `oif` rule
can never catch it; inside a namespace every process is on the tether by construction. The
NL arm runs in the root namespace. Each arm's browser reads its own egress and hb-capture
refuses a load it cannot verify — a label is not a route.
"""

import argparse
import json
import os
import random
import shlex
import subprocess
import sys
import time
from datetime import datetime, timezone

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PY = os.path.expanduser("~/.venv-browser/bin/python3")
CAPTURE = os.path.join(REPO, "tools", "adint-hb-capture")

# An arm's return code is a CAUSE, not a boolean. rc2 is the capture refusing to label a
# load whose vantage it could not prove — no row reaches disk — and rc1 is the two arms
# having collapsed onto one exit. Neither produced a pair, and neither is an error in the
# ordinary sense, so `pairs=N` counted over attempts folds three different facts into the
# study's headline number. The 2026-08-19 day cell is the case: 14 attempts, 3 of them with
# no RU side at all, and the old summary would have said `pairs=14`.
ARM_RC = {0: "recorded", 1: "arms-collapsed", 2: "vantage-unproven"}


def rc_cause(rc):
    return ARM_RC.get(rc, f"error-rc{rc}")


def tally_pairs(results):
    """results: [{arm: rc, ...}, ...] in attempt order -> (attempted, complete, causes).

    `complete` counts only attempts where EVERY arm recorded. `causes` is keyed
    "<arm>:<cause>" and counts the arms that did not, so an incomplete attempt is
    attributable rather than merely subtracted.
    """
    attempted = len(results)
    complete = 0
    causes = {}
    for r in results:
        if all(rc == 0 for rc in r.values()):
            complete += 1
            continue
        for arm, rc in sorted(r.items()):
            if rc != 0:
                causes[f"{arm}:{rc_cause(rc)}"] = causes.get(f"{arm}:{rc_cause(rc)}", 0) + 1
    return attempted, complete, causes


# MSK zones of §2.2, stored in UTC. The market's clock is Moscow's; the label is derived
# from the wall clock at the START of the cell and recorded, never inferred later.
def zone_msk(dt):
    h = (dt.hour + 3) % 24
    if h < 6:
        return "night"
    if h < 12:
        return "morning"
    if h < 18:
        return "day"
    return "evening"


def read_frame(path):
    out = []
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line or line.startswith("#"):
                continue
            p = line.split("\t")
            if len(p) < 2 or p[0] == "rank":
                continue
            out.append(p[1])
    return out


def arm_cmd(arm, url, out, window, nav_timeout, pair_prefix, netns=None, echo_tries=None,
            ip_echo=None, nav_tries=None):
    # nav_timeout is per-ARM by the caller's choice (see --ru-nav-timeout). It is NOT the
    # measurement window — that is `--settle`, fixed at 45 s for every arm by §2.1 — it is
    # only how long the arm may wait for the page to arrive before giving up. Letting the
    # slow arm wait longer changes WHICH loads exist, not how long any auction is watched.
    # The echo budget is given to BOTH arms and not just the flaky one. It costs the NL arm
    # nothing (its echo answers on the first read), and an allowance handed to one arm only
    # is an arm difference that is not the treatment — the pair would then differ in how
    # hard we tried to prove it, which is exactly the confound the pairing exists to remove.
    inner = [PY, CAPTURE, url, "--settle", str(window), "--nav-timeout", str(nav_timeout),
             "--arm", arm, "--via", "direct", "--pair-prefix", pair_prefix, "--out", out,
             "--echo-tries", str(echo_tries if echo_tries else 1)]
    # Same echo host for both arms. The echo is the instrument, not the treatment: pointing
    # the arms at different ones would make `vantage unproven` mean a different thing in
    # each, which is the one word the pair cannot afford to have two meanings of.
    if ip_echo:
        inner += ["--ip-echo", ip_echo]
    # Symmetric, like the echo budget: an arm allowed more attempts at reaching a page is an
    # arm with a different chance of HAVING that page, which is a difference in the load set
    # and not in the treatment.
    if nav_tries:
        inner += ["--nav-tries", str(nav_tries)]
    if netns:
        # runuser drops back to the user INSIDE the namespace; HOME is passed explicitly
        # because `sudo ip netns exec` does not carry it and playwright's browser path is
        # under it — a missing HOME here fails as "browser not installed", which reads as a
        # broken install rather than a lost variable.
        return ["sudo", "ip", "netns", "exec", netns, "runuser", "-u", os.environ.get("USER", "mesh-home"),
                "--", "env", f"HOME={os.path.expanduser('~')}",
                f"PATH={os.environ.get('PATH','')}"] + inner
    return inner


def main():
    ap = argparse.ArgumentParser()
    # NOT `required=True`: that makes --test unrunnable without naming a frame, and a self
    # test that cannot be invoked on its own is a self test nobody runs. Enforced below,
    # where the distinction between a real run and a test is actually known.
    ap.add_argument("--frame", default=None)
    ap.add_argument("--replicates", type=int, default=1)
    ap.add_argument("--window", type=int, default=45,
                    help="window_s, fixed at 45 for every arm of the study (§2.1)")
    ap.add_argument("--nav-timeout", type=int, default=120)
    ap.add_argument("--ru-nav-timeout", type=int, default=None,
                    help="seconds the RU arm may wait for a page, when it must differ from "
                         "--nav-timeout. Default: the same as both arms. Set it only from a "
                         "MEASUREMENT of the link, and read the asymmetry warning the run "
                         "prints — the arms then differ in something besides the treatment")
    ap.add_argument("--nav-tries", type=int, default=1,
                    help="attempts each arm gets at a navigation that never connected. "
                         "DEFAULT 1, i.e. OFF, and the measurement is why: over the FULL "
                         "night cell the immediate retry recovered 2 of 25 loads that needed "
                         "it — 8%%, bought by doubling the arm's traffic on exactly the loads "
                         "where the link is already failing. (Mid-cell it read 0 of 14; the "
                         "final number is 2 of 25, and the decision is the same.) The "
                         "connection failure "
                         "has a correlation time of MINUTES, so a retry seconds later lands "
                         "inside the same bad window — and it doubles the arm's traffic on "
                         "exactly the loads where the link is already failing. THE RETRY THAT "
                         "WORKS IS THE REPLICATE CYCLE: 14 sites revisited ~35 min apart, at "
                         "no extra cost. Same cell, next replicate: aviasales/gismeteo/rbc/"
                         "ria/sports each failed then succeeded. Identical for both arms")
    ap.add_argument("--ip-echo", default=None,
                    help="echo host for BOTH arms. Must be one the RU vantage's resolver "
                         "answers correctly: MTS returns api.ipify.org (the capture's "
                         "default) and api.myip.com as the real /24 with the last octet "
                         "ZEROED, so under carrier DNS the default echo is unreachable and "
                         "every load would refuse. Measured working 2026-08-19: "
                         "https://ifconfig.co (200, 0.39 s), https://icanhazip.com (200, "
                         "1.23 s). https://ip.sb timed out at 90 s")
    ap.add_argument("--echo-tries", type=int, default=3,
                    help="attempts each arm gets to read the IP echo before its load is "
                         "refused as vantage-unproven (default 3, measured on the RU tether "
                         "2026-08-19). Identical for both arms, on purpose")
    ap.add_argument("--seed", type=int, default=None)
    ap.add_argument("--sites", type=int, default=0, help="cap the site count (0 = the frame)")
    ap.add_argument("--ru-netns", default="ruvantage")
    ap.add_argument("--ru-arm", default="ru-mobile")
    ap.add_argument("--nl-arm", default="nl-direct")
    ap.add_argument("--out-prefix", default=None)
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()

    if args.test:
        return selftest()
    if not args.frame:
        print("adint-paired-run: --frame is required for a real run", file=sys.stderr)
        return 2

    t_start = datetime.now(timezone.utc)
    day = t_start.strftime("%Y-%m-%d")
    zone = zone_msk(t_start)
    seed = args.seed if args.seed is not None else int(t_start.strftime("%Y%m%d%H"))
    run_id = f"{day}-{zone}-{seed}"
    prefix = args.out_prefix or os.path.join(REPO, "data", f"hb-paired-{run_id}")
    out_ru, out_nl = f"{prefix}.ru.jsonl", f"{prefix}.nl.jsonl"
    logp = f"{prefix}.run.log"

    sites = read_frame(args.frame)
    if args.sites:
        sites = sites[:args.sites]
    rng = random.Random(seed)
    order = sites[:]
    rng.shuffle(order)

    log = open(logp, "a", encoding="utf-8")

    def say(msg):
        line = f"{datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ')} {msg}"
        print(line, flush=True)
        log.write(line + "\n")
        log.flush()

    ru_nav = args.ru_nav_timeout or args.nav_timeout
    say(f"echo_tries={args.echo_tries} nav_tries={args.nav_tries} (both arms)")
    if ru_nav != args.nav_timeout:
        # An asymmetry the reader must not have to infer from a flag they did not see.
        say(f"WARNING ARM ASYMMETRY: nav_timeout {args.ru_arm}={ru_nav}s "
            f"{args.nl_arm}={args.nav_timeout}s. The arms differ in PATIENCE as well as in "
            f"vantage: a page the slow arm now waits for is a load the fast arm would have "
            f"had anyway, so the arms' load SETS become more alike, not less — but a load "
            f"that needed {ru_nav}s to arrive was fetched under conditions the other arm "
            f"never met. Loads carry their own nav budget; split on it before comparing.")
    else:
        say(f"nav_timeout={args.nav_timeout}s (both arms)")
    say(f"run_id={run_id} zone_msk={zone} seed={seed} window_s={args.window} "
        f"replicates={args.replicates} frame={os.path.basename(args.frame)} n_sites={len(order)}")
    # The order is written BEFORE the run, so "both arms got the same list" is checkable
    # from the artifact instead of being a property of this process's memory.
    say("order=" + ",".join(order))

    skews = []
    attempts = []
    zone_drifted = []
    for rep in range(1, args.replicates + 1):
        for idx, domain in enumerate(order, 1):
            url = f"https://{domain}/"
            pp = f"{run_id}-r{rep}-s{idx:03d}"
            t0 = time.time()
            procs = {}
            for arm, out, ns in ((args.nl_arm, out_nl, None),
                                 (args.ru_arm, out_ru, args.ru_netns)):
                nav = ru_nav if arm == args.ru_arm else args.nav_timeout
                cmd = arm_cmd(arm, url, out, args.window, nav, pp, ns,
                              echo_tries=args.echo_tries, ip_echo=args.ip_echo,
                              nav_tries=args.nav_tries)
                procs[arm] = (subprocess.Popen(cmd, stdout=subprocess.DEVNULL,
                                               stderr=subprocess.PIPE), time.time())
            done = {}
            for arm, (pr, tlaunch) in procs.items():
                err = pr.communicate()[1]
                done[arm] = (pr.returncode, round(time.time() - tlaunch, 1),
                             (err or b"").decode("utf-8", "replace")[-200:])
            skew = round(abs(done[args.nl_arm][1] - done[args.ru_arm][1]), 1)
            skews.append(skew)
            attempts.append({a: done[a][0] for a in done})
            # The zone is the study's treatment axis, and it is stamped ONCE at the cell's
            # start — so a cell that overruns its 6-hour window keeps a run_id that is wrong
            # for its own tail. It happened on the first run of this code: the 2026-08-19
            # day cell began 14:25Z and its last pairs landed after 15:00Z, which is MSK
            # evening. The run_id is not rewritten (it is the join key, and the pairs before
            # the boundary really are day) — the DRIFT is named per pair, so the consumer
            # can drop or re-label the tail instead of trusting the id.
            zone_now = zone_msk(datetime.now(timezone.utc))
            drift = "" if zone_now == zone else f" ZONE-DRIFT={zone_now}(run says {zone})"
            if drift:
                zone_drifted.append(pp)
            say(f"rep{rep} [{idx}/{len(order)}] {domain} pair={pp} "
                + " ".join(f"{a}=rc{done[a][0]}/{done[a][1]}s" for a in done)
                + f" barrier_wait={skew}s total={round(time.time()-t0,1)}s{drift}")
            for a, (rc, _, err) in done.items():
                if rc != 0 and err.strip():
                    say(f"    {a} stderr: {err.strip()[:200]}")

    attempted, complete, causes = tally_pairs(attempts)
    cause_s = (" · " + " ".join(f"{k}={v}" for k, v in sorted(causes.items()))) if causes else ""
    say(f"done · attempted={attempted} · complete={complete} · median arm-duration gap="
        f"{sorted(skews)[len(skews)//2] if skews else 'na'}s{cause_s}")
    if zone_drifted:
        say(f"WARNING zone drift: {len(zone_drifted)} of {attempted} pair(s) finished outside "
            f"the run's `{zone}` window — {','.join(zone_drifted)}")
    say(f"out ru={out_ru} nl={out_nl}")
    log.close()
    return 0


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    from datetime import datetime as dt
    # Zones are MSK, and the UTC boundaries are where a naive local-time reading goes wrong.
    check("21:00 UTC is MSK night", zone_msk(dt(2026, 8, 19, 21, 0)), "night")
    check("02:59 UTC is still night", zone_msk(dt(2026, 8, 19, 2, 59)), "night")
    check("03:00 UTC is MSK morning", zone_msk(dt(2026, 8, 19, 3, 0)), "morning")
    check("06:00 UTC is MSK morning", zone_msk(dt(2026, 8, 19, 6, 0)), "morning")
    check("09:00 UTC is MSK day", zone_msk(dt(2026, 8, 19, 9, 0)), "day")
    check("15:00 UTC is MSK evening", zone_msk(dt(2026, 8, 19, 15, 0)), "evening")

    # The order must be a FUNCTION of the seed, or "recorded seed" records nothing.
    a, b = list("abcdefgh"), list("abcdefgh")
    random.Random(7).shuffle(a)
    random.Random(7).shuffle(b)
    check("the same seed gives both arms the same order", a, b)
    c = list("abcdefgh")
    random.Random(8).shuffle(c)
    check("a different seed gives a different order", a != c, True)

    # The RU arm must actually be namespaced. A command that merely CARRIES the label while
    # running in the root namespace is the exact failure §2.5 records for the 418-load set.
    ru = arm_cmd("ru-mobile", "https://x.ru/", "/tmp/o", 45, 120, "p", netns="ruvantage")
    check("the RU arm is executed inside the netns",
          ru[:5], ["sudo", "ip", "netns", "exec", "ruvantage"])
    check("the RU arm carries HOME into the namespace",
          any(x.startswith("HOME=") for x in ru), True)
    nl = arm_cmd("nl-direct", "https://x.ru/", "/tmp/o", 45, 120, "p", netns=None)
    # The echo budget is a property of the CELL, not of an arm: the same number in both.
    check("both arms get the same echo HOST, or `unproven` means two things",
          arm_cmd("ru-mobile", "https://x.ru/", "/tmp/o", 45, 120, "p",
                  ip_echo="https://ifconfig.co")[-1],
          arm_cmd("nl-direct", "https://x.ru/", "/tmp/o", 45, 120, "p",
                  ip_echo="https://ifconfig.co")[-1])
    check("no --ip-echo leaves the capture's own default alone",
          "--ip-echo" in arm_cmd("a", "https://x.ru/", "/tmp/o", 45, 120, "p"), False)
    check("both arms get the same navigation budget",
          arm_cmd("ru-mobile", "https://x.ru/", "/tmp/o", 45, 120, "p", nav_tries=2)[-1],
          arm_cmd("nl-direct", "https://x.ru/", "/tmp/o", 45, 120, "p", nav_tries=2)[-1])
    check("the navigation budget is passed through, not pinned",
          arm_cmd("a", "https://x.ru/", "/tmp/o", 45, 120, "p", nav_tries=5)[-1], "5")
    check("both arms get the same echo budget",
          ru[ru.index("--echo-tries") + 1] == nl[nl.index("--echo-tries") + 1], True)
    check("the echo budget is passed through, not pinned",
          arm_cmd("a", "https://x.ru/", "/tmp/o", 45, 120, "p",
                  echo_tries=7)[-1], "7")

    # A cell that overruns its zone must SAY so; the zone is the treatment axis.
    check("14:25Z is day and 15:01Z is not, so a cell across the boundary drifts",
          (zone_msk(dt(2026, 8, 19, 14, 25)), zone_msk(dt(2026, 8, 19, 15, 1))),
          ("day", "evening"))

    # ── the summary counts PAIRS, and a pair needs both arms ──
    # The 2026-08-19 day cell is the case this is written from: three of fourteen attempts
    # had no RU side at all (rc2 — the capture refusing to label an unproven vantage), and
    # the old summary counted every attempt, so it would have reported `pairs=14`.
    day_cell = ([{"nl-direct": 0, "ru-mobile": 0}] * 11
                + [{"nl-direct": 0, "ru-mobile": 2}] * 3)
    check("an attempt with one arm refused is not a pair",
          tally_pairs(day_cell)[:2], (14, 11))
    check("the refusal is attributed to the arm and the cause",
          tally_pairs(day_cell)[2], {"ru-mobile:vantage-unproven": 3})
    check("a clean cell reports no causes at all",
          tally_pairs([{"a": 0, "b": 0}] * 4), (4, 4, {}))
    check("arms collapsing onto one exit is a DIFFERENT cause from an unproven vantage",
          tally_pairs([{"a": 1, "b": 0}])[2], {"a:arms-collapsed": 1})
    check("an unnamed return code is not folded into a named one",
          tally_pairs([{"a": 137, "b": 0}])[2], {"a:error-rc137": 1})
    check("both arms failing is one incomplete attempt, counted twice by cause",
          tally_pairs([{"a": 2, "b": 2}]), (1, 0, {"a:vantage-unproven": 1,
                                                   "b:vantage-unproven": 1}))
    check("the NL arm is NOT namespaced", "netns" in nl, False)
    check("both arms are given the same pair prefix",
          ru[ru.index("--pair-prefix") + 1] == nl[nl.index("--pair-prefix") + 1], True)
    check("both arms are given the same window",
          ru[ru.index("--settle") + 1] == nl[nl.index("--settle") + 1] == "45", True)
    check("the arms are labelled apart",
          (ru[ru.index("--arm") + 1], nl[nl.index("--arm") + 1]), ("ru-mobile", "nl-direct"))
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
