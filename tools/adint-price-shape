#!/usr/bin/env python3
"""The shape of one bidder's prices: how many, how precise, and whether any value is an ATOM.

The study classifies DSPs by the SHAPE of their marginal bid distribution, and the first
question a shape asks is whether the support is continuous or has mass sitting on particular
values. This reads that off the captured bids and refuses to say more than the count allows.

What it will not do:

  * Pool currencies. RUB 2.5 and USD 2.5 are not the same value, and a distribution over two
    units is a distribution over nothing.
  * Call a repeat an atom when the sample cannot support it. With n prices and d distinct
    values, a single duplicate at n=3 is unremarkable; the report states n beside every claim
    and withholds the word `atom` below --min-n (default 8) and below --min-repeats (3).
  * Ignore PRECISION, which is the strongest evidence here and costs nothing. A price computed
    by an optimiser arrives as 4.809109470545412; a price set by a rule arrives as 2.5. When
    one bidder emits both, the round value repeating is not a coincidence of rounding — the
    bidder is not rounding anything else. So decimals are counted per value and reported.
  * Mix in zero bids. A returned bid of 0 is not a point in the price distribution; it is a
    refusal wearing a bid's clothes, and it gets its own line.
"""

import argparse
import collections
import importlib.machinery
import importlib.util
import json
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

def _load(name):
    path = os.path.join(REPO, "tools", name)
    spec = importlib.util.spec_from_file_location(
        name.replace("-", "_"), path,
        loader=importlib.machinery.SourceFileLoader(name.replace("-", "_"), path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


# What the CAPTURE writes today. Read from the producer rather than copied here, because a
# copied constant outlives its reader: the number would go on saying 5 after the capture moved
# to 6, and the staleness warning below would then be permanently silent.
CAPTURE_SCHEMA = _load("adint-hb-capture").SCHEMA

def stale_schema_note(schema):
    """A reader picks the newest schema PRESENT IN THE FILE. That is not the same as current,
    and nothing in the file says so — a corpus captured before the last fix reports cleanly,
    labelled only by a number the reader has no baseline for. So say it: the count is sound,
    what it MEANS may not be."""
    if schema >= CAPTURE_SCHEMA:
        return None
    return (f"!! this corpus is schema {schema}; the capture now writes {CAPTURE_SCHEMA}. The "
            f"counts below are of schema-{schema} rows and are internally consistent, but the "
            f"fields changed meaning between the two (see the schema history in "
            f"tools/adint-hb-capture) — do NOT pool these figures with a current corpus, and "
            f"do not read an arm comparison off a corpus captured before the arms were "
            f"verified.")


LOG = os.path.join(REPO, "data", "hb-auction.jsonl")


def decimals(v):
    """Significant decimals in the value as printed. `2.5` has 1, `4.809109470545412` has 15 —
    the difference between a rule and a computation."""
    s = repr(float(v))
    if "e" in s or "E" in s:
        return None
    return len(s.split(".")[1].rstrip("0")) if "." in s else 0


def collect(rows, schema=None):
    if schema is None:
        schema = max((r.get("schema", 1) for r in rows), default=1)
    # The site lives on the load row; a price row carries only its load_id. Joining here keeps
    # "how many sites did this value appear on" answerable, which is what separates a bidder's
    # price rule from one publisher's quirk.
    sites = {r.get("load_id"): r.get("url") for r in rows if r.get("kind") == "load"}
    prices = []
    zeros = 0
    for r in rows:
        if r.get("schema", 1) != schema or r.get("kind") != "request":
            continue
        if r.get("outcome") not in ("priced", "bid-zero"):
            continue
        d = r.get("detail") or {}
        for x in d.get("prices") or []:
            v = float(x["value"])
            rec = {"bidder": r.get("bidder_canon") or r.get("bidder"), "value": v,
                   "currency": x.get("currency") or d.get("currency"),
                   "field": x.get("field"), "path": x.get("path"),
                   "placement": x.get("placementId"), "arm": r.get("arm"),
                   "site": sites.get(r.get("load_id")),
                   "load_id": r.get("load_id"), "decimals": decimals(v)}
            if v == 0:
                zeros += 1
            else:
                prices.append(rec)
    return prices, zeros, schema


def report(prices, zeros, schema, min_n=8, min_repeats=3, out=sys.stdout):
    p = lambda s="": print(s, file=out)
    p(f"== price shape — schema {schema} ==")
    _stale = stale_schema_note(schema)
    if _stale:
        p(_stale)
    p(f"non-zero prices {len(prices)} · zero bids {zeros} (kept out of the distribution: a bid "
      f"of 0 is a refusal wearing a bid's clothes)")
    result = {"atoms": {}, "groups": {}}
    groups = collections.defaultdict(list)
    for r in prices:
        groups[(r["bidder"], r["currency"])].append(r)
    if not groups:
        p("   no non-zero price in this corpus")
        return result
    for (bidder, cur), rs in sorted(groups.items(), key=lambda kv: -len(kv[1])):
        vals = [r["value"] for r in rs]
        n = len(vals)
        counts = collections.Counter(vals)
        distinct = len(counts)
        p("")
        p(f"-- {bidder} / {cur or 'currency unstated'} --")
        p(f"   n={n} distinct={distinct} min={min(vals):.6g} max={max(vals):.6g}")
        # Precision is reported before any claim, because it is what makes a repeat legible.
        dec = collections.Counter(r["decimals"] for r in rs)
        p(f"   decimals: {dict(sorted(dec.items()))} "
          f"(a rule-set price is short; an optimised one is long)")
        # A repeat is only evidence if it happened on separate PAGE LOADS. The wrapper fires a
        # page's slots together off one config, so the same price returned twice within one
        # load is one observation of the bidder, not two — clustering at the page load is in
        # the design for exactly this reason. Counting rows here would have called `4` a
        # repeat off a single page view.
        for v, c in counts.most_common():
            rs_v = [r for r in rs if r["value"] == v]
            n_loads = len({r["load_id"] for r in rs_v})
            n_place = len({r["placement"] for r in rs_v if r["placement"]})
            n_sites = len({r["site"] for r in rs_v if r.get("site")})
            dec = decimals(v)
            mark = ""
            if c > 1:
                if n_loads < 2:
                    mark = (f"  <- {c} rows but ONE load: a page's slots fire together, so this "
                            f"is one observation, not {c}")
                elif n_loads < min_repeats:
                    mark = (f"  <- repeats on {n_loads} load(s); needs {min_repeats} before the "
                            f"word atom is used")
                elif n < min_n:
                    mark = (f"  <- repeats on {n_loads} loads, but the group has n={n}, under "
                            f"the {min_n} this report needs")
                elif n_place < 2:
                    # One slot returning the same number every time is a price fixed FOR THAT
                    # SLOT — deterministic, and not a point of mass in the bidder's price list.
                    mark = (f"  <- repeats on {n_loads} loads but only placement "
                            f"{sorted({r['placement'] for r in rs_v if r['placement']})}: a "
                            f"price fixed for that slot, not a price-list atom")
                    result.setdefault("slot_fixed", []).append({"value": v, "loads": n_loads})
                else:
                    kind = "ATOM (round)" if (dec is not None and dec <= 2) else \
                           "ATOM (full-precision — a computed value recurring exactly)"
                    mark = f"  <- {kind}, {n_loads} loads / {n_place} placements / {n_sites} sites"
                    result["atoms"].setdefault(f"{bidder}/{cur}", []).append(
                        {"value": v, "loads": n_loads, "placements": n_place, "decimals": dec})
            p(f"      {v:<20.10g} rows={c} loads={n_loads} pl={n_place}  decimals={dec}{mark}")
        result["groups"][f"{bidder}/{cur}"] = {"n": n, "distinct": distinct}
        if n < min_n:
            p(f"   n={n} is below --min-n {min_n}: this is a list of observations, not a "
              f"distribution, and no shape claim is made from it")
    return result


def selftest():
    ok = True
    import io

    def rows_for(vals, currency="RUB", bidder="sparrow", schema=4, loads=None, places=None,
                 sites=None):
        """vals[i] gets load L<i> and placement P<i> unless overridden — so a fixture can put
        two prices in ONE load, or the same price on ONE placement, which are the two cases the
        atom test has to tell apart."""
        rs = []
        seen_loads = {}
        for i, v in enumerate(vals):
            lid = (loads[i] if loads else f"L{i}")
            seen_loads[lid] = (sites[i] if sites else "https://s.ru/")
            rs.append({"schema": schema, "kind": "request", "bidder": bidder, "load_id": lid,
                       "outcome": "bid-zero" if v == 0 else "priced", "arm": "direct",
                       "detail": {"prices": [{"value": v, "field": "cpm", "currency": currency,
                                              "placementId": (places[i] if places else f"P{i}"),
                                              "path": "$[0].cpm"}]}})
        for lid, url in seen_loads.items():
            rs.append({"schema": schema, "kind": "load", "load_id": lid, "url": url})
        return rs

    # A real-shaped sample: computed values plus a round one repeating.
    vals = [4.809109470545412, 0.573, 0.1212, 0.0852, 0.0475, 2.5, 2.5, 2.5, 1.6466222636311705,
            0.0]
    prices, zeros, schema = collect(rows_for(vals))
    buf = io.StringIO()
    res = report(prices, zeros, schema, out=buf)
    text = buf.getvalue()
    # The default fixture is schema 4 and the capture is at CAPTURE_SCHEMA — and schema 3 is
    # exactly where the PRICE COLUMN changed meaning, so a price read-out that does not name
    # its distance from current is the most dangerous quiet number in this repo.
    _cur = io.StringIO()
    _c = collect(rows_for([2.5, 2.5, 2.5, 0.1], schema=CAPTURE_SCHEMA))
    report(_c[0], _c[1], _c[2], out=_cur)

    checks = [
        ("a corpus behind the capture schema says so",
         "the capture now writes" in text),
        ("and a current corpus does not carry the warning",
         "the capture now writes" not in _cur.getvalue()),
        ("zero bid kept out of the distribution", zeros == 1 and len(prices) == 9),
        ("the repeated round value is named an atom",
         [a["value"] for a in res["atoms"].get("sparrow/RUB", [])] == [2.5]
         and res["atoms"]["sparrow/RUB"][0]["loads"] == 3),
        # Precision is the evidence that makes the repeat legible, so it must be reported.
        ("precision is reported per value", "decimals=1" in text and "decimals=15" in text),
    ]

    # The same repeat in a sample too small to support the word.
    small = collect(rows_for([2.5, 2.5, 2.5, 0.1]))
    buf2 = io.StringIO()
    res2 = report(small[0], small[1], small[2], out=buf2)
    checks.append(("a repeat below min-n is not called an atom",
                   not res2["atoms"] and "under the 8 this report needs" in buf2.getvalue()
                   and "not a distribution" in buf2.getvalue()))
    # The message must name the condition that actually failed. An earlier version blamed n
    # for a repeat that was short of --min-repeats, sending the reader to fix the wrong thing.
    small_reps = collect(rows_for([2.5, 2.5] + [0.1 * i for i in range(1, 12)]))
    buf2b = io.StringIO()
    res2b = report(small_reps[0], small_reps[1], small_reps[2], out=buf2b)
    checks.append(("a short repeat is refused for REPEATS, not blamed on n",
                   not res2b["atoms"] and "needs 3 before the word atom" in buf2b.getvalue()
                   and "under the 8" not in buf2b.getvalue()))

    # Two prices of the same value inside ONE page load: the wrapper fires a page's slots
    # together, so that is one observation of the bidder, not two.
    one_load = collect(rows_for([4.0, 4.0] + [0.1 * i for i in range(1, 12)],
                                loads=["Lx", "Lx"] + [f"L{i}" for i in range(11)]))
    buf4 = io.StringIO()
    res4 = report(one_load[0], one_load[1], one_load[2], out=buf4)
    checks.append(("two rows in one load are one observation, not a repeat",
                   not res4["atoms"] and "ONE load" in buf4.getvalue()))

    # The same value returning on one placement across loads is a price fixed for that SLOT.
    one_slot = collect(rows_for([3.0, 3.0, 3.0] + [0.1 * i for i in range(1, 12)],
                                places=["P9", "P9", "P9"] + [f"P{i}" for i in range(11)]))
    buf5 = io.StringIO()
    res5 = report(one_slot[0], one_slot[1], one_slot[2], out=buf5)
    checks.append(("a value fixed to one placement is not a price-list atom",
                   not res5["atoms"] and res5.get("slot_fixed")
                   and "not a price-list atom" in buf5.getvalue()))

    # Two currencies must never be pooled into one distribution.
    mixed = rows_for([2.5] * 5, currency="RUB") + rows_for([2.5] * 5, currency="USD")
    pm, zm, sm = collect(mixed)
    buf3 = io.StringIO()
    res3 = report(pm, zm, sm, out=buf3)
    checks.append(("currencies are not pooled",
                   set(res3["groups"]) == {"sparrow/RUB", "sparrow/USD"}
                   and all(g["n"] == 5 for g in res3["groups"].values())))

    for name, good in checks:
        print(("ok   " if good else "FAIL ") + name)
        ok = ok and good
    print("--test:", "ok" if ok else "FAILED")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--log", default=LOG)
    ap.add_argument("--schema", type=int)
    ap.add_argument("--min-n", type=int, default=8)
    ap.add_argument("--min-repeats", type=int, default=3)
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        return selftest()
    if not os.path.exists(args.log):
        print(f"n/a: no log at {args.log}", file=sys.stderr)
        return 2
    rows = []
    with open(args.log) as fh:
        for line in fh:
            line = line.strip()
            if line:
                try:
                    rows.append(json.loads(line))
                except Exception:
                    pass
    prices, zeros, schema = collect(rows, args.schema)
    report(prices, zeros, schema, args.min_n, args.min_repeats)
    return 0


if __name__ == "__main__":
    sys.exit(main())
