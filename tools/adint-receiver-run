#!/usr/bin/env python3
"""Compatibility entry point for the canonical Step 1 process harness."""
import os
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parents[1]


def main():
    out = pathlib.Path(os.environ.get("ADINT_STEP1_OUT", ROOT / "data" / "step1-20260830"))
    command = [sys.executable, str(ROOT / "tools" / "adint-step1-run"),
               "--seed", "20260830", "--out-dir", str(out), "--offline-egress"]
    return subprocess.call(command)


if __name__ == "__main__":
    raise SystemExit(main())
