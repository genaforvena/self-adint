#!/usr/bin/env python3
"""Capture ONE cell of the two-week schedule, on a cadence that is not an agent's loop.

# reflex-cadence: 0 */2 * * *

WHY THIS EXISTS AT ALL. The collection is the step every finding in this study depends
on, and until now it was launched by hand at the end of each turn of an agent's loop. A
step everything depends on must have its own unconditional cadence — an agent's loop dies
with its engine, and nobody is going to remember for fourteen days. §2.3 asks for 4480
readable pairs per arm over 14 days; a cell is 28 pairs and takes about an hour, so every
two hours (12 cells a day, ~336 pairs) meets the design with margin for the cells that
fail. That margin is deliberate: a cadence sized exactly to the target has no room for a
bad night.

THREE THINGS IT REFUSES TO GET WRONG, all of them this project's own scar tissue:

  ONE WRITER. The RU arm runs inside a single netns over a single USB tether — one
  resource, no second copy. Two cells at once would interleave two vantages' traffic on
  one link and neither would be the paired design. A cell already running means this tick
  does nothing, and says so.

  A RUN THAT COLLECTED NOTHING IS NOT A CLEAN RUN. Every tick writes an outcome record
  with its coverage — cells attempted, pairs complete, which arms were alive — INCLUDING
  the ticks that collected nothing, with the reason. An empty set writes itself as a
  success unless something makes it write itself as an empty set, and over fourteen days
  the difference between "the market was quiet" and "our link was down" is the difference
  between a finding and a fabrication.

  THE LEDGERS ARE APPEND-ONLY AND KEPT WHOLE. No sliding window, no pruning, for the full
  fourteen days. This mesh already owns a ledger that prunes every sweep, and the price is
  that no `n` quoted against it is reproducible and n moves DOWN as well as up. Not here.
  Checked at every tick: free space, and the corpus growing rather than shrinking.
"""

import argparse
import json
import os
import subprocess
import sys
import time
from datetime import datetime, timezone

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOOLS = os.path.join(REPO, "tools")
DATA = os.path.join(REPO, "data")
LOG = os.path.join(REPO, "data", "collect-cell.log")
VENV = os.path.expanduser("~/.venv-browser/bin/python3")
FRAME = os.path.join(REPO, "ref", "ru-frame-stageB-ru-mobile-2026-08-19.tsv")
MIN_FREE_GB = 20


def now():
    return datetime.now(timezone.utc)


def record(outcome, reason, **extra):
    """The per-tick outcome record. ALWAYS written, including for the ticks that did
    nothing — that is the whole point of it existing separately from the cell ledgers."""
    rec = {"kind": "collect-tick", "ts": now().isoformat(), "outcome": outcome,
           "reason": reason}
    rec.update(extra)
    os.makedirs(os.path.dirname(LOG), exist_ok=True)
    with open(LOG, "a", encoding="utf-8") as fh:
        fh.write(json.dumps(rec, ensure_ascii=False) + "\n")
    print(json.dumps(rec, ensure_ascii=False))
    return rec


PROBE_FAILED = "probe-failed"


def running_pid():
    """The pid of a live cell driver, `None` if there is none, or `PROBE_FAILED`.

    Reads the process table rather than trusting a lock file: a lock file outlives the
    process that wrote it, and a stale lock would silence the collection for the rest of
    the window — a fourteen-day outage caused by the guard meant to protect it.

    IT ASKS BY UID, NOT BY $USER, AND CRON IS WHY. This selected on
    `os.environ.get("USER", "")`, and **cron does not set USER** — measured on this node
    from the environ of a live cron child: it sets HOME, LOGNAME, PATH, SHELL, LANG, and
    no USER. So under cron the call became `ps -u "" -o pid=,args=`, which exits 1 with
    `error: list of users must follow -u` and prints nothing. The returncode was never
    read, the empty output was iterated, and the guard answered "no cell is running" —
    every single tick, for as long as the fortnight ran.

    It passed every test, because a test is run from a shell and a shell sets USER. The
    gate was green in the only place it was ever exercised and inert in the only place it
    mattered. `os.getuid()` needs no environment to be true.

    AND A FAILED PROBE IS NOT AN ANSWER. Returning None on exception meant "I could not
    look" and "I looked and found nobody" were the same value — a silent fallback turning
    a total failure into the one reply that lets the caller proceed. They are now
    different, and the caller must decide; it skips. A skipped tick is recoverable and
    writes itself down. Two cells interleaving two vantages on one tether is neither.
    """
    try:
        out = subprocess.run(["/usr/bin/ps", "-u", str(os.getuid()), "-o", "pid=,args="],
                             capture_output=True, timeout=20)
    except Exception:
        return PROBE_FAILED
    if out.returncode != 0:
        return PROBE_FAILED
    for line in (out.stdout or b"").decode("utf-8", "replace").splitlines():
        line = line.strip()
        if "adint-paired-run" in line and "--test" not in line:
            pid = line.split(None, 1)[0]
            if pid.isdigit() and int(pid) != os.getpid():
                return int(pid)
    return None


def free_gb(path=REPO):
    st = os.statvfs(path)
    return st.f_bavail * st.f_frsize / 1e9


def corpus_bytes():
    tot = 0
    for root, _d, files in os.walk(DATA):
        for f in files:
            if f.endswith(".jsonl"):
                try:
                    tot += os.path.getsize(os.path.join(root, f))
                except OSError:
                    pass
    return tot


def latest_run_files():
    """The (ru, nl, control) files of the most recent cell, by mtime."""
    best, out = None, {}
    for f in os.listdir(DATA):
        if not f.startswith("hb-paired-") or not f.endswith(".jsonl"):
            continue
        stem = f.split(".")[0]
        m = os.path.getmtime(os.path.join(DATA, f))
        if best is None or m > best[1]:
            best = (stem, m)
    if not best:
        return out
    for suffix, key in ((".ru.jsonl", "ru"), (".nl.jsonl", "nl"),
                        (".control.jsonl", "control")):
        p = os.path.join(DATA, best[0] + suffix)
        if os.path.exists(p):
            out[key] = p
    return out


def count_loads(path):
    n = 0
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and '"kind": "load"' in line:
                    n += 1
    except OSError:
        pass
    return n


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--replicates", type=int, default=2)
    ap.add_argument("--window", type=int, default=45)
    ap.add_argument("--frame", default=FRAME)
    ap.add_argument("--dry-run", action="store_true",
                    help="every gate, no capture. Writes to a SEPARATE log — a dry run "
                         "appending to the record a watchdog reads for liveness forges "
                         "the evidence it exists to check")
    ap.add_argument("--test", action="store_true")
    a = ap.parse_args()
    if a.test:
        return selftest()

    global LOG
    if a.dry_run:
        LOG = os.path.join(DATA, "collect-cell.dryrun.log")

    before = corpus_bytes()

    pid = running_pid()
    if pid == PROBE_FAILED:
        record("skipped", "the process table could not be read, so single-writer cannot "
                          "be established — skipping is the recoverable direction; two "
                          "cells interleaving two vantages on one tether is not")
        return 0
    if pid:
        record("skipped", f"a cell is already running (pid {pid}) — the RU netns and its "
                          "tether are one resource and two cells would interleave two "
                          "vantages on one link", running_pid=pid)
        return 0
    if free_gb() < MIN_FREE_GB:
        record("skipped", f"only {free_gb():.1f} GB free, floor is {MIN_FREE_GB} — the "
                          "ledgers are append-only for the whole window and must not be "
                          "traded against disk", free_gb=round(free_gb(), 1))
        return 0
    if not os.path.exists(a.frame):
        record("failed", f"frame {a.frame} is missing — a cell with no frame is not a "
                         "cell of this schedule")
        return 1
    if not os.path.exists(VENV):
        record("failed", f"{VENV} is missing — the capture cannot run")
        return 1
    if a.dry_run:
        record("dry-run", "every gate passed; no capture attempted",
               free_gb=round(free_gb(), 1), corpus_bytes=before)
        return 0

    cmd = [VENV, os.path.join(TOOLS, "adint-paired-run"), "--frame", a.frame,
           "--replicates", str(a.replicates), "--window", str(a.window)]
    t0 = time.time()
    try:
        pr = subprocess.run(cmd, cwd=REPO, capture_output=True, timeout=3 * 3600)
        rc = pr.returncode
        err = (pr.stderr or b"").decode("utf-8", "replace")[-400:]
    except subprocess.TimeoutExpired:
        record("failed", "the cell exceeded 3 h and was killed — a cell that cannot "
                         "finish inside the cadence would collide with the next tick",
               elapsed_s=round(time.time() - t0, 1))
        return 1
    except Exception as e:
        record("failed", f"{type(e).__name__}: {e}"[:300])
        return 1

    files = latest_run_files()
    loads = {k: count_loads(v) for k, v in files.items() if k in ("ru", "nl")}
    after = corpus_bytes()
    # A ledger that SHRANK is the one thing that would silently destroy reproducibility.
    if after < before:
        record("failed", f"the corpus shrank ({before} -> {after} bytes) — the ledgers are "
                         "append-only and something pruned them", corpus_bytes=after)
        return 1
    # ZERO ROWS WITH A REASON, never a clean run.
    if not loads or not any(loads.values()):
        record("empty", f"the cell produced no loads (rc={rc}) — this is a tick that "
                        f"collected nothing, not a tick that had nothing to collect",
               rc=rc, stderr=err, elapsed_s=round(time.time() - t0, 1),
               corpus_bytes=after)
        return 0

    # A HALF-EMPTY CELL IS NOT A COLLECTED CELL. The gate above catches only a cell that
    # produced NOTHING; a cell whose foreign arm produced 1 load against the domestic arm's
    # 28 sails through it as `collected`, and `arms_alive` lists both because one load is
    # not zero. Measured live 2026-08-21: cell 2026082112 lost 23 consecutive nl-direct
    # loads to vantage-unproven between 12:01 and 12:47 and would have recorded green.
    #
    # A PAIR NEEDS BOTH ARMS, so a cell is worth exactly min(loads) pairs however large the
    # other arm is. That ratio is the classification rather than a threshold picked to
    # taste: below one half, most of what the cell attempted has no partner and can enter
    # no contrast. `arms_alive` keeps its old meaning — produced anything at all — and
    # `pairs_possible` is the number that matters, published beside it so the two cannot be
    # confused again.
    lo, hi, starved = pair_yield(loads)
    if starved:
        record("partial", f"arm {'/'.join(starved)} produced {lo} load(s) against {hi} — a "
                          f"pair needs both arms, so this cell is worth at most {lo} pair(s) "
                          f"and most of what it attempted has no partner",
               rc=rc, loads=loads, pairs_possible=lo, starved_arms=starved,
               elapsed_s=round(time.time() - t0, 1), corpus_bytes=after)
        # NOT a return: the rows that DID land are real and still get published. This
        # record is about how to READ the cell, not about withholding it.

    published = []
    for key in ("ru", "nl"):
        if key in files:
            p = subprocess.run([sys.executable, os.path.join(TOOLS, "adint-publish"),
                                "--kind", "paired", files[key]],
                               cwd=REPO, capture_output=True, timeout=600)
            published.append(f"{key}:rc{p.returncode}")
    if "control" in files:
        p = subprocess.run([sys.executable, os.path.join(TOOLS, "adint-publish"),
                            "--kind", "control", files["control"]],
                           cwd=REPO, capture_output=True, timeout=600)
        published.append(f"control:rc{p.returncode}")
    subprocess.run([sys.executable, os.path.join(TOOLS, "adint-status"), "--write"],
                   cwd=REPO, capture_output=True, timeout=600)

    record("collected", f"cell captured and published (rc={rc})", rc=rc,
           pairs_possible=min(loads.values()) if loads else 0,
           arms_alive=sorted(k for k, v in loads.items() if v),
           loads=loads, published=published,
           elapsed_s=round(time.time() - t0, 1), corpus_bytes=after,
           files={k: os.path.basename(v) for k, v in files.items()})
    return 0


def pair_yield(loads):
    """(min, max, starved_arms) — the pair arithmetic, as a function so it can be tested.

    A pair needs BOTH arms, so a cell is worth exactly `min(loads)` pairs however large the
    other arm is. `starved` is empty unless the smaller arm fell below half the larger, at
    which point most of what the cell attempted has no partner and the cell must not be
    recorded with the same word as a balanced one.
    """
    if not loads or not any(loads.values()):
        return 0, 0, []
    lo, hi = min(loads.values()), max(loads.values())
    if hi and lo < 0.5 * hi:
        return lo, hi, sorted(k for k, v in loads.items() if v == lo)
    return lo, hi, []


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    import tempfile
    global DATA, LOG, REPO
    keep = (DATA, LOG, REPO)
    d = tempfile.mkdtemp()
    DATA = os.path.join(d, "data")
    os.makedirs(DATA)
    LOG = os.path.join(DATA, "collect-cell.log")

    # A tick ALWAYS leaves a record, including the ticks that did nothing. Over fourteen
    # days the difference between "the market was quiet" and "our link was down" is the
    # difference between a finding and a fabrication.
    record("skipped", "because")
    rows = [json.loads(l) for l in open(LOG, encoding="utf-8")]
    check("a tick that did nothing still writes a record", len(rows), 1)
    check("...and the record carries its reason, not just its outcome",
          bool(rows[0].get("reason")) and rows[0]["outcome"] == "skipped", True)
    check("the record is timestamped", bool(rows[0].get("ts")), True)

    # An append-only corpus: shrinking is the failure that destroys reproducibility.
    open(os.path.join(DATA, "hb-paired-x.ru.jsonl"), "w").write(
        json.dumps({"kind": "load", "pair_id": "a"}) + "\n")
    b1 = corpus_bytes()
    check("the corpus size is measured over the ledgers", b1 > 0, True)
    open(os.path.join(DATA, "hb-paired-x.ru.jsonl"), "w").write("")
    check("a truncated ledger reads as a SMALLER corpus, which is the alarm",
          corpus_bytes() < b1, True)

    # The load counter must count loads, not lines: a ledger of request rows is not a
    # cell that collected, and counting lines would make an empty cell look full.
    p = os.path.join(DATA, "hb-paired-y.ru.jsonl")
    with open(p, "w") as fh:
        fh.write("# a header comment\n")
        fh.write(json.dumps({"kind": "request", "outcome": "no-bid"}) + "\n")
        fh.write(json.dumps({"kind": "load", "pair_id": "a"}) + "\n")
    check("only load rows count as loads", count_loads(p), 1)
    check("a ledger with no load rows counts zero, so an empty cell cannot read as full",
          count_loads(os.path.join(DATA, "hb-paired-x.ru.jsonl")), 0)

    # The single-writer guard reads the PROCESS TABLE, not a lock file: a lock outlives
    # the process that wrote it, and a stale one would silence collection for the rest of
    # the window — a fortnight-long outage caused by the guard meant to protect it.
    # DRIVEN, not grepped. The first cut asserted the guard by searching this file for a
    # lock-file call — and the search string sat on the grep line itself, so the gate
    # matched its own text and could never fail. Assert the BEHAVIOUR: start a real
    # process whose argv looks like a running cell, and see the guard find it and then
    # stop finding it.
    # A LIVE CELL IS NOT A TEST FAILURE. Every guard check in this section needs an empty
    # process table to start from, and this tool's whole job is to run cells — so for
    # roughly half of every two-hour cadence a real cell IS running and these checks go red
    # on a tool that is working perfectly. `mesh-doctor` drives every `--test` hourly, so
    # that is a permanently flapping red, and a red everyone learns to ignore is worse than
    # no gate at all. Honest n/a instead: the suite exits 2 (which `mesh-land` treats as a
    # pass) and SAYS the guard was not exercised. Never a silent pass — that would be the
    # vacuity this file is otherwise careful about.
    # THE PAIR ARITHMETIC, driven rather than described.
    check("a balanced cell is not starved", pair_yield({"ru": 28, "nl": 28}), (28, 28, []))
    check("28 against 1 IS starved, and the starved arm is named",
          pair_yield({"ru": 28, "nl": 1}), (1, 28, ["nl"]))
    check("28 against 26 is not — a pair needs both arms, not equal arms",
          pair_yield({"ru": 28, "nl": 26}), (26, 28, []))
    check("exactly half is not starved; below half is",
          (pair_yield({"ru": 28, "nl": 14})[2], pair_yield({"ru": 28, "nl": 13})[2]),
          ([], ["nl"]))
    check("an empty cell yields no pairs and names no starved arm (the empty gate owns it)",
          pair_yield({"ru": 0, "nl": 0}), (0, 0, []))
    check("the cell is worth min(loads) pairs, never the larger arm",
          pair_yield({"ru": 28, "nl": 3})[0], 3)

    _live = running_pid()
    if _live and _live != PROBE_FAILED:
        print(f"n/a  single-writer guard NOT exercised — a real cell is running (pid "
              f"{_live}) and these checks need an empty process table. Re-run between "
              f"cells. This is not a pass.")
        DATA, LOG, REPO = keep          # never leave the globals pointing at the fixture
        # AN N/A MUST NOT SWALLOW A RED. If anything above this point already failed, the
        # suite failed — the unexercised guard does not make those failures inapplicable.
        # Caught by breaking pair_yield while a cell was in flight: two checks went FAIL
        # and the summary still said n/a and returned 2, which mesh-land reads as a pass.
        if not ok:
            print("selftest: FAIL (and the single-writer guard was not exercised)")
            return 1
        print("selftest: n/a (single-writer guard unexercised — a cell is in flight)")
        return 2
    check("no cell running is reported as none", running_pid(), None)
    fake = subprocess.Popen(["/bin/bash", "-c",
                             "exec -a 'python3 tools/adint-paired-run --frame f' sleep 30"])
    try:
        seen = None
        for _ in range(40):                       # the process table is not instantaneous
            seen = running_pid()
            if seen:
                break
            time.sleep(0.05)
        check("a live cell driver is detected, so a second cell cannot start", seen,
              fake.pid)
    finally:
        fake.kill()
        fake.wait()
    for _ in range(40):
        if running_pid() is None:
            break
        time.sleep(0.05)
    check("the guard stops firing once the cell exits, so it cannot wedge the fortnight",
          running_pid(), None)
    # A --test invocation must never look like a running cell, or the suite would block
    # every real tick for as long as it runs. DRIVEN, like the checks above: the previous
    # cut asserted this by searching this file for the literal `"--test" not in line` —
    # and the searching line CONTAINS that literal, so it matched its own text and could
    # not fail. Two lines under a comment warning about exactly that.
    selftester = subprocess.Popen(
        ["/bin/bash", "-c",
         "exec -a 'python3 tools/adint-paired-run --frame f --test' sleep 30"])
    try:
        time.sleep(0.4)
        check("a --test process is not mistaken for a cell", running_pid(), None)
    finally:
        selftester.kill()
        selftester.wait()

    # THE ENVIRONMENT CRON ACTUALLY HANDS US. Measured from a live cron child on this
    # node: HOME, LOGNAME, PATH, SHELL, LANG — and no USER. The guard used to select on
    # $USER, so under cron it ran `ps -u ""`, which exits 1 and prints nothing, and the
    # guard reported an empty process table on every tick of the fortnight. It was green
    # here the whole time, because a test runs from a shell and a shell sets USER. So the
    # test now runs the guard in cron's environment, not in its own.
    cron_env = {k: v for k, v in os.environ.items()
                if k in ("HOME", "LOGNAME", "PATH", "SHELL", "LANG")}
    check("the fixture is the real thing — cron's environment has no USER",
          "USER" in cron_env, False)
    saved = dict(os.environ)
    fake2 = subprocess.Popen(["/bin/bash", "-c",
                              "exec -a 'python3 tools/adint-paired-run --frame f' sleep 30"])
    try:
        os.environ.clear()
        os.environ.update(cron_env)
        seen2 = None
        for _ in range(40):
            seen2 = running_pid()
            if seen2:
                break
            time.sleep(0.05)
        check("the guard still finds a live cell with USER unset, as cron runs it",
              seen2, fake2.pid)
    finally:
        os.environ.clear()
        os.environ.update(saved)
        fake2.kill()
        fake2.wait()

    # A PROBE THAT COULD NOT LOOK IS NOT A PROBE THAT FOUND NOBODY. Point the guard at a
    # `ps` that always fails and assert it says so, instead of returning the one answer
    # that lets a second cell start.
    import tempfile as _tf
    d = _tf.mkdtemp()
    bad = os.path.join(d, "ps")
    with open(bad, "w") as fh:
        fh.write("#!/bin/sh\nexit 1\n")
    os.chmod(bad, 0o755)
    real_run = subprocess.run
    try:
        subprocess.run = lambda cmd, **kw: real_run([bad] + list(cmd)[1:], **kw)
        check("a probe that cannot read the process table says PROBE_FAILED, not None",
              running_pid(), PROBE_FAILED)
    finally:
        subprocess.run = real_run


    DATA, LOG, REPO = keep
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
