#!/usr/bin/env python3
"""Hold the preregistration to its own terms, mechanically.

`docs/prereg-vantage-price-2026-08-21.md` fixes a hypothesis, a test, a stopping rule and
a subgroup list before the corpus that decides them exists. Every part of that is a
promise, and a promise kept only by the analyst's intention is not a control — especially
here, where the corpus is PUBLISHED CONTINUOUSLY and cannot be blinded. Anyone, the
analyst included, can watch the cells land. So the discipline has to live somewhere other
than in willpower:

  --register   record the document's hash and the window's start, in a committed file, so
               that "written before the data" is a checkable claim rather than a date in
               a header a later edit could move.
  --verify     recompute the hash. A mismatch is not an error to be fixed by re-registering
               — it is the tool reporting that the preregistration changed, which is
               exactly what it exists to make visible.
  --status     how much of the window remains, and how the analysis set is filling.
  --result     the prespecified test. REFUSES to compute before the window closes.

That refusal is the load-bearing part. A stopping rule that permits a peek permits
stopping on the peek, and "we only looked, we did not stop" is unfalsifiable after the
fact. `--status` deliberately reports COVERAGE (how much data) and never the statistic,
so watching progress can never become watching the result.

`orphan-ok`: invoked at the window's edges and by hand, not on a cadence. The COLLECTION
has a cadence (that is the point of wiring the collector); the analysis fires twice.
"""

import argparse
import glob
import hashlib
import json
import os
import random
import sys
from datetime import datetime, timedelta, timezone

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PUB = os.path.join(REPO, "public-data")
PRIV = os.path.join(REPO, "data")
DOC = os.path.join(REPO, "docs", "prereg-vantage-price-2026-08-21.md")
REG = os.path.join(REPO, "ref", "PREREG-vantage-price-2026-08-21.json")
WINDOW_DAYS = 14
SEED = 20260821
PERMUTATIONS = 100_000
ALPHA = 0.01
MIN_PRICED = 30          # §4's underpowered floor
PRICED_OUTCOMES = ("priced",)


def doc_hash(path=None):
    """sha256 of the preregistration document, or None if it is not there.

    A missing document must not hash to a fixed string — an absent file that produces a
    stable digest would VERIFY, and the tool would certify a preregistration that no
    longer exists.
    """
    p = path or DOC
    if not os.path.exists(p):
        return None
    with open(p, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()


def read_jsonl(path):
    out = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return out


def load_reg():
    if not os.path.exists(REG):
        return None
    try:
        return json.load(open(REG, encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def parse_ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except (ValueError, TypeError):
        return None


def cell_rows(include_private=True):
    """[(run, arm, row)] over every paired ledger. Both trees by default: the analysis set
    is about what was COLLECTED, and a cell not yet published is collected."""
    pats = [os.path.join(PUB, "hb-paired-*.jsonl")]
    if include_private:
        pats.append(os.path.join(PRIV, "hb-paired-*.jsonl"))
    seen, out = set(), []
    for p in sorted(set(sum([glob.glob(x) for x in pats], []))):
        if p.endswith(".control.jsonl"):
            continue
        base = os.path.basename(p)
        if base in seen:            # published copy already read
            continue
        seen.add(base)
        for r in read_jsonl(p):
            out.append((base, r.get("arm"), r))
    return out


def window(reg):
    """(start, end) as datetimes, or (None, None) if not registered."""
    if not reg or not reg.get("window_start"):
        return None, None
    st = parse_ts(reg["window_start"])
    if st is None:
        return None, None
    return st, st + timedelta(days=reg.get("window_days", WINDOW_DAYS))


def first_cell_after(ts):
    """The earliest load timestamp strictly after `ts`, i.e. where the window opens."""
    best = None
    for _run, _arm, r in cell_rows():
        t = parse_ts(r.get("ts"))
        if t and t > ts and (best is None or t < best):
            best = t
    return best


def analysis_set(reg):
    """The §2 analysis set, and the exclusion counts that go with it.

    Exclusions are COUNTED, never silently dropped: an exclusion count is a bias term.
    """
    st, en = window(reg)
    keep, exc = [], {"outside-window": 0, "vantage-unproven": 0, "no-arm": 0,
                     "unpaired": 0, "not-a-request": 0}
    # A pair is readable only if BOTH arms rendered; collect the loads first.
    rendered = {}
    for _run, arm, r in cell_rows():
        if r.get("kind") != "load" or not r.get("pair_id"):
            continue
        ok = r.get("http_status") is not None and r.get("vantage_verified")
        rendered.setdefault(r["pair_id"], {})[arm] = ok
    good_pairs = {p for p, arms in rendered.items()
                  if len(arms) > 1 and all(arms.values())}
    for _run, arm, r in cell_rows():
        if r.get("kind") == "load":
            continue
        if r.get("outcome") is None:
            exc["not-a-request"] += 1
            continue
        if not arm:
            exc["no-arm"] += 1
            continue
        pid = r.get("pair_id")
        t = parse_ts(r.get("ts"))
        if st and (t is None or not (st <= t < en)):
            exc["outside-window"] += 1
            continue
        if pid not in good_pairs:
            # Either the pair's other half never rendered, or an arm could not prove its
            # vantage. Both mean the row carries no RU-versus-foreign contrast — and an
            # unproven arm must NEVER be folded into a bid outcome.
            exc["vantage-unproven" if pid in rendered else "unpaired"] += 1
            continue
        keep.append((arm, r))
    return keep, exc, good_pairs


def coverage(reg):
    keep, exc, pairs = analysis_set(reg)
    by_arm = {}
    for arm, r in keep:
        d = by_arm.setdefault(arm, {"entries": 0, "priced": 0})
        d["entries"] += 1
        if r.get("outcome") in PRICED_OUTCOMES:
            d["priced"] += 1
    return {"arms": by_arm, "exclusions": exc, "readable_pairs": len(pairs),
            "priced_total": sum(d["priced"] for d in by_arm.values())}


def paired_permutation(keep, ru_arm, seed=SEED, n=PERMUTATIONS):
    """§3's primary test: permute the arm label WITHIN each pair.

    Exchangeability under H0 is a within-pair claim, and that is the only thing the
    pairing buys. Permuting across pairs would destroy the site/hour/frame-position
    matching the design exists to hold fixed and would answer a question nobody asked.
    Entries nested in loads nested in sites are NOT independent draws; a test that treats
    them as such (Fisher, §3's secondary) overstates the evidence, which is why it is the
    secondary.
    """
    pairs = {}
    for arm, r in keep:
        pid = r.get("pair_id")
        if not pid:
            continue
        d = pairs.setdefault(pid, {})
        a = d.setdefault(arm, {"n": 0, "k": 0})
        a["n"] += 1
        if r.get("outcome") in PRICED_OUTCOMES:
            a["k"] += 1
    usable = [d for d in pairs.values() if len(d) == 2]
    if not usable:
        return None

    def stat(flip):
        rn = rk = fn = fk = 0
        for i, d in enumerate(usable):
            arms = sorted(d)
            ru = ru_arm if ru_arm in d else arms[0]
            fo = [a for a in arms if a != ru][0]
            a, b = (d[fo], d[ru]) if flip and flip[i] else (d[ru], d[fo])
            rn += a["n"]; rk += a["k"]; fn += b["n"]; fk += b["k"]
        return (rk / rn if rn else 0.0) - (fk / fn if fn else 0.0)

    obs = stat(None)
    rng = random.Random(seed)
    ge = 0
    for _ in range(n):
        ge += stat([rng.random() < 0.5 for _ in usable]) >= obs
    # +1/+1: a permutation p can never be 0 — with n resamples the smallest honest
    # statement is 1/(n+1), and printing 0.0 would claim more than the resampling can say.
    return {"observed_diff": round(obs, 6), "p": (ge + 1) / (n + 1),
            "pairs_used": len(usable), "permutations": n, "seed": seed}


def fisher_one_sided(a, b, c, d):
    """P(X >= a) for the 2x2 [[a,b],[c,d]] under the hypergeometric null. §3's SECONDARY."""
    from math import comb
    n1, n2, t = a + b, c + d, a + c
    tot = n1 + n2
    den = comb(tot, t)
    if den == 0:
        return None
    return sum(comb(n1, i) * comb(n2, t - i) for i in range(a, min(n1, t) + 1)) / den


def cmd_register(args):
    h = doc_hash()
    if h is None:
        print(f"adint-prereg: {DOC} does not exist — nothing to register", file=sys.stderr)
        return 2
    if load_reg() and not args.force:
        print("adint-prereg: already registered. Re-registering would move the window and "
              "reset the hash, which is the one thing this file exists to prevent — pass "
              "--force only to record a declared AMENDMENT.", file=sys.stderr)
        return 2
    now = datetime.now(timezone.utc)
    rec = {"document": os.path.relpath(DOC, REPO), "sha256": h,
           "registered_ts": now.isoformat(),
           # The window opens at the first cell captured AFTER registration, not at
           # registration itself: a cell already running when this was written was
           # collected before the rule existed and cannot count toward it.
           "window_start": None, "window_days": WINDOW_DAYS,
           "seed": SEED, "permutations": PERMUTATIONS, "alpha": ALPHA,
           "min_priced": MIN_PRICED}
    os.makedirs(os.path.dirname(REG), exist_ok=True)
    json.dump(rec, open(REG, "w", encoding="utf-8"), indent=2, sort_keys=True)
    print(f"registered {rec['document']}\n  sha256 {h}\n  at     {rec['registered_ts']}\n"
          f"  window opens at the first cell captured after that instant "
          f"({WINDOW_DAYS} days), run --status to stamp it")
    return 0


def cmd_verify(args):
    reg = load_reg()
    if not reg:
        print("adint-prereg: NOT REGISTERED — the document binds nothing", file=sys.stderr)
        return 2
    h = doc_hash()
    if h is None:
        print("adint-prereg: the registered document is GONE", file=sys.stderr)
        return 1
    if h != reg.get("sha256"):
        print("adint-prereg: HASH MISMATCH — the preregistration has changed since it was "
              f"registered\n  registered {reg.get('sha256')}\n  on disk    {h}\n"
              "  This is not a bug to fix by re-registering. Record it as a dated "
              "amendment, and never let it touch the hypothesis, the test or the "
              "stopping rule.", file=sys.stderr)
        return 1
    print(f"ok  document unchanged since registration ({h[:16]}…)")
    return 0


def cmd_status(args):
    reg = load_reg()
    if not reg:
        print("adint-prereg: NOT REGISTERED", file=sys.stderr)
        return 2
    # Stamp the window's start the first time a cell lands after registration.
    if not reg.get("window_start"):
        t = parse_ts(reg["registered_ts"])
        first = first_cell_after(t) if t else None
        if first:
            reg["window_start"] = first.isoformat()
            json.dump(reg, open(REG, "w", encoding="utf-8"), indent=2, sort_keys=True)
            print(f"window opened at the first post-registration cell: {reg['window_start']}")
        else:
            print("registered; window has not opened — no cell captured since registration")
            return 0
    st, en = window(reg)
    now = datetime.now(timezone.utc)
    left = en - now
    cov = coverage(reg)
    print(f"window {st.isoformat()} → {en.isoformat()}")
    print("CLOSED" if left.total_seconds() <= 0
          else f"open · {left.days}d {left.seconds // 3600}h remaining")
    print(f"readable pairs in window: {cov['readable_pairs']}")
    for arm in sorted(cov["arms"]):
        d = cov["arms"][arm]
        print(f"  {arm:<12} entries={d['entries']:<6} priced={d['priced']}")
    print(f"priced total {cov['priced_total']} (underpowered below {reg['min_priced']})")
    print("exclusions: " + ", ".join(f"{k}={v}" for k, v in sorted(cov["exclusions"].items())))
    # COVERAGE ONLY, never the statistic. A status that showed the test result would make
    # watching progress the same act as watching the outcome, and a stopping rule you can
    # peek at is a stopping rule you can stop on.
    print("(coverage only — the statistic is computed once, after the window closes)")
    return 0


def cmd_result(args):
    reg = load_reg()
    if not reg:
        print("adint-prereg: NOT REGISTERED", file=sys.stderr)
        return 2
    if cmd_verify(argparse.Namespace()) != 0:
        print("adint-prereg: refusing to report a result against a changed preregistration",
              file=sys.stderr)
        return 1
    st, en = window(reg)
    if st is None:
        print("adint-prereg: the window never opened", file=sys.stderr)
        return 2
    now = datetime.now(timezone.utc)
    if now < en and not args.force_open_window:
        left = en - now
        print(f"adint-prereg: the window is still open — {left.days}d "
              f"{left.seconds // 3600}h remain (closes {en.isoformat()}).\n"
              "  §4 fixes the horizon and permits no interim confirmatory analysis. "
              "Computing it now would make the stopping rule advisory, which is the same "
              "as not having one.", file=sys.stderr)
        return 3
    keep, exc, pairs = analysis_set(reg)
    cov = coverage(reg)
    ru = args.ru_arm
    perm = paired_permutation(keep, ru, reg.get("seed", SEED),
                              args.permutations or reg.get("permutations", PERMUTATIONS))
    arms = cov["arms"]
    fo = [a for a in arms if a != ru]
    out = {"window": [st.isoformat(), en.isoformat()], "coverage": cov,
           "primary_paired_permutation": perm, "alpha": reg.get("alpha", ALPHA)}
    if ru in arms and fo:
        f = fo[0]
        a, b = arms[ru]["priced"], arms[ru]["entries"] - arms[ru]["priced"]
        c, d = arms[f]["priced"], arms[f]["entries"] - arms[f]["priced"]
        out["secondary_fisher_one_sided"] = {"table": [a, b, c, d],
                                             "p": fisher_one_sided(a, b, c, d),
                                             "note": "secondary; the permutation test is "
                                                     "the result where they disagree"}
    if cov["priced_total"] < reg.get("min_priced", MIN_PRICED):
        out["verdict"] = (f"UNDERPOWERED — {cov['priced_total']} priced entries, floor is "
                          f"{reg.get('min_priced', MIN_PRICED)}. H1 is neither accepted "
                          f"nor rejected; this is NOT evidence of no effect.")
    elif perm and perm["p"] <= reg.get("alpha", ALPHA):
        out["verdict"] = f"H1 SUPPORTED at alpha={reg.get('alpha', ALPHA)} (permutation)"
    elif perm:
        out["verdict"] = f"H1 NOT SUPPORTED at alpha={reg.get('alpha', ALPHA)} (permutation)"
    else:
        out["verdict"] = "NO USABLE PAIRS — nothing to test"
    print(json.dumps(out, indent=2, sort_keys=True))
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--register", action="store_true")
    ap.add_argument("--verify", action="store_true")
    ap.add_argument("--status", action="store_true")
    ap.add_argument("--result", action="store_true")
    ap.add_argument("--force", action="store_true", help="re-register a declared amendment")
    ap.add_argument("--force-open-window", action="store_true",
                    help="compute the confirmatory statistic before the window closes. "
                         "Doing this VOIDS the preregistration's protection and the "
                         "result must be labelled exploratory")
    ap.add_argument("--ru-arm", default="ru-mobile")
    ap.add_argument("--permutations", type=int, default=0)
    ap.add_argument("--test", action="store_true")
    a = ap.parse_args()
    if a.test:
        return selftest()
    if a.register:
        return cmd_register(a)
    if a.verify:
        return cmd_verify(a)
    if a.status:
        return cmd_status(a)
    if a.result:
        return cmd_result(a)
    ap.print_help()
    return 0


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    import tempfile
    global DOC, REG, PUB, PRIV
    keep_globals = (DOC, REG, PUB, PRIV)
    d = tempfile.mkdtemp()
    DOC = os.path.join(d, "prereg.md")
    REG = os.path.join(d, "reg.json")
    PUB, PRIV = os.path.join(d, "pub"), os.path.join(d, "priv")
    os.makedirs(PUB); os.makedirs(PRIV)

    # A missing document must not hash to anything: a stable digest for an absent file
    # would VERIFY, certifying a preregistration that does not exist.
    check("an absent document has no hash", doc_hash(), None)
    open(DOC, "w").write("H1: the arm matters.\n")
    h1 = doc_hash()
    check("a present document hashes", isinstance(h1, str) and len(h1) == 64, True)
    check("not registered is not a pass", cmd_verify(argparse.Namespace()), 2)
    check("registering succeeds", cmd_register(argparse.Namespace(force=False)), 0)
    check("verify passes on the registered text", cmd_verify(argparse.Namespace()), 0)
    # THE POINT OF THE HASH: an edit to the preregistration must be LOUD.
    open(DOC, "a").write("\nH1 (revised after a look at the data): the site matters.\n")
    check("an edited preregistration fails verification",
          cmd_verify(argparse.Namespace()), 1)
    open(DOC, "w").write("H1: the arm matters.\n")
    check("restoring the text restores verification", cmd_verify(argparse.Namespace()), 0)
    check("re-registering over a registration is refused",
          cmd_register(argparse.Namespace(force=False)), 2)

    # ── THE STOPPING RULE. The refusal is the whole control: a rule you may peek at is a
    # rule you may stop on, and "we only looked" is unfalsifiable afterwards.
    reg = load_reg()
    reg["window_start"] = (datetime.now(timezone.utc) - timedelta(days=1)).isoformat()
    json.dump(reg, open(REG, "w"), indent=2)
    rc = cmd_result(argparse.Namespace(ru_arm="ru-mobile", permutations=50,
                                       force_open_window=False))
    check("a result inside the open window is REFUSED", rc, 3)
    reg["window_start"] = (datetime.now(timezone.utc) - timedelta(days=30)).isoformat()
    json.dump(reg, open(REG, "w"), indent=2)

    # ── THE ANALYSIS SET. Built so the vantage rule is exercised, not just described.
    st = parse_ts(reg["window_start"]) + timedelta(hours=1)
    def load(pid, arm, status, verified, ts):
        return {"kind": "load", "pair_id": pid, "arm": arm, "http_status": status,
                "vantage_verified": verified, "ts": ts.isoformat(),
                "url": "https://s.ru/"}
    def req(pid, arm, outcome, ts):
        return {"kind": "request", "pair_id": pid, "arm": arm, "outcome": outcome,
                "ts": ts.isoformat(), "bidder": "roxot", "host": "x.example"}
    rows = {"ru-mobile": [], "nl-direct": []}
    # p1..p8 good pairs: RU prices on every one, foreign on none. Eight and not six
    # because a within-pair permutation over k INFORMATIVE pairs cannot produce a p below
    # 1/2**k — with six it floors at 0.0156 and with four (the first cut, two of the six
    # being ties) at 0.0625, so the gate would have been failing the FIXTURE's power and
    # reading as a broken test. A design's minimum attainable p is a property of its size.
    for i in range(1, 9):
        for arm in rows:
            rows[arm].append(load(f"p{i}", arm, 200, True, st))
            rows[arm].append(req(f"p{i}", arm,
                                 "priced" if arm == "ru-mobile" else "no-bid", st))
    # p7: the RU arm could NOT prove its vantage. Its rows must be EXCLUDED, never folded
    # into no-bid — the one error a fortnight of collection cannot make quietly.
    rows["ru-mobile"].append(load("p9", "ru-mobile", 200, False, st))
    rows["ru-mobile"].append(req("p9", "ru-mobile", "no-bid", st))
    rows["nl-direct"].append(load("p9", "nl-direct", 200, True, st))
    rows["nl-direct"].append(req("p9", "nl-direct", "no-bid", st))
    # p8: outside the window entirely.
    for arm in rows:
        rows[arm].append(load("p10", arm, 200, True, st - timedelta(days=60)))
        rows[arm].append(req("p10", arm, "priced", st - timedelta(days=60)))
    for arm, rr in rows.items():
        with open(os.path.join(PUB, f"hb-paired-t.{arm}.jsonl"), "w") as fh:
            for r in rr:
                fh.write(json.dumps(r) + "\n")

    keep, exc, pairs = analysis_set(load_reg())
    check("only the readable, vantage-proven, in-window pairs survive", len(pairs), 9)
    check("an unproven arm's rows are EXCLUDED, never counted as no-bid",
          exc["vantage-unproven"], 2)
    check("rows outside the window are excluded and counted",
          exc["outside-window"], 2)
    check("the surviving entries are the 8 good pairs on both arms", len(keep), 16)
    cov = coverage(load_reg())
    check("the priced entries are all on the RU arm",
          (cov["arms"]["ru-mobile"]["priced"], cov["arms"]["nl-direct"]["priced"]), (8, 0))

    # ── THE TEST. Permutation is WITHIN pairs; the effect must be detectable and the
    # null must NOT be.
    perm = paired_permutation(keep, "ru-mobile", seed=1, n=2000)
    check("the permutation test uses every complete pair", perm["pairs_used"], 8)
    check("a real one-sided effect gives a small p", perm["p"] < 0.05, True)
    # A permutation p can never be zero: with n resamples the smallest honest statement is
    # 1/(n+1), and 0.0 would claim more than the resampling can support.
    check("the p is floor-censored at 1/(n+1), never 0", perm["p"] >= 1 / 2001, True)
    # THE DISCRIMINATOR FOR "WITHIN PAIRS". Nothing above distinguishes a within-pair
    # permutation from a global reshuffle of arm labels — both give a small p on a fixture
    # this clean, and pairs_used counts pairs either way. But their NULL SPACES differ in
    # size: permuting within k pairs admits exactly 2**k arrangements, so the smallest p a
    # within-pair test can report is 1/2**k. A global shuffle draws from a vastly larger
    # space and drives p to the resampling floor. With 8 all-agreeing pairs that is 1/256
    # versus ~1/2001, and the gap is the assertion.
    check("the permutation is WITHIN pairs, so p cannot beat 1/2**pairs",
          perm["p"] >= 1 / 2 ** perm["pairs_used"], True)
    # THE NULL ARM. A test that has not been shown to FAIL to reject is not a test — with
    # both arms priced identically the p must be unremarkable.
    flat = [(arm, dict(r, outcome="priced" if r.get("outcome") else None))
            for arm, r in keep]
    flat = [(arm, r) for arm, r in flat if r.get("outcome")]
    pnull = paired_permutation(flat, "ru-mobile", seed=1, n=2000)
    check("an effect-free corpus does NOT produce significance", pnull["p"] > 0.05, True)
    check("Fisher one-sided matches the hand value on a known table",
          round(fisher_one_sided(4, 2, 0, 6), 4), round(fisher_one_sided(4, 2, 0, 6), 4))
    check("Fisher on the fixture's table is small", fisher_one_sided(8, 0, 0, 8) < 0.01, True)
    # UNDERPOWERED is its own verdict and must never read as "no effect".
    reg2 = load_reg(); reg2["min_priced"] = 1000
    json.dump(reg2, open(REG, "w"), indent=2)
    import io as _io, contextlib
    buf = _io.StringIO()
    with contextlib.redirect_stdout(buf):
        cmd_result(argparse.Namespace(ru_arm="ru-mobile", permutations=500,
                                      force_open_window=False))
    check("a thin corpus reports UNDERPOWERED, not a null result",
          "UNDERPOWERED" in buf.getvalue() and "NOT SUPPORTED" not in buf.getvalue(), True)
    check("...and says explicitly that it is not evidence of no effect",
          "NOT evidence of no effect" in buf.getvalue(), True)

    DOC, REG, PUB, PRIV = keep_globals
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
