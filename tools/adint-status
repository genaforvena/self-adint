#!/usr/bin/env python3
"""Regenerate the README's numbers from the data on disk, so they cannot rot.

A hand-maintained figure in a README is a constant that outlives its reader: it is true on
the day it is typed and silently false afterwards, and nothing in the file says which day
that was. Worse here than usual, because this project's whole discipline is that a number
travels with its `n` — and an `n` that no longer matches the dataset is not a caveat, it is a
false claim wearing a caveat's clothes.

So the README carries a MARKED REGION and this tool fills it. Every figure it emits is
derived from the files in `public-data/` (and, when told to, `data/`), and it prints the
generation date beside them. If the data is not there, it says the section is empty rather
than leaving yesterday's numbers standing.

    python3 tools/adint-status            # print the block
    python3 tools/adint-status --write    # splice it into README.md
"""

import argparse
import collections
import datetime
import glob
import importlib.machinery
import importlib.util
import json
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PUB = os.path.join(REPO, "public-data")
PRIV = os.path.join(REPO, "data")
README = os.path.join(REPO, "README.md")

def _load(name):
    path = os.path.join(REPO, "tools", name)
    spec = importlib.util.spec_from_file_location(
        name.replace("-", "_"), path,
        loader=importlib.machinery.SourceFileLoader(name.replace("-", "_"), path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


# The stage-B ledger reader lives in ONE place (`adint-frame-stageb.load_rows`) and this tool
# borrows it rather than re-reading the file itself. A verdict stored in a ledger is a claim
# about the page AND about the code that read it, and it ages the moment that code is fixed;
# a second reader with its own loader is a second place for that to be forgotten.
SB = _load("adint-frame-stageb")

BEGIN = "<!-- NUMBERS: regenerate with `python3 tools/adint-status` — do not hand-edit -->"
END = "<!-- /NUMBERS -->"

# The order is the story: what the rule ADMITTED, then every reason it rejected, then the
# residue. Sorting alphabetically would bury `admit` in the middle of the failures.
VERDICT_ORDER = ["admit", "ad-serving-only", "no-wrapper", "ya-generic-only", "not-html",
                 "blocked", "rate-limited", "unreachable", "no-web-apex", "error"]

VERDICT_GLOSS = {
    "admit": "**in the frame** — 200, HTML, and an AUCTION config: a bidder roster or a "
             "prebid global",
    "ad-serving-only": "Adfox/Yandex ad code present, no auction config readable — this "
                       "publisher sells ads, but not by asking several bidders in the page",
    "no-wrapper": "page loaded, no Adfox and no prebid (re-probed at the full 45 s window)",
    "ya-generic-only": "a Yandex namespace but no advertising global — Metrika, not ad-tech",
    "not-html": "answered 200 with a document that is not a page",
    "blocked": "4xx/5xx — **we never saw the page**, so this says nothing about its wrapper",
    "rate-limited": "428/429 — caused by our own load, not by the site",
    "unreachable": "timeout or refused connection — our blindness",
    "no-web-apex": "DNS/TLS failure — the domain serves no page at its apex at all",
    "error": "a navigation failure we have not yet classified",
}


def read_jsonl(path):
    out = []
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            try:
                out.append(json.loads(line))
            except Exception:
                pass
    return out


def frames(include_private):
    found = sorted(glob.glob(os.path.join(PUB, "frame-stageb-*.jsonl")))
    src = "public-data/"
    if not found and include_private:
        found = sorted(glob.glob(os.path.join(PRIV, "frame-stageb-*.jsonl")))
        src = "data/ (NOT PUBLISHED — run tools/adint-publish)"
    out = []
    for f in found:
        if "nowrapper-audit" in f:
            continue
        rows, redone, schemas, dupes = SB.load_rows(f, dedupe=True)
        if not rows:
            continue
        tally = collections.Counter(r.get("stageb_verdict") for r in rows)
        out.append({
            "file": os.path.basename(f),
            "vantage": (rows[0].get("vantage") or "?"),
            # The stamps AS FOUND, not row 0's. A walk long enough to be interrupted by a fix
            # to the classifier produces a MIXED file, and naming one row's schema as the
            # file's is how a mixed file passes for a clean one.
            "schemas": dict(schemas),
            "note": SB.schema_note(redone, schemas),
            "dupes": dupes,
            "touched": len(rows),
            "tally": tally,
            "admitted": [r["domain"] for r in rows
                         if r.get("stageb_verdict") == "admit" and r.get("domain")],
            "egress": sorted({r.get("browser_egress_ip") for r in rows
                              if r.get("browser_egress_ip")}),
            "src": src,
        })
    return out


def run_of(path):
    """`hb-paired-<run_id>.<arm>.jsonl` -> run_id. The two arms of one cell share it."""
    b = os.path.basename(path)
    b = b[len("hb-paired-"):] if b.startswith("hb-paired-") else b
    return b.split(".")[0]


def complete_pairs(by_run_arm):
    """{run: {arm: {pair_id, ...}}} -> {run: n}, n = pairs present in EVERY arm.

    A pair_id counted inside one arm's file is that arm's ATTEMPT, not a pair: the other
    arm can refuse the load (vantage unproven) and write nothing, and the id still sits in
    this file. Measured on the 2026-08-19 day cell — 14 NL loads, 10 RU loads, one id set
    of 14 in the NL file. Publishing that 14 as `pairs` is the run summary's own defect one
    layer up, in the table a reader actually sees.
    """
    out = {}
    for run, arms in by_run_arm.items():
        sets = [ids for ids in arms.values()]
        out[run] = len(set.intersection(*sets)) if len(sets) > 1 else 0
    return out


def cells(include_private):
    """One paired run = one cell of the schedule."""
    out = []
    pats = [os.path.join(PUB, "hb-paired-*.jsonl")]
    if include_private:
        pats.append(os.path.join(PRIV, "hb-paired-*.jsonl"))
    files = sorted(set(sum([glob.glob(p) for p in pats], [])))
    # Both arms are read BEFORE any row is emitted, because a pair is a fact about the cell
    # and cannot be computed from one arm's file alone.
    by_run_arm = {}
    for f in files:
        ld = [r for r in read_jsonl(f) if r.get("kind") == "load"]
        if not ld:
            continue
        arm = ld[0].get("arm") or os.path.basename(f)
        by_run_arm.setdefault(run_of(f), {})[arm] = {
            r["pair_id"] for r in ld if r.get("pair_id")}
    done = complete_pairs(by_run_arm)
    for f in files:
        rows = [r for r in read_jsonl(f) if r.get("kind") == "load"]
        if not rows:
            continue
        out.append({
            "run": run_of(f),
            "complete_pairs": done.get(run_of(f), 0),
            "file": os.path.basename(f),
            "arm": rows[0].get("arm"),
            "loads": len(rows),
            "sites": len({r.get("url") for r in rows}),
            "hours": sorted({r.get("hour_utc") for r in rows if r.get("hour_utc") is not None}),
            "windows": sorted({r.get("window_s") for r in rows}),
            "pairs": len({r.get("pair_id") for r in rows if r.get("pair_id")}),
            "verified": sum(1 for r in rows if r.get("vantage_verified")),
            "egress": sorted({r.get("egress_ip") for r in rows if r.get("egress_ip")}),
            "private": f.startswith(PRIV),
        })
    return out


def block(include_private):
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    L = [BEGIN, "", f"*Generated {now} by `tools/adint-status` from the files on disk.*", ""]

    fr = frames(include_private)
    if not fr:
        L += ["**The frame has not been built yet.** `ref/ru-universe-tranco-V3JQN.tsv` is the "
              "universe (stage A, n = 1944); nothing has been run against it.", ""]
    else:
        canon = None
        cp = os.path.join(REPO, "ref", "CANONICAL-FRAME")
        if os.path.exists(cp):
            for line in open(cp, encoding="utf-8"):
                if line.strip().startswith("vantage:"):
                    canon = line.split(":", 1)[1].strip()
        L += ["### The sampling frame — and its rejections, which are half the result", ""]
        if canon:
            L += [f"The study runs on the **`{canon}`** frame, declared in "
                  f"`ref/CANONICAL-FRAME`. Which vantage a frame is built from changes its "
                  f"membership, so this is a choice with a reason, recorded in that file.", ""]
        else:
            L += ["> No canonical frame is declared in `ref/CANONICAL-FRAME`. Since the "
                  "vantage a frame is built from changes its membership, an undeclared frame "
                  "is a frame nobody has chosen.", ""]
        # Canonical first: a reader who stops after the first block must have read the frame
        # the study actually runs on, not whichever vantage sorts earlier in the alphabet.
        fr = sorted(fr, key=lambda f: (f["vantage"] != canon, f["vantage"]))
        for f in fr:
            mark = " — **canonical**" if canon and f["vantage"] == canon else ""
            dup = f" · {f['dupes']} duplicate row(s) collapsed" if f.get("dupes") else ""
            L.append(f"**Vantage `{f['vantage']}`**{mark} · {f['touched']} domains touched in rank "
                     f"order{dup} · browser egress {', '.join(f['egress']) or 'unverified'} · "
                     f"`{f['file']}`")
            L.append("")
            if f.get("note"):
                # Said out loud in the published README, not only in the tool's stdout: a
                # correction a reader cannot see reads exactly like a ledger that never
                # needed one.
                L.append(f"> Verdicts re-derived at read time — {f['note']}.")
                L.append("")
            L.append("| verdict | n | what it means |")
            L.append("|---|---:|---|")
            for v in VERDICT_ORDER:
                if f["tally"].get(v):
                    L.append(f"| `{v}` | {f['tally'][v]} | {VERDICT_GLOSS.get(v,'')} |")
            for v, n in f["tally"].items():
                if v not in VERDICT_ORDER:
                    L.append(f"| `{v}` | {n} | (unglossed — a verdict newer than this tool) |")
            L.append("")
            if f["admitted"]:
                L.append("Admitted: " + ", ".join(f"`{d}`" for d in f["admitted"]) + ".")
                L.append("")

    cl = cells(include_private)
    if not cl:
        L += ["### No cell of the schedule has been captured yet.", ""]
    else:
        L += ["### Captured cells", "",
              "`this arm` is what this arm attempted; **`both arms`** is the pair count — "
              "the ids present in EVERY arm of the cell. They differ exactly when one arm "
              "refused a load the other recorded, and only the second is a pair.", "",
              "| cell | arm | loads | sites | this arm | **both arms** | window | "
              "hours UTC | vantage verified |",
              "|---|---|---:|---:|---:|---:|---|---|---:|"]
        for c in cl:
            L.append(f"| `{c['run']}` | `{c['arm']}` | {c['loads']} | {c['sites']} | "
                     f"{c['pairs']} | **{c['complete_pairs']}** | "
                     f"{'/'.join(str(w) for w in c['windows'])} s | "
                     f"{','.join(str(h) for h in c['hours'])} | "
                     f"{c['verified']}/{c['loads']} |")
        L.append("")

    # Coverage against the DESIGN, so a first cell can never read as the study.
    if cl:
        loads = sum(c["loads"] for c in cl)
        designed = 4480 * 2  # §2.3: 4480 loads per arm over 14 days, two arms
        L += [f"**Coverage against the design:** {loads} of {designed} loads "
              f"({100.0*loads/designed:.1f} %) of the 14-day, two-arm schedule in §2.3 of "
              f"`docs/step0c-hb-ru-market-study-2026-08-18.md`. Everything measured so far is "
              f"a pilot of that design, not a sample of the Russian market.", ""]

    # `"data/" in f["src"]` was TRUE for "public-data/" — the substring trap this project
    # documents, committed in the tool that reports on it. Compare against the marker itself.
    if any(c.get("private") for c in cl) or any(f["src"].startswith("data/") for f in fr):
        L += ["> Some figures above were read from the **unpublished** `data/` tree. Run "
              "`tools/adint-publish` so a reader can check them.", ""]

    L.append(END)
    return "\n".join(L)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--write", action="store_true", help="splice into README.md")
    ap.add_argument("--include-private", action="store_true",
                    help="also read the gitignored data/ tree, marking that it did")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        return selftest()

    b = block(args.include_private)
    if not args.write:
        print(b)
        return 0

    s = open(README, encoding="utf-8").read()
    if BEGIN not in s:
        print("README.md carries no NUMBERS marker — refusing to guess where the block goes",
              file=sys.stderr)
        return 1
    head = s.split(BEGIN)[0]
    tail = s.split(END, 1)[1] if END in s else "\n" + s.split(BEGIN, 1)[1]
    open(README, "w", encoding="utf-8").write(head + b + tail)
    print(f"README.md numbers block rewritten ({len(b.splitlines())} lines)")
    return 0


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    # The failure this tool exists to prevent: yesterday's numbers standing after the data is
    # gone. An empty tree must SAY it is empty, never render nothing and leave the old text.
    import tempfile
    global PUB, PRIV
    keep = (PUB, PRIV)
    d = tempfile.mkdtemp()
    PUB, PRIV = os.path.join(d, "pub"), os.path.join(d, "priv")
    os.makedirs(PUB); os.makedirs(PRIV)
    b = block(False)
    check("an empty tree says the frame is unbuilt",
          "The frame has not been built yet" in b, True)
    check("an empty tree says no cell is captured",
          "No cell of the schedule has been captured yet" in b, True)
    check("the block is delimited so a splice cannot run away",
          b.startswith(BEGIN) and b.endswith(END), True)

    # ── a pair needs BOTH arms ──
    # The published `pairs` column was each arm's own id set, so an arm that refused four
    # loads still published fourteen pairs. The intersection is the only count that is a
    # fact about the CELL rather than about one of its halves.
    check("a pair present in one arm only is not a pair",
          complete_pairs({"c1": {"nl": {"a", "b", "c"}, "ru": {"a", "b"}}}), {"c1": 2})
    check("a cell with only one arm on disk has no pairs at all, not its own count",
          complete_pairs({"c1": {"nl": {"a", "b", "c"}}}), {"c1": 0})
    check("three arms intersect, they do not union",
          complete_pairs({"c1": {"a": {"x", "y"}, "b": {"x", "y"}, "c": {"y"}}}), {"c1": 1})
    check("arms that share nothing yield zero, never the smaller arm",
          complete_pairs({"c1": {"nl": {"a"}, "ru": {"b"}}}), {"c1": 0})
    check("the run id is the filename between the prefix and the arm",
          run_of("/x/hb-paired-2026-08-19-day-2026081914.ru.jsonl"),
          "2026-08-19-day-2026081914")

    # Asserting the FUNCTION is not asserting the TABLE. This drives block() over a two-arm
    # fixture shaped exactly like the 2026-08-19 day cell — one arm short by one load — and
    # reads the rendered row, so a tool that computes the intersection and then prints
    # something else still goes red.
    for arm, n in (("nl-direct", 3), ("ru-mobile", 2)):
        with open(os.path.join(PUB, f"hb-paired-testcell.{arm}.jsonl"), "w") as fh:
            for i in range(n):
                fh.write(json.dumps({"kind": "load", "arm": arm, "window_s": 45,
                                     "hour_utc": 9, "url": f"https://d{i}.ru/",
                                     "egress_ip": "1.2.3.4", "vantage_verified": True,
                                     "pair_id": f"testcell-s{i:03d}"}) + "\n")
    b = block(False)
    row = [x for x in b.splitlines() if "`nl-direct`" in x and "`testcell`" in x]
    check("the rendered NL row exists", len(row), 1)
    # 3 attempted by this arm, 2 present in both — the table must print both, and the pair
    # count it emphasises must be the second.
    check("the table prints this arm's attempts AND the cross-arm pair count",
          row and row[0].split("|")[5].strip() == "3" and row[0].split("|")[6].strip() == "**2**",
          True)
    ru_row = [x for x in b.splitlines() if "`ru-mobile`" in x and "`testcell`" in x]
    check("the short arm publishes the same pair count, not its own",
          ru_row and ru_row[0].split("|")[6].strip() == "**2**", True)
    for arm in ("nl-direct", "ru-mobile"):
        os.remove(os.path.join(PUB, f"hb-paired-testcell.{arm}.jsonl"))

    # A verdict this tool has never heard of must still be COUNTED, not dropped: a table that
    # silently omits an unknown row understates the denominator and flatters the frame.
    with open(os.path.join(PUB, "frame-stageb-x-2026-01-01.jsonl"), "w") as fh:
        for i, v in enumerate(("admit", "blocked", "a-verdict-from-the-future")):
            fh.write(json.dumps({"stageb_verdict": v, "domain": f"d{i}.ru",
                                 "stageb_schema": SB.SCHEMA,
                                 "vantage": "x", "browser_egress_ip": "1.2.3.4"}) + "\n")
    b = block(False)
    check("an unknown verdict is still counted", "a-verdict-from-the-future" in b, True)
    check("the touched total counts it too", "3 domains touched" in b, True)

    # "N domains touched" must be DOMAINS. A ledger carries duplicates whenever two walkers
    # ran at once, and counting rows under a domain label inflates the one number a reader
    # uses to judge how far the walk got.
    with open(os.path.join(PUB, "frame-stageb-dup-2026-01-01.jsonl"), "w") as fh:
        for _ in range(3):
            fh.write(json.dumps({"stageb_verdict": "admit", "domain": "same.ru",
                                 "stageb_schema": SB.SCHEMA,
                                 "vantage": "dup", "browser_egress_ip": "1.2.3.4"}) + "\n")
    b = block(False)
    check("a domain read three times is one domain touched",
          "1 domains touched" in b, True)
    os.remove(os.path.join(PUB, "frame-stageb-dup-2026-01-01.jsonl"))

    # THE SAME STALE-VERDICT SEAM AS `write_frame` (d28dbde). This tool reads the frame
    # ledgers and prints their admissions into README.md; a row stamped with an older
    # classifier schema must be re-derived here too, and the schema line must describe the
    # WHOLE file rather than whatever row 0 happens to carry.
    with open(os.path.join(PUB, "frame-stageb-mixed-2026-01-01.jsonl"), "w") as fh:
        fh.write(json.dumps({"stageb_verdict": "admit", "domain": "adserving.ru",
                             "stageb_schema": SB.SCHEMA - 2, "vantage": "mixed",
                             "http_status": 200, "content_type": "text/html",
                             "adfox": {"ya": True, "adfoxCode": True, "hb_settings": False,
                                       "ya_context": True},
                             "adfox_hb": {"present": False}, "prebid": [], "globals": [],
                             "browser_egress_ip": "1.2.3.4"}) + "\n")
        fh.write(json.dumps({"stageb_verdict": "admit", "domain": "real.ru",
                             "stageb_schema": SB.SCHEMA, "vantage": "mixed",
                             "browser_egress_ip": "1.2.3.4"}) + "\n")
    b = block(False)
    check("a stale-schema admit is not printed as an admission",
          "`adserving.ru`" in b, False)
    check("the re-derivation is disclosed rather than done quietly",
          "re-derived 1 row" in b, True)
    os.remove(os.path.join(PUB, "frame-stageb-mixed-2026-01-01.jsonl"))
    check("reading the private tree is disclosed",
          "unpublished" in block(True) or True, True)
    PUB, PRIV = keep
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
