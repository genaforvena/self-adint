#!/usr/bin/env python3
"""Count the wire captures: who was asked, who answered, who stayed silent.

Reads data/hb-auction.jsonl (written by adint-hb-capture) and counts it. Nothing here
measures; the capture already did that. What this refuses to do is most of its content:

  * It never pools schemas. A row written under an older schema meant something else.
  * It never folds `no-answer` into `no-bid`. A bidder that was asked and said nothing is not
    a bidder that declined; folding them makes selectivity a measurement of our own latency.
  * It counts SITES, not rows. One publisher visited four times is one publisher, and a
    bidder asked on eighteen slots of one page is one site's worth of evidence.
  * It never reports a load that ran a wrapper but produced no candidate request as "no
    demand". That is a coverage GAP — we did not observe the auction — and it is printed as
    one, because those two readings point in opposite directions.
  * It says what the arms actually were. `arm: A` / `arm: B` with an A/A note is a noise
    floor, not an experiment, and the report says so rather than letting the column imply it.

Rows inside one page load are NOT independent — the wrapper fires them together off one
config — so every count that could mislead is reported alongside its load count.
"""

import argparse
import collections
import json
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
LOG = os.path.join(REPO, "data", "hb-auction.jsonl")
ALIASES = os.path.join(REPO, "ref", "org-aliases.tsv")

# Outcomes that are statements about a BIDDER, in the order they are reported. `no-answer`
# leads the silent half deliberately: it is the one most likely to be quietly absorbed.
BIDDER_OUTCOMES = ("priced", "bid-returned", "no-bid", "no-answer", "error")


def _norm(name):
    return "".join(ch for ch in str(name).lower() if ch.isalnum())


def load_aliases(path=ALIASES):
    """One vocabulary. The roster calls a bidder `mytarget`; ref/exchange-domains.tsv calls the
    same company `MyTarget/VK`; both land on ad.mail.ru. Counted raw they are two bidders with
    half the evidence each — the same split that cost a roster count earlier, one layer up."""
    out = {}
    try:
        with open(path) as fh:
            for line in fh:
                if line.startswith("#") or not line.strip():
                    continue
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 2 and parts[0] and parts[1]:
                    out[_norm(parts[0])] = parts[1]
                    out[_norm(parts[1])] = parts[1]
    except FileNotFoundError:
        pass
    return out


def learn_host_bidders(rows, aliases):
    """host -> bidder, learned ONLY from placement-id attributions.

    A placement id comes from the publisher's own config and names one bidder exactly, so a
    host seen under it is evidence. A host learned this way can then name the SAME host on a
    load where the roster was never read — which is most of them: 261 of ~770 candidate rows in
    the schema-4 corpus had no attribution while their host was named by placement id
    elsewhere. What is refused: learning from weaker attributions (a roster name in a URL is a
    substring, not a fact), and learning from a host that has ever named two different bidders.
    """
    seen = collections.defaultdict(collections.Counter)
    for r in rows:
        if r.get("match_by") == "placement-id" and r.get("bidder") and r.get("host"):
            seen[r["host"]][aliases.get(_norm(r["bidder"]), r["bidder"])] += 1
    learned, ambiguous = {}, {}
    for host, names in seen.items():
        if len(names) == 1:
            name, n = next(iter(names.items()))
            learned[host] = (name, n)
        else:
            ambiguous[host] = dict(names)
    return learned, ambiguous


def load(path, schema=None):
    rows, bad = [], 0
    with open(path) as fh:
        for line in fh:
            line = line.strip()
            if not line:
                continue
            try:
                rows.append(json.loads(line))
            except Exception:
                bad += 1
    for r in rows:
        r.setdefault("schema", 1)
    present = sorted({r["schema"] for r in rows})
    if schema is None:
        schema = present[-1] if present else 1
    kept = [r for r in rows if r["schema"] == schema]
    return kept, rows, schema, present, bad


def report(kept, all_rows, schema, present, bad, out=sys.stdout):
    p = lambda s="": print(s, file=out)
    loads = [r for r in kept if r.get("kind") == "load"]
    reqs = [r for r in kept if r.get("kind") == "request"]
    # ASKED means we saw a bid request or a bid response — protocol evidence. A bidder's host
    # being contacted is not the same claim: its cookie-sync pixel fires on pages where it is
    # never asked to bid, and counting those as asked inflates reach and manufactures no-bids.
    # A row with no `evidence_strength` predates that distinction; it is counted as `unstated`
    # and said out loud rather than quietly folded into either side.
    cands = [r for r in reqs if r.get("evidence_strength") == "protocol"]
    attrib_only = [r for r in reqs if r.get("evidence_strength") == "attribution-only"]
    unstated = [r for r in reqs if r.get("is_bid_candidate") and not r.get("evidence_strength")]
    by_load = {l["load_id"]: l for l in loads}

    aliases = load_aliases()
    learned, ambiguous_hosts = learn_host_bidders(cands, aliases)
    learned_applied = 0
    for r in cands:
        if r.get("bidder"):
            r["bidder_canon"] = aliases.get(_norm(r["bidder"]), r["bidder"])
            r["attribution"] = r.get("match_by")
        elif r.get("host") in learned:
            name, n = learned[r["host"]]
            r["bidder_canon"] = name
            r["attribution"] = f"learned-host(n={n})"
            learned_applied += 1
        else:
            r["bidder_canon"] = None
            r["attribution"] = r.get("match_by")

    p(f"== hb capture read-out — schema {schema} ==")
    p(f"rows {len(all_rows)} · counted {len(kept)} · set aside "
      f"{len(all_rows) - len(kept)} (other schemas {[s for s in present if s != schema]}) · "
      f"unparseable {bad}")

    # The vantage and the arms, before any count that could be read as an experiment.
    ips = collections.Counter(l.get("egress_ip") for l in loads)
    notes = {l.get("arm_note") for l in loads if l.get("arm_note")}
    arms = collections.Counter(l.get("arm") for l in loads)
    p("")
    p("-- vantage and assignment --")
    for ip, n in ips.most_common():
        p(f"   egress {ip or 'unknown'}  loads={n}")
    p(f"   arms: {dict(sorted(arms.items()))}")
    if notes:
        for n in sorted(notes):
            p(f"   arm note: {n}")
        if any("A/A" in n or "identical" in n.lower() for n in notes):
            p("   -> these arms are a NOISE FLOOR, not an experiment. Any difference between "
              "them is the corpus disagreeing with itself.")
    elif len(arms) > 1:
        p("   !! more than one arm and NO note on the load rows — the treatment is unstated, "
          "so these labels cannot be read as conditions")

    # Coverage first: what fraction of loads could say anything at all.
    rendered = [l for l in loads if (l.get("http_status") or 0) < 400 and not l.get("error")]
    with_wrapper = [l for l in rendered if l.get("wrapper_timeout_ms") is not None
                    or (l.get("roster") or [])]
    cand_loads = {r["load_id"] for r in cands}
    silent_wrapper = [l for l in with_wrapper if l["load_id"] not in cand_loads]
    p("")
    p("-- coverage --")
    p(f"   loads {len(loads)} · rendered {len(rendered)} · carrying a wrapper "
      f"{len(with_wrapper)} · with at least one candidate request {len(cand_loads)}")
    p(f"   loads that ran a wrapper and produced NO candidate request: {len(silent_wrapper)}")
    p("   that is a coverage gap — the auction was not observed on those loads — and it is "
      "NOT a reading of no demand.")
    for l in silent_wrapper[:10]:
        p(f"      {l['url']} (load {l['load_id']}, roster {len(l.get('roster') or [])}, "
          f"wrapper_timeout {l.get('wrapper_timeout_ms')})")
    if len(silent_wrapper) > 10:
        p(f"      … and {len(silent_wrapper) - 10} more")
    sync_bidders = collections.Counter(r.get("bidder") for r in attrib_only if r.get("bidder"))
    p(f"   named-but-not-asked rows (host contacted, no bid protocol seen): {len(attrib_only)}"
      + (f" — {dict(sync_bidders.most_common(6))}" if sync_bidders else ""))
    p("   those are contacts, mostly cookie syncs; they are NOT counted as asked anywhere below")
    if unstated:
        p(f"   !! {len(unstated)} candidate row(s) carry no evidence_strength (written before "
          f"the distinction existed) — they are counted NOWHERE; re-capture to include them")

    # Per bidder. Sites, not rows: the unit of evidence is a publisher.
    p("")
    p("-- per bidder (sites, then requests; outcomes never folded) --")
    sites_by_bidder = collections.defaultdict(set)
    out_by_bidder = collections.defaultdict(collections.Counter)
    unattributed = collections.Counter()
    for r in cands:
        site = (by_load.get(r["load_id"]) or {}).get("url", "?")
        b = r.get("bidder_canon")
        if not b:
            unattributed[r.get("match_by") or "none"] += 1
            continue
        sites_by_bidder[b].add(site)
        out_by_bidder[b][r.get("outcome")] += 1
    if not sites_by_bidder:
        p("   no attributed bidder request in this corpus")
    for b in sorted(sites_by_bidder, key=lambda x: (-len(sites_by_bidder[x]), x)):
        counts = out_by_bidder[b]
        cells = " ".join(f"{o}={counts.get(o, 0)}" for o in BIDDER_OUTCOMES
                         if counts.get(o))
        other = {k: v for k, v in counts.items() if k not in BIDDER_OUTCOMES}
        p(f"   {b:22} sites={len(sites_by_bidder[b]):3} requests={sum(counts.values()):3}  "
          f"{cells}" + (f"  other={other}" if other else ""))
    p(f"   attribution: {len(cands) - learned_applied - sum(unattributed.values())} direct, "
      f"{learned_applied} by host learned from placement ids ({len(learned)} host(s) learned), "
      f"{sum(unattributed.values())} unattributed")
    if ambiguous_hosts:
        p(f"   hosts refused for learning (more than one bidder seen under a placement id): "
          f"{ambiguous_hosts}")
    if unattributed:
        p(f"   unattributed candidate requests: {sum(unattributed.values())} "
          f"({dict(unattributed)}) — recorded, never assigned to a bidder")

    # Latency against the wrapper's own deadline. Our observation window is seconds wide and
    # the wrapper's deadline is often under one second, so an answer we recorded may have
    # arrived far too late for the auction to use it. Counting such an answer as participation
    # would overstate a slow bidder's presence and understate the fast ones' advantage — and
    # the row carries everything needed to tell them apart, so there is no excuse to fold.
    p("")
    p("-- answers against the wrapper's deadline --")
    lat = collections.defaultdict(lambda: {"answered": 0, "late": 0, "ms": []})
    no_deadline = 0
    for r in cands:
        if r.get("t_request_s") is None or r.get("t_response_s") is None:
            continue
        if r.get("outcome") not in ("priced", "bid-returned", "no-bid"):
            continue
        wt = r.get("wrapper_timeout_ms")
        ms = (r["t_response_s"] - r["t_request_s"]) * 1000.0
        e = lat[r.get("bidder") or "(unattributed)"]
        e["answered"] += 1
        e["ms"].append(ms)
        if wt is None:
            no_deadline += 1
        elif ms > wt:
            e["late"] += 1
    if not lat:
        p("   no timed answer in this corpus")
    for b, e in sorted(lat.items(), key=lambda kv: -kv[1]["answered"]):
        med = sorted(e["ms"])[len(e["ms"]) // 2]
        p(f"   {b:22} answered={e['answered']:3} after-deadline={e['late']:3} "
          f"median={med:.0f}ms")
    if no_deadline:
        p(f"   {no_deadline} answer(s) on loads with NO wrapper deadline read — lateness is "
          f"undecidable there, and is left uncounted rather than assumed on time")
    p("   an answer after the deadline is not a bid the auction could use; it is kept as an "
      "answer and counted separately, never silently as participation")

    # The arms, compared — and first, whether the comparison can mean anything at all.
    p("")
    p("-- arms compared --")
    arm_out = collections.defaultdict(collections.Counter)
    for r in cands:
        arm_out[(by_load.get(r["load_id"]) or {}).get("arm")][r.get("outcome")] += 1
    for a in sorted(arm_out):
        c = arm_out[a]
        p(f"   {a:8} n={sum(c.values()):4}  {dict(sorted(c.items()))}")

    # A site that only ever ran arm X in pass N has arm and pass welded together: any
    # difference between the arms is also a difference between two moments in time, and the
    # hour is the dominant confounder on this market. Detected from the data rather than
    # trusted from the design, because the design is what produced the weld.
    pairs = collections.defaultdict(set)
    for l in loads:
        if l.get("arm") is not None and l.get("run_idx") is not None:
            pairs[l["url"]].add((l["arm"], l["run_idx"]))
    welded = []
    for url, ps in pairs.items():
        arms_here = {a for a, _ in ps}
        runs_here = {r for _, r in ps}
        if len(arms_here) > 1 and len(runs_here) > 1:
            # arm is confounded with run when each arm appears in exactly one run
            if all(len({r for a2, r in ps if a2 == a}) == 1 for a in arms_here) and \
               len({r for _, r in ps}) == len(arms_here):
                welded.append(url)
    if welded:
        p(f"   !! arm is CONFOUNDED WITH PASS on {len(welded)} of {len(pairs)} site(s): each arm "
          f"ran in exactly one pass, so an arm difference is also a time difference")
        p("   the counts above cannot separate the treatment from the pass; balance needs each "
          "arm in BOTH passes (e.g. offsets 0,1,1,0 over four passes)")
    else:
        p("   each arm appears in more than one pass — arm and pass are not welded")

    # Per site, with the load count beside it, because rows inside a load are not independent.
    p("")
    p("-- per site --")
    per_site = collections.defaultdict(lambda: {"loads": set(), "cands": 0,
                                                "outcomes": collections.Counter(),
                                                "bidders": set(), "timeout": None})
    for l in loads:
        s = per_site[l["url"]]
        s["loads"].add(l["load_id"])
        if l.get("wrapper_timeout_ms") is not None:
            s["timeout"] = l["wrapper_timeout_ms"]
    for r in cands:
        s = per_site[(by_load.get(r["load_id"]) or {}).get("url", "?")]
        s["cands"] += 1
        s["outcomes"][r.get("outcome")] += 1
        if r.get("bidder"):
            s["bidders"].add(r["bidder"])
    for url in sorted(per_site, key=lambda u: (-per_site[u]["cands"], u)):
        s = per_site[url]
        if not s["cands"]:
            continue
        p(f"   {url}")
        p(f"      loads={len(s['loads'])} wrapper_timeout={s['timeout']} "
          f"candidates={s['cands']} bidders={sorted(s['bidders'])}")
        p(f"      outcomes={dict(sorted(s['outcomes'].items()))}")

    # bidder x placement: the finest stratum the wire exposes on this market, since a
    # placement is the adUnit the bidder was asked about.
    p("")
    p("-- strata: bidder x placement x site (top 20 by requests) --")
    strata = collections.Counter()
    for r in cands:
        if not r.get("bidder"):
            continue
        site = (by_load.get(r["load_id"]) or {}).get("url", "?")
        for pid in ((r.get("req_adfox") or {}).get("placement_ids") or ["?"]):
            strata[(r["bidder"], pid, site)] += 1
    for (b, pid, site), n in strata.most_common(20):
        p(f"   {b:20} {pid:26} {site:32} n={n}")
    if not strata:
        p("   none")

    # Repeats: the design's requirement that a verdict not rest on one visit.
    p("")
    p("-- repeats --")
    visits = collections.Counter(l["url"] for l in loads)
    repeated = {u: n for u, n in visits.items() if n > 1}
    p(f"   sites visited more than once: {len(repeated)} of {len(visits)}")
    if not repeated:
        p("   NO site was visited twice — this corpus cannot support a stability claim, and "
          "a single visit is a sample, not a site property")
    else:
        disagree = []
        for u in repeated:
            sigs = set()
            for l in loads:
                if l["url"] != u:
                    continue
                # An unattributed row has bidder None, and None does not order against a
                # string: sorting these raw crashed the whole read-out after the repeats
                # header, so the tail of the report simply did not exist.
                got = tuple(sorted(
                    ((r.get("bidder") or ""), (r.get("outcome") or ""))
                    for r in cands if r["load_id"] == l["load_id"]))
                sigs.add(got)
            if len(sigs) > 1:
                disagree.append(u)
        p(f"   sites whose candidate set/outcome changed between visits: {len(disagree)}")
        for u in sorted(disagree)[:10]:
            p(f"      {u}")
    return {"loads": len(loads), "candidates": len(cands), "rendered": len(rendered),
            "with_wrapper": len(with_wrapper), "silent_wrapper": len(silent_wrapper),
            "bidders": {b: dict(out_by_bidder[b]) for b in out_by_bidder},
            "latency": {b: {"answered": e["answered"], "late": e["late"]}
                        for b, e in lat.items()},
            "no_deadline": no_deadline, "attribution_only": len(attrib_only),
            "arm_outcomes": {a: dict(c) for a, c in arm_out.items()}, "welded": len(welded),
            "learned_applied": learned_applied, "learned_hosts": len(learned),
            "ambiguous_hosts": ambiguous_hosts,
            "unstated": len(unstated),
            "sites_by_bidder": {b: len(v) for b, v in sites_by_bidder.items()},
            "repeated": len(repeated)}


def selftest():
    import io
    import tempfile
    ok = True
    rows = [
        # An older schema whose `no-answer` did not exist: must not be pooled.
        {"schema": 0, "kind": "request", "load_id": "old", "outcome": "no-bid",
         "bidder": "mediasniper", "is_bid_candidate": True},
        {"schema": 1, "kind": "load", "load_id": "L1", "url": "https://a.ru/", "arm": "A",
         "arm_note": "A/A null: identical treatment", "egress_ip": "1.2.3.4",
         "http_status": 200, "wrapper_timeout_ms": 3000, "roster": ["mediasniper", "astralab"]},
        # Answers at 400ms against a 3000ms deadline: in time.
        {"schema": 1, "kind": "request", "load_id": "L1", "bidder": "mediasniper",
         "outcome": "no-bid", "is_bid_candidate": True, "evidence_strength": "protocol", "wrapper_timeout_ms": 3000,
         "t_request_s": 8.0, "t_response_s": 8.4,
         "req_adfox": {"placement_ids": ["41139"], "places": 3}},
        # Answers at 4.5s against the same deadline: the auction was over. Still an answer.
        {"schema": 1, "kind": "request", "load_id": "L1", "bidder": "buzzoola",
         "outcome": "priced", "is_bid_candidate": True, "evidence_strength": "protocol", "wrapper_timeout_ms": 3000,
         "t_request_s": 8.0, "t_response_s": 12.5,
         "req_adfox": {"placement_ids": ["777"], "places": 3}},
        {"schema": 1, "kind": "request", "load_id": "L1", "bidder": "astralab",
         "outcome": "no-answer", "is_bid_candidate": True, "evidence_strength": "protocol",
         "req_adfox": {"placement_ids": ["69eb"], "places": 3}},
        # Same publisher, second visit: mediasniper answers again, astralab is absent.
        {"schema": 1, "kind": "load", "load_id": "L2", "url": "https://a.ru/", "arm": "B",
         "arm_note": "A/A null: identical treatment", "egress_ip": "1.2.3.4",
         "http_status": 200, "wrapper_timeout_ms": 3000, "roster": ["mediasniper", "astralab"]},
        # Attribution evidence: ad.mail.ru named by placement id on one load...
        {"schema": 1, "kind": "request", "load_id": "L1", "bidder": "mytarget",
         "host": "ad.mail.ru", "match_by": "placement-id", "outcome": "no-bid",
         "is_bid_candidate": True, "evidence_strength": "protocol"},
        # ...the SAME host unattributed on another, which the learned map should name.
        {"schema": 1, "kind": "request", "load_id": "L2", "bidder": None,
         "host": "ad.mail.ru", "match_by": "none", "outcome": "no-bid",
         "is_bid_candidate": True, "evidence_strength": "protocol"},
        # The other vocabulary for the same company, from the host table.
        {"schema": 1, "kind": "request", "load_id": "L2", "bidder": "MyTarget/VK",
         "host": "ad.mail.ru", "match_by": "host-table:mail.ru", "outcome": "no-bid",
         "is_bid_candidate": True, "evidence_strength": "protocol"},
        # A host named only by a URL substring must NOT teach the map.
        {"schema": 1, "kind": "request", "load_id": "L1", "bidder": "buzzoola",
         "host": "weak.example", "match_by": "roster-name-in-url", "outcome": "no-bid",
         "is_bid_candidate": True, "evidence_strength": "protocol"},
        {"schema": 1, "kind": "request", "load_id": "L2", "bidder": None,
         "host": "weak.example", "match_by": "none", "outcome": "no-bid",
         "is_bid_candidate": True, "evidence_strength": "protocol"},
        # A host that placement ids have named TWO ways teaches nothing.
        {"schema": 1, "kind": "request", "load_id": "L1", "bidder": "gnezdo",
         "host": "shared.example", "match_by": "placement-id", "outcome": "no-bid",
         "is_bid_candidate": True, "evidence_strength": "protocol"},
        {"schema": 1, "kind": "request", "load_id": "L2", "bidder": "smi2",
         "host": "shared.example", "match_by": "placement-id", "outcome": "no-bid",
         "is_bid_candidate": True, "evidence_strength": "protocol"},
        # Unattributed (bidder None) on a repeat-visited site: sorting this against a named
        # row is what crashed the read-out.
        {"schema": 1, "kind": "request", "load_id": "L2", "bidder": None,
         "outcome": "no-answer", "is_bid_candidate": True, "evidence_strength": "protocol",
         "match_by": "none"},
        # Timed, but the wrapper's deadline was never read on this load: lateness is
        # undecidable and must not default to "on time".
        {"schema": 1, "kind": "request", "load_id": "L2", "bidder": "mediasniper",
         "outcome": "no-bid", "is_bid_candidate": True, "evidence_strength": "protocol", "wrapper_timeout_ms": None,
         "t_request_s": 8.0, "t_response_s": 9.9,
         "req_adfox": {"placement_ids": ["41139"], "places": 3}},
        # adriver's host was contacted for a cookie sync. Named, never asked to bid.
        {"schema": 1, "kind": "request", "load_id": "L1", "bidder": "adriver",
         "outcome": "redirect", "is_bid_candidate": True,
         "evidence_strength": "attribution-only"},
        # Written before the distinction existed: countable nowhere, and said out loud.
        {"schema": 1, "kind": "request", "load_id": "L2", "bidder": "sape",
         "outcome": "no-bid", "is_bid_candidate": True},
        # A load that ran a wrapper and produced nothing: a coverage gap, not zero demand.
        {"schema": 1, "kind": "load", "load_id": "L3", "url": "https://b.ru/", "arm": "A",
         "arm_note": "A/A null: identical treatment", "egress_ip": "1.2.3.4",
         "http_status": 200, "wrapper_timeout_ms": 1000, "roster": ["mytarget"]},
        # Analytics traffic: present in the log, never counted.
        {"schema": 1, "kind": "request", "load_id": "L3", "bidder": None, "outcome": "no-bid",
         "is_bid_candidate": False},
        # A blocked load says nothing at all.
        {"schema": 1, "kind": "load", "load_id": "L4", "url": "https://c.ru/", "arm": "B",
         "arm_note": "A/A null: identical treatment", "egress_ip": "1.2.3.4",
         "http_status": 403},
    ]
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as fh:
        for r in rows:
            fh.write(json.dumps(r) + "\n")
        path = fh.name
    buf = io.StringIO()
    kept, allr, schema, present, bad = load(path)
    res = report(kept, allr, schema, present, bad, out=buf)
    text = buf.getvalue()
    os.unlink(path)

    checks = [
        ("older schema set aside", res["loads"] == 4 and "set aside 1" in text),
        # The fold the whole design turns on.
        ("no-answer counted apart from no-bid",
         res["bidders"].get("astralab") == {"no-answer": 1}
         and res["bidders"].get("mediasniper") == {"no-bid": 2}),
        # Two visits, one publisher.
        ("bidder reach counted in sites, not requests",
         res["sites_by_bidder"].get("mediasniper") == 1 and "requests=  2" in text),
        ("a wrapper load with no candidate is a coverage gap",
         res["silent_wrapper"] == 1 and "NOT a reading of no demand" in text
         and "https://b.ru/" in text),
        ("analytics traffic never reaches a bidder count",
         "mytarget" not in res["bidders"]),
        # A 403 page did not render, so it carries no wrapper and cannot be a coverage gap —
        # counting it as one would invent an unobserved auction on a site we never saw.
        ("a blocked load is neither rendered nor a gap",
         res["rendered"] == 3 and res["with_wrapper"] == 3 and res["silent_wrapper"] == 1),
        ("A/A arms are named as a noise floor, not an experiment",
         "NOISE FLOOR, not an experiment" in text),
        # One company, two vocabularies, one host — counted raw it is two bidders with half
        # the evidence each.
        ("alias table collapses mytarget and MyTarget/VK into one bidder",
         "MyTarget/VK" in res["sites_by_bidder"] and "mytarget" not in res["sites_by_bidder"]),
        # A host named by a placement id can name the same host where the roster was not read.
        ("an unattributed row is named by a host learned from placement ids",
         res["learned_applied"] == 1 and "by host learned from placement ids" in text),
        # ...but only from that evidence, and only when the host is unambiguous.
        ("a host known only from a URL substring teaches nothing",
         "weak.example" not in str(res.get("ambiguous_hosts")) and res["learned_hosts"] == 1),
        ("a host that named two bidders is refused and reported",
         "shared.example" in res["ambiguous_hosts"] and "refused for learning" in text),
        ("an unattributed row does not crash the repeats section",
         "-- repeats --" in text and "sites visited more than once" in text),
        ("repeat visits are detected and the disagreement is named",
         res["repeated"] == 1 and "changed between visits: 1" in text),
        ("placement stratum is reported",
         "41139" in text and "69eb" in text),
        # An answer the auction could not have used must not read as participation.
        ("a late answer is counted, and counted as late",
         res["latency"].get("buzzoola") == {"answered": 1, "late": 1}
         and res["latency"].get("mediasniper", {}).get("late") == 0),
        ("lateness is undecidable without a deadline and is left uncounted",
         res["no_deadline"] == 1),
        # The inflation this split exists to stop.
        ("a cookie-sync contact is never counted as an asked bidder",
         "adriver" not in res["bidders"] and res["attribution_only"] == 1
         and "NOT counted as asked" in text),
        ("rows predating the distinction are counted nowhere and said so",
         res["unstated"] == 1 and "sape" not in res["bidders"]
         and "counted NOWHERE" in text),
    ]

    # Arm/pass welding: the design that produced it, and the balanced design that does not.
    welded_rows = []
    for run, arm in ((0, "proxy"), (1, "direct")):
        welded_rows.append({"schema": 1, "kind": "load", "load_id": f"W{run}",
                            "url": "https://w.ru/", "arm": arm, "run_idx": run,
                            "http_status": 200, "wrapper_timeout_ms": 1000})
        welded_rows.append({"schema": 1, "kind": "request", "load_id": f"W{run}",
                            "bidder": "sape", "outcome": "no-bid", "is_bid_candidate": True,
                            "evidence_strength": "protocol"})
    balanced_rows = []
    for i, (run, arm) in enumerate(((0, "proxy"), (1, "direct"), (2, "direct"), (3, "proxy"))):
        balanced_rows.append({"schema": 1, "kind": "load", "load_id": f"B{i}",
                              "url": "https://b.ru/", "arm": arm, "run_idx": run,
                              "http_status": 200, "wrapper_timeout_ms": 1000})
        balanced_rows.append({"schema": 1, "kind": "request", "load_id": f"B{i}",
                              "bidder": "sape", "outcome": "no-bid", "is_bid_candidate": True,
                              "evidence_strength": "protocol"})

    def run_on(rs):
        with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as fh:
            for r in rs:
                fh.write(json.dumps(r) + "\n")
            pth = fh.name
        b = io.StringIO()
        kk, aa, ss, pp, bb = load(pth)
        rr = report(kk, aa, ss, pp, bb, out=b)
        os.unlink(pth)
        return rr, b.getvalue()

    res_w, text_w = run_on(welded_rows)
    res_b, text_b = run_on(balanced_rows)
    checks.append(("arm welded to pass is detected and refused",
                   res_w["welded"] == 1 and "CONFOUNDED WITH PASS" in text_w))
    checks.append(("a balanced design is not flagged",
                   res_b["welded"] == 0 and "not welded" in text_b))
    checks.append(("both arms are counted separately",
                   set(res_w["arm_outcomes"]) == {"proxy", "direct"}))

    # A corpus where every site was seen once must say the stability claim is unavailable.
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as fh:
        fh.write(json.dumps({"schema": 1, "kind": "load", "load_id": "S1",
                             "url": "https://d.ru/", "http_status": 200}) + "\n")
        path2 = fh.name
    buf2 = io.StringIO()
    k2, a2, s2, p2, b2 = load(path2)
    report(k2, a2, s2, p2, b2, out=buf2)
    os.unlink(path2)
    checks.append(("single-visit corpus refuses a stability claim",
                   "cannot support a stability claim" in buf2.getvalue()))

    for name, good in checks:
        print(("ok   " if good else "FAIL ") + name)
        ok = ok and good
    print("--test:", "ok" if ok else "FAILED")
    return 0 if ok else 1


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--log", default=LOG)
    ap.add_argument("--schema", type=int)
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        return selftest()
    if not os.path.exists(args.log):
        print(f"n/a: no log at {args.log}", file=sys.stderr)
        return 2
    kept, allr, schema, present, bad = load(args.log, args.schema)
    if not kept:
        print(f"n/a: no rows of schema {schema}", file=sys.stderr)
        return 2
    report(kept, allr, schema, present, bad)
    return 0


if __name__ == "__main__":
    sys.exit(main())
