#!/usr/bin/env python3
"""Compare two stage-B ledgers taken from different vantages, on the domains BOTH touched.

The question this answers is not decorative. A frame is built by a probe, a probe is run
from somewhere, and `blocked` is exactly the verdict most likely to differ between a Russian
and a non-Russian exit address. If it does differ, then a frame built from one vantage
carries that vantage's blindness into BOTH arms of a paired study — the arms would be
comparing sites selected by one of them. So the disagreement rate is a property the study
has to measure rather than assume, in either direction.

It is computed on the INTERSECTION only. A domain one walk has reached and the other has not
is not a disagreement, it is a difference in progress, and pooling those two would make a
slow walk look like a censoring vantage.

Verdicts are RE-DERIVED with the current classifier from the stored probe rows, not read from
the `stageb_verdict` field, so two ledgers written under different schemas can still be
compared — the comparison is between the pages, not between the days the tools were edited.
"""

import argparse
import collections
import importlib.machinery
import importlib.util
import json
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


def _load(name):
    path = os.path.join(REPO, "tools", name)
    spec = importlib.util.spec_from_file_location(
        name.replace("-", "_"), path,
        loader=importlib.machinery.SourceFileLoader(name.replace("-", "_"), path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def read(path):
    """First reading per domain wins — a ledger may carry duplicates from concurrent
    writers, and taking the last would silently prefer whichever walker finished later."""
    d = {}
    for line in open(path, encoding="utf-8"):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        r = json.loads(line)
        d.setdefault(r.get("domain"), r)
    return d


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("a", nargs="?")
    ap.add_argument("b", nargs="?")
    ap.add_argument("--quiet", action="store_true", help="only the summary")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        return selftest()
    if not args.a or not args.b:
        print("usage: adint-frame-compare <ledger-a.jsonl> <ledger-b.jsonl>", file=sys.stderr)
        return 2

    sb = _load("adint-frame-stageb")
    A, B = read(args.a), read(args.b)
    va = next((r.get("vantage") for r in A.values() if r.get("vantage")), "a")
    vb = next((r.get("vantage") for r in B.values() if r.get("vantage")), "b")
    both = sorted(set(A) & set(B), key=lambda d: A[d].get("rank") or 0)

    pairs = collections.Counter()
    diffs = []
    for d in both:
        x, y = sb.classify(A[d])[0], sb.classify(B[d])[0]
        pairs[(x, y)] += 1
        if x != y:
            diffs.append((A[d].get("rank"), d, x, y))
        if not args.quiet:
            mark = "" if x == y else "   <-- DIFFERS"
            print(f"{d:24s} {A[d].get('rank') or 0:6d}  {x:17s} {y:17s}{mark}")

    agree = sum(n for (x, y), n in pairs.items() if x == y)
    n = len(both)
    print(f"\nvantages: {va} vs {vb}")
    print(f"intersection: {n} domain(s)  ·  agree {agree}  ·  differ {n - agree}"
          + (f"  ({100.0*(n-agree)/n:.1f} %)" if n else ""))
    print(f"reached by {va} only: {len(set(A) - set(B))}  ·  by {vb} only: {len(set(B) - set(A))}"
          "   (progress, NOT disagreement)")
    if diffs:
        print("\ndisagreements:")
        for rank, d, x, y in diffs:
            print(f"  #{rank:<6} {d:24s} {va}={x}  {vb}={y}")
    # The verdict most likely to be geo-shaped gets its own line: a null result here is worth
    # as much as a positive one and must not be left implicit in a total.
    bl = [d for d in both
          if "blocked" in (sb.classify(A[d])[0], sb.classify(B[d])[0])]
    bl_diff = [d for d in bl if sb.classify(A[d])[0] != sb.classify(B[d])[0]]
    if bl:
        print(f"\n`blocked` on either side: {len(bl)} domain(s), of which {len(bl_diff)} "
              f"differ between the vantages"
              + ("  — these refusals are not geo-shaped at this depth" if not bl_diff else ""))
    # ── THE FRAME QUESTION, which is what this tool is actually for ──────────────────
    # Disagreement counts do not answer it. What decides whether a frame built from ONE
    # vantage is usable is asymmetric: a domain the OTHER vantage admits and this one does
    # not is a HOLE — a real site missing from the frame — while a domain this vantage has
    # simply not reached yet is PROGRESS. Those two look identical in any total.
    adm_a = {d for d in A if sb.classify(A[d])[0] == "admit"}
    adm_b = {d for d in B if sb.classify(B[d])[0] == "admit"}
    hole_a = sorted((A[d].get("rank") or 0, d, sb.classify(A[d])[0])
                    for d in (adm_b & set(A)) - adm_a)
    hole_b = sorted((B[d].get("rank") or 0, d, sb.classify(B[d])[0])
                    for d in (adm_a & set(B)) - adm_b)
    pend_a = sorted((B[d].get("rank") or 0, d) for d in adm_b - set(A))
    pend_b = sorted((A[d].get("rank") or 0, d) for d in adm_a - set(B))
    print(f"\nFRAME: {va} admits {len(adm_a)} · {vb} admits {len(adm_b)} · "
          f"union {len(adm_a | adm_b)}")
    for who, other, holes in ((va, vb, hole_a), (vb, va, hole_b)):
        if holes:
            print(f"  HOLE in a {who}-built frame — {other} admits these and {who} does not:")
            for rank, d, verdict in holes:
                print(f"    #{rank:<6} {d:24s} {who} says {verdict}")
        else:
            print(f"  no hole in a {who}-built frame: every domain {other} admits and {who} "
                  f"has reached, {who} admits too")
    for who, other, pend in ((va, vb, pend_a), (vb, va, pend_b)):
        if pend:
            print(f"  PENDING for {who} (reached by {other} only — progress, NOT a hole): "
                  + ", ".join(f"{d} #{r}" for r, d in pend))

    if n:
        print("\nCOVERAGE: this is a statement about the intersection above and nothing else. "
              f"Ranks {min(A[d].get('rank') or 0 for d in both)}–"
              f"{max(A[d].get('rank') or 0 for d in both)}.")
    return 0


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    import tempfile
    d = tempfile.mkdtemp()
    a, b = os.path.join(d, "a.jsonl"), os.path.join(d, "b.jsonl")
    common = {"http_status": 200, "content_type": "text/html"}
    with open(a, "w") as fh:
        fh.write(json.dumps({"domain": "same.ru", "rank": 1, "vantage": "x", **common}) + "\n")
        fh.write(json.dumps({"domain": "geo.ru", "rank": 2, "vantage": "x",
                             "http_status": 403}) + "\n")
        fh.write(json.dumps({"domain": "onlya.ru", "rank": 3, "vantage": "x", **common}) + "\n")
        # a duplicate row, as a concurrent writer would leave
        fh.write(json.dumps({"domain": "same.ru", "rank": 1, "vantage": "x",
                             "http_status": 403}) + "\n")
    with open(b, "w") as fh:
        fh.write(json.dumps({"domain": "same.ru", "rank": 1, "vantage": "y", **common}) + "\n")
        fh.write(json.dumps({"domain": "geo.ru", "rank": 2, "vantage": "y", **common}) + "\n")

    check("a duplicate row does not change the reading",
          read(a)["same.ru"]["http_status"], 200)
    A, B = read(a), read(b)
    check("the intersection excludes what only one walk reached",
          sorted(set(A) & set(B)), ["geo.ru", "same.ru"])
    check("a domain only one walk reached is not counted as a disagreement",
          "onlya.ru" in (set(A) & set(B)), False)
    sb = _load("adint-frame-stageb")
    check("a 403 on one side and a page on the other IS a disagreement",
          sb.classify(A["geo.ru"])[0] != sb.classify(B["geo.ru"])[0], True)

    # The asymmetry that decides whether a one-vantage frame is usable. A HOLE (the other
    # side admits it, this side reached it and did not) and PENDING (this side has not
    # reached it at all) are indistinguishable in any disagreement total, and only one of
    # them is a defect.
    d2 = tempfile.mkdtemp()
    x, y = os.path.join(d2, "x.jsonl"), os.path.join(d2, "y.jsonl")
    hb = {"present": True, "bidders": ["b1"]}
    with open(x, "w") as fh:
        fh.write(json.dumps({"domain": "hole.ru", "rank": 1, "vantage": "x",
                             "http_status": 403}) + "\n")
        fh.write(json.dumps({"domain": "shared.ru", "rank": 2, "vantage": "x",
                             "http_status": 200, "content_type": "text/html",
                             "adfox_hb": hb}) + "\n")
    with open(y, "w") as fh:
        fh.write(json.dumps({"domain": "hole.ru", "rank": 1, "vantage": "y",
                             "http_status": 200, "content_type": "text/html",
                             "adfox_hb": hb}) + "\n")
        fh.write(json.dumps({"domain": "shared.ru", "rank": 2, "vantage": "y",
                             "http_status": 200, "content_type": "text/html",
                             "adfox_hb": hb}) + "\n")
        fh.write(json.dumps({"domain": "deeper.ru", "rank": 9, "vantage": "y",
                             "http_status": 200, "content_type": "text/html",
                             "adfox_hb": hb}) + "\n")
    X, Y = read(x), read(y)
    admX = {d for d in X if sb.classify(X[d])[0] == "admit"}
    admY = {d for d in Y if sb.classify(Y[d])[0] == "admit"}
    check("a domain the other vantage admits and this one refused is a HOLE",
          sorted((admY & set(X)) - admX), ["hole.ru"])
    check("a domain this vantage has not reached is PENDING, not a hole",
          sorted(admY - set(X)), ["deeper.ru"])
    check("the deeper walk has no hole of its own here",
          sorted((admX & set(Y)) - admY), [])
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
