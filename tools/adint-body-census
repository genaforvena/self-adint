#!/usr/bin/env python3
"""What does each exchange path actually ASK FOR about the person? A census of bid-request
key paths, per exchange host, that never reports a value.

WHY THIS TOOL EXISTS
`adint-hb-capture` schema 6 keeps the bid request's raw body, because the README's thesis is
that the audience profile arrives inside that request. A raw body answers the question but
cannot be published: it describes one real person and this repository is public. So the
finding and the evidence are separated here. This tool reads the private bodies and emits the
SHAPE of each request — which key paths an exchange sends, and what kind of value sits at
each — with the values themselves replaced by a class and a length. The shape is publishable;
the body is not.

WHAT IT REFUSES TO CONFLATE
An exchange we never saw send a body, and an exchange whose body carries no audience field,
are different facts, and the second is the only one that is a finding. Three states, never
merged:

    no-request    we never observed this host at all in this ledger
    no-body       we saw requests, none carried a payload we could read (a GET, an opaque
                  blob, a body the browser would not hand us)
    read          we read N bodies — and only here does "carries no identity field" mean
                  anything

A GET-based exchange encodes the same profile in its QUERY STRING, so `no-body` is the
loudest possible "look here next", not a null result.

THE TAXONOMY IS A HEURISTIC AND SAYS SO
Fields are bucketed by name (identity / segments / geo / consent / device / content). Name
matching is a lead, not a verdict: `user.ext.eids` is an identity graph by definition, but a
key called `sid` might be a session id or a segment id and this tool cannot tell. So every
bucket also prints the RAW key paths it matched, and `--paths` prints the unbucketed census,
so a reader can disagree with the bucketing without re-running the capture.
"""

import argparse
import base64
import collections
import gzip
import hashlib
import json
import os
import re
import sys
import urllib.parse
import zlib

SCHEMA = 1

# ── the taxonomy ──────────────────────────────────────────────────────────────────────
# Matched against the LAST segment of a key path first, then against the whole path. Last
# segment first because `user.ext.eids[].uids[].id` is an identity field and `imp[].id` is
# not, and a whole-path substring match on "id" calls both of them one thing.
LEAF = {
    "identity": {
        "eids", "buyeruid", "buyerid", "buyeruids", "ifa", "idfa", "gaid", "aaid", "adid",
        "did", "dpid", "macsha1", "macmd5", "didsha1", "didmd5", "dpidsha1", "dpidmd5",
        "yandexuid", "icookie", "puid", "uid", "uids", "userid", "user_id", "customerid",
        "fpid", "sessionid", "ssp_user_id", "tuid", "duid", "cuid", "hid", "suid",
    },
    "segments": {
        "segment", "segments", "segtax", "segclass", "keywords", "kw", "interests",
        "audience", "audiences", "taxonomy", "topics", "cohort", "cohorts", "targeting",
    },
    "geo": {
        "geo", "lat", "lon", "country", "region", "regionfips104", "city", "zip", "metro",
        "utcoffset", "accuracy", "ipservice", "ip", "ipv6", "ip6",
    },
    "consent": {
        "consent", "gdpr", "gdprapplies", "us_privacy", "usprivacy", "gpp", "gpp_sid",
        "coppa", "dnt", "lmt", "regs",
    },
    "device": {
        "ua", "sua", "devicetype", "make", "model", "os", "osv", "hwv", "language", "langb",
        "carrier", "mccmnc", "connectiontype", "js", "h", "w", "ppi", "pxratio", "flashver",
        # The GET exchanges state the viewport in their own vocabulary, not OpenRTB's.
        "screenw", "screenh", "screen_width", "screen_height", "sw", "sh", "dpr", "cd",
        "winw", "winh", "vpw", "vph",
    },
    "content": {
        "cat", "sectioncat", "pagecat", "cattax", "domain", "page", "ref", "referer",
        "referrer", "targetref", "title", "keywords_page",
    },
}
# LEAF FAMILIES. An exact-name set is a copy of the world that rots: the first live sweep
# through a GET exchange (ssp01.rambler.ru, 2026-08-20) carried `adtech_uid` as a UUID,
# `publisher_uid`, `rq_sess`, `top100_session_id.<siteid>` and six `puidN` targeting params —
# and the exact-name taxonomy above bucketed NOT ONE of them, so the census printed the
# richest identity payload in the sweep as carrying no audience data. These families are the
# repair. They are still NAME matching, i.e. still a lead: `pad_id` and `block_id` on that
# same request are placement ids, which is why a bare `_id$` rule is deliberately absent.
LEAF_RX = [
    # `…_uid`, `uid`, `uuid` — an identifier for the person, whoever minted it.
    ("identity", re.compile(r"(^|_)u?uid$")),
    # A session identifier is an identifier that expires, not a non-identifier.
    ("identity", re.compile(r"(^|_)(sess|session)(_?id)?$")),
    ("identity", re.compile(r"session_?id")),
    # Adfox/Rambler `puid1..puid63`: publisher-declared USER TARGETING parameters. The name
    # says "user id" and the role is a segment — bucketed by role, flagged here because the
    # name would send a reader the other way.
    ("segments", re.compile(r"^puid\d+$")),
    ("identity", re.compile(r"^(fp|fingerprint)(_?key|_?id)?$")),
    # `places[].sapeFpUids[].id` / `.source` is an eids-shaped identity GRAPH — an array of
    # {source, id} pairs — and the exact-name set scored it as nothing because its leaves are
    # the two most generic words in the schema. The vendor prefix is the only distinguishing
    # part of the name, so the family matches the PARENT.
    ("identity", re.compile(r"fp_?uids?$")),
    # `places[].solta_stable`: a field whose name asserts persistence.
    ("identity", re.compile(r"_stable$")),
]

# Whole-path rules, applied when the leaf did not decide. Ordered: first match wins.
PATH = [
    # `top100_session_id.<site id>` — the leaf is the publisher's numeric site id, so no leaf
    # rule can see this one. The identifier is in the PARENT key.
    ("identity", re.compile(r"fp_?uids?\[\]", re.I)),
    ("identity", re.compile(r"sess(ion)?_?id", re.I)),
    ("identity", re.compile(r"(^|\.)user\.(ext\.)?(id|eids)", re.I)),
    ("segments", re.compile(r"(^|\.)user\.(data|ext\.data)", re.I)),
    ("geo", re.compile(r"(^|\.)(user|device)\.geo(\.|$)", re.I)),
    ("consent", re.compile(r"(^|\.)(regs|ext\.consent)", re.I)),
    ("device", re.compile(r"(^|\.)device(\.|$)", re.I)),
    ("content", re.compile(r"(^|\.)(site|app)(\.|$)", re.I)),
]
BUCKETS = ["identity", "segments", "geo", "consent", "device", "content"]


def bucket(path):
    # The `?` marks a query-string path. Stripped HERE rather than at each call site: a caller
    # that forgets sends `?screenw` through as a leaf nothing matches, and the field silently
    # buckets as nothing — which is this tool's whole failure mode.
    leaf = path.lstrip("?").rsplit(".", 1)[-1].replace("[]", "").lower()
    for name, names in LEAF.items():
        if leaf in names:
            return name
    for name, rx in LEAF_RX:
        if rx.search(leaf):
            return name
    for name, rx in PATH:
        if rx.search(path):
            return name
    return None


# ── value shapes: what KIND of thing sits there, never the thing ──────────────────────
HEX = re.compile(r"^[0-9a-f]+$", re.I)
B64ISH = re.compile(r"^[A-Za-z0-9+/=_-]+$")
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$", re.I)


def shape(v):
    """A class and a size. Never the value — this output is meant to be publishable."""
    if v is None:
        return "null"
    if isinstance(v, bool):
        return "bool"
    if isinstance(v, (int, float)):
        return "num"
    if isinstance(v, str):
        s = v.strip()
        if not s:
            return "str:empty"
        if UUID.match(s):
            return "uuid"
        # A long all-decimal string matches the hex alphabet, and calling it `hex` hides what
        # it is: yandex's `duid` decodes to 19 decimal digits whose leading 10 are a unix
        # timestamp, i.e. an id MINTED FROM THE CLOCK — a different animal from a 32-char
        # random hex. Split before the hex rule, and only where hex would have claimed it, so
        # no shorter shape changes.
        if len(s) >= 16 and s.isdigit():
            return "digits:%d" % len(s)
        if len(s) >= 16 and HEX.match(s):
            return "hex:%d" % len(s)
        if len(s) >= 24 and B64ISH.match(s):
            return "opaque:%d" % len(s)
        return "str:%d" % len(s)
    if isinstance(v, list):
        return "list:%d" % len(v)
    if isinstance(v, dict):
        return "obj:%d" % len(v)
    return type(v).__name__


def unwrap(v):
    """One layer down an opaque value, or None. Never returns the plaintext to a caller that
    would print it — the result is fed straight back into `flatten`, which emits shapes.

    Measured on yandex.ru 2026-08-20: `?bids` is base64 of
    `[{"bidderName":"betweendigital","campaign_id":…}]` — the wrapper reporting EVERY OTHER
    BIDDER'S BID to Yandex — and `?duid` is base64 of a 19-digit decimal. Left as
    `opaque:1844` and `opaque:28`, a census calls the most interesting field on the wire "an
    opaque blob".

    A layer that does not decode stays opaque and SAYS so, because `?grab` is base64 whose
    payload is `{"grab_version":2}` followed by 3.7 KB that is not gzip, zlib or raw deflate.
    "We could not read it" and "there is nothing in it" are the same distinction this whole
    tool is built on.
    """
    if not isinstance(v, str) or len(v) < 16:
        return None
    s = v.strip()
    for dec in (base64.b64decode, base64.urlsafe_b64decode):
        try:
            raw = dec(s + "==")
        except Exception:
            continue
        if not raw:
            continue
        for fn in (lambda b: b, gzip.decompress, zlib.decompress,
                   lambda b: zlib.decompress(b, -15)):
            try:
                out = fn(raw)
            except Exception:
                continue
            try:
                txt = out.decode("utf-8")
            except Exception:
                continue
            t = txt.strip()
            if t[:1] in "{[":
                try:
                    return json.loads(t)
                except Exception:
                    pass
            # A decimal id inside base64 is still a decoded value, and its LENGTH is the
            # finding (a 19-digit id minted from a clock is not an identity graph).
            if t.isdigit():
                return {"_decimal": t}
        break
    return None


DECODE = False   # set by --decode; off by default so a census is a plain reading
# Captured at import, because the gate below sets DECODE by hand to drive both branches and
# would otherwise be asserting the value it just wrote. `--decode --test` also mutates the
# live flag before selftest runs, so only a snapshot taken here can see the real default.
DECODE_DEFAULT = DECODE


def _leaf(p, v, out, depth):
    """Record one scalar, and — under --decode — one layer inside it if it opens.

    The decoded path is marked `~b64` rather than merged into the parent: a field we had to
    decode is a different claim about what the exchange sent than a field it sent in the
    clear, and pooling them would let a census say "site.page was on the wire" about
    something only a base64 round-trip revealed.
    """
    e = out.setdefault(p, {"shapes": set(), "vals": set()})
    e["shapes"].add(shape(v))
    if len(e["vals"]) < VAL_CAP:
        e["vals"].add(vhash(v))
    if not DECODE or depth > 6:
        return
    inner = unwrap(v)
    if inner is not None:
        flatten(inner, p + "~b64", out, depth + 1)


VAL_CAP = 500   # distinct values tracked per path before the count is marked saturated


def vhash(v):
    """A stable, one-way tag for a value. NEVER reversible, never printed — only counted.

    Identifier STABILITY is the sharpest test of the README's thesis and it cannot be done
    with shapes: `uuid` and `uuid` are the same shape whether they are the same uuid or two
    freshly minted ones. Counting distinct values answers it and publishes nothing, because
    the count is the finding and the values never leave this process.
    """
    return hashlib.blake2b(repr(v).encode("utf-8", "replace"), digest_size=8).digest()


def flatten(obj, prefix="", out=None, depth=0):
    """Dotted key paths. Arrays collapse to `[]` so ten imps are one path, not ten."""
    out = {} if out is None else out
    if depth > 12:
        return out
    if isinstance(obj, dict):
        for k, v in obj.items():
            p = ("%s.%s" % (prefix, k)) if prefix else str(k)
            if isinstance(v, (dict, list)):
                flatten(v, p, out, depth + 1)
            else:
                _leaf(p, v, out, depth)
    elif isinstance(obj, list):
        p = prefix + "[]"
        if not obj:
            out.setdefault(p, {"shapes": set(), "vals": set()})["shapes"].add("list:0")
        for v in obj:
            if isinstance(v, (dict, list)):
                flatten(v, p, out, depth + 1)
            else:
                _leaf(p, v, out, depth)
    return out


def parse_body(body):
    """(format, flattened) — or (format, None) when the payload is real but unreadable.

    None is not {}: a body we could not parse carries an unknown number of audience fields,
    and rendering it as an empty census would publish "this exchange asks for nothing" about
    a request we never read.
    """
    if body is None:
        return None, None
    s = body.strip()
    if not s:
        return "empty", {}
    if s[0] in "{[":
        try:
            return "json", flatten(json.loads(s))
        except Exception:
            pass
    # A urlencoded form is a real wire format here, not a fallback: several RU paths post
    # `key=value&...` with the profile spread across the keys.
    if "=" in s and "\n" not in s[:200]:
        try:
            pairs = urllib.parse.parse_qsl(s, keep_blank_values=True)
            if pairs and all(re.match(r"^[\w.\[\]-]+$", k) for k, _ in pairs):
                out = {}
                for k, v in pairs:
                    # A urlencoded value is very often itself JSON — unwrap one level, so
                    # `data={"user":{...}}` is censused as user.* and not as one opaque blob.
                    vs = v.strip()
                    if vs[:1] in "{[":
                        try:
                            flatten(json.loads(vs), k, out)
                            continue
                        except Exception:
                            pass
                    _leaf(k, v, out, 0)
                return "urlencoded", out
        except Exception:
            pass
    return "unparsed", None


def _merge(dst, path, ent, load_id):
    """Fold one request's reading of one key path into the running census.

    `vals` is a set of one-way tags, capped at VAL_CAP. Saturation is recorded rather than
    silently truncated: a path that hit the cap has AT LEAST that many distinct values, and
    reporting the cap as if it were the count would turn "thousands of distinct values"
    into a fixed number that looks like a measurement.
    """
    e = dst.setdefault(path, {"n": 0, "shapes": set(), "loads": set(),
                              "vals": set(), "vals_saturated": False})
    e["n"] += 1
    e["shapes"] |= ent["shapes"]
    room = VAL_CAP - len(e["vals"])
    if room <= 0:
        if ent["vals"] - e["vals"]:
            e["vals_saturated"] = True
    else:
        e["vals"] |= set(list(ent["vals"])[:room])
        if len(e["vals"]) >= VAL_CAP:
            e["vals_saturated"] = True
    if load_id:
        e["loads"].add(load_id)


def census(rows):
    """host -> {state, n_req, n_body, n_read, formats, paths{path: {shapes, n}}}"""
    per = collections.defaultdict(lambda: {
        "n_req": 0, "n_body": 0, "n_read": 0, "n_unparsed": 0, "n_truncated": 0,
        "n_url_q": 0, "n_url_maybe_cut": 0, "loads": set(),
        "n_candidate": 0, "n_noncandidate": 0, "n_unclassified": 0, "bidders": set(),
        "formats": collections.Counter(), "paths": {}, "qpaths": {},
    })
    for r in rows:
        if r.get("kind") != "request":
            continue
        host = (r.get("host") or "").lower()
        if not host:
            continue
        h = per[host]
        h["n_req"] += 1
        # WHETHER THIS PATH IS AN AUCTION AT ALL is not this tool's judgement to make. The
        # capture tool classifies each request (`is_bid_candidate`, `bidder`) behind its own
        # gates, and re-deciding it here by hostname would be a second, unreviewed classifier
        # disagreeing with the first. A row that predates the field renders `None`, and a host
        # whose rows are all `None` is UNKNOWN — never "not an exchange".
        if r.get("is_bid_candidate") is True:
            h["n_candidate"] += 1
        elif r.get("is_bid_candidate") is False:
            h["n_noncandidate"] += 1
        else:
            h["n_unclassified"] += 1
        if r.get("bidder"):
            h["bidders"].add(r["bidder"])
        # THE LOAD, not the request, is the unit for "does this field appear". A page that
        # fires one exchange twenty times and a field that shows up on twenty pages are the
        # same request count and completely different evidence.
        lid = r.get("load_id")
        if lid:
            h["loads"].add(lid)

        # THE QUERY STRING IS THE OTHER HALF OF THE QUESTION. A GET-based exchange puts the
        # same profile there that a POST one puts in the body, so a census that reads only
        # bodies reports `no-body` — indistinguishable from "asked nothing about the person"
        # — for exactly the paths most worth reading. Schema 7 keeps the full url; a
        # schema<=6 row has only a 500-char preview and its query census is a FLOOR, never a
        # complete reading, which is why `url_truncated` is counted separately.
        full = r.get("req_url_full")
        if full is None:
            full = r.get("url")
            if full and len(full) >= 500:
                h["n_url_maybe_cut"] += 1
        if r.get("req_url_truncated"):
            h["n_url_maybe_cut"] += 1
        q = urllib.parse.urlsplit(full or "").query
        if q:
            h["n_url_q"] += 1
            for k, v in urllib.parse.parse_qsl(q, keep_blank_values=True):
                vs = v.strip()
                sub = None
                if vs[:1] in "{[":
                    try:
                        sub = flatten(json.loads(vs), "?" + k)
                    except Exception:
                        sub = None
                if sub is None:
                    sub = {}
                    _leaf("?" + k, v, sub, 0)
                for pth, ent in sub.items():
                    _merge(h["qpaths"], pth, ent, lid)

        body = r.get("req_body")
        if body is None:
            continue
        h["n_body"] += 1
        if r.get("req_body_truncated"):
            h["n_truncated"] += 1
        fmt, flat = parse_body(body)
        h["formats"][fmt or "none"] += 1
        if flat is None:
            h["n_unparsed"] += 1
            continue
        h["n_read"] += 1
        for p, ent in flat.items():
            _merge(h["paths"], p, ent, lid)
    for h in per.values():
        # Four states, and the middle two are the ones a body-only census merged. `url-only`
        # is a real reading of a real question; `no-payload` is the only one that can support
        # "this path asked nothing".
        h["state"] = ("read" if h["n_read"] else
                      ("url-only" if h["qpaths"] else
                       ("no-payload" if h["n_req"] else "no-request")))
    return per


EMPTY_SHAPES = {"list:0", "obj:0", "str:empty", "null"}


def slots(h):
    """(empty, filled) audience key paths for one host.

    THE MOST INFORMATIVE STATE IS `PRESENT AND EMPTY`, and it is the one a bucket count hides.
    `places[].sapeFpUids[]` is an eids-shaped identity graph that sape asks for on every bid
    request; on this browser it arrives `list:0` twenty-two times out of twenty-four. Counted
    as "sape carries an identity field" it overstates; counted as "sape asks nothing about
    the person" it understates and misses the finding entirely. The slot EXISTS and is EMPTY,
    which is a fact about this browser rather than about the protocol.

    A path is `filled` if it was ever seen non-empty and `empty` if every reading of it was.
    """
    empty, filled = [], []
    for src in (h["paths"], h["qpaths"]):
        for p, e in src.items():
            if bucket(p) not in ("identity", "segments", "consent"):
                continue
            (empty if e["shapes"] <= EMPTY_SHAPES else filled).append(p)
    return sorted(empty), sorted(filled)


def buckets_of(h, half="both"):
    """Bucket the body paths, the query paths, or both. A query path is prefixed `?`, so the
    two halves stay distinguishable in the output rather than pooling into one claim."""
    out = {b: [] for b in BUCKETS}
    src = []
    if half in ("both", "body"):
        src += sorted(h["paths"])
    if half in ("both", "url"):
        src += sorted(h["qpaths"])
    for p in src:
        b = bucket(p)
        if b:
            out[b].append(p)
    return out


def by_arm(rows):
    """{arm: census}. The arm is read from the ROW, never from which file it came in.

    A warming study's whole content is a difference between two arms, and the difference that
    matters is which key paths APPEAR — `user.eids[]` sitting empty on a cold profile and
    populated on a warmed one is the README's thesis in one field. Splitting by row keeps a
    single interleaved ledger (one hour, one vantage) as the unit, instead of two runs whose
    difference includes the hour.
    """
    per = collections.defaultdict(list)
    for r in rows:
        per[r.get("arm")].append(r)
    return {arm: census(rs) for arm, rs in per.items()}


def arm_diff(a, b, host, min_loads=1):
    """(only_in_a, only_in_b, shape_changed) for one host across two arm censuses.

    A host absent from an arm yields NO diff rather than "everything is new": the two arms
    load different pages at different moments and an exchange that simply did not appear is
    not a field that arrived.
    """
    ha, hb = a.get(host), b.get(host)
    if not ha or not hb:
        return None
    pa = dict(ha["paths"]); pa.update({k: v for k, v in ha["qpaths"].items()})
    pb = dict(hb["paths"]); pb.update({k: v for k, v in hb["qpaths"].items()})
    # A PATH SEEN ON ONE LOAD IS NOT A TREATMENT EFFECT. The two arms load the same 23 sites
    # but a page is not the same page twice: a video that started, an error that fired, a lazy
    # block that scrolled into view all add key paths that have nothing to do with the
    # profile. `min_loads` is the floor under which a difference is page variance, and it is
    # applied to the arm the path is claimed to be IN — a field present on 12 of 23 warmed
    # loads and 0 cold ones is a finding; 1 versus 0 is noise wearing the same shape.
    def _n(e):
        return len(e.get("loads") or ()) or e["n"]

    only_a = sorted(k for k in set(pa) - set(pb) if _n(pa[k]) >= min_loads)
    only_b = sorted(k for k in set(pb) - set(pa) if _n(pb[k]) >= min_loads)
    changed = sorted(k for k in set(pa) & set(pb)
                     if pa[k]["shapes"] != pb[k]["shapes"])

    # AN EMPTY ARRAY THAT FILLS UP LOOKS LIKE A FIELD THAT VANISHED. `flatten` collapses
    # `"eids": []` to the single path `user.eids[]` and `"eids":[{"source":…}]` to
    # `user.eids[].source`, so the arrival of an identity graph renders as
    #   - only under cold   user.eids[]
    #   + only under warm   user.eids[].source
    # and the minus line reads as LOSS when it is the exact gain the study is looking for.
    # Named `filled` and lifted out of `only_a`, because the sign is the finding.
    filled = sorted(k for k in only_a
                    if any(q.startswith(k + ".") or q.startswith(k[:-2] + "[].")
                           for q in only_b))
    only_a = [k for k in only_a if k not in set(filled)]
    counts = {k: (_n(pa[k]) if k in pa else 0, _n(pb[k]) if k in pb else 0)
              for k in set(only_a) | set(only_b) | set(changed) | set(filled)}

    # IDENTIFIER STABILITY, which shapes cannot answer: `uuid` and `uuid` are the same shape
    # whether they are the same uuid on every load or a fresh one each time. A field taking
    # ONE value across 23 loads is an identity that persists; one taking 23 is an id minted
    # per load and carries nothing about who is behind it.
    stab = {}
    for k in set(pa) & set(pb):
        va, vb = len(pa[k].get("vals") or ()), len(pb[k].get("vals") or ())
        la, lb = _n(pa[k]), _n(pb[k])
        if la >= min_loads and lb >= min_loads and (va, la) != (vb, lb):
            stab[k] = (va, la, vb, lb,
                       bool(pa[k].get("vals_saturated") or pb[k].get("vals_saturated")))
    return only_a, only_b, changed, filled, counts, stab


def load(paths):
    rows, schemas = [], collections.Counter()
    for path in paths:
        with open(path) as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    r = json.loads(line)
                except Exception:
                    continue
                schemas[r.get("schema")] += 1
                rows.append(r)
    return rows, schemas


def main():
    ap = argparse.ArgumentParser(prog="adint-body-census", description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("ledgers", nargs="*")
    ap.add_argument("--host", help="census one host in full")
    ap.add_argument("--by-arm", nargs=2, metavar=("BASE", "OTHER"),
                    help="split the ledger by the row's `arm` and diff two of them: which "
                         "key paths appear only under OTHER, and which changed value shape")
    ap.add_argument("--min-loads", type=int, default=1,
                    help="with --by-arm, ignore a difference seen on fewer than this many "
                         "LOADS. Below it a difference is page variance — a video that "
                         "started, an error that fired — not the treatment (default 1: keep "
                         "everything, which is the honest default for a first look)")
    ap.add_argument("--audience-only", action="store_true",
                    help="with --by-arm, show only differences in fields that make a claim "
                         "ABOUT THE PERSON (identity / segments / consent)")
    ap.add_argument("--decode", action="store_true",
                    help="open one layer inside opaque values (base64, then gzip/zlib) and "
                         "census what is in there, marked `~b64`. Still shapes, never "
                         "values. Off by default: a decoded field is a different claim about "
                         "what the exchange sent than one sent in the clear")
    ap.add_argument("--paths", action="store_true",
                    help="print every key path, unbucketed, with its value shapes")
    ap.add_argument("--candidates", choices=["only", "exclude", "all"], default="all",
                    help="restrict to hosts the CAPTURE TOOL classified as bid candidates "
                         "(`only`), to those it did not (`exclude`), or neither. The verdict "
                         "is the capture tool's, read off the row — this tool does not "
                         "re-decide what an auction is by hostname")
    ap.add_argument("--min-req", type=int, default=1,
                    help="hide hosts seen fewer than this many times (default 1: hide none)")
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.decode:
        globals()["DECODE"] = True
    if args.test:
        return selftest()
    if not args.ledgers:
        ap.error("no ledger given")

    rows, schemas = load(args.ledgers)
    # Schema<=5 discarded the body. Reading such a ledger and reporting "no audience data"
    # would be exactly the error the schema-6 commit was written against, so it is named.
    old = sum(n for s, n in schemas.items() if isinstance(s, int) and s < 6)
    per = census(rows)

    if args.json:
        out = {}
        for host, h in per.items():
            if h["n_req"] < args.min_req:
                continue
            out[host] = {
                "state": h["state"], "n_req": h["n_req"], "n_body": h["n_body"],
                "n_read": h["n_read"], "n_unparsed": h["n_unparsed"],
                "n_truncated": h["n_truncated"], "formats": dict(h["formats"]),
                "n_url_q": h["n_url_q"], "n_url_maybe_cut": h["n_url_maybe_cut"],
                "buckets": buckets_of(h),
                "buckets_body": buckets_of(h, "body"),
                "buckets_url": buckets_of(h, "url"),
                "paths": {p: {"n": e["n"], "shapes": sorted(e["shapes"])}
                          for p, e in h["paths"].items()},
                "qpaths": {p: {"n": e["n"], "shapes": sorted(e["shapes"])}
                           for p, e in h["qpaths"].items()},
            }
        print(json.dumps({"census_schema": SCHEMA,
                          "rows_schema<6": old, "hosts": out},
                         ensure_ascii=False, indent=1))
        return 0

    if old:
        print("NOTE %d row(s) come from schema<6, which parsed the body and DISCARDED it."
              % old)
        print("     Their silence about a profile is not evidence the request carried none.")
        print()

    if args.by_arm:
        base, other = args.by_arm
        arms = by_arm(rows)
        missing = [a for a in (base, other) if a not in arms]
        if missing:
            print("arm(s) not in this ledger: " + ", ".join(missing))
            print("present: " + ", ".join(sorted(str(a) for a in arms)))
            return 2
        A, B = arms[base], arms[other]
        na = sum(1 for r in rows if r.get("arm") == base and r.get("kind") == "load")
        nb = sum(1 for r in rows if r.get("arm") == other and r.get("kind") == "load")
        print("%s: %d load(s)   %s: %d load(s)" % (base, na, other, nb))
        print("hosts in both: %d   only %s: %d   only %s: %d"
              % (len(set(A) & set(B)), base, len(set(A) - set(B)),
                 other, len(set(B) - set(A))))
        print()
        for host in sorted(set(A) & set(B)):
            d = arm_diff(A, B, host, args.min_loads)
            if d is None:
                continue
            only_a, only_b, changed, filled, counts, stab = d
            stab_ks = sorted(stab)
            if args.audience_only:
                keep = lambda ps: [p for p in ps if bucket(p)
                                   in ("identity", "segments", "consent")]
                only_a, only_b = keep(only_a), keep(only_b)
                changed, filled = keep(changed), keep(filled)
                stab_ks = keep(stab_ks)
            if not (only_a or only_b or changed or filled or stab_ks):
                continue
            print("%s   [%d/%d loads]"
                  % (host, len(A[host]["loads"]), len(B[host]["loads"])))

            def _sh(cen, p):
                return "|".join(sorted(
                    (cen[host]["paths"].get(p) or cen[host]["qpaths"][p])["shapes"]))

            def _c(p):
                a, b = counts.get(p, (0, 0))
                return "%d/%d" % (a, b)

            for p in filled:
                print("   * FILLED %-6s %-7s %-40s was %s"
                      % (other, _c(p), p, _sh(A, p)))
            for p in only_b:
                print("   + only %-8s %-7s %-40s %s" % (other, _c(p), p, _sh(B, p)))
            for p in only_a:
                print("   - only %-8s %-7s %-40s %s" % (base, _c(p), p, _sh(A, p)))
            for p in changed:
                print("   ~ shape    %-7s %-40s %s -> %s"
                      % (_c(p), p, _sh(A, p), _sh(B, p)))
            for p in stab_ks:
                va, la, vb, lb, sat = stab[p]
                print("   = values   %-7s %-40s %d over %d load(s) -> %d over %d%s"
                      % ("", p, va, la, vb, lb, "  (saturated)" if sat else ""))
            print()
        return 0

    if args.host:
        h = per.get(args.host)
        if not h:
            print("%s: no-request — never seen in this ledger" % args.host)
            return 0
        print("%s  state=%s  requests=%d bodies=%d read=%d unparsed=%d truncated=%d"
              % (args.host, h["state"], h["n_req"], h["n_body"], h["n_read"],
                 h["n_unparsed"], h["n_truncated"]))
        print("  formats: " + ", ".join("%s=%d" % kv for kv in h["formats"].most_common()))
        print("  query strings read=%d  urls possibly CUT=%d"
              % (h["n_url_q"], h["n_url_maybe_cut"]))
        if h["n_url_maybe_cut"]:
            print("  WARNING %d url(s) may be cut. Missing query params here are OUR limit,"
                  % h["n_url_maybe_cut"])
            print("          not a question the exchange did not ask.")
        for b, ps in buckets_of(h).items():
            print("  %-9s %s" % (b, ", ".join(ps) if ps else "—"))
        emp, fil = slots(h)
        print("  audience slots: %d filled, %d present-but-ALWAYS-EMPTY" % (len(fil), len(emp)))
        if emp:
            print("    empty: " + ", ".join(emp))
        if fil:
            print("    filled: " + ", ".join(fil))
        if args.paths:
            print("  ── body key paths ──")
            for p in sorted(h["paths"]):
                e = h["paths"][p]
                print("   %-52s n=%-4d %s" % (p, e["n"], "|".join(sorted(e["shapes"]))))
            print("  ── query key paths ──")
            for p in sorted(h["qpaths"]):
                e = h["qpaths"][p]
                print("   %-52s n=%-4d %s" % (p, e["n"], "|".join(sorted(e["shapes"]))))
        return 0

    if args.candidates != "all":
        want = args.candidates == "only"
        per = {k: v for k, v in per.items()
               if (v["n_candidate"] > 0) == want}
    hdr = ("%-30s %-10s %5s %5s %5s %5s  %s"
           % ("host", "state", "req", "body", "url?", "cand", "audience buckets"))
    print(hdr)
    print("-" * len(hdr))
    for host, h in sorted(per.items(), key=lambda kv: (-kv[1]["n_read"], -kv[1]["n_req"])):
        if h["n_req"] < args.min_req:
            continue
        bs = buckets_of(h)
        mark = " ".join(("%s:%d" % (b[:4], len(bs[b]))) for b in BUCKETS if bs[b]) or "—"
        emp, fil = slots(h)
        if emp or fil:
            mark += "   slots %d filled / %d ALWAYS EMPTY" % (len(fil), len(emp))
        cut = "!" if h["n_url_maybe_cut"] else " "
        cand = ("%d" % h["n_candidate"] if h["n_candidate"]
                else ("?" if h["n_unclassified"] and not h["n_noncandidate"] else "-"))
        print("%-30s %-10s %5d %5d %4d%s %5s  %s"
              % (host[:30], h["state"], h["n_req"], h["n_read"], h["n_url_q"], cut,
                 cand, mark))
    return 0


def selftest():
    ok = True
    checks = []

    # The three states must never merge.
    per = census([
        {"kind": "request", "host": "a.example", "req_body": '{"user":{"id":"x"}}'},
        {"kind": "request", "host": "b.example", "req_body": None},
        {"kind": "request", "host": "c.example", "req_body": "\x00\x01binary"},
    ])
    checks.append(("a host with a readable body is `read`", per["a.example"]["state"] == "read"))
    checks.append(("a host we saw send no payload at all is `no-payload`, not `read`",
                   per["b.example"]["state"] == "no-payload"))
    checks.append(("a host never seen is absent, so the caller renders no-request",
                   "z.example" not in per))
    # THE CENTRAL REFUSAL: an unreadable payload must not census as an empty request.
    checks.append(("an unparsed body is NOT counted as read",
                   per["c.example"]["state"] == "no-payload"
                   and per["c.example"]["n_unparsed"] == 1
                   and per["c.example"]["paths"] == {}))

    # THE GET EXCHANGE. Body-only censusing filed these as "sent nothing" — the loudest
    # possible wrong answer, since the query string IS the bid request for such a path.
    perq = census([
        {"kind": "request", "host": "g.example", "req_body": None,
         "req_url_full": "https://g.example/rtb?uid=abc123&segments=%5B1%2C2%5D&gdpr=1"},
        # schema<=6: only a 500-char preview exists, and it sits AT the cap.
        {"kind": "request", "host": "old.example", "req_body": None,
         "url": "https://old.example/rtb?" + "k=v&" * 130},
    ])
    checks.append(("a GET exchange with query params is `url-only`, never `no-payload`",
                   perq["g.example"]["state"] == "url-only"))
    checks.append(("a query param is censused under a `?` prefix, so the halves never pool",
                   "?uid" in perq["g.example"]["qpaths"]))
    checks.append(("a query param's value is a shape, never the value",
                   perq["g.example"]["qpaths"].get("?uid", {}).get("shapes") == {"str:6"}))
    checks.append(("a JSON-valued query param is unwrapped, not left opaque",
                   "?segments[]" in perq["g.example"]["qpaths"]))
    checks.append(("query params bucket like body fields",
                   buckets_of(perq["g.example"], "url")["consent"] == ["?gdpr"]))
    # A url read from a 500-char preview is a FLOOR. Saying so is the whole point: absent
    # params there are OUR cut, not the exchange's silence.
    checks.append(("a url at the schema<=6 preview cap is counted as possibly CUT",
                   perq["old.example"]["n_url_maybe_cut"] == 1))
    checks.append(("an uncut short url is not flagged",
                   perq["g.example"]["n_url_maybe_cut"] == 0))

    # Values never appear in the output.
    flat = flatten({"user": {"buyeruid": "8f14e45fceea167a5a36dedd4bea2543",
                             "geo": {"lat": 55.75}},
                    "imp": [{"id": "1"}, {"id": "2"}]})
    checks.append(("an identifier is reported as a shape, never as its value",
                   flat["user.buyeruid"]["shapes"] == {"hex:32"}))
    checks.append(("an array collapses to one path, not one per element",
                   [k for k in flat if k.startswith("imp")] == ["imp[].id"]))
    checks.append(("no output string contains the identifier itself",
                   "8f14e45f" not in json.dumps(
                       {k: sorted(v["shapes"]) for k, v in flat.items()})))

    # Bucketing: the leaf decides before the path, else every `id` is an identity.
    checks.append(("imp[].id is not an identity field", bucket("imp[].id") is None))
    checks.append(("user.ext.eids[].uids[].id IS an identity field",
                   bucket("user.ext.eids[].uids[].id") == "identity"))
    checks.append(("device.ip is geo, not content", bucket("device.ip") == "geo"))
    checks.append(("regs.ext.gdpr is consent", bucket("regs.ext.gdpr") == "consent"))
    checks.append(("site.page is content, never audience", bucket("site.page") == "content"))

    # THE FAMILIES, each pinned to the live field that defeated the exact-name taxonomy on
    # 2026-08-20. Mutant: drop LEAF_RX and the session-id PATH rule, and ssp01.rambler.ru's
    # two identifiers, its session id and its six targeting params all bucket as nothing —
    # the census then prints the richest identity payload in the sweep as carrying none.
    checks.append(("`adtech_uid` is identity — an exact-name set never listed it",
                   bucket("?adtech_uid") == "identity"))
    checks.append(("`publisher_uid` is identity", bucket("?publisher_uid") == "identity"))
    checks.append(("`rq_sess` is identity — a session id is an id that expires",
                   bucket("?rq_sess") == "identity"))
    # The leaf here is the publisher's numeric site id, so only a whole-path rule can see it.
    checks.append(("`top100_session_id.<siteid>` is identity, though its leaf is a number",
                   bucket("?top100_session_id.7731951") == "identity"))
    # Named "publisher USER ID", carries a publisher-declared audience attribute.
    checks.append(("`puidN` buckets by its ROLE (segments), not by its name",
                   bucket("?jparams.puid6") == "segments"))
    # And the discipline that keeps the families honest: a placement id is not a person.
    checks.append(("`block_id` and `pad_id` on that same request stay unbucketed",
                   bucket("?block_id") is None and bucket("?pad_id") is None))
    checks.append(("`screenw` is device, in the GET exchanges' own vocabulary",
                   bucket("?screenw") == "device"))

    # urlencoded is a real wire format, and a JSON value inside it is unwrapped.
    fmt, flat2 = parse_body('sid=99&data={"user":{"segment":["a","b"]}}')
    checks.append(("a urlencoded body is parsed, not filed unparsed", fmt == "urlencoded"))
    checks.append(("JSON nested inside a urlencoded value is censused, not left opaque",
                   "data.user.segment[]" in (flat2 or {})))

    # A urlencoded body must survive the FULL census path, not just parse_body. The live data
    # found this: `flatten` grew a {shapes, vals} entry and the urlencoded branch still built
    # a bare set, so every ledger containing one urlencoded request crashed in `_merge` —
    # and every gate passed, because they all fed JSON. A parser gate is not a census gate.
    _ue = census([{"kind": "request", "host": "u.example", "load_id": "L1",
                   "req_body": "sid=99&k=v"}])
    checks.append(("a urlencoded body survives the whole census, not just the parser",
                   _ue["u.example"]["state"] == "read"
                   and _ue["u.example"]["paths"]["sid"]["shapes"] == {"str:2"}))
    # And so must a query string, for the same reason and by the same route.
    _q2 = census([{"kind": "request", "host": "q.example", "load_id": "L1",
                   "req_body": None, "req_url_full": "https://q.example/x?a=1"}])
    checks.append(("a query-string-only request survives the whole census",
                   _q2["q.example"]["qpaths"]["?a"]["shapes"] == {"str:1"}))

    # A truncated body is flagged, because a field missing because we cut the string reads
    # exactly like a field the exchange never sent.
    per2 = census([{"kind": "request", "host": "t.example", "req_body": '{"a":1}',
                    "req_body_truncated": True}])
    checks.append(("a truncated body is counted as truncated",
                   per2["t.example"]["n_truncated"] == 1))

    # --- by-arm: the warming study's whole content is a diff between two arms ----------
    _rows = [
        {"kind": "request", "arm": "cold", "host": "x.example",
         "req_body": '{"user":{"eids":[],"id":"a"}}'},
        {"kind": "request", "arm": "warm", "host": "x.example",
         "req_body": '{"user":{"eids":[{"source":"s"}],"id":"a","data":[{"segment":[1]}]}}'},
        # An exchange that appeared in only one arm. Two arms load different pages at
        # different moments; a host that simply did not show up is NOT a field that arrived.
        {"kind": "request", "arm": "warm", "host": "only-warm.example",
         "req_body": '{"user":{"id":"z"}}'},
    ]
    _arms = by_arm(_rows)
    _rows[0]["req_body"] = '{"user":{"eids":[],"id":"a"}}'
    _rows[1]["req_body"] = ('{"user":{"eids":[{"source":"s"}],'
                            '"id":"8f14e45fceea167a5a36dedd4bea2543",'
                            '"data":[{"segment":[1]}]}}')
    _arms = by_arm(_rows)
    _d = arm_diff(_arms["cold"], _arms["warm"], "x.example")
    checks += [
        ("the arm comes from the ROW, so one interleaved ledger splits cleanly",
         sorted(_arms) == ["cold", "warm"]),
        ("a path present only under the warmed arm is reported as arriving",
         "user.data[].segment[]" in _d[1]),
        ("a path whose value SHAPE changed is reported, not just new paths",
         "user.id" in _d[2]),
        # The sign is the finding: an identity graph arriving must not render as loss.
        ("an empty array that FILLS is reported as filled, never as a path that vanished",
         _d[3] == ["user.eids[]"] and "user.eids[]" not in _d[0]),
        ("a host seen in only one arm yields no diff, never a whole-host `arrived`",
         arm_diff(_arms["cold"], _arms["warm"], "only-warm.example") is None),
    ]

    # PRESENT-AND-EMPTY. The state a bucket count hides, and the one that carries the finding.
    _sl = census([
        # sape's real shape: an eids-style graph, asked for on every request, empty on this
        # browser — except once.
        {"kind": "request", "host": "sl.example", "load_id": "L1",
         "req_body": '{"places":[{"sapeFpUids":[],"solta_stable":"","targetRef":"p"}]}'},
        {"kind": "request", "host": "sl.example", "load_id": "L2",
         "req_body": '{"places":[{"sapeFpUids":[],"solta_stable":"","targetRef":"p"}]}'},
        {"kind": "request", "host": "sl.example", "load_id": "L3",
         "req_body": '{"places":[{"sapeFpUids":[{"source":"s","id":"x"}],'
                     '"solta_stable":"","targetRef":"p"}]}'},
    ])["sl.example"]
    _emp, _fil = slots(_sl)
    checks += [
        # The vendor prefix is the only distinguishing part of the name: its leaves are `id`
        # and `source`, the two most generic words in the schema, so an exact-name set scored
        # this identity graph as nothing.
        ("an eids-shaped graph under a vendor prefix is identity",
         bucket("places[].sapeFpUids[].id") == "identity"
         and bucket("places[].sapeFpUids[]") == "identity"),
        ("a field that was EVER non-empty counts as filled",
         "places[].sapeFpUids[].id" in _fil),
        # The distinction: asked for on every request, never answered.
        ("a field present on every request and always empty is reported as an EMPTY SLOT",
         "places[].solta_stable" in _emp),
        ("an empty slot is not counted as filled",
         "places[].solta_stable" not in _fil),
        # And the boundary: a placement id is not a slot for a person.
        ("a non-audience field is not a slot at all",
         "places[].targetRef" not in _emp + _fil),
    ]

    # THE CANDIDATE VERDICT IS READ, NEVER RE-DECIDED. Three states, because a row that
    # predates the field is not a row that says "not an exchange".
    _cc = census([
        {"kind": "request", "host": "bid.example", "load_id": "L1",
         "is_bid_candidate": True, "bidder": "adriver", "req_body": '{"imp":[]}'},
        {"kind": "request", "host": "px.example", "load_id": "L1",
         "is_bid_candidate": False, "req_body": '{"evt":"pv"}'},
        {"kind": "request", "host": "old.example", "load_id": "L1", "req_body": '{"a":1}'},
    ])
    checks += [
        ("a candidate request is counted as one, and its bidder kept",
         _cc["bid.example"]["n_candidate"] == 1
         and _cc["bid.example"]["bidders"] == {"adriver"}),
        ("a request the capture tool called NOT a candidate is not counted as one",
         _cc["px.example"]["n_candidate"] == 0
         and _cc["px.example"]["n_noncandidate"] == 1),
        # The distinction that stops a schema-blind ledger reading as a market with no
        # exchanges in it.
        ("a row with no verdict is UNCLASSIFIED, never 'not an exchange'",
         _cc["old.example"]["n_unclassified"] == 1
         and _cc["old.example"]["n_noncandidate"] == 0),
    ]

    # IDENTIFIER STABILITY. The sharpest test the README's thesis has, and shapes are blind
    # to it: one uuid on every load and a fresh uuid each load are the same shape.
    _st = [{"kind": "request", "arm": "cold", "host": "s.example", "load_id": "L%d" % i,
            "req_body": json.dumps({"uid": "cold-%d" % i, "pin": "same"})}
           for i in range(5)]
    _st += [{"kind": "request", "arm": "warm", "host": "s.example", "load_id": "W%d" % i,
             "req_body": json.dumps({"uid": "stable", "pin": "same"})} for i in range(5)]
    _sa = by_arm(_st)
    _sd = arm_diff(_sa["cold"], _sa["warm"], "s.example", 1)
    checks += [
        ("a field with a fresh value every load is counted as 5 distinct over 5 loads",
         _sd[5].get("uid", ())[:2] == (5, 5)),
        ("the same field stable across the warmed arm is 1 distinct over 5 loads",
         _sd[5].get("uid", ())[2:4] == (1, 5)),
        # Shapes would have called these two identical, which is the whole point.
        ("shapes alone cannot see it — the shape did not change",
         "uid" not in _sd[2]),
        ("a field identical in both arms raises no stability line",
         "pin" not in _sd[5]),
        # The values themselves must never be reachable from the census.
        ("stability is counted from one-way tags, so no value is retained",
         all(isinstance(v, bytes) and len(v) == 8
             for v in _sa["cold"]["s.example"]["paths"]["uid"]["vals"])),
    ]

    # SATURATION. A path with more distinct values than the cap has AT LEAST that many;
    # reporting the cap as the count would turn "thousands" into a number that looks measured.
    _sat_rows = [{"kind": "request", "arm": "cold", "host": "sat.example",
                  "load_id": "L%d" % i, "req_body": json.dumps({"u": "v%d" % i})}
                 for i in range(VAL_CAP + 10)]
    _satc = census(_sat_rows)["sat.example"]["paths"]["u"]
    checks += [
        ("a path past the distinct-value cap is MARKED saturated, not silently truncated",
         _satc["vals_saturated"] is True and len(_satc["vals"]) == VAL_CAP),
    ]

    # THE PAGE-VARIANCE FLOOR. Two arms load the same sites and a page is not the same page
    # twice; without a floor, one video that happened to start under one arm reports thirty
    # "fields the warmed profile caused".
    _v = [{"kind": "request", "arm": "cold", "host": "v.example", "load_id": "L%d" % i,
           "req_body": '{"user":{"id":"a"}}'} for i in range(6)]
    _v += [{"kind": "request", "arm": "warm", "host": "v.example", "load_id": "W%d" % i,
            "req_body": '{"user":{"id":"a"},"steady":1}'} for i in range(6)]
    # One warmed load, and one only, sees a field. That is page variance, not a treatment.
    _v.append({"kind": "request", "arm": "warm", "host": "v.example", "load_id": "W9",
               "req_body": '{"user":{"id":"a"},"oneoff":1}'})
    _va = by_arm(_v)
    _lo = arm_diff(_va["cold"], _va["warm"], "v.example", 1)
    _hi = arm_diff(_va["cold"], _va["warm"], "v.example", 3)
    checks += [
        ("with no floor, a one-load difference is reported",
         "oneoff" in _lo[1] and "steady" in _lo[1]),
        ("with a floor of 3 loads, the one-load difference is dropped",
         "oneoff" not in _hi[1] and "steady" in _hi[1]),
        # The count is on the row so the reader can apply their own floor, not just mine.
        ("every reported path carries its per-arm LOAD count",
         _lo[4]["steady"] == (0, 6) and _lo[4]["oneoff"] == (0, 1)),
        # A field on twenty requests of one page is not a field on twenty pages.
        ("the unit is the load, not the request",
         arm_diff(by_arm([
             {"kind": "request", "arm": "cold", "host": "r.example", "load_id": "L1",
              "req_body": '{"a":1}'},
             {"kind": "request", "arm": "warm", "host": "r.example", "load_id": "W1",
              "req_body": '{"a":1,"b":2}'},
             {"kind": "request", "arm": "warm", "host": "r.example", "load_id": "W1",
              "req_body": '{"a":1,"b":2}'},
             {"kind": "request", "arm": "warm", "host": "r.example", "load_id": "W1",
              "req_body": '{"a":1,"b":2}'}])["cold"],
             by_arm([
             {"kind": "request", "arm": "cold", "host": "r.example", "load_id": "L1",
              "req_body": '{"a":1}'},
             {"kind": "request", "arm": "warm", "host": "r.example", "load_id": "W1",
              "req_body": '{"a":1,"b":2}'},
             {"kind": "request", "arm": "warm", "host": "r.example", "load_id": "W1",
              "req_body": '{"a":1,"b":2}'},
             {"kind": "request", "arm": "warm", "host": "r.example", "load_id": "W1",
              "req_body": '{"a":1,"b":2}'}])["warm"],
             "r.example", 2)[1] == []),
    ]

    # --- --decode: one layer inside an opaque value ------------------------------------
    import base64 as _b64
    _payload = _b64.b64encode(
        b'[{"bidderName":"betweendigital","user":{"buyeruid":"REAL-PERSON"}}]').decode()
    _num = _b64.b64encode(b"1787239337664887042").decode()
    globals()["DECODE"] = False
    _off = flatten({"bids": _payload})
    globals()["DECODE"] = True
    _on = flatten({"bids": _payload, "duid": _num, "grab": "x" * 40})
    globals()["DECODE"] = False
    checks += [
        ("decoding is OFF by default — a census is a plain reading unless asked",
         DECODE_DEFAULT is False),
        ("with decoding off an opaque value stays opaque",
         list(_off) == ["bids"]
         and any(x.startswith("opaque:") for x in _off["bids"]["shapes"])),
        ("with --decode the layer inside is censused",
         "bids~b64[].bidderName" in _on),
        # The mark is the point: a field only a base64 round-trip revealed is not a field the
        # exchange sent in the clear, and an unmarked merge would state the stronger claim.
        ("a decoded path is MARKED `~b64`, never merged into the parent",
         all(k.startswith("bids~b64") for k in _on if k.startswith("bids") and k != "bids")),
        ("the decoded value is still reported as a shape",
         _on["bids~b64[].user.buyeruid"]["shapes"] == {"str:11"}),
        ("no decoded value leaks into the output",
         "REAL-PERSON" not in json.dumps(
             {k: sorted(v["shapes"]) for k, v in _on.items()})),
        # base64 of a decimal is a decode, not a failure — a 19-digit id minted from a clock
        # is a finding about what kind of identifier it is.
        ("base64 of a decimal opens, and its length is on the row",
         _on["duid~b64._decimal"]["shapes"] == {"digits:19"}),
        # AND THE REFUSAL: a value that does not open stays opaque and says so.
        # THE REFUSAL, asserted on `unwrap` itself: a mutant that turned a failed decode into
        # `{}` left the path census unchanged (an empty dict contributes no paths), so the
        # path-level check below passes either way and is not the gate. This one is.
        ("an undecodable value returns None from unwrap, never an empty structure",
         unwrap("x" * 40) is None and unwrap(_b64.b64encode(b"\x00\x01\x02" * 20).decode())
         is None),
        ("and it stays opaque in the census, with no phantom child path",
         [k for k in _on if k.startswith("grab")] == ["grab"]),
    ]

    for name, good in checks:
        print(("ok   " if good else "FAIL ") + name)
        ok = ok and good
    print("--test:", "ok" if ok else "FAILED")
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
