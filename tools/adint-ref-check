#!/usr/bin/env python3
"""adint-ref-check — a gate on the reference tables, and on the hole between them.

    tools/adint-ref-check [--ref ref/exchange-domains.tsv] [--sigs ref/sdk-signatures.tsv]
                          [--candidates data/bundle-sdk-candidates.tsv]
                          [--unresolved data/unresolved-hosts.tsv] [--min-obs N]

Four classes of check, in rising order of what they catch:

1. STRUCTURE — the file loads under the same loader the pipeline uses, no duplicate
   patterns, no empty source, no pattern written as a wildcard or a URL. A malformed row
   here does not crash anything; it silently stops matching, which is worse.

2. CONTRADICTION — `external_seat=yes` while `rtb_exchange=no` says an outsider can buy on
   an exchange that is not there. `role=exchange` with `rtb_exchange=no` says the same thing
   twice over. These cannot both be true and one of them is feeding the decision.

3. COVERAGE — the hole BETWEEN the two halves of Step 0. An org whose SDK ships on his phone
   but which has no domain row can never be named when its traffic shows up: the observation
   lands in `unresolved-hosts.tsv` and the org reads as absent from the bundle table. That is
   a false negative in the exact direction this project must not produce, so it is reported
   as a named gap, per org, not as a count.

4. THE WIRE (`--unresolved`) — the same hole read from the other end. Check 3 can only ask
   about an org whose SDK is IN a DEX; a host reached by an obfuscated app, by a preinstalled
   system app, or by an SDK we never inventoried is invisible to it. The first real capture
   proved this is not hypothetical: Moloco's DSP host, Baidu MediaGo, Xiaomi's own ad estate
   and a ByteDance host under the MIUI ad service all arrived on the wire while the
   87-row SDK-constant reference could name none of them. So the two legs have OPPOSITE
   blind spots and both are run: check 3 asks *what could talk and can never be named*,
   check 4 asks *what DID talk and was not named*.

   Two things this leg must not be read as saying:

   * An unnamed host is a LEAD, never a defect. Most of them are first-party API traffic and
     will never belong in an exchange table. It is reported, ranked by observations, and
     never turned into an error.
   * It is silent about the largest gap of all. `unresolved-hosts.tsv` only holds rows that
     HAD a hostname; connections whose DNS was already cached carry no name at all (354 of
     1348 rows — 26% — in the 2026-08-15 capture) and are unnameable by any table. The leg
     says so out loud, because "12 hosts unnamed" otherwise reads as the whole of what the
     capture failed to identify.

   The matcher is IMPORTED from `adint-aggregate`, never re-implemented here: a second
   suffix-matcher would drift, and a gate that resolves hosts differently from the pipeline
   it guards reports gaps the pipeline does not have — and misses the ones it does.

Exit codes: 0 clean · 1 structural error or contradiction · 0 with warnings for coverage
gaps (a gap is a lead, not a defect — an SDK in a DEX need not ever talk).
"""

import argparse
import importlib.util
import os
import sys
from collections import Counter, defaultdict

HERE = os.path.dirname(os.path.abspath(__file__))
ROOT = os.path.dirname(HERE)

REF_COLUMNS = ["domain_pattern", "org", "role", "rtb_exchange", "external_seat",
               "confidence", "source"]
YESNO = {"yes", "no", "unknown"}


def read_tsv(path, columns):
    rows = []
    with open(path, encoding="utf-8") as fh:
        header = None
        for lineno, line in enumerate(fh, start=1):
            line = line.rstrip("\n")
            if not line.strip() or line.lstrip().startswith("#"):
                continue
            parts = line.split("\t")
            if header is None:
                header = parts
                if header[:len(columns)] != columns:
                    raise ValueError("%s: header is %r, expected %r" % (path, header, columns))
                continue
            rows.append((lineno, parts))
    if header is None:
        raise ValueError("%s: no header" % path)
    return header, rows


def check_ref(path):
    errors, warnings = [], []
    header, rows = read_tsv(path, REF_COLUMNS)
    n = len(header)
    seen = Counter()
    for lineno, parts in rows:
        pat = parts[0].strip()
        if len(parts) != n:
            errors.append("%s:%d has %d fields, header has %d" % (path, lineno, len(parts), n))
            continue
        seen[pat] += 1
        if not pat:
            errors.append("%s:%d empty domain_pattern" % (path, lineno))
        if pat.startswith(".") or "*" in pat or "/" in pat or " " in pat:
            errors.append("%s:%d pattern %r is not a bare suffix (no dots-leading, wildcards, "
                          "slashes or spaces — the matcher does suffix comparison)"
                          % (path, lineno, pat))
        rtb, seat = parts[3].strip(), parts[4].strip()
        if rtb not in YESNO:
            errors.append("%s:%d rtb_exchange=%r not in yes/no/unknown" % (path, lineno, rtb))
        if seat not in YESNO:
            errors.append("%s:%d external_seat=%r not in yes/no/unknown" % (path, lineno, seat))
        if seat == "yes" and rtb == "no":
            errors.append("%s:%d %s: external_seat=yes while rtb_exchange=no — an outsider "
                          "cannot buy on an exchange that is not there" % (path, lineno, pat))
        if parts[2].strip() == "exchange" and rtb == "no":
            errors.append("%s:%d %s: role=exchange while rtb_exchange=no" % (path, lineno, pat))
        if not parts[6].strip():
            errors.append("%s:%d %s: empty source — an unsourced row is a guess wearing a "
                          "table's clothes" % (path, lineno, pat))
    for pat, cnt in seen.items():
        if cnt > 1:
            errors.append("%s: duplicate pattern %r (%d rows) — longest-suffix picks one "
                          "arbitrarily" % (path, pat, cnt))
    # a shorter pattern that is a suffix of a longer one is legal and useful, but if the two
    # name DIFFERENT orgs the specific one must exist for the right reason: report it.
    pats = sorted(seen, key=len)
    orgs = {p.strip(): r[1].strip() for _, r in rows for p in [r[0]] if len(r) == n}
    for long_ in pats:
        for short in pats:
            if short != long_ and long_.endswith("." + short) and orgs.get(long_) != orgs.get(short):
                warnings.append("%s: %r (%s) is shadowed by the shorter %r (%s) for any host "
                                "that does not match it exactly — verify the specific row wins "
                                "where it should" % (path, long_, orgs.get(long_), short,
                                                     orgs.get(short)))
    return errors, warnings, len(rows)


def norm_org(name):
    """Canonical form for comparing an org across the two tables.

    They are written by different hands: the signature table says `DigitalTurbine`, the
    domain table says `Digital Turbine (Fyber/Inneractive)`. Compared raw, that pair reads
    as a coverage gap on the org with the third-most DEX hits on his phone -- a fabricated
    hole, and the loudest kind of false positive a gate can produce."""
    return "".join(ch for ch in name.lower() if ch.isalnum())


def check_coverage(ref_path, candidates_path):
    """Orgs whose SDK ships on the device but which no domain row can ever name."""
    if not os.path.exists(candidates_path):
        return [], 0
    ref_orgs = set()
    _, rows = read_tsv(ref_path, REF_COLUMNS)
    for _, parts in rows:
        ref_orgs.add(norm_org(parts[1]))

    dev_orgs = defaultdict(int)
    dev_families = defaultdict(set)
    with open(candidates_path, encoding="utf-8") as fh:
        for line in fh:
            if line.startswith("#") or line.startswith("bundle\t"):
                continue
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 7 or parts[6] != "yes":
                continue
            dev_orgs[parts[1].strip()] += int(parts[4] or 0)
            for sdk in parts[3].split(","):
                if sdk.strip():
                    dev_families[parts[1].strip()].add(sdk.strip())

    gaps = []
    for org, hits in sorted(dev_orgs.items(), key=lambda kv: -kv[1]):
        o = norm_org(org)
        if not any(o in r or r in o for r in ref_orgs):
            gaps.append("%s (%d dex hits on the device, no domain row — its traffic can only "
                        "land in unresolved-hosts.tsv)" % (org, hits))

    # The coverage check above is ORG-level, and an org can own several SDK families with
    # entirely separate domain families. One row for one family then reads as coverage for
    # all of them: the gate reports no gap while the other family's traffic still lands in
    # unresolved-hosts.tsv. (Live example: DigitalTurbine owns both Fyber and AdColony; the
    # table names inner-active/fyber hosts and no adcolony host at all.) Not a defect in the
    # table -- a limit of what an org-level check can assert, so it is said out loud.
    coarse = []
    for org, fams in sorted(dev_families.items()):
        o = norm_org(org)
        covered = any(o in r or r in o for r in ref_orgs)
        if covered and len(fams) > 1:
            coarse.append("%s is covered ORG-level while the device carries %d SDK "
                          "families under it (%s) — a domain row for one family reads as "
                          "coverage for all" % (org, len(fams), ", ".join(sorted(fams))))
    return gaps, len(dev_orgs), coarse


def _aggregate_matcher():
    """Import load_ref/resolve from adint-aggregate — one matcher for gate and pipeline.

    The sibling has no .py suffix (it is a command, not a module), so it is loaded by path.
    If it cannot be loaded the wire leg must NOT quietly fall back to a local copy of the
    matching rule: that is how a gate starts asserting something the pipeline does not do."""
    path = os.path.join(HERE, "adint-aggregate")
    spec = importlib.util.spec_from_loader(
        "adint_aggregate", importlib.machinery.SourceFileLoader("adint_aggregate", path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod.load_ref, mod.resolve


def check_wire(ref_path, unresolved_path, min_obs):
    """Hosts the WIRE produced that no ref row can name.

    Returns (leads, stats). `leads` is [(host, observations, packages)] over the threshold,
    most-observed first. Never an error: an unnamed host is usually first-party traffic."""
    if not os.path.exists(unresolved_path):
        return [], None
    load_ref, resolve = _aggregate_matcher()
    table = load_ref(ref_path)

    leads, total_hosts, total_obs, named_now = [], 0, 0, 0
    with open(unresolved_path, encoding="utf-8") as fh:
        for line in fh:
            line = line.rstrip("\n")
            if not line.strip() or line.startswith("#") or line.startswith("hostname\t"):
                continue
            parts = line.split("\t")
            if len(parts) < 2:
                continue
            host = parts[0].strip()
            try:
                obs = int(parts[1])
            except ValueError:
                continue
            pkgs = parts[2].strip() if len(parts) > 2 else "?"
            total_hosts += 1
            total_obs += obs
            # A host listed as unresolved that the CURRENT table resolves is not a lead —
            # it is the artifact being older than the reference. Counted, not reported.
            if resolve(host, table) is not None:
                named_now += 1
                continue
            if obs >= min_obs:
                leads.append((host, obs, pkgs))
    leads.sort(key=lambda t: (-t[1], t[0]))
    return leads, {"hosts": total_hosts, "obs": total_obs, "named_since": named_now}


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--ref", default=os.path.join(ROOT, "ref", "exchange-domains.tsv"))
    ap.add_argument("--candidates", default=os.path.join(ROOT, "data", "bundle-sdk-candidates.tsv"))
    ap.add_argument("--unresolved", default=os.path.join(ROOT, "data", "unresolved-hosts.tsv"))
    ap.add_argument("--min-obs", type=int, default=2,
                    help="report an unnamed host only from this many observations (default 2)")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()

    if args.test:
        return selftest()

    try:
        errors, warnings, nrows = check_ref(args.ref)
    except (ValueError, FileNotFoundError) as e:
        print("adint-ref-check: %s" % e, file=sys.stderr)
        return 1

    gaps, norgs, coarse = check_coverage(args.ref, args.candidates)

    print("%s: %d rows" % (args.ref, nrows))
    for w in warnings + coarse:
        print("  warn  %s" % w)
    for e in errors:
        print("  ERROR %s" % e)
    if gaps:
        print("  coverage gaps (%d demand-side orgs on the device, %d unnameable):"
              % (norgs, len(gaps)))
        for g in gaps:
            print("    gap %s" % g)
    elif norgs:
        print("  coverage: every demand-side org on the device has at least one domain row (%d orgs)"
              % norgs)

    leads, wstats = check_wire(args.ref, args.unresolved, args.min_obs)
    if wstats is None:
        print("  wire: no %s — the wire leg did not run (this is not a pass)"
              % os.path.relpath(args.unresolved, ROOT))
    else:
        print("  wire: %d hosts / %d observations in %s; %d now named by the table"
              % (wstats["hosts"], wstats["obs"], os.path.relpath(args.unresolved, ROOT),
                 wstats["named_since"]))
        for host, obs, pkgs in leads:
            print("    lead %-52s %4d obs  %s pkg" % (host, obs, pkgs))
        if leads:
            print("    (leads, not defects — most unnamed hosts are first-party API traffic)")
        print("    NOTE this leg sees only rows that HAD a hostname; connections whose DNS was "
              "already cached carry no name and are unnameable by any table.")

    print("%d errors, %d warnings, %d coverage gaps, %d wire leads"
          % (len(errors), len(warnings) + len(coarse), len(gaps), len(leads)))
    return 1 if errors else 0


# ---------------------------------------------------------------- self-test

def selftest():
    import tempfile
    fails = []

    def check(name, cond, detail=""):
        if cond:
            print("  ok   %s" % name)
        else:
            print("  FAIL %s %s" % (name, detail))
            fails.append(name)

    hdr = "\t".join(REF_COLUMNS)
    good = "\t".join(["example.com", "Ex", "exchange", "yes", "yes", "high", "http://src"])

    with tempfile.TemporaryDirectory() as td:
        def write(name, body):
            p = os.path.join(td, name)
            with open(p, "w", encoding="utf-8") as fh:
                fh.write(body)
            return p

        p = write("ok.tsv", hdr + "\n" + good + "\n")
        e, w, n = check_ref(p)
        check("a clean table passes", not e and n == 1, (e, n))

        p = write("dup.tsv", hdr + "\n" + good + "\n" + good + "\n")
        e, _, _ = check_ref(p)
        check("duplicate pattern is an error", any("duplicate" in x for x in e), e)

        p = write("contra.tsv", hdr + "\n" +
                  "\t".join(["a.com", "Ex", "ssp", "no", "yes", "low", "s"]) + "\n")
        e, _, _ = check_ref(p)
        check("seat=yes with rtb=no is an error",
              any("external_seat=yes while" in x for x in e), e)

        p = write("contra2.tsv", hdr + "\n" +
                  "\t".join(["a.com", "Ex", "exchange", "no", "no", "low", "s"]) + "\n")
        e, _, _ = check_ref(p)
        check("role=exchange with rtb=no is an error",
              any("role=exchange while" in x for x in e), e)

        p = write("nosrc.tsv", hdr + "\n" +
                  "\t".join(["a.com", "Ex", "exchange", "yes", "no", "low", ""]) + "\n")
        e, _, _ = check_ref(p)
        check("unsourced row is an error", any("empty source" in x for x in e), e)

        p = write("wild.tsv", hdr + "\n" +
                  "\t".join(["*.a.com", "Ex", "exchange", "yes", "no", "low", "s"]) + "\n")
        e, _, _ = check_ref(p)
        check("wildcard pattern is an error", any("not a bare suffix" in x for x in e), e)

        p = write("enum.tsv", hdr + "\n" +
                  "\t".join(["a.com", "Ex", "exchange", "true", "no", "low", "s"]) + "\n")
        e, _, _ = check_ref(p)
        check("non-enum rtb_exchange is an error", any("not in yes/no/unknown" in x for x in e), e)

        p = write("shadow.tsv", hdr + "\n" + good + "\n" +
                  "\t".join(["ads.example.com", "Other", "ssp", "yes", "no", "low", "s"]) + "\n")
        _, w, _ = check_ref(p)
        check("cross-org suffix shadowing warns", any("shadowed by the shorter" in x for x in w), w)

        # coverage: an org on the device with no domain row must be NAMED, not counted
        refp = write("cov-ref.tsv", hdr + "\n" + good + "\n")
        candp = write("cands.tsv", "\t".join(
            ["bundle", "org", "role", "sdks", "signature_hits", "distinct_signatures",
             "demand_side"]) + "\n" +
            "com.a\tEx\texchange\tX\t100\t1\tyes\n" +
            "com.b\tGhostOrg\texchange\tY\t4242\t1\tyes\n" +
            "com.c\tAppsFlyer\tattribution\tZ\t900\t1\tno\n")
        gaps, norgs, coarse = check_coverage(refp, candp)
        check("known org is not a gap", not any("Ex (" in g for g in gaps), gaps)
        check("unnameable org is named", any("GhostOrg" in g for g in gaps), gaps)
        check("gap carries its weight", any("4242" in g for g in gaps), gaps)
        check("non-demand org is not a gap", not any("AppsFlyer" in g for g in gaps), gaps)
        check("org count counts demand side only", norgs == 2, norgs)

        # the two tables are written by different hands and spell orgs differently
        refp2 = write("cov-ref2.tsv", hdr + "\n" + "\t".join(
            ["dt.example", "Digital Turbine (Fyber/Inneractive)", "exchange", "yes", "yes",
             "high", "s"]) + "\n")
        candp2 = write("cands2.tsv", "\t".join(
            ["bundle", "org", "role", "sdks", "signature_hits", "distinct_signatures",
             "demand_side"]) + "\n" + "com.a\tDigitalTurbine\texchange\tX\t1894\t1\tyes\n")
        gaps2, _, _ = check_coverage(refp2, candp2)
        check("org spelling differences do not fabricate a gap", not gaps2, gaps2)

        # an org owning several SDK families is covered only coarsely — say so
        candp3 = write("cands3.tsv", "\t".join(
            ["bundle", "org", "role", "sdks", "signature_hits", "distinct_signatures",
             "demand_side"]) + "\n" +
            "com.a\tDigital Turbine (Fyber/Inneractive)\texchange\tFyber\t900\t1\tyes\n" +
            "com.b\tDigital Turbine (Fyber/Inneractive)\texchange\tAdColony\t400\t1\tyes\n")
        _, _, coarse3 = check_coverage(refp2, candp3)
        check("multi-family org warns that coverage is coarse",
              any("AdColony" in c and "ORG-level" in c for c in coarse3), coarse3)
        _, _, coarse4 = check_coverage(refp2, candp2)
        check("single-family org does not warn", not coarse4, coarse4)

        # ---- the wire leg: what DID talk and was not named ----
        wref = write("wire-ref.tsv", hdr + "\n" + "\t".join(
            ["known.com", "Known", "exchange", "yes", "yes", "high", "s"]) + "\n")
        unres = write("unresolved.tsv",
                      "hostname\tobservations\tdistinct_packages\n"
                      "sdkapi.dsp-api.ghost.com\t9\t2\n"      # unnamed, above threshold
                      "api.known.com\t7\t1\n"                 # the table names it now
                      "one-off.ghost.com\t1\t1\n")            # unnamed, below threshold
        leads, st = check_wire(wref, unres, 2)
        check("an unnamed wire host is a lead",
              any(h == "sdkapi.dsp-api.ghost.com" for h, _, _ in leads), leads)
        check("a host the table NOW names is not a lead",
              not any(h == "api.known.com" for h, _, _ in leads), leads)
        check("suffix match comes from the pipeline's matcher, not a local copy",
              st["named_since"] == 1, st)
        check("min-obs suppresses the long tail",
              not any(h == "one-off.ghost.com" for h, _, _ in leads), leads)
        leads1, _ = check_wire(wref, unres, 1)
        check("min-obs=1 keeps the long tail",
              any(h == "one-off.ghost.com" for h, _, _ in leads1), leads1)
        check("wire stats count every row, lead or not", st["hosts"] == 3 and st["obs"] == 17, st)
        # a MISSING artifact must be distinguishable from a clean one — a wire leg that
        # silently returns [] when the capture was never imported reads as "nothing unnamed".
        _, st_missing = check_wire(wref, os.path.join(td, "no-such.tsv"), 2)
        check("a missing unresolved file is not a pass", st_missing is None, st_missing)

    print("selftest: %d checks failed" % len(fails))
    return 1 if fails else 0


if __name__ == "__main__":
    sys.exit(main())
