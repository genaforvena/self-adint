#!/usr/bin/env python3
"""adint-hb-capture — read the auction off the WIRE, because on this market it is not in a JS API.

    tools/adint-hb-capture <url> [--settle 8] [--run-idx N] [--arm A] [--test]

Step 0 established that runet display is Adfox header bidding, not prebid: `Ya` on every
observable site, `YaHeaderBiddingSettings` on 16 of 22, and prebid's own global present on
three sites and empty every time (docs/step0-prebid-vantage-2026-08-16.md). So
`pbjs.getBidResponses()` — the vantage the study was designed around — does not exist here.
What does exist is the traffic: the wrapper issues one request per bidder and takes back a
response, and the columns the design requires live in those two documents.

What is recorded, and why each is its OWN column
------------------------------------------------
  price      taken from the RESPONSE at its raw path (OpenRTB `seatbid[].bid[].price`), with
             the currency the response itself declares. Never a wrapper-adjusted number: the
             design says originalCpm/originalCurrency and never `cpm`/`hb_pb`, because a
             bidCpmAdjustment and an FX conversion smear a discrete price list into a
             continuous one — which is precisely the shape the study is trying to read. The
             fixture serves a decoy adjusted field beside the real one and a mutant that
             reads it goes red.
  floor      taken from the REQUEST (`imp[].bidfloor` + `bidfloorcur`). Without it an atom at
             the floor is indistinguishable from a flat price, and under a dynamic floor a
             floor-follower reads as a live valuation — the taxonomy inverts.
  outcome    priced / no-bid / no-answer / error, kept apart. A bidder that was asked and
             said nothing is NOT a bidder that answered "no bid": folding them makes
             selectivity a measurement of our own latency. `no-answer` is deliberately not
             called `timeout`: it means no response arrived inside OUR observation window,
             which is a claim about this capture, not about the wrapper's own deadline. The
             wrapper's deadline is recorded separately (`wrapper_timeout_ms`) and a row whose
             window was shorter than that deadline says so (`window_shorter_than_wrapper`),
             because such a row cannot distinguish a slow bidder from a dropped one.
  attribution  a request is attributed to a bidder only by evidence: a host match in
             ref/exchange-domains.tsv, or a roster name occurring in the URL. Everything else
             is `null` with `match_by: none`. A guessed attribution is worse than no
             attribution — it puts a price under the wrong bidder's distribution.
  contamination  run index, arm, page-load id, wall hour, egress IP, and the context's age
             (always 0 here: a fresh profile per load, so cookie-age never silently becomes a
             covariate). Clustering is at the PAGE LOAD, so every row carries `load_id`.

Output is append-only JSONL: one row per candidate request, plus one `kind: "load"` row per
page load carrying the vantage and the wrapper config. Nothing is aggregated here — the count
is a separate step over the log, on purpose.
"""

import argparse
import json
import os
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
OUT = os.path.join(REPO, "data", "hb-auction.jsonl")
DOMAINS = os.path.join(REPO, "ref", "exchange-domains.tsv")

BODY_CAP = 400_000          # a response body larger than this is recorded by size, not stored
ROW_CAP = 600               # per page load; an exceeded cap is REPORTED, never silent

# The wrapper's own roster and deadline, read once after settle. Same object step 0 counted.
WRAPPER_JS = r"""
() => {
  const out = {wrapper_timeout_ms: null, roster: [], placements: {}, adfox: false, pbjs: false};
  try { out.adfox = typeof window.Ya !== 'undefined'; } catch (e) {}
  try { out.pbjs = Array.isArray(window._pbjsGlobals) && window._pbjsGlobals.length > 0; } catch (e) {}
  try {
    const s = window.YaHeaderBiddingSettings;
    if (s && typeof s === 'object') {
      out.wrapper_timeout_ms = typeof s.timeout === 'number' ? s.timeout : null;
      const names = {};
      for (const n of Object.keys(s.biddersMap || {})) names[String(n).toLowerCase()] = 1;
      for (const u of (Array.isArray(s.adUnits) ? s.adUnits : [])) {
        for (const b of ((u && u.bids) || [])) {
          if (!b || !b.bidder) continue;
          const name = String(b.bidder).toLowerCase();
          names[name] = 1;
          // placementId -> bidder. This is the ONE attribution that is exact on this market:
          // each wrapper endpoint is a single bidder, and the id it is asked with is written
          // in the publisher's own config. Measured on lenta.ru — 41139 -> mediasniper hit
          // hb.bumlam.com, 69eb5feb… -> astralab hit ssp.al-adtech.com.
          const pid = b.params && b.params.placementId;
          if (pid !== undefined && pid !== null) out.placements[String(pid)] = name;
        }
      }
      out.roster = Object.keys(names).sort();
    }
  } catch (e) {}
  return out;
}
"""


def load_domain_table(path=DOMAINS):
    """domain_pattern -> org. Attribution evidence, not a guess."""
    table = []
    try:
        with open(path) as fh:
            for i, line in enumerate(fh):
                if i == 0 or not line.strip() or line.startswith("#"):
                    continue
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 2 and parts[0]:
                    table.append((parts[0].lower(), parts[1]))
    except FileNotFoundError:
        pass
    # Longest pattern first: `googleads.g.doubleclick.net` must win over `doubleclick.net`.
    table.sort(key=lambda t: -len(t[0]))
    return table


def attribute(url, host, roster, table, placement_ids=None, placements=None):
    """Name a bidder only on evidence. `none` is a valid, and often the honest, answer.

    Strongest evidence first: the placement ids the REQUEST was made with, matched against the
    publisher's own `placementId -> bidder` config. On this market each wrapper endpoint is one
    bidder, so a request carrying only that bidder's ids names it exactly — no host list to
    maintain and no substring luck.
    """
    if placement_ids and placements:
        named = {placements[p] for p in placement_ids if p in placements}
        if len(named) == 1:
            return named.pop(), "placement-id"
        if len(named) > 1:
            return None, "ambiguous-placements:" + ",".join(sorted(named))
    for pattern, org in table:
        if host == pattern or host.endswith("." + pattern):
            return org, "host-table:" + pattern
    low = url.lower()
    hits = [b for b in roster if b and len(b) >= 4 and b in low]
    if len(hits) == 1:
        return hits[0], "roster-name-in-url"
    if len(hits) > 1:
        # Two roster names in one URL name nothing; a coin flip here would put a price under
        # the wrong bidder's distribution.
        return None, "ambiguous:" + ",".join(sorted(hits))
    return None, "none"


def _in_bid_container(path):
    """Is this path inside a bid list? `$.seatbid[0].bid[0]` and `$.bids[0]` are; the rest of
    a JSON document is not, whatever its keys are called."""
    low = path.lower()
    return ".seatbid" in low or ".bids" in low or ".bid[" in low or low.endswith(".bid")


def _walk_prices(node, path="$", out=None, depth=0):
    """Find price-bearing nodes by structure, recording the PATH each came from.

    The path is the citation: a number labelled `price` at `$.seatbid[0].bid[0].price` is an
    OpenRTB bid, while a number labelled `cpm` beside it may be anything the wrapper wrote
    after adjustment. The reader downstream must be able to tell them apart, so the field name
    and its location travel with the value.
    """
    if out is None:
        out = []
    if depth > 12 or len(out) >= 50:
        return out
    if isinstance(node, dict):
        for k, v in node.items():
            # A key named `price` is not a price a bidder offered. 3dnews.ru serves
            # /currency.json, where `$.currency.USD.price = 84.54` is the dollar rate — it was
            # classified as a bid, and under evidence grading it would have counted as protocol
            # evidence and put 84.54 into the price column. The container is what makes a
            # number a bid, so a price is only taken from inside a `seatbid`/`bid`/`bids` node.
            if k == "price" and isinstance(v, (int, float)) and _in_bid_container(path):
                out.append({"path": f"{path}.{k}", "field": k, "value": float(v)})
            else:
                _walk_prices(v, f"{path}.{k}", out, depth + 1)
    elif isinstance(node, list):
        for i, v in enumerate(node[:20]):
            _walk_prices(v, f"{path}[{i}]", out, depth + 1)
    return out


def _walk_numbers(node, path="$", out=None, depth=0):
    """Every numeric leaf with its path — the raw material for identifying an unfamiliar
    bidder's price field from a real bid instead of guessing at it."""
    if out is None:
        out = []
    if depth > 8 or len(out) >= 60:
        return out
    if isinstance(node, dict):
        for k, v in node.items():
            if isinstance(v, (int, float)) and not isinstance(v, bool):
                out.append({"path": f"{path}.{k}", "field": k, "value": float(v)})
            else:
                _walk_numbers(v, f"{path}.{k}", out, depth + 1)
    elif isinstance(node, list):
        for i, v in enumerate(node[:20]):
            _walk_numbers(v, f"{path}[{i}]", out, depth + 1)
    return out


def parse_response(body_text):
    """Classify an answer. Returns (outcome, detail).

    `no-bid` here means "answered, and the answer carries no price". It is only a statement
    about a BIDDER once the row is known to be bidder traffic — see `bid_evidence`; a
    pixel that answers 200 is not a bidder declining to bid.
    """
    if body_text is None:
        return "no-bid", {"reason": "empty-body"}
    t = body_text.strip()
    if not t:
        return "no-bid", {"reason": "empty-body"}
    try:
        doc = json.loads(t)
    except Exception:
        return "unparsed", {"reason": "not-json", "bytes": len(t)}
    # The Adfox HB answer, measured: `{"bids":[]}` from both of lenta.ru's bidders. An empty
    # array is a REAL no-bid from a real bidder — it is not the absence of an auction, and it
    # is certainly not silence.
    if isinstance(doc, dict) and isinstance(doc.get("bids"), list):
        if not doc["bids"]:
            return "no-bid", {"reason": "adfox-empty-bids", "has_bids_key": True}
        if not all(isinstance(b, dict) for b in doc["bids"]):
            # Measured: hb.bumlam.com answers {"bids":["INCORRECT_UNPUT"]} (their typo) when it
            # rejects the request. A non-empty array of non-objects is the bidder refusing the
            # protocol, not a bid — as `bid-returned` it would read as demand we do not have.
            return "error", {"reason": "bids-not-objects", "has_bids_key": True,
                             "bids_raw": json.dumps(doc["bids"][:3])[:2000]}
        prices = _walk_prices(doc)
        if prices:
            return "priced", {"prices": prices, "has_bids_key": True,
                              "currency": doc.get("cur") or doc.get("currency"),
                              "bids_raw": json.dumps(doc["bids"][:3])[:2000]}
        # A bid came back and nothing in it is called `price`. The field name is not something
        # to guess: the raw objects and every numeric field found are recorded so the price key
        # can be identified from a real bid rather than assumed from a schema we have not seen.
        return "bid-returned", {"reason": "bids-present-no-price-key", "has_bids_key": True,
                                "numeric_fields": _walk_numbers(doc["bids"][:3]),
                                "bids_raw": json.dumps(doc["bids"][:3])[:2000]}

    prices = _walk_prices(doc)
    cur = None
    has_seatbid = False
    if isinstance(doc, dict):
        cur = doc.get("cur") or doc.get("currency")
        has_seatbid = "seatbid" in doc
    if not prices:
        # An answer with no price IS a no-bid — a distinct fact from never answering.
        return "no-bid", {"reason": "no-price-in-body", "has_seatbid": has_seatbid,
                          "seatbid": len(doc.get("seatbid", [])) if isinstance(doc, dict) else None}
    return "priced", {"prices": prices, "currency": cur, "has_seatbid": has_seatbid}


def request_adfox_places(post_data):
    """The Adfox HB request shape, measured on lenta.ru 2026-08-16:

        {"places":[{"id":"begun_block_…","placementId":"41139","sizes":[[970,250]],
                    "codeType":"combo","targetRef":"https://lenta.ru/"}, …]}

    It is NOT OpenRTB — no `imp`, no `bidfloor` — so a collector that only knows OpenRTB
    records this market's entire auction as uninteresting traffic. Returns the placement ids,
    which are also the attribution key.
    """
    if not post_data:
        return None
    try:
        doc = json.loads(post_data)
    except Exception:
        return None
    if not isinstance(doc, dict) or not isinstance(doc.get("places"), list):
        return None
    ids = []
    for pl in doc["places"][:60]:
        if isinstance(pl, dict) and pl.get("placementId") is not None:
            ids.append(str(pl["placementId"]))
    return {"placement_ids": ids, "places": len(doc["places"])}


def request_is_openrtb(post_data):
    """Does the REQUEST look like a bid request? `imp` is OpenRTB's required inventory array
    and no analytics beacon carries it. This is evidence, not proof, and it is recorded as
    evidence — see `bid_evidence` on each row."""
    if not post_data:
        return False
    try:
        doc = json.loads(post_data)
    except Exception:
        return False
    return isinstance(doc, dict) and isinstance(doc.get("imp"), list)


def parse_request_floor(post_data):
    """The floor as the REQUEST stated it. Absent is `null`, never 0 — a zero floor is a
    claim, and an unstated floor is not that claim."""
    if not post_data:
        return None
    try:
        doc = json.loads(post_data)
    except Exception:
        return None
    floors = []
    for imp in (doc.get("imp") or []) if isinstance(doc, dict) else []:
        if isinstance(imp, dict) and "bidfloor" in imp:
            floors.append({"imp": imp.get("id"), "bidfloor": imp.get("bidfloor"),
                           "bidfloorcur": imp.get("bidfloorcur")})
    return floors or None


def arm_plan(count, arms, offset=0):
    """Which arm each load runs, in load order. Alternating, never blocked: the hour is the
    dominant confounder, so a block design hands whichever hour it ran in to one arm.

    The offset exists because alternation alone is not enough across passes. The url list is
    read in a fixed order, so `i % 2` gives every site the SAME arm on every pass — arm would
    be perfectly confounded with site parity, and a per-site difference would read as an arm
    effect. Shifting the offset by one on the next pass gives each site both arms, so an arm
    effect can be estimated WITHIN a site.
    """
    return [arms[(i + offset) % len(arms)] for i in range(count)]


def arms_need_note(arms, note):
    """More than one arm without a stated treatment is refused — see main()."""
    return len(arms) > 1 and not note


PROXY_VARS = ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY",
              "http_proxy", "https_proxy", "all_proxy")


def _curl_ip(env, timeout=15):
    try:
        r = subprocess.run(["curl", "-s", "--max-time", str(timeout), "https://api.ipify.org"],
                           capture_output=True, text=True, timeout=timeout + 5, env=env)
        return r.stdout.strip() or None
    except Exception:
        return None


def egress_ips(timeout=15):
    """BOTH paths, because this node has two and they land in different countries.

    A shell here inherits HTTP_PROXY/HTTPS_PROXY/ALL_PROXY=http://127.0.0.1:8118 (privoxy,
    forwarding to socks5 127.0.0.1:1080). curl honours those variables and so does Chromium,
    so the first sweeps of this study measured the PROXY's exit and recorded it as the node's:
    38.49.216.141 (Montréal) is privoxy's far end, while the node's own default route leaves
    at 77.246.104.228 (Amsterdam). Measuring one and labelling it "our vantage" is how a
    corpus acquires a geo it never had.
    """
    proxied = _curl_ip(os.environ.copy(), timeout)
    clean = {k: v for k, v in os.environ.items() if k not in PROXY_VARS}
    direct = _curl_ip(clean, timeout)
    return {"egress_ip_proxied": proxied, "egress_ip_direct": direct,
            "proxy_env": os.environ.get("HTTPS_PROXY") or os.environ.get("ALL_PROXY")}


def capture(pw, url, settle, nav_timeout, ip, run_idx, arm, headed=False, arm_note=None,
            use_proxy=True):
    """One page load. Returns (load_row, request_rows)."""
    load_id = uuid.uuid4().hex[:12]
    t_wall = datetime.now(timezone.utc)
    load = {
        # schema 2 added evidence_strength (protocol vs attribution-only) and the
        # `redirect` outcome. schema 3 fixed the price column itself: a schema-2 row
        # could carry a `price` read from any JSON key of that name — a currency
        # widget among them — so its prices are not this column and must not pool.
        # schema 4 records WHICH egress the browser used. Schema<=3 rows carry an
        # `egress_ip` that was measured through the inherited proxy whether or not
        # the browser used it, so their vantage column is not this one.
        "schema": 4, "kind": "load", "load_id": load_id,
        "ts": t_wall.strftime("%Y-%m-%dT%H:%M:%SZ"), "hour_utc": t_wall.hour,
        "url": url, "run_idx": run_idx, "arm": arm, "arm_note": arm_note,
        # `egress_ip` is the address the BROWSER left from, never whichever one was easiest to
        # measure. The other path is recorded beside it so the row is unambiguous on its own.
        "egress_ip": (ip.get("egress_ip_proxied") if use_proxy else ip.get("egress_ip_direct"))
        if isinstance(ip, dict) else ip,
        "browser_used_proxy": use_proxy,
        "egress_ip_proxied": ip.get("egress_ip_proxied") if isinstance(ip, dict) else None,
        "egress_ip_direct": ip.get("egress_ip_direct") if isinstance(ip, dict) else None,
        "proxy_env": ip.get("proxy_env") if isinstance(ip, dict) else None,
        # Fresh context per load: the profile has no history, so cookie age can never become
        # an unrecorded covariate. It is stated rather than assumed.
        "profile_age_s": 0, "window_s": settle,
    }
    rows = []
    seen = {}      # playwright Request -> row
    table = load_domain_table()
    browser = ctx = None
    t0 = time.time()

    def rel():
        return round(time.time() - t0, 3)

    try:
        # --no-proxy-server overrides the inherited env for this browser only; it
        # changes nothing on the node and raises nothing.
        browser = pw.chromium.launch(headless=not headed,
                                     args=[] if use_proxy else ["--no-proxy-server"])
        ctx = browser.new_context(locale="ru-RU", timezone_id="Europe/Moscow",
                                  viewport={"width": 1366, "height": 900})
        page = ctx.new_page()

        def on_request(req):
            try:
                if req.resource_type not in ("xhr", "fetch") and req.method != "POST":
                    return
                if len(seen) >= ROW_CAP:
                    load["rows_capped"] = load.get("rows_capped", 0) + 1
                    return
                from urllib.parse import urlparse
                host = (urlparse(req.url).hostname or "").lower()
                row = {
                    "schema": 4, "kind": "request", "load_id": load_id,
                    "t_request_s": rel(), "method": req.method, "host": host,
                    "url": req.url[:500], "resource_type": req.resource_type,
                    "floor": parse_request_floor(req.post_data),
                    "req_openrtb": request_is_openrtb(req.post_data),
                    "req_adfox": request_adfox_places(req.post_data),
                    "outcome": None, "t_response_s": None, "status": None,
                }
                seen[req] = row
                rows.append(row)
            except Exception as e:
                load.setdefault("handler_errs", []).append(f"req: {type(e).__name__}")

        def on_response(resp):
            try:
                row = seen.get(resp.request)
                if row is None:
                    return
                row["status"] = resp.status
                row["t_response_s"] = rel()
                if resp.status >= 400:
                    row["outcome"] = "error"
                    row["detail"] = {"reason": f"http-{resp.status}"}
                    return
                if 300 <= resp.status < 400:
                    # A cookie-sync hop. It has no body to read, and filing it as `unread`
                    # reads as "we failed to look" — 16 such rows in the first sweep, mostly
                    # sync.dmp.otm-r.com / sync.programmatica.com / mc.acint.net.
                    row["outcome"] = "redirect"
                    row["detail"] = {"reason": f"http-{resp.status}",
                                     "location": (resp.headers or {}).get("location", "")[:200]}
                    return
                if resp.status == 204:
                    row["outcome"] = "no-bid"
                    row["detail"] = {"reason": "http-204"}
                    return
                try:
                    raw = resp.body()
                except Exception as e:
                    row["outcome"] = "unread"
                    row["detail"] = {"reason": f"body-unavailable: {type(e).__name__}"}
                    return
                if len(raw) > BODY_CAP:
                    row["outcome"] = "unread"
                    row["detail"] = {"reason": "body-over-cap", "bytes": len(raw)}
                    return
                try:
                    body = raw.decode("utf-8")
                except UnicodeDecodeError:
                    # Not text at all — a beacon's gif, a font, a compressed blob. Reading it
                    # through `resp.text()` raised, and the first version filed 124 of these
                    # as `unread`, which reads as "we failed to look" when the truth is "this
                    # was never an auction message".
                    row["outcome"] = "binary"
                    row["detail"] = {"reason": "body-not-utf8", "bytes": len(raw)}
                    return
                outcome, detail = parse_response(body)
                row["outcome"] = outcome
                row["detail"] = detail
            except Exception as e:
                load.setdefault("handler_errs", []).append(f"resp: {type(e).__name__}")

        def on_failed(req):
            try:
                row = seen.get(req)
                if row is None:
                    return
                # A request can FAIL AFTER its response already arrived — the wrapper aborts
                # in flight at its deadline, and the browser reports ERR_ABORTED for a socket
                # whose body was never consumed. Overwriting here turns an observed answer
                # into a phantom no-answer: the exact fold the design forbids, running
                # backwards. The abort is recorded; the concluded outcome stands.
                if row.get("outcome") is not None or row.get("status") is not None:
                    row["post_response_abort"] = True
                    row["abort_reason"] = (req.failure or "")[:80]
                    return
                fail = (req.failure or "")[:80]
                # A connection that never happened is not a bidder declining to speak. DNS,
                # TLS and refused connections are OUR network failing, and filing them as
                # silence would hand the study phantom timeouts — on this node's first live
                # capture, six rows failed ERR_CERT_AUTHORITY_INVALID and would have counted
                # as three bidders going quiet.
                net_fault = any(k in fail for k in (
                    "CERT", "NAME_NOT_RESOLVED", "CONNECTION_REFUSED", "CONNECTION_RESET",
                    "CONNECTION_CLOSED", "ADDRESS_UNREACHABLE", "INTERNET_DISCONNECTED",
                    "SSL", "PROXY", "TUNNEL", "UNSAFE_PORT", "BLOCKED_BY_CLIENT"))
                row["outcome"] = "error" if net_fault else "no-answer"
                row["detail"] = {"reason": f"failed: {fail}",
                                 "net_fault": net_fault}
                row["t_response_s"] = rel()
            except Exception:
                pass

        page.on("request", on_request)
        page.on("response", on_response)
        page.on("requestfailed", on_failed)

        resp = page.goto(url, wait_until="domcontentloaded", timeout=nav_timeout * 1000)
        load["http_status"] = resp.status if resp else None
        load["final_url"] = page.url
        if load["http_status"] is not None and load["http_status"] >= 400:
            load["note"] = "page did not render; rows say nothing about the auction"
            return load, rows
        page.wait_for_timeout(settle * 1000)
        try:
            for y in (600, 1600):
                page.evaluate(f"window.scrollTo(0,{y})")
                page.wait_for_timeout(1200)
            page.evaluate("window.scrollTo(0,0)")
            page.wait_for_timeout(settle * 1000)
        except Exception as e:
            load["scroll_err"] = f"{type(e).__name__}"
        try:
            load.update(page.evaluate(WRAPPER_JS))
        except Exception as e:
            load["wrapper_err"] = f"{type(e).__name__}"
    except Exception as e:
        load["error"] = f"{type(e).__name__}: {str(e)[:200]}"
    finally:
        try:
            if ctx:
                ctx.close()
        except Exception:
            pass
        try:
            if browser:
                browser.close()
        except Exception:
            pass

    load["observed_s"] = round(time.time() - t0, 2)
    roster = load.get("roster") or []
    wt = load.get("wrapper_timeout_ms")
    for row in rows:
        if row["outcome"] is None:
            # Asked, and nothing came back before we stopped looking. That is a statement
            # about our window; it is not the wrapper's timeout and is not a no-bid.
            row["outcome"] = "no-answer"
            row["detail"] = {"reason": "no-response-in-window"}
        pids = (row.get("req_adfox") or {}).get("placement_ids")
        row["bidder"], row["match_by"] = attribute(
            row["url"], row["host"], roster, table, pids, load.get("placements") or {})
        # A page fires far more xhr/fetch than it runs bidders: analytics, error beacons,
        # recommendation widgets. The first live capture put 194 rows on disk and 13 of them
        # landed in `no-bid` off metrica and error-reporting endpoints — a pixel that answers
        # 200 is not a bidder declining to bid, and counting it as one poisons exactly the
        # column the study reads. So an outcome is only a statement about a BIDDER when there
        # is evidence the row is bidder traffic, and the evidence is listed rather than
        # collapsed into a boolean somebody has to trust.
        d = row.get("detail") or {}
        evidence = []
        if row.get("req_openrtb"):
            evidence.append("openrtb-request")
        if row.get("req_adfox"):
            evidence.append("adfox-hb-request")
        if d.get("has_bids_key"):
            evidence.append("adfox-hb-response")
        if d.get("has_seatbid"):
            # Never `or outcome == "priced"`: that made the evidence a restatement of the
            # verdict it exists to justify, and the currency ticker above rode in on it.
            evidence.append("openrtb-response")
        if row.get("bidder"):
            evidence.append("attributed:" + str(row.get("match_by")))
        row["bid_evidence"] = evidence
        row["is_bid_candidate"] = bool(evidence)
        # Not all evidence is equal, and the difference decides who counts as ASKED. Protocol
        # evidence means we saw a bid request or a bid response. A name alone means only that
        # a bidder's host was contacted — and a bidder's cookie-sync pixel is contacted on
        # every page whether or not it is ever asked to bid. On fontanka.ru's first capture
        # 52 rows were "named" and a good share of them were sync hops.
        protocol = [e for e in evidence if e in (
            "adfox-hb-request", "adfox-hb-response", "openrtb-request", "openrtb-response")]
        row["evidence_strength"] = ("protocol" if protocol
                                    else ("attribution-only" if evidence else "none"))
        row["wrapper_timeout_ms"] = wt
        # Our window is in seconds, the wrapper's deadline in ms. If ours is the shorter one,
        # a `no-answer` here cannot be distinguished from a bidder the wrapper itself dropped.
        row["window_shorter_than_wrapper"] = bool(
            wt is not None and (load.get("window_s") or 0) * 1000 < wt)
        for k in ("run_idx", "arm", "arm_note", "egress_ip", "browser_used_proxy",
                  "hour_utc", "profile_age_s"):
            row[k] = load.get(k)
    return load, rows


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("urls", nargs="*")
    ap.add_argument("--file")
    ap.add_argument("--settle", type=int, default=8)
    ap.add_argument("--nav-timeout", type=int, default=30)
    ap.add_argument("--run-idx", type=int, default=0)
    ap.add_argument("--arm", default="A", help="contamination column: which interleaved arm")
    ap.add_argument("--arms", help="comma-separated arm labels, alternated PER LOAD (never in "
                                   "blocks: the hour is the dominant confounder)")
    ap.add_argument("--arm-note", help="what the arms actually differ in; REQUIRED with --arms, "
                                       "because a label is not a treatment")
    ap.add_argument("--treatment", choices=["proxy"],
                    help="make the arms a REAL treatment. `proxy` requires --arms proxy,direct "
                         "and runs the browser through the inherited privoxy on one arm and on "
                         "the node's own route on the other")
    ap.add_argument("--arm-offset", type=int, default=0,
                    help="shift the alternation; use 1 on the next pass so a site does not "
                         "always land in the same arm (see arm_plan)")
    ap.add_argument("--out", default=OUT)
    ap.add_argument("--headed", action="store_true")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()

    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        print("n/a: no playwright in this interpreter (use ~/.venv-browser/bin/python3)",
              file=sys.stderr)
        return 2

    if args.test:
        return selftest(sync_playwright)

    urls = list(args.urls)
    if args.file:
        with open(args.file) as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if line:
                    urls.append(line)
    if not urls:
        print("no urls", file=sys.stderr)
        return 2

    arms = [a.strip() for a in (args.arms or args.arm).split(",") if a.strip()]
    plan = arm_plan(len(urls), arms, args.arm_offset)
    if args.treatment == "proxy":
        if sorted(arms) != ["direct", "proxy"]:
            print("refusing: --treatment proxy needs --arms proxy,direct", file=sys.stderr)
            return 2
        # The note is GENERATED here rather than typed, so it cannot drift from what the code
        # actually does — this node spent a whole sweep believing a hand-written vantage.
        args.arm_note = ("treatment=proxy: arm `proxy` leaves through the inherited privoxy "
                         "(127.0.0.1:8118 -> socks5 1080), arm `direct` through the node's own "
                         "default route")
    if arms_need_note(arms, args.arm_note):
        # An arm label with no stated treatment is a column that LOOKS like an experiment.
        # Somebody reading `arm: A` / `arm: B` months later will believe two conditions were
        # run; if they were identical, the honest name for that is an A/A null and it has to
        # be said on the row, not remembered.
        print("refusing: --arms without --arm-note. State what the arms differ in "
              "(use --arm-note 'A/A null: identical treatment' if they do not).",
              file=sys.stderr)
        return 2

    ip = egress_ips()
    if ip.get("proxy_env") and args.treatment != "proxy":
        print(f"note: this shell exports a proxy ({ip['proxy_env']}); the browser inherits it. "
              f"proxied exit {ip.get('egress_ip_proxied')} · direct exit "
              f"{ip.get('egress_ip_direct')}", file=sys.stderr)
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    with sync_playwright() as pw:
        for i, u in enumerate(urls, 1):
            arm = plan[i - 1]
            use_proxy = (arm == "proxy") if args.treatment == "proxy" else True
            load, rows = capture(pw, u, args.settle, args.nav_timeout, ip, args.run_idx,
                                 arm, arm_note=args.arm_note, use_proxy=use_proxy)
            with open(args.out, "a") as fh:
                fh.write(json.dumps(load, ensure_ascii=False) + "\n")
                for r in rows:
                    fh.write(json.dumps(r, ensure_ascii=False) + "\n")
            # Two tallies, never one: the outcome counts that MATTER are the candidate ones,
            # and printing a single mixed number is how a page's analytics traffic gets read
            # as an auction.
            cand = [r for r in rows if r.get("is_bid_candidate")]
            tally = {}
            for r in cand:
                tally[r["outcome"]] = tally.get(r["outcome"], 0) + 1
            named = sum(1 for r in cand if r.get("bidder"))
            print(f"[{i}/{len(urls)}] {u} arm={load.get('arm')} "
                  f"proxy={load.get('browser_used_proxy')} load={load['load_id']} "
                  f"status={load.get('http_status')} wrapper_timeout={load.get('wrapper_timeout_ms')} "
                  f"roster={len(load.get('roster') or [])} rows={len(rows)} "
                  f"candidates={len(cand)} named={named} "
                  f"{' '.join(f'{k}={v}' for k, v in sorted(tally.items())) or '(no candidate rows)'}")
            sys.stdout.flush()
    return 0


def selftest(sync_playwright):
    """Drive a real browser against a local wrapper page and a local stub bidder.

    The point of a local fixture is that it is provable WITHOUT demand: this node's egress is
    a Montréal datacenter ASN and no real bidder will bid to it, so a gate that needed a live
    auction could never run here. Every outcome the classifier can emit is served on purpose,
    including one that never answers.
    """
    import http.server
    import socketserver
    import threading

    ok = True
    PRICED = json.dumps({
        "cur": "RUB",
        # The decoy: an adjusted number, larger, sitting right beside the real one. A collector
        # that reads it instead of `price` reports a different distribution entirely.
        "seatbid": [{"bid": [{"impid": "1", "price": 1.23, "cpm": 9.99, "adm": "<div/>"}]}],
    })
    EMPTY = json.dumps({"cur": "RUB", "seatbid": []})

    class H(http.server.BaseHTTPRequestHandler):
        def _send(self, code, body=b"", ctype="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if body:
                self.wfile.write(body)

        def do_POST(self):
            n = int(self.headers.get("Content-Length") or 0)
            if n:
                self.rfile.read(n)
            if self.path.startswith("/priced"):
                self._send(200, PRICED.encode())
            elif self.path.startswith("/nobid204"):
                self._send(204)
            elif self.path.startswith("/nobid-empty"):
                self._send(200, EMPTY.encode())
            elif self.path.startswith("/err"):
                self._send(500, b"{}")
            elif self.path.startswith("/adfox-nobid"):
                # The measured shape: a real bidder, answering, declining.
                self._send(200, b'{"bids":[]}')
            elif self.path.startswith("/adfox-bid"):
                # A bid came back and nothing in it is called `price`. The collector must not
                # invent a price field; it records the raw bid and every number in it.
                self._send(200, json.dumps({"bids": [
                    {"placementId": "69ebPID", "width": 300, "height": 600,
                     "bidValue": 42.5, "html": "<div/>"}]}).encode())
            elif self.path.startswith("/currency"):
                # A widget, not an auction: `price` is a dollar rate. Answered to an
                # auction-shaped request so the leg cannot pass on the request shape alone.
                self._send(200, json.dumps({"currency": {"USD": {"price": 84.54}}}).encode())
            elif self.path.startswith("/badbids"):
                # The bidder rejecting the protocol, in its own words (their typo).
                self._send(200, b'{"bids":["INCORRECT_UNPUT"]}')
            elif self.path.startswith("/sync"):
                # A cookie-sync hop carrying a bidder's name: contacted, never asked to bid.
                self.send_response(302)
                self.send_header("Location", "/nobid204")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("Content-Length", "0")
                self.end_headers()
            elif self.path.startswith("/beacon"):
                # Analytics: answers 200, carries no price, and is not a bidder. The page
                # fires more of these than it runs bidders.
                self._send(200, b'{"ok":1}')
            elif self.path.startswith("/binary"):
                self._send(200, bytes([0x1f, 0x8b, 0x08, 0x00, 0xff, 0xfe, 0x00, 0x80]),
                           "application/octet-stream")
            elif self.path.startswith("/silent"):
                # Answers long after the capture window closes: asked, never answered.
                time.sleep(60)
                self._send(200, EMPTY.encode())
            else:
                self._send(404, b"{}")

        def do_GET(self):
            if self.path.startswith("/page"):
                self._send(200, PAGE.encode(), "text/html; charset=utf-8")
            else:
                self._send(404, b"")

        def log_message(self, *a):
            pass

    class TS(socketserver.ThreadingTCPServer):
        daemon_threads = True
        allow_reuse_address = True

    srv = TS(("127.0.0.1", 0), H)
    port = srv.server_address[1]
    base = f"http://127.0.0.1:{port}"
    # A port nothing listens on, taken from the kernel and released — Chrome refuses the
    # low ports outright (ERR_UNSAFE_PORT), which is a different failure from a refused
    # connection and would let this leg pass for the wrong reason.
    import socket as _socket
    _s = _socket.socket()
    _s.bind(("127.0.0.1", 0))
    dead_port = _s.getsockname()[1]
    _s.close()
    # A wrapper page: a roster and a deadline in the same shape the live sites carry, and one
    # request per bidder, each with the floor stated in the request the way OpenRTB states it.
    PAGE = f"""<html><body>fixture
<script>
window.Ya = {{adfoxCode: {{}}}};
window.YaHeaderBiddingSettings = {{
  timeout: 1200,
  biddersMap: {{betweenDigital: 'x', myTarget: 'y'}},
  adUnits: [{{code: 'top', bids: [{{bidder: 'betweendigital'}}, {{bidder: 'mytarget'}},
                                  {{bidder: 'buzzoola'}}, {{bidder: 'astralab'}}, {{bidder: 'adriver'}},
                                  {{bidder: 'mediasniper', params: {{placementId: '41139'}}}},
                                  {{bidder: 'astralab2', params: {{placementId: '69ebPID'}}}}]}}]
}};
function askAdfox(path, pid) {{
  return fetch('{base}' + path, {{
    method: 'POST',
    body: JSON.stringify({{places: [{{id: 'begun_block_1', placementId: pid,
                                     sizes: [[970, 250]], codeType: 'combo',
                                     targetRef: location.href}}]}})
  }}).catch(function(e) {{}});
}}
function ask(path, floor) {{
  return fetch('{base}' + path, {{
    method: 'POST',
    body: JSON.stringify({{imp: [{{id: '1', bidfloor: floor, bidfloorcur: 'RUB'}}]}})
  }}).catch(function(e) {{}});
}}
ask('/priced?bidder=betweendigital', 0.5);
ask('/nobid204?bidder=mytarget', 0.5);
ask('/nobid-empty?bidder=buzzoola', 0.7);
ask('/silent?bidder=astralab', 0.9);
ask('/err?bidder=unknownvendor', 0.1);
// The market's real protocol: places + placementId out, {{"bids":[…]}} back.
askAdfox('/adfox-nobid', '41139');
askAdfox('/adfox-bid', '69ebPID');
askAdfox('/currency', '41139');
askAdfox('/badbids', '69ebPID');
// A bidder's host, contacted for a cookie sync — named, but never asked to bid.
fetch('{base}/sync?bidder=adriver', {{method: 'POST', body: '{{"u":"1"}}'}}).catch(function(e) {{}});
// Not an auction message at all: no imp in the request, no seatbid in the answer.
fetch('{base}/beacon?evt=pageview', {{method: 'POST', body: '{{"evt":"pv"}}'}}).catch(function(e) {{}});
// Not text: a beacon's compressed blob. Reading it as UTF-8 raises.
fetch('{base}/binary?evt=px', {{method: 'POST', body: '{{"evt":"px"}}'}}).catch(function(e) {{}});
// The network failing is not a bidder going quiet.
fetch('http://127.0.0.1:{dead_port}/refused', {{method: 'POST', body: '{{"imp":[{{"id":"1"}}]}}'}}).catch(function(e) {{}});
</script></body></html>"""
    threading.Thread(target=srv.serve_forever, daemon=True).start()

    try:
        with sync_playwright() as pw:
            load, rows = capture(pw, f"{base}/page", 2, 20,
                                 {"egress_ip_proxied": "proxy-ip",
                                  "egress_ip_direct": "direct-ip",
                                  "proxy_env": "http://127.0.0.1:8118"}, 7, "B")
            # The same fixture on the node's own route: the browser must be launched with the
            # inherited proxy disabled, and the row must say which exit it used.
            load_d, rows_d = capture(pw, f"{base}/page", 2, 20,
                                     {"egress_ip_proxied": "proxy-ip",
                                      "egress_ip_direct": "direct-ip",
                                      "proxy_env": "http://127.0.0.1:8118"}, 7, "direct",
                                     use_proxy=False)
    finally:
        srv.shutdown()
        srv.server_close()

    by = {}
    for r in rows:
        for name in ("betweendigital", "mytarget", "buzzoola", "astralab", "unknownvendor",
                     "beacon", "binary", "refused", "adfox-nobid", "adfox-bid", "/sync",
                     "currency", "badbids"):
            if name in r["url"]:
                by[name] = r

    priced = by.get("betweendigital", {})
    prices = (priced.get("detail") or {}).get("prices") or []
    checks = [
        ("wrapper deadline read", load.get("wrapper_timeout_ms") == 1200),
        ("roster read from the page", "buzzoola" in (load.get("roster") or [])),
        ("every asked bidder produced a row", len(by) == 13),
        ("priced answer classified", priced.get("outcome") == "priced"),
        # The whole reason the raw path travels with the number.
        ("price is the RAW price, not the adjusted decoy",
         len(prices) == 1 and prices[0]["value"] == 1.23
         and prices[0]["path"].endswith(".price")),
        ("currency from the response's own cur",
         (priced.get("detail") or {}).get("currency") == "RUB"),
        # Floor comes from the request; without it an atom at the floor is unreadable.
        ("floor read from the request",
         (priced.get("floor") or [{}])[0].get("bidfloor") == 0.5
         and (priced.get("floor") or [{}])[0].get("bidfloorcur") == "RUB"),
        ("204 is a no-bid", by.get("mytarget", {}).get("outcome") == "no-bid"),
        # This fixture's 204 arrives and is THEN aborted — the shape a wrapper deadline
        # produces on a live page. The abort must be recorded without touching the verdict.
        ("post-response abort recorded, outcome untouched",
         by.get("mytarget", {}).get("post_response_abort") is True
         and by.get("mytarget", {}).get("outcome") == "no-bid"),
        ("empty seatbid is a no-bid", by.get("buzzoola", {}).get("outcome") == "no-bid"),
        # The distinction the design turns on.
        ("silent bidder is no-answer, NOT no-bid",
         by.get("astralab", {}).get("outcome") == "no-answer"),
        ("no-answer never reads as no-bid",
         by.get("astralab", {}).get("outcome") != "no-bid"),
        ("http 500 is an error, not a no-bid",
         by.get("unknownvendor", {}).get("outcome") == "error"),
        # Our 2s window is shorter than the page's 1200ms? No — flag must be False here, and
        # the flag must exist so a short-window capture cannot pass silently.
        ("window-vs-wrapper flag present and correct",
         priced.get("window_shorter_than_wrapper") is False),
        ("attribution by roster name in url", priced.get("bidder") == "betweendigital"
         and priced.get("match_by") == "roster-name-in-url"),
        # A vendor nobody's roster names must stay unnamed rather than be guessed.
        ("unrostered host stays unattributed",
         by.get("unknownvendor", {}).get("bidder") is None
         and by.get("unknownvendor", {}).get("match_by") == "none"),
        ("contamination columns on every row",
         all(r.get("run_idx") == 7 and r.get("arm") == "B" and r.get("load_id") == load["load_id"]
             and r.get("egress_ip") == "proxy-ip" and r.get("profile_age_s") == 0 for r in rows)),
        ("load row carries the vantage and the hour",
         load.get("egress_ip") == "proxy-ip" and isinstance(load.get("hour_utc"), int)),
        # The failure that mislabelled this study's whole vantage: the recorded exit must be
        # the one the BROWSER used, not whichever was easiest to measure, and both are kept.
        ("the recorded exit is the one the browser actually used",
         load.get("browser_used_proxy") is True and load.get("egress_ip") == "proxy-ip"
         and load_d.get("browser_used_proxy") is False
         and load_d.get("egress_ip") == "direct-ip"),
        ("both exits and the proxy env travel on the load row",
         load.get("egress_ip_proxied") == "proxy-ip"
         and load.get("egress_ip_direct") == "direct-ip"
         and load.get("proxy_env") == "http://127.0.0.1:8118"),
        ("the proxy arm is a column on every request row",
         all(r.get("browser_used_proxy") is True for r in rows)
         and all(r.get("browser_used_proxy") is False for r in rows_d)),
        ("the un-proxied arm still reads the auction",
         any(r.get("evidence_strength") == "protocol" for r in rows_d)),
        # Bidder traffic is identified by evidence that is listed, not by a boolean to trust.
        ("a real bid exchange is a candidate on both halves",
         priced.get("is_bid_candidate") is True
         and "openrtb-request" in (priced.get("bid_evidence") or [])
         and "openrtb-response" in (priced.get("bid_evidence") or [])),
        # The live capture's actual failure: 13 analytics answers landed in `no-bid`.
        ("an analytics beacon is not a bidder declining to bid",
         by.get("beacon", {}).get("is_bid_candidate") is False
         and by.get("beacon", {}).get("bid_evidence") == []),
        ("a non-utf8 body is classified, not filed as unread",
         by.get("binary", {}).get("outcome") == "binary"
         and by.get("binary", {}).get("is_bid_candidate") is False),
        # DNS/TLS/refused is our network failing; as silence it would mint phantom timeouts.
        ("a refused connection is an error, never no-answer",
         by.get("refused", {}).get("outcome") == "error"
         and (by.get("refused", {}).get("detail") or {}).get("net_fault") is True),
        # ...and the abort case must still read as silence, or the split above is vacuous.
        ("an aborted-in-flight request is still no-answer, not error",
         by.get("astralab", {}).get("outcome") == "no-answer"),

        # The market's actual protocol. A collector that only knows OpenRTB records this
        # entire auction as uninteresting traffic — which is what the first live capture did:
        # 197 rows, zero candidates, while two bidders were answering on the wire.
        ("adfox `places` request is recognised as an auction message",
         "adfox-hb-request" in (by.get("adfox-nobid", {}).get("bid_evidence") or [])
         and by.get("adfox-nobid", {}).get("is_bid_candidate") is True),
        ("empty `bids` array is a real no-bid, not silence",
         by.get("adfox-nobid", {}).get("outcome") == "no-bid"
         and (by.get("adfox-nobid", {}).get("detail") or {}).get("reason") == "adfox-empty-bids"),
        # Exact attribution from the publisher's own config, no host list, no substring luck.
        ("placement id names the bidder",
         by.get("adfox-nobid", {}).get("bidder") == "mediasniper"
         and by.get("adfox-nobid", {}).get("match_by") == "placement-id"),
        # An unfamiliar bid must not be given an invented price field.
        ("a bid with no `price` key is kept as bid-returned, with the raw object",
         by.get("adfox-bid", {}).get("outcome") == "bid-returned"
         and any(f["field"] == "bidValue" and f["value"] == 42.5
                 for f in (by.get("adfox-bid", {}).get("detail") or {}).get("numeric_fields", []))
         and "bidValue" in ((by.get("adfox-bid", {}).get("detail") or {}).get("bids_raw") or "")),
        ("a returned bid is never counted as a no-bid",
         by.get("adfox-bid", {}).get("outcome") != "no-bid"),

        # A key named `price` outside a bid container is not a price a bidder offered.
        ("a currency ticker is not a bid",
         by.get("currency", {}).get("outcome") != "priced"
         and not (by.get("currency", {}).get("detail") or {}).get("prices")),
        ("and it never earns openrtb-response evidence",
         "openrtb-response" not in (by.get("currency", {}).get("bid_evidence") or [])),
        # A non-empty bids array of non-objects is the bidder refusing the protocol.
        ("a bids array of non-objects is an error, not a returned bid",
         by.get("badbids", {}).get("outcome") == "error"
         and (by.get("badbids", {}).get("detail") or {}).get("reason") == "bids-not-objects"
         and "INCORRECT_UNPUT" in ((by.get("badbids", {}).get("detail") or {}).get("bids_raw") or "")),

        # A bidder's host being contacted is not that bidder being asked to bid.
        ("a cookie-sync hop is redirect + attribution-only, not an asked bidder",
         by.get("/sync", {}).get("outcome") == "redirect"
         and by.get("/sync", {}).get("evidence_strength") == "attribution-only"),
        ("a real bid exchange carries protocol evidence",
         by.get("adfox-nobid", {}).get("evidence_strength") == "protocol"
         and priced.get("evidence_strength") == "protocol"),

        # Assignment: alternating, and a label that claims nothing is refused.
        ("arms alternate per load, never in blocks",
         arm_plan(6, ["A", "B"]) == ["A", "B", "A", "B", "A", "B"]),
        # Without the offset, a fixed url order gives every site the same arm on every pass
        # and arm becomes site parity wearing a different name.
        ("the next pass can give each site the other arm",
         arm_plan(4, ["A", "B"], 1) == ["B", "A", "B", "A"]
         and all(a != b for a, b in zip(arm_plan(4, ["A", "B"]), arm_plan(4, ["A", "B"], 1)))),
        ("a single arm needs no note", not arms_need_note(["A"], None)),
        ("two arms without a stated treatment are refused",
         arms_need_note(["A", "B"], None) and not arms_need_note(["A", "B"], "A/A null")),
        ("the arm note travels on every row, not just the load",
         all("arm_note" in r for r in rows)),
    ]
    for name, good in checks:
        print(("ok   " if good else "FAIL ") + name)
        ok = ok and good
    print("--test:", "ok" if ok else "FAILED")
    return 0 if ok else 1


