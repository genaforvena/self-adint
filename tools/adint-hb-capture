                def goto(self, url, **kw):
                    if fails:
                        raise RuntimeError("net::ERR_CONNECTION_TIMED_OUT")

                def inner_text(self, sel):
                    return "  91.79.81.62 "

                def close(self):
                    pass
            return _P()

