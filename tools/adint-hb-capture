            # Against the mutant "use browser.new_context instead of
            # launch_persistent_context": nothing survives and c2 is empty like c1.
            ("the first load of a fresh profile finds an EMPTY cookie jar", w["c1"] == ""),
            ("the second load FINDS the first load's cookie — the profile really persisted",
             "adint_warm=1" in (w["c2"] or "")),
        ]
    else:
        print("SKIP the persistent-profile leg: it did not run")

    if live["ran"]:
        checks += [
            # RED against the mutant: drop the env strip in capture() (flag only, the way
            # this tool ran for 117 loads per arm) and the two exits become the same address.
            ("the direct arm's browser leaves by a different exit than the proxy arm",
             live["direct"] != live["proxied"]),
            ("the direct exit is the node's own route, not privoxy's",
             live["direct"] == egress_ips().get("egress_ip_direct")),
            # A verified arm is a MEASURED arm; the boolean must come from the echo, not
            # from the flag we passed.
            ("the load row carries the browser-measured exit and verifies it",
             live["load"].get("vantage_verified") is True
             and live["load"].get("browser_egress_ip") == live["direct"]),
        ]
    # THE ECHO CONTROL IS A DIAGNOSTIC ON A FAILURE PATH, so the one thing it must never
    # do is raise — a crash there would turn an honest rc=2 refusal into a traceback and
    # lose the refusal itself. Driven with a captured stderr, asserting it probes EVERY
    # echo host (a control that checks one host cannot tell a dead link from a dead host)
    # and that it says so out loud when curl is missing rather than doing nothing quietly.
    import io as _io, contextlib as _ctx
    _buf = _io.StringIO()
    try:
        with _ctx.redirect_stderr(_buf):
            shell_echo_control("selftest")
        _out = _buf.getvalue()
        _raised = False
    except Exception:
        _out, _raised = "", True
    checks = checks + [
        ("the echo control never raises on the refusal path", not _raised),
        ("the echo control probes EVERY echo host, not just the first",
         all(h in _out for h in echo_hosts())),
        ("the echo control names the two hypotheses it exists to separate",
         "the link" in _out and "browser context" in _out),
    ]

    for name, good in checks:
        print(("ok   " if good else "FAIL ") + name)
        ok = ok and good
    if not live["ran"]:
        print("SKIP the live vantage leg: " + (live["why"] or "unknown"))
    print("--test:", "ok" if ok else "FAILED")
    if not ok:
        return 1
    # Green-but-unverified is not green. The arm is the one thing this tool cannot check
    # against a localhost fixture, so when that leg could not run the test reports n/a
    # rather than a pass that covers everything except the failure that already happened.
    return 0 if live["ran"] else 2


if __name__ == "__main__":
    sys.exit(main())
