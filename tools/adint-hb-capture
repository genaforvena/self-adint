#!/usr/bin/env python3
"""adint-hb-capture — read the auction off the WIRE, because on this market it is not in a JS API.

    tools/adint-hb-capture <url> [--settle 8] [--run-idx N] [--arm A] [--test]

Step 0 established that runet display is Adfox header bidding, not prebid: `Ya` on every
observable site, `YaHeaderBiddingSettings` on 16 of 22, and prebid's own global present on
three sites and empty every time (docs/step0-prebid-vantage-2026-08-16.md). So
`pbjs.getBidResponses()` — the vantage the study was designed around — does not exist here.
What does exist is the traffic: the wrapper issues one request per bidder and takes back a
response, and the columns the design requires live in those two documents.

What is recorded, and why each is its OWN column
------------------------------------------------
  price      taken from the RESPONSE at its raw path (OpenRTB `seatbid[].bid[].price`), with
             the currency the response itself declares. Never a wrapper-adjusted number: the
             design says originalCpm/originalCurrency and never `cpm`/`hb_pb`, because a
             bidCpmAdjustment and an FX conversion smear a discrete price list into a
             continuous one — which is precisely the shape the study is trying to read. The
             fixture serves a decoy adjusted field beside the real one and a mutant that
             reads it goes red.
  floor      taken from the REQUEST (`imp[].bidfloor` + `bidfloorcur`). Without it an atom at
             the floor is indistinguishable from a flat price, and under a dynamic floor a
             floor-follower reads as a live valuation — the taxonomy inverts.
  outcome    priced / no-bid / no-answer / error, kept apart. A bidder that was asked and
             said nothing is NOT a bidder that answered "no bid": folding them makes
             selectivity a measurement of our own latency. `no-answer` is deliberately not
             called `timeout`: it means no response arrived inside OUR observation window,
             which is a claim about this capture, not about the wrapper's own deadline. The
             wrapper's deadline is recorded separately (`wrapper_timeout_ms`) and a row whose
             window was shorter than that deadline says so (`window_shorter_than_wrapper`),
             because such a row cannot distinguish a slow bidder from a dropped one.
  attribution  a request is attributed to a bidder only by evidence: a host match in
             ref/exchange-domains.tsv, or a roster name occurring in the URL. Everything else
             is `null` with `match_by: none`. A guessed attribution is worse than no
             attribution — it puts a price under the wrong bidder's distribution.
  contamination  run index, arm, page-load id, wall hour, egress IP, and the context's age
             (always 0 here: a fresh profile per load, so cookie-age never silently becomes a
             covariate). Clustering is at the PAGE LOAD, so every row carries `load_id`.

Output is append-only JSONL: one row per candidate request, plus one `kind: "load"` row per
page load carrying the vantage and the wrapper config. Nothing is aggregated here — the count
is a separate step over the log, on purpose.
"""

import argparse
import json
import os
import re
import subprocess
import sys
import time
import uuid
from datetime import datetime, timezone

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))

# THE CAPTURE SCHEMA, as a constant a reader can import. It was written as the literal `5` at
# both row-writing sites, which made "is this ledger current?" a question no consumer could
# ask — every reader had to pick the newest schema PRESENT IN THE FILE and call that current.
# A file whose newest rows are old then reads as fully current, which is the one thing the
# stamp exists to prevent. The per-schema history lives beside the load row below.
# schema 6 KEEPS THE REQUEST BODY. Schemas 1-5 parsed `post_data` for three narrow things
# (floor, is-it-OpenRTB, adfox placement ids) and then DISCARDED it — so `req_openrtb` on
# disk was a boolean and the payload was gone. That payload is the thing this project says
# it exists to read: README's thesis is that the audience profile arrives INSIDE the bid
# request, readable without buying the impression. It was never on disk. A schema<=5 row
# cannot answer the profile question at all; its absence there is not evidence of an empty
# request.
SCHEMA = 7
# Per-body cap. OpenRTB requests here run 2-8 KB; 16 KB keeps the whole of a normal one and
# bounds a pathological one. A truncated body is FLAGGED, never silently shortened — a
# profile field missing because we cut the string reads exactly like a profile field the
# exchange did not send.
REQ_BODY_CAP = 16384
# The SAME cap for the query string, for the same reason. `url` stays a 500-char preview so
# every existing reader keeps working; `req_url_full` is the evidence column and carries the
# same privacy class as the body — it is a description of one real person and does not cross
# adint-publish's allowlist.
REQ_URL_CAP = 16384
OUT = os.path.join(REPO, "data", "hb-auction.jsonl")
DOMAINS = os.path.join(REPO, "ref", "exchange-domains.tsv")

BODY_CAP = 400_000          # a response body larger than this is recorded by size, not stored
ROW_CAP = 600               # per page load; an exceeded cap is REPORTED, never silent

# The wrapper's own roster and deadline, read once after settle. Same object step 0 counted.
WRAPPER_JS = r"""
() => {
  const out = {wrapper_timeout_ms: null, roster: [], placements: {}, adfox: false, pbjs: false};
  try { out.adfox = typeof window.Ya !== 'undefined'; } catch (e) {}
  try { out.pbjs = Array.isArray(window._pbjsGlobals) && window._pbjsGlobals.length > 0; } catch (e) {}
  try {
    const s = window.YaHeaderBiddingSettings;
    if (s && typeof s === 'object') {
      out.wrapper_timeout_ms = typeof s.timeout === 'number' ? s.timeout : null;
      const names = {};
      for (const n of Object.keys(s.biddersMap || {})) names[String(n).toLowerCase()] = 1;
      for (const u of (Array.isArray(s.adUnits) ? s.adUnits : [])) {
        for (const b of ((u && u.bids) || [])) {
          if (!b || !b.bidder) continue;
          const name = String(b.bidder).toLowerCase();
          names[name] = 1;
          // placementId -> bidder. This is the ONE attribution that is exact on this market:
          // each wrapper endpoint is a single bidder, and the id it is asked with is written
          // in the publisher's own config. Measured on lenta.ru — 41139 -> mediasniper hit
          // hb.bumlam.com, 69eb5feb… -> astralab hit ssp.al-adtech.com.
          const pid = b.params && b.params.placementId;
          if (pid !== undefined && pid !== null) out.placements[String(pid)] = name;
        }
      }
      out.roster = Object.keys(names).sort();
    }
  } catch (e) {}
  return out;
}
"""


def load_domain_table(path=DOMAINS):
    """domain_pattern -> org. Attribution evidence, not a guess."""
    table = []
    try:
        with open(path) as fh:
            for i, line in enumerate(fh):
                if i == 0 or not line.strip() or line.startswith("#"):
                    continue
                parts = line.rstrip("\n").split("\t")
                if len(parts) >= 2 and parts[0]:
                    table.append((parts[0].lower(), parts[1]))
    except FileNotFoundError:
        pass
    # Longest pattern first: `googleads.g.doubleclick.net` must win over `doubleclick.net`.
    table.sort(key=lambda t: -len(t[0]))
    return table


def attribute(url, host, roster, table, placement_ids=None, placements=None):
    """Name a bidder only on evidence. `none` is a valid, and often the honest, answer.

    Strongest evidence first: the placement ids the REQUEST was made with, matched against the
    publisher's own `placementId -> bidder` config. On this market each wrapper endpoint is one
    bidder, so a request carrying only that bidder's ids names it exactly — no host list to
    maintain and no substring luck.
    """
    if placement_ids and placements:
        named = {placements[p] for p in placement_ids if p in placements}
        if len(named) == 1:
            return named.pop(), "placement-id"
        if len(named) > 1:
            return None, "ambiguous-placements:" + ",".join(sorted(named))
    for pattern, org in table:
        if host == pattern or host.endswith("." + pattern):
            return org, "host-table:" + pattern
    low = url.lower()
    hits = [b for b in roster if b and len(b) >= 4 and b in low]
    if len(hits) == 1:
        return hits[0], "roster-name-in-url"
    if len(hits) > 1:
        # Two roster names in one URL name nothing; a coin flip here would put a price under
        # the wrong bidder's distribution.
        return None, "ambiguous:" + ",".join(sorted(hits))
    return None, "none"


def _in_bid_container(path):
    """Is this path inside a bid list? `$.seatbid[0].bid[0]` and `$.bids[0]` are; the rest of
    a JSON document is not, whatever its keys are called."""
    low = path.lower()
    return ".seatbid" in low or ".bids" in low or ".bid[" in low or low.endswith(".bid")


def _walk_prices(node, path="$", out=None, depth=0):
    """Find price-bearing nodes by structure, recording the PATH each came from.

    The path is the citation: a number labelled `price` at `$.seatbid[0].bid[0].price` is an
    OpenRTB bid, while a number labelled `cpm` beside it may be anything the wrapper wrote
    after adjustment. The reader downstream must be able to tell them apart, so the field name
    and its location travel with the value.
    """
    if out is None:
        out = []
    if depth > 12 or len(out) >= 50:
        return out
    if isinstance(node, dict):
        for k, v in node.items():
            # A key named `price` is not a price a bidder offered. 3dnews.ru serves
            # /currency.json, where `$.currency.USD.price = 84.54` is the dollar rate — it was
            # classified as a bid, and under evidence grading it would have counted as protocol
            # evidence and put 84.54 into the price column. The container is what makes a
            # number a bid, so a price is only taken from inside a `seatbid`/`bid`/`bids` node.
            if k == "price" and isinstance(v, (int, float)) and _in_bid_container(path):
                out.append({"path": f"{path}.{k}", "field": k, "value": float(v)})
            else:
                _walk_prices(v, f"{path}.{k}", out, depth + 1)
    elif isinstance(node, list):
        for i, v in enumerate(node[:20]):
            _walk_prices(v, f"{path}[{i}]", out, depth + 1)
    return out


def _bid_prices(bids):
    """A price per bid OBJECT, with the field it came from.

    Field preference is deliberate and narrow. Where a bid carries `price`, that is the price
    and `cpm` beside it is ignored — in a prebid-shaped object `cpm` is the value AFTER
    bidCpmAdjustment and FX, and the design forbids reading it. Where a bid has no `price` at
    all, `cpm` is the bidder's own field: sparrow answers
    `{"placementId":"320892","currency":"RUB","cpm":1.6466…,"displayCode":"<!-- Sparrow -->…"}`
    and there is no other number in it. The field name travels with the value so the two can
    never be confused downstream.
    """
    out = []
    for i, b in enumerate(bids[:20]):
        if not isinstance(b, dict):
            continue
        for field in ("price", "cpm", "bid"):
            v = b.get(field)
            if isinstance(v, (int, float)) and not isinstance(v, bool):
                out.append({"path": f"$[{i}].{field}", "field": field, "value": float(v),
                            "currency": b.get("currency") or b.get("cur"),
                            "placementId": b.get("placementId")})
                break
    return out


def _walk_numbers(node, path="$", out=None, depth=0):
    """Every numeric leaf with its path — the raw material for identifying an unfamiliar
    bidder's price field from a real bid instead of guessing at it."""
    if out is None:
        out = []
    if depth > 8 or len(out) >= 60:
        return out
    if isinstance(node, dict):
        for k, v in node.items():
            if isinstance(v, (int, float)) and not isinstance(v, bool):
                out.append({"path": f"{path}.{k}", "field": k, "value": float(v)})
            else:
                _walk_numbers(v, f"{path}.{k}", out, depth + 1)
    elif isinstance(node, list):
        for i, v in enumerate(node[:20]):
            _walk_numbers(v, f"{path}[{i}]", out, depth + 1)
    return out


def parse_response(body_text):
    """Classify an answer. Returns (outcome, detail).

    `no-bid` here means "answered, and the answer carries no price". It is only a statement
    about a BIDDER once the row is known to be bidder traffic — see `bid_evidence`; a
    pixel that answers 200 is not a bidder declining to bid.
    """
    if body_text is None:
        return "no-bid", {"reason": "empty-body"}
    t = body_text.strip()
    if not t:
        return "no-bid", {"reason": "empty-body"}
    try:
        doc = json.loads(t)
    except Exception:
        return "unparsed", {"reason": "not-json", "bytes": len(t)}
    # The Adfox HB answer, measured: `{"bids":[]}` from both of lenta.ru's bidders. An empty
    # array is a REAL no-bid from a real bidder — it is not the absence of an auction, and it
    # is certainly not silence.
    if isinstance(doc, dict) and isinstance(doc.get("bids"), list):
        if not doc["bids"]:
            return "no-bid", {"reason": "adfox-empty-bids", "has_bids_key": True}
        if not all(isinstance(b, dict) for b in doc["bids"]):
            # Measured: hb.bumlam.com answers {"bids":["INCORRECT_UNPUT"]} (their typo) when it
            # rejects the request. A non-empty array of non-objects is the bidder refusing the
            # protocol, not a bid — as `bid-returned` it would read as demand we do not have.
            return "error", {"reason": "bids-not-objects", "has_bids_key": True,
                             "bids_raw": json.dumps(doc["bids"][:3])[:2000]}
        prices = _bid_prices(doc["bids"])
        if prices:
            # A bid of ZERO is a returned bid with no value. It is not demand and it must not
            # inflate a priced count, so it gets its own outcome rather than a footnote.
            nonzero = [x for x in prices if x["value"] > 0]
            return ("priced" if nonzero else "bid-zero"), {
                "prices": prices, "has_bids_key": True,
                "currency": doc.get("cur") or doc.get("currency")
                or (prices[0].get("currency") if prices else None),
                "bids_raw": json.dumps(doc["bids"][:3])[:2000]}
        # A bid came back and nothing in it is called `price`. The field name is not something
        # to guess: the raw objects and every numeric field found are recorded so the price key
        # can be identified from a real bid rather than assumed from a schema we have not seen.
        return "bid-returned", {"reason": "bids-present-no-price-key", "has_bids_key": True,
                                "numeric_fields": _walk_numbers(doc["bids"][:3]),
                                "bids_raw": json.dumps(doc["bids"][:3])[:2000]}

    prices = _walk_prices(doc)
    cur = None
    has_seatbid = False
    if isinstance(doc, dict):
        cur = doc.get("cur") or doc.get("currency")
        has_seatbid = "seatbid" in doc
    if not prices:
        # An answer with no price IS a no-bid — a distinct fact from never answering.
        return "no-bid", {"reason": "no-price-in-body", "has_seatbid": has_seatbid,
                          "seatbid": len(doc.get("seatbid", [])) if isinstance(doc, dict) else None}
    return "priced", {"prices": prices, "currency": cur, "has_seatbid": has_seatbid}


def _profile_age_s(profile_dir):
    """Seconds since this profile was created. 0 means COLD — no history at all.

    Read from a stamp file written at creation, never from the directory mtime: mtime moves
    every time the browser writes a cookie, which would make an OLD profile look newly born
    exactly when it is most warmed.
    """
    if not profile_dir:
        return 0
    stamp = os.path.join(profile_dir, ".created")
    try:
        with open(stamp) as fh:
            return max(0, int(time.time() - float(fh.read().strip())))
    except Exception:
        return None


def _profile_for_arm(arm, warm_arm, profile_dir):
    """Which profile dir THIS load runs in. None means a cold, fresh context.

    Without `--warm-arm` the profile applies to every load, which forces cold and warmed into
    two separate runs at two different hours — and the hour is this market's dominant
    confounder, so a block-assigned warming study measures the evening and calls it warming.
    With it, one run alternates the arms per load and the profile is the only thing that
    differs between them.
    """
    if profile_dir is None:
        return None
    if warm_arm is None:
        return profile_dir
    return profile_dir if arm == warm_arm else None


def _profile_stamp(profile_dir):
    """Create the profile dir if absent and stamp its birth. Returns nothing.

    The stamp is written ONLY when we create the directory. A dir that already exists without
    a stamp is a profile whose age we genuinely do not know, and `_profile_age_s` must keep
    rendering that as None: stamping it here would date it from first USE and report a warmed
    profile as newborn — the treatment axis reading zero exactly where the treatment is
    strongest. Nothing wrote this stamp until 2026-08-20, so every persistent profile scored
    None and cold/warmed were indistinguishable on the row.
    """
    if not profile_dir or os.path.exists(profile_dir):
        return
    os.makedirs(profile_dir, exist_ok=True)
    with open(os.path.join(profile_dir, ".created"), "w") as fh:
        fh.write("%.3f" % time.time())


def _req_url_fields(url):
    """{req_url_full, req_url_bytes, req_url_truncated} for one request.

    THE OTHER HALF OF THE REQUEST. Schema 6 kept the POST body because "the audience profile
    arrives inside the bid request" — and then recorded the URL as `url[:500]`, so every
    exchange that asks by GET had its question cut mid-query-string with nothing on the row
    saying so. Measured on the 2026-08-20 cold sweep before this landed: 212 request rows sat
    at exactly 500 chars, among them `ssp01.rambler.ru`, a real SSP that sends no body at all.
    Its census read `no-body` and its actual question was unread.

    A silent cut is the trap the body cap already names: a field missing because we cut the
    string reads exactly like a field the exchange never sent. So the length and the cut are
    both on the row.
    """
    u = url or ""
    n = len(u)
    return {"req_url_full": u[:REQ_URL_CAP],
            "req_url_bytes": n,
            "req_url_truncated": n > REQ_URL_CAP}


def _req_body_fields(req):
    """{req_body, req_body_bytes, req_body_truncated} for one request.

    Absent body renders `None`, never `""` — a GET with no payload and a POST whose body we
    failed to read are different facts, and an empty string would merge them.
    """
    try:
        body = req.post_data
    except Exception:
        return {"req_body": None, "req_body_bytes": None, "req_body_truncated": None}
    if body is None:
        return {"req_body": None, "req_body_bytes": 0, "req_body_truncated": False}
    n = len(body)
    return {"req_body": body[:REQ_BODY_CAP],
            "req_body_bytes": n,
            "req_body_truncated": n > REQ_BODY_CAP}


def request_adfox_places(post_data):
    """The Adfox HB request shape, measured on lenta.ru 2026-08-16:

        {"places":[{"id":"begun_block_…","placementId":"41139","sizes":[[970,250]],
                    "codeType":"combo","targetRef":"https://lenta.ru/"}, …]}

    It is NOT OpenRTB — no `imp`, no `bidfloor` — so a collector that only knows OpenRTB
    records this market's entire auction as uninteresting traffic. Returns the placement ids,
    which are also the attribution key.
    """
    if not post_data:
        return None
    try:
        doc = json.loads(post_data)
    except Exception:
        return None
    if not isinstance(doc, dict) or not isinstance(doc.get("places"), list):
        return None
    ids = []
    for pl in doc["places"][:60]:
        if isinstance(pl, dict) and pl.get("placementId") is not None:
            ids.append(str(pl["placementId"]))
    return {"placement_ids": ids, "places": len(doc["places"])}


def request_is_openrtb(post_data):
    """Does the REQUEST look like a bid request? `imp` is OpenRTB's required inventory array
    and no analytics beacon carries it. This is evidence, not proof, and it is recorded as
    evidence — see `bid_evidence` on each row."""
    if not post_data:
        return False
    try:
        doc = json.loads(post_data)
    except Exception:
        return False
    return isinstance(doc, dict) and isinstance(doc.get("imp"), list)


def parse_request_floor(post_data):
    """The floor as the REQUEST stated it. Absent is `null`, never 0 — a zero floor is a
    claim, and an unstated floor is not that claim."""
    if not post_data:
        return None
    try:
        doc = json.loads(post_data)
    except Exception:
        return None
    floors = []
    for imp in (doc.get("imp") or []) if isinstance(doc, dict) else []:
        if isinstance(imp, dict) and "bidfloor" in imp:
            floors.append({"imp": imp.get("id"), "bidfloor": imp.get("bidfloor"),
                           "bidfloorcur": imp.get("bidfloorcur")})
    return floors or None


def arm_plan(count, arms, offset=0):
    """Which arm each load runs, in load order. Alternating, never blocked: the hour is the
    dominant confounder, so a block design hands whichever hour it ran in to one arm.

    The offset exists because alternation alone is not enough across passes. The url list is
    read in a fixed order, so `i % 2` gives every site the SAME arm on every pass — arm would
    be perfectly confounded with site parity, and a per-site difference would read as an arm
    effect. Shifting the offset by one on the next pass gives each site both arms, so an arm
    effect can be estimated WITHIN a site.
    """
    return [arms[(i + offset) % len(arms)] for i in range(count)]


def arms_need_note(arms, note):
    """More than one arm without a stated treatment is refused — see main()."""
    return len(arms) > 1 and not note


PROXY_VARS = ("HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY",
              "http_proxy", "https_proxy", "all_proxy")


# The echo contract is "a bare IP and nothing else" — the right contract for a host WE choose.
# It stops being a choice when the region under test can reach exactly one echo. Measured
# 2026-08-20 from inside the MTS netns, five echoes were unreachable (api.ipify.org,
# ifconfig.co, icanhazip.com, ident.me, ipinfo.io — all rc=28) and the only one that answered
# was Yandex's, which returns the address JSON-QUOTED: "91.79.84.208". The quote is not in
# [0-9a-fA-F:.], so the strict full-match read a perfectly good answer as unreadable, and the
# preflight refused every load on a vantage that fetched 6/6 of the corpus in the same minute.
# So the address may now be WRAPPED, and nothing more. The body stays capped, because the cap
# is what the full-match was really buying: an HTML page that merely CONTAINS an address must
# never satisfy a gate whose whole job is to prove where we are.
_ECHO_BODY_MAX = 64
_ECHO_RE = re.compile(r"""^["'\s]*([0-9a-fA-F:.]{7,45})["'\s]*$""")


# One echo is a single point of failure for BOTH arms at once. Measured over the 28 pairs of
# the 2026-08-20 night cell: rep1 ran 14/14 with both arms proven on Yandex's echo, then rep2
# lost 13 of 14 RU arms AND 3 us-exit arms to that same host going unreadable — the border did
# not move and the parse did not change, the host did. So the answer is SEVERAL echoes, and the
# cheap way to spend them is across the ATTEMPTS that already exist: attempt i asks host
# i % len(hosts), so `--echo-tries 3` over three hosts costs three reads, not nine. Hammering
# one host three times is the one arrangement that cannot survive that host being down.
def echo_hosts(echo=None):
    """The echo URLs to try, in order. A single URL behaves exactly as it always has."""
    raw = IP_ECHO if echo is None else echo
    if isinstance(raw, (list, tuple)):
        parts = list(raw)
    else:
        parts = str(raw).split(",")
    hosts = [h.strip() for h in parts if h and h.strip()]
    # An empty/blank override falls back to the DEFAULT, and the default is itself a list, so it
    # has to be split too. `or [IP_ECHO]` was correct only while IP_ECHO was one URL; with a
    # comma-joined default it would hand back the whole joined string AS a single URL — one
    # unreachable host wearing the shape of a working fallback.
    if hosts:
        return hosts
    return [h.strip() for h in str(IP_ECHO).split(",") if h.strip()]


def shell_echo_control(reason):
    """On a preflight refusal, ask the SAME echoes from the SHELL and say what happened.

    A refusal currently records only that the BROWSER could not read an echo, which leaves
    "the network was down" and "this browser context could not reach it" indistinguishable
    in the record. Measured 2026-08-21: nl-direct refused 23 consecutive loads over 47
    minutes with `exit=None echo_attempts=3/3`, and nothing in the artifact says which of
    those two it was — a shell curl run afterwards answered 200, but afterwards is not a
    comparison.

    This is the control-curl principle the study already applies per pair, applied to the
    vantage proof: a second measurement from a different stack AT THE SAME MOMENT. It
    writes to stderr only, which `adint-paired-run` already folds into the run log, so it
    adds no row and changes no analysis — a failure that was previously unattributable
    becomes attributable, and nothing else moves.
    """
    import shutil
    curl = shutil.which("curl")
    if not curl:
        print(f"echo-control: SKIPPED (no curl on PATH) — {reason}", file=sys.stderr)
        return
    for host in echo_hosts():
        try:
            r = subprocess.run([curl, "-s", "-m", "10", host], capture_output=True,
                               timeout=15)
            body = (r.stdout or b"").decode("utf-8", "replace").strip()[:40]
            print(f"echo-control: shell {host} rc={r.returncode} body={body!r}",
                  file=sys.stderr)
        except Exception as e:
            print(f"echo-control: shell {host} raised {type(e).__name__}", file=sys.stderr)
    print(f"echo-control: the browser could not read an echo; the lines above are the "
          f"SAME echoes from the shell at the same moment. Both failing means the link; "
          f"only the browser failing means the browser context. ({reason})",
          file=sys.stderr)


def echo_ip(txt):
    """The address an echo body states, or None if it does not state exactly one."""
    if txt is None:
        return None
    t = txt.strip()
    if not t or len(t) > _ECHO_BODY_MAX:
        return None
    m = _ECHO_RE.match(t)
    return m.group(1) if m else None


def _curl_ip(env, timeout=15):
    for host in echo_hosts():
        try:
            r = subprocess.run(["curl", "-s", "--max-time", str(timeout), host],
                               capture_output=True, text=True, timeout=timeout + 5, env=env)
            got = echo_ip(r.stdout)
            if got is not None:
                return got
        except Exception:
            continue
    return None


def egress_ips(timeout=15):
    """BOTH paths, because this node has two and they land in different countries.

    A shell here inherits HTTP_PROXY/HTTPS_PROXY/ALL_PROXY=http://127.0.0.1:8118 (privoxy,
    forwarding to socks5 127.0.0.1:1080). curl honours those variables and so does Chromium,
    so the first sweeps of this study measured the PROXY's exit and recorded it as the node's:
    38.49.216.141 (Montréal) is privoxy's far end, while the node's own default route leaves
    at 77.246.104.228 (Amsterdam). Measuring one and labelling it "our vantage" is how a
    corpus acquires a geo it never had.
    """
    # The proxied leg is only a MEASUREMENT when a proxy is actually configured. With no
    # proxy var set, `proxied` and `direct` are the same command with the same environment,
    # so their equality is a tautology — and the `--via direct` gate below reads that
    # tautology as "the browser is still going through privoxy" and refuses a run that has no
    # proxy to go through. That false refusal is not hypothetical: it blocked the 2026-08-18
    # RU-vantage run, which executes in a network namespace where 127.0.0.1:8118 does not
    # exist at all. Absent a proxy env there is nothing for the browser to inherit, so the
    # leak the gate guards against cannot occur; the honest value is None (no evidence),
    # never a number that makes an unrelated comparison fire.
    proxy_env = os.environ.get("HTTPS_PROXY") or os.environ.get("ALL_PROXY") \
        or os.environ.get("HTTP_PROXY")
    proxied = _curl_ip(os.environ.copy(), timeout) if proxy_env else None
    clean = {k: v for k, v in os.environ.items() if k not in PROXY_VARS}
    direct = _curl_ip(clean, timeout)
    return {"egress_ip_proxied": proxied, "egress_ip_direct": direct,
            "proxy_env": proxy_env,
            "proxied_leg": "measured" if proxy_env else "n/a: no proxy in this environment"}


# The echo host is part of the INSTRUMENT, and on a censored or mangling vantage it can be the
# one host that does not work. Measured 2026-08-18 from the RU MTS vantage: MTS's own resolvers
# (212.188.31.154/155) answer api.ipify.org AND example.com with 8.47.69.0 / 8.6.112.0 — the
# same /24s Google answers with, last octet zeroed — and nothing listens there, so curl and
# chromium both fail while every .ru host resolves identically. Choosing between "use the
# subscriber's resolver" and "prove the vantage" is a false choice: keep the resolver, move the
# echo. --ip-echo does that; it must return a bare IP and nothing else.
# The DEFAULT is a LIST, because a single default is what made the multi-host machinery above
# unreachable: `echo_hosts()` has rotated across attempts since 2026-08-18, but IP_ECHO stayed one
# URL, so every cell that did not pass --ip-echo still hammered api.ipify.org three times and the
# remedy sat in the code unused. A fix that is implemented and not wired into the default is not a
# fix. Measured from the RU MTS vantage 2026-08-21T02:1xZ, and it is TWO failure modes, not one:
#   - POISONED NAME: api.ipify.org -> 8.47.69.0, example.com -> 8.6.112.0 (MTS resolvers
#     212.188.31.154/155, real /24s with the last octet zeroed); nothing listens, curl hangs.
#   - RESOLVED AND STILL DEAD: icanhazip.com -> 104.16.184.241 and ifconfig.co -> 104.21.54.91
#     are the CORRECT Cloudflare addresses and both time out at 20s, as do 1.1.1.1 and
#     cdn.jsdelivr.net. So the older note here ("keep the resolver, move the echo") is only half
#     the story: moving to a correctly-resolved FOREIGN echo would have failed too. On that
#     vantage in that hour the only echo that answered was the in-country one (0.3s), while
#     aif.ru/ria.ru/mail.ru/vk.com all loaded normally -- the link was fine, the reach was not.
# Hence the order: an in-country echo first (the only one verified readable from BOTH arms:
# 0.3s RU, 1.4s NL), then two foreign ones so the list cannot become a single-vendor dependency.
# It is an IP echo, not a measurement surface, so the first host being Yandex does not touch the
# roster the run is here to record.
IP_ECHO = ("https://ipv4.internet.yandex.net/api/v0/ip,"
           "https://api.ipify.org,"
           "https://icanhazip.com")


# How long the browser is given to read the IP echo. 12s was tuned on a fibre vantage and is
# NOT a property of the check — on the 2026-08-18 HSDPA vantage curl read the echo in 25s while
# the browser timed out at 12s, and the gate then refused a run whose exit was perfectly
# provable. A timeout is not a refusal: the patience must scale with the link, so main() derives
# this from --nav-timeout unless --echo-timeout says otherwise. The GATE is unchanged — an
# unread echo still stops the run; only how long we wait before calling it unread moves.
ECHO_TIMEOUT_MS = 12000
# One attempt by default, because a retry is a claim about the LINK and must be asked for.
# Measured on the RU tether 2026-08-19 (n=8 curls to the echo, `--max-time 30`): four read
# the address (12.1 / 12.5 / 23.9 / 26.3 s) and four did not (two connection failures at
# 19.8 s, two hard timeouts) — while the same tether carried eleven 45-second captures in
# the same hour. So the echo fails TRANSIENTLY on a working vantage, and a single attempt
# converts that into `vantage unproven`, which the run then refuses. It is not slowness:
# --echo-timeout already derives from --nav-timeout (120 s in a paired cell), so patience
# was never the binding constraint and raising it further would have fixed nothing.
ECHO_TRIES = 1
# Navigation attempts. 1 by default for the same reason as ECHO_TRIES: a retry is a claim
# about the link and has to be asked for.
NAV_TRIES = 1
# The attempts are RECORDED, not smoothed away: a retry that hides its own count turns a
# degrading link into a clean one, and the count is the only place the degradation shows.
ECHO_ATTEMPT_PAUSE_S = 2.0


def echo_read(ctx, timeout_ms=None, echo=None, tries=None, pause_s=None):
    """(address, attempts). Retries a TRANSIENT echo failure; the verdict is unchanged.

    None still means the echo could not be read, and a caller still refuses on it — this
    only stops one flaky read from being mistaken for that. `attempts` is what the row and
    the preflight line report, so a vantage that needed three tries is visible as such.
    """
    if tries is None:
        tries = ECHO_TRIES
    if pause_s is None:
        pause_s = ECHO_ATTEMPT_PAUSE_S
    hosts = echo_hosts(echo)
    attempts = 0
    for i in range(max(1, tries)):
        if i:
            time.sleep(pause_s)
        attempts += 1
        got = _echo_once(ctx, timeout_ms, hosts[i % len(hosts)])
        if got is not None:
            return got, attempts
    return None, attempts


def browser_egress(ctx, timeout_ms=None, echo=None, tries=None):
    """The exit address as the BROWSER sees it. None when the echo cannot be read.

    None is not a failure of the arm — it is the absence of evidence about the arm, and it
    must stay distinguishable from a verified match.
    """
    return echo_read(ctx, timeout_ms, echo, tries)[0]


def _echo_once(ctx, timeout_ms=None, echo=None):
    p = None
    # Both defaults resolve HERE, not in the signature: a default argument is bound once at
    # def time, so `echo=IP_ECHO` in the signature would pin the module value and silently
    # ignore --ip-echo.
    if timeout_ms is None:
        timeout_ms = ECHO_TIMEOUT_MS
    if echo is None:
        echo = IP_ECHO
    try:
        p = ctx.new_page()
        p.goto(echo, wait_until="domcontentloaded", timeout=timeout_ms)
        txt = (p.inner_text("body") or "").strip()
        return echo_ip(txt)
    except Exception:
        return None
    finally:
        try:
            if p is not None:
                p.close()
        except Exception:
            pass


def pair_key(prefix, index):
    """step0c §2.4's pair key: positional, so both arms derive it from the shared ordered
    URL list without communicating. None when no pairing was asked for — an unpaired run
    must not carry a key that would let a later join mint pairs that were never run."""
    return f"{prefix}-{index:03d}" if prefix else None


def capture(pw, url, settle, nav_timeout, ip, run_idx, arm, headed=False, arm_note=None,
            use_proxy=True, vantage_probe=True, pair_id=None, nav_tries=None,
            profile_dir=None):
    """One page load. Returns (load_row, request_rows).

    `nav_tries` defaults to NAV_TRIES (1). Resolved here, never in the signature, so the
    module default stays live rather than being bound once at def time — the trap that made
    `--ip-echo` silently inert once already.

    `pair_id` is step0c §2.4's requirement that pairing be recoverable FROM THE DATA and not
    reconstructed later by timestamp arithmetic. `load_id` cannot carry it: it is a fresh
    uuid per load, so two arms loading the same site in the same minute share nothing, and
    the only way back to the pair is to sort by clock and hope — on a market where floors
    move, "same hour" is not a pair, and a reconstruction cannot tell a pair from a
    coincidence. The two arms are launched with the same --pair-id; a run with no pairing
    leaves it null rather than inventing a key that would make unpaired rows look paired."""
    load_id = uuid.uuid4().hex[:12]
    # Stamp BEFORE the age is read into the row below, else the profile's very first load
    # reports None instead of the 0 it actually is.
    _profile_stamp(profile_dir)
    t_wall = datetime.now(timezone.utc)
    load = {
        # schema 2 added evidence_strength (protocol vs attribution-only) and the
        # `redirect` outcome. schema 3 fixed the price column itself: a schema-2 row
        # could carry a `price` read from any JSON key of that name — a currency
        # widget among them — so its prices are not this column and must not pool.
        # schema 4 records WHICH egress the browser used. Schema<=3 rows carry an
        # `egress_ip` that was measured through the inherited proxy whether or not
        # the browser used it, so their vantage column is not this one.
        # schema 5 VERIFIES it from inside the browser. Schema-4 `direct` rows are
        # mislabelled: the arm was launched with --no-proxy-server only, which does not
        # override the inherited proxy env, so BOTH arms left through privoxy. Their
        # `egress_ip: 77.246.104.228` is what the parent's curl measured, not where that
        # browser went — schema-4 arms are an A/A null wearing a treatment's name.
        "schema": SCHEMA, "kind": "load", "load_id": load_id, "pair_id": pair_id,
        "ts": t_wall.strftime("%Y-%m-%dT%H:%M:%SZ"), "hour_utc": t_wall.hour,
        "url": url, "run_idx": run_idx, "arm": arm, "arm_note": arm_note,
        # The arm's PATIENCE, on the row. Once the arms may be given different nav budgets,
        # a `no-answer` means "did not arrive within THIS many seconds" and the number is
        # part of the reading — without it two arms' silences are not the same claim.
        "nav_timeout_s": nav_timeout,
        # `egress_ip` is the address the BROWSER left from, never whichever one was easiest to
        # measure. The other path is recorded beside it so the row is unambiguous on its own.
        "egress_ip": (ip.get("egress_ip_proxied") if use_proxy else ip.get("egress_ip_direct"))
        if isinstance(ip, dict) else ip,
        "browser_used_proxy": use_proxy,
        "egress_ip_proxied": ip.get("egress_ip_proxied") if isinstance(ip, dict) else None,
        "egress_ip_direct": ip.get("egress_ip_direct") if isinstance(ip, dict) else None,
        "proxy_env": ip.get("proxy_env") if isinstance(ip, dict) else None,
        # PROFILE AGE IS THE TREATMENT, not a constant. Until 2026-08-20 this field was
        # hardcoded 0 and the comment below explained why that was safe — a fresh context per
        # load means cookie age cannot become an unrecorded covariate. True, and it also made
        # the study permanently blind to the variable the README's thesis is ABOUT: a bid
        # request describes an audience, and a browser with no history has no audience to
        # describe. With --profile-dir the age is the real age of that profile in seconds, so
        # cold and warmed rows are distinguishable on the row rather than by which run
        # produced them.
        "profile_age_s": _profile_age_s(profile_dir), "window_s": settle,
        "profile_dir": os.path.basename(profile_dir) if profile_dir else None,
    }
    rows = []
    seen = {}      # playwright Request -> row
    table = load_domain_table()
    browser = ctx = None
    if nav_tries is None:
        nav_tries = NAV_TRIES
    t0 = time.time()

    def rel():
        return round(time.time() - t0, 3)

    try:
        # `--no-proxy-server` DOES NOT bypass the inherited proxy here, and believing it did
        # cost this study its entire treatment axis. Measured 2026-08-16, same node, same
        # chromium: launched with the flag alone the browser still reported 38.49.216.141
        # (privoxy's exit) from api.ipify.org, and every request to a host privoxy blocks
        # still failed ERR_TUNNEL_CONNECTION_FAILED — an error only a proxy CONNECT can
        # produce. Only stripping HTTP_PROXY/HTTPS_PROXY/ALL_PROXY from the CHILD's
        # environment moved the exit to 77.246.104.228, and betweendigital answered
        # (HTTP 400 to a bare GET) instead of failing. The env wins over the flag; the flag
        # is kept because it is harmless and states the intent.
        launch_env = None if use_proxy else {
            k: v for k, v in os.environ.items() if k not in PROXY_VARS}
        ctx_args = dict(locale="ru-RU", timezone_id="Europe/Moscow",
                        viewport={"width": 1366, "height": 900})
        if profile_dir:
            # A persistent context IS the browser — there is no separate browser object to
            # close, and closing the context is what flushes cookies to disk. Getting that
            # wrong loses the warming between runs, which would silently turn the treatment
            # arm back into the control.
            ctx = pw.chromium.launch_persistent_context(
                profile_dir, headless=not headed,
                args=[] if use_proxy else ["--no-proxy-server"],
                **({} if launch_env is None else {"env": launch_env}), **ctx_args)
            browser = None
        else:
            browser = pw.chromium.launch(headless=not headed,
                                         args=[] if use_proxy else ["--no-proxy-server"],
                                         **({} if launch_env is None else {"env": launch_env}))
            ctx = browser.new_context(**ctx_args)
        # The arm is verified from INSIDE the browser, per load, before the site is opened.
        # A launch flag is an intention and the parent's curl measures the parent; neither is
        # this browser's vantage. Missing renders null — never the expected value.
        if vantage_probe:
            load["browser_egress_ip"], load["browser_egress_attempts"] = echo_read(ctx)
            expected = load.get("egress_ip")
            load["vantage_verified"] = (
                None if load["browser_egress_ip"] is None
                else (load["browser_egress_ip"] == expected))
            if load["vantage_verified"] is False:
                load["note_vantage"] = (
                    f"arm `{arm}` claims {expected} but the browser left from "
                    f"{load['browser_egress_ip']} — this load's vantage is NOT the arm's")
        page = ctx.new_page()

        def on_request(req):
            try:
                if req.resource_type not in ("xhr", "fetch") and req.method != "POST":
                    return
                if len(seen) >= ROW_CAP:
                    load["rows_capped"] = load.get("rows_capped", 0) + 1
                    return
                from urllib.parse import urlparse
                host = (urlparse(req.url).hostname or "").lower()
                row = {
                    "schema": SCHEMA, "kind": "request", "load_id": load_id,
                    "t_request_s": rel(), "method": req.method, "host": host,
                    "url": req.url[:500], "resource_type": req.resource_type,
                    "floor": parse_request_floor(req.post_data),
                    "req_openrtb": request_is_openrtb(req.post_data),
                    "req_adfox": request_adfox_places(req.post_data),
                    # THE PAYLOAD ITSELF, kept raw rather than parsed into fields. A derived
                    # field ages the moment the parser improves (d28dbde's lesson); the raw
                    # body can be re-read by a better parser forever. It is the operator's
                    # OWN profile and it is NOT in adint-publish's allowlist — see the gate
                    # named for it there.
                    **_req_body_fields(req),
                    **_req_url_fields(req.url),
                    "outcome": None, "t_response_s": None, "status": None,
                }
                seen[req] = row
                rows.append(row)
            except Exception as e:
                load.setdefault("handler_errs", []).append(f"req: {type(e).__name__}")

        def on_response(resp):
            try:
                row = seen.get(resp.request)
                if row is None:
                    return
                row["status"] = resp.status
                row["t_response_s"] = rel()
                if resp.status >= 400:
                    row["outcome"] = "error"
                    row["detail"] = {"reason": f"http-{resp.status}"}
                    return
                if 300 <= resp.status < 400:
                    # A cookie-sync hop. It has no body to read, and filing it as `unread`
                    # reads as "we failed to look" — 16 such rows in the first sweep, mostly
                    # sync.dmp.otm-r.com / sync.programmatica.com / mc.acint.net.
                    row["outcome"] = "redirect"
                    row["detail"] = {"reason": f"http-{resp.status}",
                                     "location": (resp.headers or {}).get("location", "")[:200]}
                    return
                if resp.status == 204:
                    row["outcome"] = "no-bid"
                    row["detail"] = {"reason": "http-204"}
                    return
                try:
                    raw = resp.body()
                except Exception as e:
                    row["outcome"] = "unread"
                    row["detail"] = {"reason": f"body-unavailable: {type(e).__name__}"}
                    return
                if len(raw) > BODY_CAP:
                    row["outcome"] = "unread"
                    row["detail"] = {"reason": "body-over-cap", "bytes": len(raw)}
                    return
                try:
                    body = raw.decode("utf-8")
                except UnicodeDecodeError:
                    # Not text at all — a beacon's gif, a font, a compressed blob. Reading it
                    # through `resp.text()` raised, and the first version filed 124 of these
                    # as `unread`, which reads as "we failed to look" when the truth is "this
                    # was never an auction message".
                    row["outcome"] = "binary"
                    row["detail"] = {"reason": "body-not-utf8", "bytes": len(raw)}
                    return
                outcome, detail = parse_response(body)
                row["outcome"] = outcome
                row["detail"] = detail
            except Exception as e:
                load.setdefault("handler_errs", []).append(f"resp: {type(e).__name__}")

        def on_failed(req):
            try:
                row = seen.get(req)
                if row is None:
                    return
                # A request can FAIL AFTER its response already arrived — the wrapper aborts
                # in flight at its deadline, and the browser reports ERR_ABORTED for a socket
                # whose body was never consumed. Overwriting here turns an observed answer
                # into a phantom no-answer: the exact fold the design forbids, running
                # backwards. The abort is recorded; the concluded outcome stands.
                if row.get("outcome") is not None or row.get("status") is not None:
                    row["post_response_abort"] = True
                    row["abort_reason"] = (req.failure or "")[:80]
                    return
                fail = (req.failure or "")[:80]
                # A connection that never happened is not a bidder declining to speak. DNS,
                # TLS and refused connections are OUR network failing, and filing them as
                # silence would hand the study phantom timeouts — on this node's first live
                # capture, six rows failed ERR_CERT_AUTHORITY_INVALID and would have counted
                # as three bidders going quiet.
                net_fault = any(k in fail for k in (
                    "CERT", "NAME_NOT_RESOLVED", "CONNECTION_REFUSED", "CONNECTION_RESET",
                    "CONNECTION_CLOSED", "ADDRESS_UNREACHABLE", "INTERNET_DISCONNECTED",
                    "SSL", "PROXY", "TUNNEL", "UNSAFE_PORT", "BLOCKED_BY_CLIENT"))
                row["outcome"] = "error" if net_fault else "no-answer"
                row["detail"] = {"reason": f"failed: {fail}",
                                 "net_fault": net_fault}
                row["t_response_s"] = rel()
            except Exception:
                pass

        page.on("request", on_request)
        page.on("response", on_response)
        page.on("requestfailed", on_failed)

        # A NAVIGATION THAT NEVER CONNECTS IS TRANSIENT, and retrying it is the only lever
        # left once the other two are measured out. Evidence, RU tether 2026-08-19:
        #   - DNS was genuinely broken; fixing it moved the loss 46% -> 36%, p=0.56.
        #   - PATIENCE IS NOT OURS TO SPEND. Given a 600 s budget, aif.ru and kp.ru failed at
        #     133.1 s and 135.2 s with net::ERR_CONNECTION_TIMED_OUT — Chromium's own connect
        #     timeout fires first, so any --nav-timeout above ~135 s is inert.
        #   - mk.ru timed out at 120 s inside the cell and loaded in 3.8 s minutes later.
        # That last line is the argument: the page is not slow and the site is not refusing
        # us, the connection intermittently fails to establish. Same shape as the IP echo,
        # same remedy, same obligation to RECORD the attempts — a load that needed three
        # tries must never read as a first-try load.
        resp = None
        for attempt in range(1, max(1, nav_tries) + 1):
            load["nav_attempts"] = attempt
            try:
                resp = page.goto(url, wait_until="domcontentloaded",
                                 timeout=nav_timeout * 1000)
                break
            except Exception:
                if attempt >= max(1, nav_tries):
                    raise
                # A fresh page per attempt: the failed one may hold a half-open connection,
                # and any rows it collected belong to an attempt that never rendered.
                del rows[:]
                try:
                    page.close()
                except Exception:
                    pass
                page = ctx.new_page()
                page.on("request", on_request)
                page.on("response", on_response)
                page.on("requestfailed", on_failed)
        load["http_status"] = resp.status if resp else None
        load["final_url"] = page.url
        if load["http_status"] is not None and load["http_status"] >= 400:
            load["note"] = "page did not render; rows say nothing about the auction"
            return load, rows
        page.wait_for_timeout(settle * 1000)
        try:
            for y in (600, 1600):
                page.evaluate(f"window.scrollTo(0,{y})")
                page.wait_for_timeout(1200)
            page.evaluate("window.scrollTo(0,0)")
            page.wait_for_timeout(settle * 1000)
        except Exception as e:
            load["scroll_err"] = f"{type(e).__name__}"
        try:
            load.update(page.evaluate(WRAPPER_JS))
        except Exception as e:
            load["wrapper_err"] = f"{type(e).__name__}"
    except Exception as e:
        load["error"] = f"{type(e).__name__}: {str(e)[:200]}"
    finally:
        try:
            if ctx:
                ctx.close()
        except Exception:
            pass
        try:
            # None for a persistent context: the ctx close above already tore it down AND
            # flushed its cookies. Calling close on a missing browser would raise inside the
            # finally and mask whatever real error brought us here.
            if browser:
                browser.close()
        except Exception:
            pass

    load["observed_s"] = round(time.time() - t0, 2)
    roster = load.get("roster") or []
    wt = load.get("wrapper_timeout_ms")
    for row in rows:
        if row["outcome"] is None:
            # Asked, and nothing came back before we stopped looking. That is a statement
            # about our window; it is not the wrapper's timeout and is not a no-bid.
            row["outcome"] = "no-answer"
            row["detail"] = {"reason": "no-response-in-window"}
        pids = (row.get("req_adfox") or {}).get("placement_ids")
        row["bidder"], row["match_by"] = attribute(
            row["url"], row["host"], roster, table, pids, load.get("placements") or {})
        # A page fires far more xhr/fetch than it runs bidders: analytics, error beacons,
        # recommendation widgets. The first live capture put 194 rows on disk and 13 of them
        # landed in `no-bid` off metrica and error-reporting endpoints — a pixel that answers
        # 200 is not a bidder declining to bid, and counting it as one poisons exactly the
        # column the study reads. So an outcome is only a statement about a BIDDER when there
        # is evidence the row is bidder traffic, and the evidence is listed rather than
        # collapsed into a boolean somebody has to trust.
        d = row.get("detail") or {}
        evidence = []
        if row.get("req_openrtb"):
            evidence.append("openrtb-request")
        if row.get("req_adfox"):
            evidence.append("adfox-hb-request")
        if d.get("has_bids_key"):
            evidence.append("adfox-hb-response")
        if d.get("has_seatbid"):
            # Never `or outcome == "priced"`: that made the evidence a restatement of the
            # verdict it exists to justify, and the currency ticker above rode in on it.
            evidence.append("openrtb-response")
        if row.get("bidder"):
            evidence.append("attributed:" + str(row.get("match_by")))
        row["bid_evidence"] = evidence
        row["is_bid_candidate"] = bool(evidence)
        # Not all evidence is equal, and the difference decides who counts as ASKED. Protocol
        # evidence means we saw a bid request or a bid response. A name alone means only that
        # a bidder's host was contacted — and a bidder's cookie-sync pixel is contacted on
        # every page whether or not it is ever asked to bid. On fontanka.ru's first capture
        # 52 rows were "named" and a good share of them were sync hops.
        protocol = [e for e in evidence if e in (
            "adfox-hb-request", "adfox-hb-response", "openrtb-request", "openrtb-response")]
        row["evidence_strength"] = ("protocol" if protocol
                                    else ("attribution-only" if evidence else "none"))
        row["wrapper_timeout_ms"] = wt
        # Our window is in seconds, the wrapper's deadline in ms. If ours is the shorter one,
        # a `no-answer` here cannot be distinguished from a bidder the wrapper itself dropped.
        row["window_shorter_than_wrapper"] = bool(
            wt is not None and (load.get("window_s") or 0) * 1000 < wt)
        # …AND THE OTHER SIDE OF THE SAME CLOCK. Our window is longer than the wrapper's
        # deadline on most pages, so we observe answers the AUCTION ITSELF threw away:
        # measured 2026-08-19 on magnit.ru, `hybrid` returned 70.0 RUB CPM in 1747 ms of
        # bidder latency against a 500 ms wrapper deadline. A real bid, and NOT a price the
        # auction could have used — pooling it with in-time prices overstates both the depth
        # of demand and the clearing level.
        #
        # THE QUANTITY IS THE BIDDER'S OWN LATENCY, `t_response_s - t_request_s`, NOT
        # `t_response_s`. Both columns are measured from NAVIGATION START, while the wrapper's
        # deadline runs from when the auction starts. The first version of this flag compared
        # `t_response_s` against the deadline and reported 595/595 and 483/483 — **100 % of
        # answers late on BOTH arms**, which is the tell: a flag that fires on everything has
        # stopped being a measurement. The difference is the per-bidder latency the deadline
        # is actually about, and it separates the arms cleanly (median 171 ms vs 659 ms).
        #
        # Per REQUEST, because the deadline is per page and the latency is per bidder: a
        # consumer that wants "what the auction saw" filters on this, one that wants "what the
        # bidder was willing to pay" does not.
        _lat_ms = (None if (row.get("t_response_s") is None or row.get("t_request_s") is None)
                   else (row["t_response_s"] - row["t_request_s"]) * 1000)
        row["bidder_latency_ms"] = None if _lat_ms is None else round(_lat_ms, 1)
        row["answered_after_wrapper_deadline"] = bool(
            wt is not None and _lat_ms is not None and _lat_ms > wt)
        for k in ("run_idx", "arm", "arm_note", "egress_ip", "browser_used_proxy",
                  "nav_timeout_s", "nav_attempts",
                  "browser_egress_ip", "browser_egress_attempts",
                  "vantage_verified",
                  "hour_utc", "profile_age_s"):
            row[k] = load.get(k)
    return load, rows


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("urls", nargs="*")
    ap.add_argument("--file")
    ap.add_argument("--settle", type=int, default=8)
    ap.add_argument("--nav-timeout", type=int, default=30)
    ap.add_argument("--run-idx", type=int, default=0)
    ap.add_argument("--arm", default="A", help="contamination column: which interleaved arm")
    ap.add_argument("--arms", help="comma-separated arm labels, alternated PER LOAD (never in "
                                   "blocks: the hour is the dominant confounder)")
    ap.add_argument("--arm-note", help="what the arms actually differ in; REQUIRED with --arms, "
                                       "because a label is not a treatment")
    ap.add_argument("--treatment", choices=["proxy"],
                    help="make the arms a REAL treatment. `proxy` requires --arms proxy,direct "
                         "and runs the browser through the inherited privoxy on one arm and on "
                         "the node's own route on the other")
    ap.add_argument("--via", choices=["inherited-proxy", "direct"], default="inherited-proxy",
                    help="which route the browser takes when there is no --treatment. Naming "
                         "an arm `direct` does NOT make the run direct — the arm is a label "
                         "and this is the switch")
    ap.add_argument("--ip-echo",
                    help="comma-separated URL(s) returning a bare IP (the address may be "
                         "quoted), used for BOTH the parent's curl and the browser's read "
                         "(default https://api.ipify.org). Give SEVERAL: attempt i asks host "
                         "i %% len(hosts), so the retries you already pay for buy host "
                         "diversity instead of hammering one. Change it when the vantage "
                         "cannot reach or its resolver mangles the default — see IP_ECHO")
    ap.add_argument("--echo-timeout", type=int,
                    help="seconds the browser gets to read the IP echo (default: --nav-timeout, "
                         "min 12). Raise it on a slow vantage; it changes the patience, not the "
                         "gate — an unread echo still refuses the run")
    ap.add_argument("--profile-dir", default=None,
                    help="run in a PERSISTENT browser profile at this path (cookies and "
                         "storage survive between loads). Absent = a cold profile, which is "
                         "what every load before 2026-08-20 was. The row records "
                         "profile_age_s so the two are told apart on the row, not by run")
    ap.add_argument("--warm-arm", default=None,
                    help="make --profile-dir apply to THIS arm only; every other arm gets a "
                         "fresh cold context. Without it the profile applies to every load, "
                         "which forces cold and warmed into separate runs at separate hours "
                         "— and the hour is this market's dominant confounder, so a "
                         "block-assigned warming study measures the evening")
    ap.add_argument("--nav-tries", type=int, default=1,
                    help="how many times a load may retry a navigation that never connected "
                         "(default 1). Chromium's own connect timeout fires around 135 s, so "
                         "this is the lever --nav-timeout is not: measured on the RU tether "
                         "2026-08-19, mk.ru timed out at 120 s in a cell and loaded in 3.8 s "
                         "minutes later. The attempts used are recorded on every load")
    ap.add_argument("--echo-tries", type=int, default=1,
                    help="how many times the browser may retry an unread IP echo before the "
                         "run is refused (default 1). Raise it on a link that fails the echo "
                         "transiently — it changes how many reads are attempted, never what "
                         "an unread echo means. The count used is recorded on every row")
    ap.add_argument("--arm-offset", type=int, default=0,
                    help="shift the alternation; use 1 on the next pass so a site does not "
                         "always land in the same arm (see arm_plan)")
    ap.add_argument("--pair-prefix", default=None,
                    help="stamp every load with `<prefix>-<index>` so the two arms' rows "
                         "join on the pair, per step0c §2.4. Both arms must be given the "
                         "SAME prefix and the SAME ordered URL list — the key is positional")
    ap.add_argument("--out", default=OUT)
    ap.add_argument("--headed", action="store_true")
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()

    # Patience for the echo read, in ms. Derived from --nav-timeout so a vantage that needs a
    # long navigation is not refused for a short echo, with the old 12s as the floor.
    global ECHO_TIMEOUT_MS, IP_ECHO, ECHO_TRIES, NAV_TRIES
    ECHO_TIMEOUT_MS = max(12, args.echo_timeout or args.nav_timeout) * 1000
    ECHO_TRIES = max(1, args.echo_tries)
    NAV_TRIES = max(1, args.nav_tries)
    if args.ip_echo:
        IP_ECHO = args.ip_echo

    try:
        from playwright.sync_api import sync_playwright
    except ImportError:
        print("n/a: no playwright in this interpreter (use ~/.venv-browser/bin/python3)",
              file=sys.stderr)
        return 2

    if args.test:
        return selftest(sync_playwright)

    urls = list(args.urls)
    if args.file:
        with open(args.file) as fh:
            for line in fh:
                line = line.split("#", 1)[0].strip()
                if line:
                    urls.append(line)
    if not urls:
        print("no urls", file=sys.stderr)
        return 2

    arms = [a.strip() for a in (args.arms or args.arm).split(",") if a.strip()]
    plan = arm_plan(len(urls), arms, args.arm_offset)
    if args.treatment == "proxy":
        if sorted(arms) != ["direct", "proxy"]:
            print("refusing: --treatment proxy needs --arms proxy,direct", file=sys.stderr)
            return 2
        # The note is GENERATED here rather than typed, so it cannot drift from what the code
        # actually does — this node spent a whole sweep believing a hand-written vantage.
        args.arm_note = ("treatment=proxy: arm `proxy` leaves through the inherited privoxy "
                         "(127.0.0.1:8118 -> socks5 1080), arm `direct` through the node's own "
                         "default route")
    if arms_need_note(arms, args.arm_note):
        # An arm label with no stated treatment is a column that LOOKS like an experiment.
        # Somebody reading `arm: A` / `arm: B` months later will believe two conditions were
        # run; if they were identical, the honest name for that is an A/A null and it has to
        # be said on the row, not remembered.
        print("refusing: --arms without --arm-note. State what the arms differ in "
              "(use --arm-note 'A/A null: identical treatment' if they do not).",
              file=sys.stderr)
        return 2

    ip = egress_ips()
    if ip.get("proxy_env") and args.treatment != "proxy" and args.via != "direct":
        print(f"note: this shell exports a proxy ({ip['proxy_env']}); the browser inherits it. "
              f"proxied exit {ip.get('egress_ip_proxied')} · direct exit "
              f"{ip.get('egress_ip_direct')}", file=sys.stderr)
    os.makedirs(os.path.dirname(args.out), exist_ok=True)
    with sync_playwright() as pw:
        # PREFLIGHT: prove the treatment exists before spending a sweep on it. The first
        # proxy/direct sweep (117 loads per arm) was an A/A null nobody could see, because
        # the only evidence for the arm was the flag we passed and a curl the parent ran.
        if args.treatment == "proxy":
            seen_exits = {}
            for a in ("proxy", "direct"):
                up = (a == "proxy")
                env = None if up else {k: v for k, v in os.environ.items()
                                       if k not in PROXY_VARS}
                b = pw.chromium.launch(headless=True,
                                       args=[] if up else ["--no-proxy-server"],
                                       **({} if env is None else {"env": env}))
                try:
                    seen_exits[a] = browser_egress(b.new_context())  # tries per ECHO_TRIES
                finally:
                    b.close()
            print(f"preflight vantage: proxy={seen_exits['proxy']} direct={seen_exits['direct']}",
                  file=sys.stderr)
            if None in seen_exits.values():
                shell_echo_control("proxy/direct preflight")
                print("refusing: the echo could not be read, so the arms are unproven "
                      "(no vantage evidence is not evidence of a vantage)", file=sys.stderr)
                return 2
            if seen_exits["proxy"] == seen_exits["direct"]:
                print(f"refusing: both arms leave from {seen_exits['direct']} — the labels "
                      "differ and the treatment does not", file=sys.stderr)
                return 1
            if seen_exits["direct"] != ip.get("egress_ip_direct"):
                print(f"note: the browser's direct exit ({seen_exits['direct']}) is not the "
                      f"parent's ({ip.get('egress_ip_direct')}); the ROW records the browser's",
                      file=sys.stderr)
                ip["egress_ip_direct"] = seen_exits["direct"]
            if seen_exits["proxy"] != ip.get("egress_ip_proxied"):
                ip["egress_ip_proxied"] = seen_exits["proxy"]
        elif args.via == "direct":
            # Same preflight for a single-arm sweep: a run asked to leave by the node's own
            # route proves it once before spending an hour, rather than labelling every row.
            env = {k: v for k, v in os.environ.items() if k not in PROXY_VARS}
            b = pw.chromium.launch(headless=True, args=["--no-proxy-server"], env=env)
            try:
                seen, seen_tries = echo_read(b.new_context())
            finally:
                b.close()
            print(f"preflight vantage: via=direct exit={seen} echo_attempts={seen_tries}"
                  f"/{ECHO_TRIES}", file=sys.stderr)
            if seen is None:
                shell_echo_control("via=direct preflight")
                print("refusing: the echo could not be read, so --via direct is unproven",
                      file=sys.stderr)
                return 2
            if seen == ip.get("egress_ip_proxied"):
                print(f"refusing: --via direct still leaves from {seen} (the proxy's exit)",
                      file=sys.stderr)
                return 1
            ip["egress_ip_direct"] = seen
        for i, u in enumerate(urls, 1):
            arm = plan[i - 1]
            use_proxy = ((arm == "proxy") if args.treatment == "proxy"
                         else args.via != "direct")
            # The pair key is the INDEX in the shared, identically-ordered URL list — not a
            # random id and not the clock. Both arms are handed the same list, so the same
            # site lands on the same key in both without the arms having to talk to each
            # other; and because it is positional, a run whose list differs cannot silently
            # produce fake pairs — the sites under a key would simply not match, which is
            # checkable after the fact. Absent --pair-prefix the field stays null.
            pair_id = pair_key(args.pair_prefix, i)
            load, rows = capture(pw, u, args.settle, args.nav_timeout, ip, args.run_idx,
                                 arm, arm_note=args.arm_note, use_proxy=use_proxy,
                                 pair_id=pair_id, nav_tries=NAV_TRIES,
                                 profile_dir=_profile_for_arm(
                                     arm, args.warm_arm, args.profile_dir))
            with open(args.out, "a") as fh:
                fh.write(json.dumps(load, ensure_ascii=False) + "\n")
                for r in rows:
                    fh.write(json.dumps(r, ensure_ascii=False) + "\n")
            # Two tallies, never one: the outcome counts that MATTER are the candidate ones,
            # and printing a single mixed number is how a page's analytics traffic gets read
            # as an auction.
            cand = [r for r in rows if r.get("is_bid_candidate")]
            tally = {}
            for r in cand:
                tally[r["outcome"]] = tally.get(r["outcome"], 0) + 1
            named = sum(1 for r in cand if r.get("bidder"))
            print(f"[{i}/{len(urls)}] {u} arm={load.get('arm')} "
                  f"proxy={load.get('browser_used_proxy')} load={load['load_id']} "
                  f"status={load.get('http_status')} wrapper_timeout={load.get('wrapper_timeout_ms')} "
                  f"roster={len(load.get('roster') or [])} rows={len(rows)} "
                  f"candidates={len(cand)} named={named} "
                  f"{' '.join(f'{k}={v}' for k, v in sorted(tally.items())) or '(no candidate rows)'}")
            sys.stdout.flush()
    return 0


def selftest(sync_playwright):
    """Drive a real browser against a local wrapper page and a local stub bidder.

    The point of a local fixture is that it is provable WITHOUT demand: this node's egress is
    a Montréal datacenter ASN and no real bidder will bid to it, so a gate that needed a live
    auction could never run here. Every outcome the classifier can emit is served on purpose,
    including one that never answers.
    """
    import http.server
    import socketserver
    import tempfile as _tf
    import threading

    ok = True
    PRICED = json.dumps({
        "cur": "RUB",
        # The decoy: an adjusted number, larger, sitting right beside the real one. A collector
        # that reads it instead of `price` reports a different distribution entirely.
        "seatbid": [{"bid": [{"impid": "1", "price": 1.23, "cpm": 9.99, "adm": "<div/>"}]}],
    })
    EMPTY = json.dumps({"cur": "RUB", "seatbid": []})

    class H(http.server.BaseHTTPRequestHandler):
        def _send(self, code, body=b"", ctype="application/json"):
            self.send_response(code)
            self.send_header("Content-Type", ctype)
            self.send_header("Access-Control-Allow-Origin", "*")
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            if body:
                self.wfile.write(body)

        def do_POST(self):
            n = int(self.headers.get("Content-Length") or 0)
            if n:
                self.rfile.read(n)
            if self.path.startswith("/priced"):
                self._send(200, PRICED.encode())
            elif self.path.startswith("/nobid204"):
                self._send(204)
            elif self.path.startswith("/nobid-empty"):
                self._send(200, EMPTY.encode())
            elif self.path.startswith("/err"):
                self._send(500, b"{}")
            elif self.path.startswith("/adfox-nobid"):
                # The measured shape: a real bidder, answering, declining.
                self._send(200, b'{"bids":[]}')
            elif self.path.startswith("/adfox-cpm"):
                # sparrow's real shape, measured on fontanka.ru: no `price` key at all.
                self._send(200, json.dumps({"bids": [
                    {"placementId": "320892", "currency": "RUB", "cpm": 1.6466222636311705,
                     "codeType": "html", "displayCode": "<!-- Sparrow -->"}]}).encode())
            elif self.path.startswith("/adfox-both"):
                # Both fields present: `price` is the bid, `cpm` is post-adjustment.
                self._send(200, json.dumps({"bids": [
                    {"placementId": "1", "currency": "RUB", "price": 1.23, "cpm": 9.99}]}).encode())
            elif self.path.startswith("/adfox-zero"):
                # A returned bid worth nothing. Not demand.
                self._send(200, json.dumps({"bids": [
                    {"placementId": "2", "currency": "RUB", "cpm": 0.0}]}).encode())
            elif self.path.startswith("/adfox-bid"):
                # A bid came back and nothing in it is called `price`. The collector must not
                # invent a price field; it records the raw bid and every number in it.
                self._send(200, json.dumps({"bids": [
                    {"placementId": "69ebPID", "width": 300, "height": 600,
                     "bidValue": 42.5, "html": "<div/>"}]}).encode())
            elif self.path.startswith("/currency"):
                # A widget, not an auction: `price` is a dollar rate. Answered to an
                # auction-shaped request so the leg cannot pass on the request shape alone.
                self._send(200, json.dumps({"currency": {"USD": {"price": 84.54}}}).encode())
            elif self.path.startswith("/badbids"):
                # The bidder rejecting the protocol, in its own words (their typo).
                self._send(200, b'{"bids":["INCORRECT_UNPUT"]}')
            elif self.path.startswith("/sync"):
                # A cookie-sync hop carrying a bidder's name: contacted, never asked to bid.
                self.send_response(302)
                self.send_header("Location", "/nobid204")
                self.send_header("Access-Control-Allow-Origin", "*")
                self.send_header("Content-Length", "0")
                self.end_headers()
            elif self.path.startswith("/beacon"):
                # Analytics: answers 200, carries no price, and is not a bidder. The page
                # fires more of these than it runs bidders.
                self._send(200, b'{"ok":1}')
            elif self.path.startswith("/binary"):
                self._send(200, bytes([0x1f, 0x8b, 0x08, 0x00, 0xff, 0xfe, 0x00, 0x80]),
                           "application/octet-stream")
            elif self.path.startswith("/warm"):
                self._send(200, b'{"ok":1}')
            elif self.path.startswith("/silent"):
                # Answers long after the capture window closes: asked, never answered.
                time.sleep(60)
                self._send(200, EMPTY.encode())
            else:
                self._send(404, b"{}")

        def do_GET(self):
            if self.path.startswith("/page"):
                self._send(200, PAGE.encode(), "text/html; charset=utf-8")
            else:
                self._send(404, b"")

        def log_message(self, *a):
            pass

    class TS(socketserver.ThreadingTCPServer):
        daemon_threads = True
        allow_reuse_address = True

    srv = TS(("127.0.0.1", 0), H)
    port = srv.server_address[1]
    base = f"http://127.0.0.1:{port}"
    # A port nothing listens on, taken from the kernel and released — Chrome refuses the
    # low ports outright (ERR_UNSAFE_PORT), which is a different failure from a refused
    # connection and would let this leg pass for the wrong reason.
    import socket as _socket
    _s = _socket.socket()
    _s.bind(("127.0.0.1", 0))
    dead_port = _s.getsockname()[1]
    _s.close()
    # A wrapper page: a roster and a deadline in the same shape the live sites carry, and one
    # request per bidder, each with the floor stated in the request the way OpenRTB states it.
    PAGE = f"""<html><body>fixture
<script>
window.Ya = {{adfoxCode: {{}}}};
window.YaHeaderBiddingSettings = {{
  timeout: 1200,
  biddersMap: {{betweenDigital: 'x', myTarget: 'y'}},
  adUnits: [{{code: 'top', bids: [{{bidder: 'betweendigital'}}, {{bidder: 'mytarget'}},
                                  {{bidder: 'buzzoola'}}, {{bidder: 'astralab'}}, {{bidder: 'adriver'}},
                                  {{bidder: 'mediasniper', params: {{placementId: '41139'}}}},
                                  {{bidder: 'astralab2', params: {{placementId: '69ebPID'}}}}]}}]
}};
function askAdfox(path, pid) {{
  return fetch('{base}' + path, {{
    method: 'POST',
    body: JSON.stringify({{places: [{{id: 'begun_block_1', placementId: pid,
                                     sizes: [[970, 250]], codeType: 'combo',
                                     targetRef: location.href}}]}})
  }}).catch(function(e) {{}});
}}
function ask(path, floor) {{
  return fetch('{base}' + path, {{
    method: 'POST',
    body: JSON.stringify({{imp: [{{id: '1', bidfloor: floor, bidfloorcur: 'RUB'}}]}})
  }}).catch(function(e) {{}});
}}
ask('/priced?bidder=betweendigital', 0.5);
ask('/nobid204?bidder=mytarget', 0.5);
ask('/nobid-empty?bidder=buzzoola', 0.7);
ask('/silent?bidder=astralab', 0.9);
ask('/err?bidder=unknownvendor', 0.1);
// The market's real protocol: places + placementId out, {{"bids":[…]}} back.
askAdfox('/adfox-nobid', '41139');
askAdfox('/adfox-bid', '69ebPID');
askAdfox('/adfox-cpm', '320892');
askAdfox('/adfox-both', '41139');
askAdfox('/adfox-zero', '69ebPID');
askAdfox('/currency', '41139');
askAdfox('/badbids', '69ebPID');
// A bidder's host, contacted for a cookie sync — named, but never asked to bid.
fetch('{base}/sync?bidder=adriver', {{method: 'POST', body: '{{"u":"1"}}'}}).catch(function(e) {{}});
// Not an auction message at all: no imp in the request, no seatbid in the answer.
fetch('{base}/beacon?evt=pageview', {{method: 'POST', body: '{{"evt":"pv"}}'}}).catch(function(e) {{}});
// Not text: a beacon's compressed blob. Reading it as UTF-8 raises.
fetch('{base}/binary?evt=px', {{method: 'POST', body: '{{"evt":"px"}}'}}).catch(function(e) {{}});
// The network failing is not a bidder going quiet.
fetch('http://127.0.0.1:{dead_port}/refused', {{method: 'POST', body: '{{"imp":[{{"id":"1"}}]}}'}}).catch(function(e) {{}});
// THE WARMING PROBE. Reports the cookie jar as it was found, BEFORE writing to it — a report
// taken after the write says '1' on a cold profile too, which is exactly the reading that
// would make a broken persistent context look like a working one.
fetch('{base}/warm', {{method: 'POST',
                       body: JSON.stringify({{cookie_before: document.cookie}})}}).catch(function(e) {{}});
document.cookie = 'adint_warm=1; path=/; max-age=3600';
</script></body></html>"""
    threading.Thread(target=srv.serve_forever, daemon=True).start()

    live = {"ran": False, "proxied": None, "direct": None, "load": None, "why": None,
            "warm": None}
    try:
        with sync_playwright() as pw:
            load, rows = capture(pw, f"{base}/page", 2, 20,
                                 {"egress_ip_proxied": "proxy-ip",
                                  "egress_ip_direct": "direct-ip",
                                  "proxy_env": "http://127.0.0.1:8118"}, 7, "B",
                                 vantage_probe=False, pair_id=pair_key("t", 4))
            # The same fixture on the node's own route: the browser must be launched with the
            # inherited proxy disabled, and the row must say which exit it used.
            load_d, rows_d = capture(pw, f"{base}/page", 2, 20,
                                     {"egress_ip_proxied": "proxy-ip",
                                      "egress_ip_direct": "direct-ip",
                                      "proxy_env": "http://127.0.0.1:8118"}, 7, "direct",
                                     use_proxy=False, vantage_probe=False,
                                     pair_id=pair_key("t", 4))
            # PERSISTENT PROFILE: two loads on one dir. The second must FIND the cookie the
            # first left, which is the only evidence the context persisted anything — a
            # profile flag that silently fell back to an ephemeral context would turn the
            # warmed arm back into the control while every row still said `warm`.
            _pdir = os.path.join(_tf.mkdtemp(prefix="adint-warm-gate-"), "p")
            warm1, wrows1 = capture(pw, f"{base}/page", 2, 20,
                                    {"egress_ip_proxied": "p", "egress_ip_direct": "d",
