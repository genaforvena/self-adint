def hole_counts(d, vantage):
    """(holes in the canonical frame, holes in the other) — a HOLE is a domain the other
    vantage admits that this one REACHED and did not admit. A domain this vantage has not
    reached yet is pending, not a hole, and conflating them is how a frame's completeness
    gets overstated."""
    fr = d["frames"]
    if len(fr) < 2 or not vantage:
        return 0, 0
    me = next((f for f in fr if f["vantage"] == vantage), None)
    other = next((f for f in fr if f["vantage"] != vantage), None)
    if not me or not other:
        return 0, 0
    vm = {r["domain"]: r.get("stageb_verdict") for r in me["rows"]}
    vo = {r["domain"]: r.get("stageb_verdict") for r in other["rows"]}
    adm_m = {k for k, v in vm.items() if v == "admit"}
    adm_o = {k for k, v in vo.items() if v == "admit"}
    return (len((adm_o & set(vm)) - adm_m), len((adm_m & set(vo)) - adm_o))


def canonical_vantage():
    """The vantage named in ref/CANONICAL-FRAME, or None if nothing is declared."""
    p = os.path.join(REPO, "ref", "CANONICAL-FRAME")
    if not os.path.exists(p):
        return None
    for line in open(p, encoding="utf-8"):
        line = line.strip()
        if line.startswith("#") or ":" not in line:
            continue
        k, v = line.split(":", 1)
        if k.strip() == "vantage":
            return v.strip() or None
    return None


def build(d, generated):
    fr = d["frames"]
    cells = d["cells"]
    # The canonical frame is DECLARED in ref/CANONICAL-FRAME, not inferred. "The one with
    # more admissions" would re-point the study every time a walk got further, and size is
    # not why a frame is canonical — absence of a hole is (see that file).
    canon = canonical_vantage()
    main = next((f for f in fr if f["vantage"] == canon), None) if canon else None
    undeclared = main is None
    if main is None:
        main = fr[0] if fr else None
    total = len(main["rows"]) if main else 0
    admits = main["admitted"] if main else []
    density = (100.0 * len(admits) / total) if total else 0.0

    P = []
    A = P.append
    A('<title>Where Russian Header Bidding Starts</title>')
    A('<link rel="preconnect" href="https://fonts.googleapis.com">')
    A('<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>')
    A('<link rel="stylesheet" href="https://fonts.googleapis.com/css2?'
      'family=Literata:ital,opsz,wght@0,7..72,400;0,7..72,600;0,7..72,700;1,7..72,400'
      '&family=IBM+Plex+Mono:wght@400;600&display=swap">')
    A(f"<style>{CSS}</style>")
    A('<div class="wrap">')

    # ── masthead
    A('<header class="masthead">')
    A(f'<div class="kicker"><span>self-adint · step 0d</span><span>generated {generated}</span>'
      f'<span>CC0 1.0</span></div>')
    A('<h1>Where Russian header bidding starts</h1>')
    A('<p class="standfirst">A frame built by a published rule, walked in rank order — and the '
      'rule inverted on contact. What follows is a report about an instrument, not about a '
      'market. Every figure carries its <span class="mono">n</span> and the vantage it was '
      'measured from.</p>')
    A('</header>')

    # ── tiles
    A('<section>')
    A('<span class="status">Measured</span>')
    A('<div class="tiles">')
    A(f'<div class="tile"><span class="lab">domains walked</span><span class="n">{total}</span>'
      f'<span class="sub">in strict Tranco rank order from a universe of 1,944</span></div>')
    A(f'<div class="tile"><span class="lab">in the frame</span>'
      f'<span class="n" style="color:var(--evidence)">{len(admits)}</span>'
      f'<span class="sub">carry an auction config we can read</span></div>')
    A(f'<div class="tile"><span class="lab">admission density</span>'
      f'<span class="n">{density:.1f}%</span>'
      f'<span class="sub">the study\'s binding cost is the frame, not the capture</span></div>')
    first = min([r for r, _, _ in admits] or [0])
    A(f'<div class="tile"><span class="lab">first admission at rank</span>'
      f'<span class="n">#{first}</span>'
      f'<span class="sub">nothing above it runs an observable auction</span></div>')
    A('</div>')
    # AFTER the grid closes. Emitted inside it, this paragraph became a grid ITEM sitting
    # between two tiles — the tiles container is a `repeat(auto-fit, minmax(190px,1fr))`
    # grid, so a stray <p> takes a cell and shoves the last tile onto its own row. Nothing
    # in the generator complains; it only shows up in the rendered page.
    if not undeclared:
        # DERIVED, not asserted. This sentence first read "a frame built from the other
        # vantage is missing real publishers outright" — true when the canonical frame had no
        # hole of its own, false fifteen minutes later when the walk found one. Twice now a
        # hand-written conclusion has outlived its data on this page; the fix is the same
        # both times, so it is applied here rather than re-typed.
        hn, ho = hole_counts(d, main["vantage"] if main else None)
        if ho and hn:
            verdict = (f'Neither frame is complete: the other vantage is missing '
                       f'<strong>{ho}</strong> domain{"s" if ho != 1 else ""} this one '
                       f'admits, and this one is missing <strong>{hn}</strong> that it '
                       f'admits. The union of both is strictly better than either — see '
                       f'below.')
        elif ho:
            verdict = (f'That is not a formality: a frame built from the other vantage is '
                       f'missing <strong>{ho}</strong> real publisher'
                       f'{"s" if ho != 1 else ""} outright, and this one is missing none of '
                       f'what the other admits — see below.')
        else:
            verdict = ('At the ranks walked so far the two vantages admit the same set, so '
                       'this declaration costs nothing either way — see below.')
        A(f'<p>The study runs on the frame built from '
          f'<strong class="mono">{html.escape(main["vantage"])}</strong>, declared in '
          f'<code>ref/CANONICAL-FRAME</code>. {verdict}</p>')
    A('</section>')

    # ── the ledger
    if main:
        A('<section>')
        A('<span class="status">Measured · rejections published</span>')
        A('<h2>The rejections are half the dataset</h2>')
        A('<p>A frame that publishes only what it admitted cannot be audited. Every domain the '
          'probe touched is here with its verdict, and the verdicts are kept apart by <em>whose '
          'fact</em> they are — because folding our own blindness into a finding about the '
          'market is the one mistake this study cannot afford.</p>')
        A('<figure><div class="panel">')
        A(seg_bar(main["tally"], total))
        A('<div class="legend" style="margin-top:14px">'
          '<span><i class="swatch sw-evidence"></i>we saw an auction</span>'
          '<span><i class="swatch sw-domain"></i>a fact about the domain</span>'
          '<span><i class="swatch sw-blind"></i>our own blindness</span></div>')
        A('</div>')
        if undeclared:
            A('<p class="note">No canonical frame is declared in '
              '<code>ref/CANONICAL-FRAME</code>, so this section shows whichever walk sorted '
              'first. Which vantage a frame is built from changes its membership — see below '
              '— so an undeclared frame is a frame nobody has chosen.</p>')
        # PROVENANCE, on the page rather than in the tool's stdout. A reader who cannot fetch
        # the ledger this chart is drawn from cannot check it, and that is a property of the
        # chart, not a footnote about our workflow.
        if not main.get("public"):
            A('<p class="note">This chart is drawn from a ledger that is '
              '<strong>not published</strong> — it lives in the working tree only, so the '
              'numbers here cannot yet be checked against a file you can fetch. Run '
              '<code>tools/adint-publish</code> to close that gap.</p>')
        if main.get("note"):
            A(f'<p class="note">Verdicts are re-derived from the stored probe rows at read '
              f'time, not taken from the ledger: {html.escape(main["note"])}. A stored '
              f'verdict is a claim about the page <em>and</em> about the code that read it, '
              f'and it ages the moment that code is fixed.</p>')
        A(f'<figcaption>All {total} domains walked from vantage '
          f'<span class="mono">{html.escape(main["vantage"])}</span>'
          f'{" · browser egress " + html.escape(", ".join(main["egress"])) if main["egress"] else ""}. '
          f'Segment widths are shares of {total}; hover any segment for its count.</figcaption>')
        A('</figure>')

        A('<div class="tablewrap"><table>')
        A('<thead><tr><th>verdict</th><th>n</th><th>state of knowledge</th>'
          '<th>what it means</th></tr></thead><tbody>')
        for v in VERDICT_ORDER:
            n = main["tally"].get(v, 0)
            if not n:
                continue
            cls = VERDICT_CLASS[v]
            nice = {"evidence": "evidence", "blind": "our blindness",
                    "domain": "about the domain"}[cls]
            A(f'<tr><td><span class="dot sw-{cls}"></span><code>{html.escape(v)}</code></td>'
              f'<td class="n">{n}</td><td>{nice}</td>'
              f'<td>{html.escape(VERDICT_GLOSS.get(v, ""))}</td></tr>')
        A('</tbody></table></div>')
        A('</section>')

        # ── rank strip
        A('<section>')
        A('<span class="status">Measured</span>')
        A('<h2>Header bidding does not live at the top of the list</h2>')
        A('<p>Tranco ranks by resolver traffic, so it answers <em>what is resolved</em>, not '
          '<em>what a person reads with ads on it</em>. The top of the Russian list is CDNs, '
          'registrars, telecoms, marketplaces and government. The first domain that runs an '
          'auction we can observe appears far down the walk.</p>')
        A('<figure><div class="panel">')
        A(rank_strip(main["ranks"], admits))
        A('</div><figcaption>Every domain walked (faint) and every domain admitted (solid), '
          'positioned by Tranco rank.</figcaption></figure>')
        if admits:
            A('<div class="tablewrap"><table>')
            A('<thead><tr><th>rank</th><th>domain</th><th>evidence for admission</th>'
              '</tr></thead><tbody>')
            for r, dom, ev in sorted(admits):
                A(f'<tr><td class="n">#{r}</td><td><code>{html.escape(dom)}</code></td>'
                  f'<td class="mono">{html.escape(ev)}</td></tr>')
            A('</tbody></table></div>')
        A('<p class="note">The rule first admitted seven domains near the top of the list — '
          'including two registrars and an image CDN. Not one of them carried a bidder roster: '
          'they had been admitted on Yandex’s ad-<em>serving</em> globals, which mean a page '
          'shows advertising, not that it asks several bidders. The frame contained zero '
          'instances of the phenomenon the study measures, and looked full.</p>')
        A('</section>')

    # ── the paired cell
    if cells:
        by_arm = {c["arm"]: c for c in cells}
        arms = [a for a in ("nl-direct", "ru-mobile") if a in by_arm] or list(by_arm)
        # EVERY outcome present, not the two that make the point. `binary` and `unread` are
        # our own read failures and they land almost equally on both arms — which is exactly
        # what makes the no-bid/no-answer split meaningful rather than cherry-picked. A chart
        # that showed only the two moving columns would be arguing, not reporting.
        cats = ["priced", "no-bid", "no-answer", "unread", "binary", "redirect", "error",
                "bid-zero", "unparsed"]
        present = sorted({c for a in arms for c in by_arm[a]["outcomes"] if c})
        cats = [c for c in cats if c in present] + [c for c in present if c not in cats]
        series = []
        for a in arms:
            cls = EVIDENCE if a.startswith("nl") else BLIND
            series.append((a, {c: by_arm[a]["outcomes"].get(c, 0) for c in cats}, cls))
        A('<section>')
        A('<span class="status">Measured · confounded, and named</span>')
        A('<h2>The slow arm turns answers into silence</h2>')
        A('<p>Both arms load the same site in the same minute — a barrier, not two walks that '
          'drift apart — and read the same bidder roster off the page. They still disagree '
          'about the market, and the disagreement is the link, not the demand.</p>')
        A('<figure><div class="panel">')
        A(grouped_bars(series, cats))
        A('<div class="legend" style="margin-top:10px">'
          + "".join(f'<span><i class="swatch sw-{cls}"></i>{html.escape(lab)}</span>'
                    for lab, _, cls in series) + '</div>')
        A('</div>')
        n_pairs = len(set().union(*[set(c["pairs"]) for c in cells])) if cells else 0
        A(f'<figcaption>Candidate bid requests across {n_pairs} simultaneous pair(s), '
          f'window 45 s on both arms. <strong>no-bid</strong> is a bidder answering '
          f'“no”; <strong>no-answer</strong> is a bidder asked and silent inside our '
          f'window.</figcaption></figure>')
        A('<div class="cols">')
        for a in arms:
            c = by_arm[a]
            A('<div class="panel"><h3 class="mono">' + html.escape(a) + '</h3>'
              f'<p style="font-size:15px;color:var(--muted);margin-top:8px">'
              f'egress {html.escape(", ".join(c["egress"]) or "?")} · {c["loads"]} load(s), '
              f'{c["verified"]}/{c["loads"]} with the exit verified from inside the browser · '
              f'{c["candidates"]} candidate requests · wrapper deadline '
              f'{", ".join(str(x) for x in c["deadline"]) or "?"} ms</p></div>')
        A('</div>')
        # The headline ratio, computed rather than asserted: of the bidders that were asked and
        # either declined or stayed silent, what fraction stayed silent?
        A('<div class="tiles">')
        for a in arms:
            o = by_arm[a]["outcomes"]
            nb, na = o.get("no-bid", 0), o.get("no-answer", 0)
            den = nb + na
            pct = (100.0 * na / den) if den else 0.0
            A(f'<div class="tile"><span class="lab">{html.escape(a)} · silence rate</span>'
              f'<span class="n" style="color:var({"--evidence" if a.startswith("nl") else "--blind"})">'
              f"{pct:.1f}%</span>"
              f'<span class="sub">{na} of {den} asked bidders said nothing rather than '
              f'declining</span></div>')
        A('</div>')
        A('<p class="note">Measured round-trip time on the mobile arm is 400–1100 ms against '
          'a wrapper deadline of 1000 ms. A bidder that answers perfectly promptly still misses '
          'the publisher’s own deadline, and the page records silence. So “Russian '
          'bidders are less responsive” cannot be read off this arm at all — vantage and '
          'channel are perfectly confounded, and the difference is two main effects wearing the '
          'interaction’s name. A third arm, the datacentre link degraded to the mobile '
          'arm’s measured profile, is what would separate them.</p>')
        A('</section>')

    # ── vantage agreement
    if len(fr) > 1:
        a, b = fr[0], fr[1]
        va = {r["domain"]: r.get("stageb_verdict") for r in a["rows"]}
        vb = {r["domain"]: r.get("stageb_verdict") for r in b["rows"]}
        common = sorted(set(va) & set(vb))
        differ = [d for d in common if va[d] != vb[d]]
        # The verdict that matters is `blocked`, and specifically a `blocked` that turns into
        # an ADMISSION from the other side: that is a real site the first vantage cannot see
        # at all, and it does not average out — it is missing from the frame.
        flips = [d for d in differ
                 if "blocked" in (va[d], vb[d]) and "admit" in (va[d], vb[d])]
        blocked_diff = [d for d in differ if "blocked" in (va[d], vb[d])]
        lo = min([r.get("rank") or 0 for r in a["rows"] if r["domain"] in common] or [0])
        hi = max([r.get("rank") or 0 for r in a["rows"] if r["domain"] in common] or [0])
        A('<section>')
        # THE CLAIM IS DERIVED, NOT TYPED. An earlier version of this page carried the
        # sentence "not an artefact of where we stand — so far" as prose, written when the
        # walk had reached rank 865 and the vantages agreed 25/25. Two hundred ranks later
        # they did not, and the prose would have gone on asserting a tie. A page that
        # regenerates its numbers and not its conclusions is worse than one that regenerates
        # neither, because it looks current.
        if flips:
            A('<span class="status">Measured · the frame depends on where we stand</span>')
            A('<h2>A frame built from one vantage silently omits real sites</h2>')
            A(f'<p>Across the <strong>{len(common)}</strong> domains both walks reached '
              f'(ranks {lo}–{hi}), the two vantages returned '
              f'<strong>{len(common)-len(differ)}</strong> identical verdicts and '
              f'<strong>{len(differ)}</strong> different ones. That headline understates it. '
              f'<strong>{len(flips)}</strong> domain'
              f'{"s were" if len(flips) != 1 else " was"} refused outright from one vantage '
              f'and <em>admitted to the frame</em> from the other — real publishers running '
              f'real auctions that one observer cannot see exist.</p>')
            A('<div class="tablewrap"><table><thead><tr><th>rank</th><th>domain</th>'
              f'<th>{html.escape(a["vantage"])}</th><th>{html.escape(b["vantage"])}</th>'
              '</tr></thead><tbody>')
            rank_of = {r["domain"]: r.get("rank") for r in a["rows"]}
            for d in sorted(differ, key=lambda d: rank_of.get(d) or 0):
                hot = ' style="font-weight:600"' if d in flips else ""
                A(f'<tr{hot}><td class="n">#{rank_of.get(d)}</td>'
                  f'<td><code>{html.escape(d)}</code></td>'
                  f'<td><span class="dot sw-{VERDICT_CLASS.get(va[d], DOMAIN)}"></span>'
                  f'<code>{html.escape(va[d] or "")}</code></td>'
                  f'<td><span class="dot sw-{VERDICT_CLASS.get(vb[d], DOMAIN)}"></span>'
                  f'<code>{html.escape(vb[d] or "")}</code></td></tr>')
            A('</tbody></table></div>')
            A(f'<p class="note">Of {len(blocked_diff)} domains where either vantage said '
              f'<code>blocked</code> and they disagreed, {len(flips)} became admissions from '
              f'the other side. This is not a rounding error in a frame — it is a hole in it, '
              f'and it falls exactly on the class of site the study is about. An earlier pass '
              f'of this walk found the vantages agreeing 25 out of 25 and reported no '
              f'dependence, binding that claim to its rank band; the band was infrastructure '
              f'and marketplaces. The disagreements begin where the publishers do.</p>')
        else:
            A('<span class="status">Measured · a null result</span>')
            A('<h2>The frame does not depend on where we stand — within this band</h2>')
            A(f'<p>Across the <strong>{len(common)}</strong> domains both walks reached '
              f'(ranks {lo}–{hi}), the vantages returned '
              f'<strong>{len(common)-len(differ)}</strong> identical verdicts and '
              f'<strong>{len(differ)}</strong> different ones, with no refusal on one side '
              f'becoming an admission on the other.</p>')
            A('<p class="note">Coverage binds this, and the binding is not a formality: the '
              'claim is about the ranks walked so far and nothing beyond them.</p>')
        A('<p class="note">A domain one walk has reached and the other has not is a difference '
          'in <em>progress</em>, and is excluded — pooling those would make a slow walk look '
          'like a censoring vantage.</p>')
        A('</section>')

    # ── blindness
    A('<section>')
    A('<span class="status">Not observable</span>')
    A('<h2>What this instrument cannot see</h2>')
    A('<div class="cols">')
    for h3, body in [
        ("The server-side auction",
         "Everything here is a passive read of what a wrapper hands the browser. "
         "Server-to-server bidding never touches it. A domain recorded as carrying no wrapper "
         "may be selling its inventory perfectly well."),
        ("Any page we did not see",
         "A 401, 403 or 5xx is our own access failing. It is recorded as blindness and never "
         "as “this publisher runs no header bidding”."),
        ("Wrappers we did not look for",
         "The detector knows Adfox and Prebid, the two the study is about. Google’s and "
         "Amazon’s stacks are recorded as evidence but never admit — so a rejection "
         "bounds the detector, not the site."),
        ("A market",
         "The frame holds a handful of sites, from one or two vantages, on one date, in one "
         "six-hour zone of the Moscow clock. The word market is not available yet."),
    ]:
        A(f'<div><h3>{h3}</h3><p style="margin-top:8px;color:var(--muted);font-size:15.5px">'
          f'{body}</p></div>')
    A('</div>')
    A('</section>')

    # ── reproduce
    A('<section>')
    A('<span class="status">Check us</span>')
    A('<h2>Every number here is re-derivable</h2>')
    A('<p>The universe is pinned and re-fetchable, the rule is a runnable tool, and the '
      'rejection ledger is published beside the frame. Disagreeing with this page should not '
      'require our cooperation.</p>')
    A('<pre>'
      'git clone https://github.com/genaforvena/self-adint &amp;&amp; cd self-adint\n'
      'python3 tools/adint-frame-stageb  --test        # 25 gates, offline\n'
      'python3 tools/adint-status                      # the numbers above, from disk\n'
      'python3 tools/adint-frame-compare data/frame-stageb-nl-direct-*.jsonl \\\n'
      '                                  data/frame-stageb-ru-mobile-*.jsonl\n'
      '\n'
      '# rebuild this page\n'
      'python3 tools/adint-report-page -o report.html</pre>')
    A('<p>Method and design: <code>docs/step0c-hb-ru-market-study-2026-08-18.md</code>. '
      'What the walk did to it: <code>docs/step0d-hb-first-cell-2026-08-19.md</code>. '
      'The dataset’s passport: <code>docs/DATASHEET-ru-hb-frame.md</code>.</p>')
    A('</section>')

    A('<footer><div>self-adint — one operator reading his own advertising profile from the '
      'demand side. Nobody else is observed.</div>'
      '<div>Public domain (CC0 1.0). A dedication is a statement about rights, not about truth: '
      'every number here is published with its n so you can judge it rather than inherit it.</div>'
      f'<div class="mono" style="font-size:12px">generated {generated}</div></footer>')
    A('</div>')
    return "\n".join(P)


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("-o", "--out", default=os.path.join(REPO, "report.html"))
    ap.add_argument("--test", action="store_true")
    args = ap.parse_args()
    if args.test:
        return selftest()
    d = gather()
    gen = datetime.datetime.now(datetime.timezone.utc).strftime("%Y-%m-%d %H:%M UTC")
    open(args.out, "w", encoding="utf-8").write(build(d, gen))
    print(f"{args.out}  ({len(d['frames'])} frame(s), {len(d['cells'])} arm file(s))")
    return 0


def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    # Every verdict the classifier can emit must have a knowledge-class and a gloss, or the
    # page silently drops a column of the ledger — the exact failure the ledger exists to
    # prevent, reintroduced at the presentation layer.
    emitted = set()
    for row in ({"http_status": 200, "content_type": "text/html",
                 "adfox_hb": {"present": True, "bidders": ["x"]}},
                {"http_status": 200, "content_type": "text/html",
                 "adfox": {"ya": True, "adfoxCode": True}},
                {"http_status": 200, "content_type": "text/html", "adfox": {"ya": True}},
                {"http_status": 200, "content_type": "text/html"},
                {"http_status": 200, "content_type": "application/json"},
                {"http_status": 403}, {"http_status": 429},
                {"verdict": "error", "error": "TimeoutError"},
                {"verdict": "error", "error": "net::ERR_NAME_NOT_RESOLVED"},
                {"verdict": "error", "error": "net::ERR_WHAT"}):
        emitted.add(sb.classify(row)[0])
    missing_cls = sorted(v for v in emitted if v not in VERDICT_CLASS)
    missing_ord = sorted(v for v in emitted if v not in VERDICT_ORDER)
    missing_gls = sorted(v for v in emitted if v not in VERDICT_GLOSS)
    check("every verdict the classifier emits has a knowledge-class", missing_cls, [])
    check("every verdict the classifier emits is in the render order", missing_ord, [])
    check("every verdict the classifier emits has a gloss", missing_gls, [])

    # A bar over zero rows must not divide by zero or render a stray mark.
    # The same capture lives in data/ and public-data/ once published; counting both would
    # double every arm.
    _tmp = collections.Counter(c["arm"] for c in gather()["cells"])
    check("a published capture is not counted twice",
          [a for a, n in _tmp.items() if n > 1], [])
    check("an empty ledger renders no bar", seg_bar(collections.Counter(), 0), "")
    check("an empty rank list renders no strip", rank_strip([], []), "")

    # Theme correctness is structural, not a matter of taste: a colour whose ONLY definition
    # sits inside a media query never applies in the un-stamped default state.
    for tok in ("--paper", "--ink", "--evidence", "--blind", "--domain", "--surface",
                "--muted", "--rule", "--shade"):
        first = CSS.index(tok)
        check(f"{tok} is defined on bare :root before any media block",
              first < CSS.index("@media (prefers-color-scheme: dark)"), True)
    check("body paints an explicit background token", "background:var(--paper)" in CSS, True)
    check("the dark media block is guarded against an explicit light choice",
          ':root:not([data-theme="light"])' in CSS, True)
    check("an explicit dark stamp is honoured too", ':root[data-theme="dark"]' in CSS, True)
    check("wide content scrolls in its own container", "overflow-x:auto" in CSS, True)
    check("reduced motion is respected", "prefers-reduced-motion" in CSS, True)

    check("the canonical frame is read from the declaration",
          canonical_vantage(), "ru-mobile")
    # A domain the other vantage admits and this one REACHED and refused is a hole; one this
    # vantage has not reached is pending. The page's headline sentence turns on the
    # difference, so it is asserted here rather than trusted.
    CANON = canonical_vantage() or "me"

    def _fake(pairs, reached_only_by_other=()):
        rows_m, rows_o = [], []
        for i, (dm, a, b) in enumerate(pairs, 1):
            rows_m.append({"domain": dm, "rank": i, "stageb_verdict": a,
                           "vantage": CANON})
            rows_o.append({"domain": dm, "rank": i, "stageb_verdict": b, "vantage": "other"})
        for j, dm in enumerate(reached_only_by_other, 100):
            rows_o.append({"domain": dm, "rank": j, "stageb_verdict": "admit",
                           "vantage": "other"})
        mk = lambda v, rows: {"vantage": v, "rows": rows, "file": v, "public": True,
                              "tally": collections.Counter(), "admitted": [], "ranks": [],
                              "egress": []}
        return {"frames": [mk(CANON, rows_m), mk("other", rows_o)], "cells": [],
                "pairs": []}
    check("a refusal where the other admits counts as a hole",
          hole_counts(_fake([("a.ru", "blocked", "admit")]), CANON), (1, 0))
    check("a domain not yet reached is NOT counted as a hole",
          hole_counts(_fake([("a.ru", "admit", "admit")], ("deep.ru",)), CANON), (0, 0))
    check("holes are counted in both directions",
          hole_counts(_fake([("a.ru", "blocked", "admit"),
                             ("b.ru", "admit", "ad-serving-only")]), CANON), (1, 1))
    both = build(_fake([("a.ru", "blocked", "admit"),
                        ("b.ru", "admit", "ad-serving-only")]), "T")
    check("two-sided holes are reported as neither frame being complete",
          "Neither frame is complete" in both, True)
    one = build(_fake([("a.ru", "admit", "admit")], ("deep.ru",)), "T")
    check("no hole does not claim the other frame is missing publishers",
          "missing" in one.split("declared in")[1][:400], False)
    # gather() READS THE LEDGERS, and the three ways that read can lie are all file-level, so
    # they need a real tree rather than a hand-made frames dict.
    import tempfile as _tf
    global PUB, PRIV
    _keep = (PUB, PRIV)
    _d = _tf.mkdtemp()
    PUB, PRIV = os.path.join(_d, "pub"), os.path.join(_d, "priv")
    os.makedirs(PUB); os.makedirs(PRIV)
    # (1) The stale-verdict seam of d28dbde, at the presentation layer: this page PUBLISHES
    #     the admission list, so a verdict left over from a retired classifier is read by
    #     strangers as a finding about the market.
    with open(os.path.join(PUB, "frame-stageb-v-2026-01-01.jsonl"), "w") as fh:
        fh.write(json.dumps({"domain": "adserving.ru", "rank": 1, "vantage": "v",
                             "stageb_verdict": "admit", "stageb_schema": sb.SCHEMA - 2,
                             "http_status": 200, "content_type": "text/html",
                             "adfox": {"ya": True, "adfoxCode": True, "hb_settings": False,
                                       "ya_context": True},
                             "adfox_hb": {"present": False}, "prebid": [], "globals": [],
                             "browser_egress_ip": "1.2.3.4"}) + "\n")
        fh.write(json.dumps({"domain": "real.ru", "rank": 2, "vantage": "v",
                             "stageb_verdict": "admit", "stageb_schema": sb.SCHEMA,
                             "browser_egress_ip": "1.2.3.4"}) + "\n")
    _g = gather()
    check("a stale-schema admit is re-derived before it reaches the page",
          [d for _r, d, _e in _g["frames"][0]["admitted"]], ["real.ru"])
    # (2) The same walk exists in both trees once published. The page is the PUBLIC artifact,
    #     so it must render the copy a stranger can fetch — the cells loop below already
    #     decides it that way, and the frames loop decided it by row count with an
    #     alphabetical tie-break, which silently preferred `data/`.
    _row = {"domain": "real.ru", "rank": 2, "vantage": "v", "stageb_verdict": "admit",
            "stageb_schema": sb.SCHEMA, "browser_egress_ip": "1.2.3.4"}
    with open(os.path.join(PRIV, "frame-stageb-v-2026-01-01.jsonl"), "w") as fh:
        fh.write(json.dumps(_row) + "\n")
    check("the published copy of a walk wins over the private one",
          gather()["frames"][0]["public"], True)
    # (3) …and when only the private copy exists, the page must SAY so rather than present
    #     an unpublished tree as the record.
    os.remove(os.path.join(PUB, "frame-stageb-v-2026-01-01.jsonl"))
    check("a frame read from the private tree is marked unpublished",
          gather()["frames"][0]["public"], False)
    check("and the page says it out loud",
          "not published" in build(gather(), "T"), True)
    PUB, PRIV = _keep

    page = build(gather(), "TEST")
    check("the page says which vantage's frame the study runs on",
          "declared in" in page, True)
    # …and says it OUTSIDE the tiles grid: a <p> between two tiles is a grid item, which
    # takes a cell and reflows the row. The generator cannot see that; this can.
    _tiles = page[page.index('<div class="tiles">'):]
    _tiles = _tiles[:_tiles.index("</section>")]
    check("no stray paragraph is nested inside the tiles grid",
          "<p" in _tiles.rsplit("</div>", 1)[0], False)
    check("the page names itself", "<title>" in page, True)
    # The vantage section's CONCLUSION must follow the data, not a sentence typed once. Drive
    # both branches from synthetic ledgers: a tie must not claim dependence, and a
    # blocked->admit flip must not go on claiming a null result.
    def _vsec(pairs):
        global gather
        real = gather
        rows_a = [{"domain": d, "rank": i * 10, "vantage": "va", "stageb_verdict": x}
                  for i, (d, x, _y) in enumerate(pairs, 1)]
        rows_b = [{"domain": d, "rank": i * 10, "vantage": "vb", "stageb_verdict": y}
                  for i, (d, _x, y) in enumerate(pairs, 1)]
        mk = lambda v, rows: {"file": v, "vantage": v, "public": True, "rows": rows,
                              "tally": collections.Counter(r["stageb_verdict"] for r in rows),
                              "admitted": [], "ranks": [r["rank"] for r in rows],
                              "egress": []}
        gather = lambda: {"frames": [mk("va", rows_a), mk("vb", rows_b)], "cells": [],
                          "pairs": []}
        out = build(gather(), "T")
        gather = real
        return out
    tie = _vsec([("a.ru", "blocked", "blocked"), ("b.ru", "admit", "admit")])
    check("agreeing vantages report a null result",
          "does not depend on where we stand" in tie, True)
    check("a null result does not claim a hole", "silently omits" in tie, False)
    flip = _vsec([("a.ru", "blocked", "admit"), ("b.ru", "admit", "admit")])
    check("a blocked-to-admit flip is reported as a hole in the frame",
          "silently omits real sites" in flip, True)
    check("a flip does not go on claiming a null result",
          "does not depend on where we stand" in flip, False)
    check("identity is never colour alone — the legend is present",
          'class="legend"' in page, True)
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
