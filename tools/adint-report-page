#!/usr/bin/env python3
"""Generate the living report page from the data on disk.

The operator asked for "a live report page at a link, with charts, updated as the run
accumulates". The important word is *updated*: a page written by hand is a snapshot that
starts lying the moment the next walk appends a row. So the page is GENERATED — every figure
in it is read from `public-data/` and `data/` at build time, and rebuilding it is one command.

    python3 tools/adint-report-page -o /tmp/report.html

Design constraints that are not decoration:
  * Every number carries its `n` and the vantage it was measured from, in the same line.
  * Three states of knowledge are colored apart and never mixed: what we SAW (evidence),
    what WE could not see (our blindness), and facts about the DOMAIN that are not evidence
    about header bidding. Collapsing those is the study's characteristic failure, so the
    palette refuses to let a reader collapse them either.
  * The palette is validated for colour-vision deficiency in both themes, and identity is
    never carried by colour alone — every segment is also labelled.
"""

import argparse
import collections
import datetime
import glob
import html
import importlib.machinery
import importlib.util
import json
import os
import sys

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PUB = os.path.join(REPO, "public-data")
PRIV = os.path.join(REPO, "data")


def _load(name):
    path = os.path.join(REPO, "tools", name)
    spec = importlib.util.spec_from_file_location(
        name.replace("-", "_"), path,
        loader=importlib.machinery.SourceFileLoader(name.replace("-", "_"), path))
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


# The stage-B ledger reader lives in ONE place and every consumer borrows it. A second
# loader is a second place to forget that a stored verdict ages with its classifier.
sb = _load("adint-frame-stageb")

# Which state of knowledge each verdict belongs to. This mapping IS the page's thesis.
EVIDENCE, BLIND, DOMAIN = "evidence", "blind", "domain"
VERDICT_CLASS = {
    "admit": EVIDENCE,
    "ad-serving-only": DOMAIN,
    "no-wrapper": DOMAIN,
    "ya-generic-only": DOMAIN,
    "not-html": DOMAIN,
    "no-web-apex": DOMAIN,
    "blocked": BLIND,
    "rate-limited": BLIND,
    "unreachable": BLIND,
    "error": BLIND,
}
VERDICT_ORDER = ["admit", "ad-serving-only", "no-wrapper", "ya-generic-only", "not-html",
                 "no-web-apex", "blocked", "rate-limited", "unreachable", "error"]
VERDICT_GLOSS = {
    "admit": "200, HTML, and an auction config — a bidder roster or a prebid global",
    "ad-serving-only": "Yandex ad code, no auction config: sells ads without asking several bidders",
    "no-wrapper": "the page loaded and carried nothing to bid with (re-probed at 45 s)",
    "ya-generic-only": "a Yandex namespace only — Metrika is not ad-tech",
    "not-html": "answered 200 with something that is not a page",
    "no-web-apex": "DNS or TLS failure — no site at this domain's apex at all",
    "blocked": "4xx/5xx — we never saw the page, so this says nothing about it",
    "rate-limited": "428/429 — caused by our own load",
    "unreachable": "timeout or refused connection",
    "error": "a navigation failure not yet classified",
}


def read_jsonl(p):
    out = []
    for line in open(p, encoding="utf-8"):
        line = line.strip()
        if line and not line.startswith("#"):
            try:
                out.append(json.loads(line))
            except Exception:
                pass
    return out


def gather():
    d = {"frames": [], "cells": [], "pairs": []}
    # The PUBLISHED copy of a walk wins over the private one — same rule as the cells loop
    # below, and for the same reason: this page is the public artifact, so it must render
    # what a stranger can fetch. The frames loop used to decide this by ROW COUNT with an
    # alphabetical tie-break, which quietly preferred `data/` on every tie.
    by_base = {}
    for f in sorted(glob.glob(os.path.join(PRIV, "frame-stageb-*.jsonl"))):
        by_base[os.path.basename(f)] = f
    for f in sorted(glob.glob(os.path.join(PUB, "frame-stageb-*.jsonl"))):
        by_base[os.path.basename(f)] = f
    for f in sorted(by_base.values()):
        if "nowrapper-audit" in f:
            continue
        # Verdicts RE-DERIVED at read time (see adint-frame-stageb.load_rows): a stored
        # verdict is a claim about the page and about the code that read it, and this tool
        # publishes the admission list to strangers. The private glob no longer filters on a
        # `schema` in the FILENAME — that was a proxy for "somebody ran --reclassify", which
        # is not a property of the data and hid any ledger whose name lacked the token.
        rows, redone, schemas, dupes = sb.load_rows(f, dedupe=True)
        if not rows:
            continue
        d["frames"].append({
            "file": os.path.basename(f),
            "vantage": rows[0].get("vantage") or "?",
            "public": f.startswith(PUB),
            "rows": rows,
            "note": sb.schema_note(redone, schemas),
            "dupes": dupes,
            "tally": collections.Counter(r.get("stageb_verdict") for r in rows),
            "admitted": [(r.get("rank"), r.get("domain"),
                          " + ".join(r.get("wrapper_evidence") or []))
                         for r in rows if r.get("stageb_verdict") == "admit"],
            "ranks": [r.get("rank") or 0 for r in rows],
            "egress": sorted({r.get("browser_egress_ip") for r in rows
                              if r.get("browser_egress_ip")}),
        })
    # One frame per vantage: published first, then the walk that got further. "Further" is
    # rows, which is progress; it is NOT recency, and the two come apart whenever a repaired
    # vantage is re-walked from the start.
    best = {}
    for fr in d["frames"]:
        cur = best.get(fr["vantage"])
        if cur is None or (fr["public"], len(fr["rows"])) > (cur["public"], len(cur["rows"])):
            best[fr["vantage"]] = fr
    d["frames"] = sorted(best.values(), key=lambda f: f["vantage"])

    # PUBLISHED copy wins, private is the fallback — the same capture exists in both trees
    # once it has been published, and globbing both counted every arm twice. Nothing in the
    # page looked wrong: the outcome mix is identical in both copies, so the doubling showed
    # up only as an arm-file count, and the per-arm figures would have been right while the
    # pair count silently doubled.
    seen_base = {}
    for f in (sorted(glob.glob(os.path.join(PRIV, "hb-paired-*.jsonl")))
              + sorted(glob.glob(os.path.join(PUB, "hb-paired-*.jsonl")))):
        seen_base[os.path.basename(f)] = f    # PUB globbed second, so it overwrites PRIV
    for f in sorted(seen_base.values()):
        rows = read_jsonl(f)
        loads = [r for r in rows if r.get("kind") == "load"]
        if not loads:
            continue
        cand = [r for r in rows if r.get("is_bid_candidate")]
        d["cells"].append({
            "file": os.path.basename(f),
            "arm": loads[0].get("arm"),
            "loads": len(loads),
            "sites": sorted({r["url"].split("/")[2] for r in loads}),
            "pairs": sorted({r.get("pair_id") for r in loads if r.get("pair_id")}),
            "window": sorted({r.get("window_s") for r in loads}),
            "egress": sorted({r.get("egress_ip") for r in loads if r.get("egress_ip")}),
            "verified": sum(1 for r in loads if r.get("vantage_verified")),
            "deadline": sorted({r.get("wrapper_timeout_ms") for r in loads
                                if r.get("wrapper_timeout_ms")}),
            "outcomes": collections.Counter(r.get("outcome") for r in cand),
            "candidates": len(cand),
        })
    return d


# ── svg helpers ───────────────────────────────────────────────────────────────────────
# Hand-built SVG rather than a library: the page must be self-contained (no external
# script host is reachable from a published artifact), and these are simple forms.

def seg_bar(counts, total, width=880, height=54):
    """One horizontal bar segmented by verdict, coloured by state of knowledge.

    A pie would answer 'what share' and this has to answer 'how little' — a single bar with
    the admitted sliver at the left end makes the density legible at a glance without a
    reader doing arithmetic on a legend."""
    if not total:
        return ""
    x, parts = 0.0, []
    GAP = 2.0   # surface gap between fills, so adjacent segments never blend
    for v in VERDICT_ORDER:
        n = counts.get(v, 0)
        if not n:
            continue
        w = max(3.0, width * n / total - GAP)
        cls = VERDICT_CLASS.get(v, DOMAIN)
        parts.append(
            f'<g class="seg"><title>{html.escape(v)}: {n} of {total} domains — '
            f'{html.escape(VERDICT_GLOSS.get(v, ""))}</title>'
            f'<rect x="{x:.1f}" y="0" width="{w:.1f}" height="{height}" rx="3" '
            f'class="fill-{cls}"/></g>')
        x += w + GAP
    return (f'<svg viewBox="0 0 {width} {height}" width="100%" height="{height}" '
            f'role="img" aria-label="verdict shares across {total} domains walked">'
            + "".join(parts) + "</svg>")


def grouped_bars(series, cats, width=760, height=260):
    """series = [(label, {cat: value}, css_class)] — one axis, always."""
    mx = max([v for _, d, _ in series for v in d.values()] + [1])
    pad_l, pad_b, pad_t = 46, 34, 12
    plot_w, plot_h = width - pad_l - 12, height - pad_b - pad_t
    group_w = plot_w / len(cats)
    bw = min(64.0, group_w / (len(series) + 1))
    out = []
    for i in range(0, 5):
        y = pad_t + plot_h - plot_h * i / 4
        val = mx * i / 4
        out.append(f'<line x1="{pad_l}" y1="{y:.1f}" x2="{width-12}" y2="{y:.1f}" class="grid"/>')
        out.append(f'<text x="{pad_l-8}" y="{y+4:.1f}" class="axis" text-anchor="end">'
                   f'{val:.0f}</text>')
    for ci, cat in enumerate(cats):
        gx = pad_l + group_w * ci
        for si, (label, data, cls) in enumerate(series):
            v = data.get(cat, 0)
            h = plot_h * v / mx
            x = gx + (group_w - bw * len(series)) / 2 + bw * si
            y = pad_t + plot_h - h
            out.append(
                f'<g class="seg"><title>{html.escape(label)} · {html.escape(cat)}: {v}</title>'
                f'<rect x="{x:.1f}" y="{y:.1f}" width="{bw-2:.1f}" height="{max(h,2):.1f}" '
                f'rx="3" class="fill-{cls}"/></g>')
            out.append(f'<text x="{x + (bw-2)/2:.1f}" y="{y-6:.1f}" class="val" '
                       f'text-anchor="middle">{v}</text>')
        out.append(f'<text x="{gx + group_w/2:.1f}" y="{height-10}" class="axis" '
                   f'text-anchor="middle">{html.escape(cat)}</text>')
    return (f'<svg viewBox="0 0 {width} {height}" width="100%" height="{height}" role="img" '
            f'aria-label="outcome counts by arm">' + "".join(out) + "</svg>")


def rank_strip(ranks, admits, width=880, height=76):
    """Where in the rank order the frame's members actually fall."""
    if not ranks:
        return ""
    lo, hi = min(ranks), max(ranks)
    span = max(hi - lo, 1)
    y = 34
    out = [f'<line x1="8" y1="{y}" x2="{width-8}" y2="{y}" class="axis-line"/>']
    for r in ranks:
        x = 8 + (width - 16) * (r - lo) / span
        out.append(f'<line x1="{x:.1f}" y1="{y-7}" x2="{x:.1f}" y2="{y+7}" class="tick-walked"/>')
    for r, dom, _ev in admits:
        x = 8 + (width - 16) * ((r or lo) - lo) / span
        anchor = "start" if x < width * 0.7 else "end"
        out.append(f'<line x1="{x:.1f}" y1="{y-15}" x2="{x:.1f}" y2="{y+15}" class="tick-admit"/>')
        out.append(f'<text x="{x + (6 if anchor=="start" else -6):.1f}" y="{y+30}" '
                   f'class="val" text-anchor="{anchor}">{html.escape(dom)} #{r}</text>')
    out.append(f'<text x="8" y="{y-20}" class="axis">rank {lo}</text>')
    out.append(f'<text x="{width-8}" y="{y-20}" class="axis" text-anchor="end">rank {hi}</text>')
    return (f'<svg viewBox="0 0 {width} {height}" width="100%" height="{height}" role="img" '
            f'aria-label="rank positions of walked and admitted domains">'
            + "".join(out) + "</svg>")


