#!/usr/bin/env python3
"""Keep the corpus split in two, and make spending the holdout an event you cannot hide.

`docs/split-exploratory-holdout-2026-08-21.md` declares a split rule before anyone looks
at the data. Nothing is predicted; the exploratory half is free to mine any way at all.
The discipline is entirely at the other end: whatever the mining suggests is checked
against a holdout that has NOT been looked at, and that check happens exactly once.

  --declare    record the document's hash and the split rule, in a committed file, so
               "declared before the analysis" is checkable rather than a date in a header
               that a later edit could move.
  --verify     recompute the hash. A mismatch is not a bug to fix by re-declaring — it is
               the tool reporting that the split rule changed, which is what it is for.
  --split      show the assignment: which cells are exploratory, which are holdout.
  --explore    compute freely on the EXPLORATORY half. No limit, no correction, no plan.
               Every figure is stamped EXPLORATORY — not confirmed.
  --confirm    read the HOLDOUT. Appends to an append-only read ledger and reports the
               holdout as SPENT afterwards.

Why the read ledger and not a promise: a holdout is worth exactly one look, a second look
turns it into more exploration, and "we only glanced" is unfalsifiable after the fact. So
a glance writes a row. This mesh already owns the underlying failure — a null computed
inside the selection window is not a holdout.

`orphan-ok`: driven by hand at the analysis edges. The COLLECTION carries the cadence
(tools/adint-collect-cell); the analysis is not a reflex.
"""

import argparse
import glob
import hashlib
import json
import math
import os
import random
import sys
from datetime import datetime, timezone

REPO = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
PUB = os.path.join(REPO, "public-data")
PRIV = os.path.join(REPO, "data")
DOC = os.path.join(REPO, "docs", "split-exploratory-holdout-2026-08-21.md")
REG = os.path.join(REPO, "ref", "SPLIT-2026-08-21.json")
READS = os.path.join(REPO, "ref", "HOLDOUT-READS.jsonl")
SPLIT_SALT = "adint-split-2026-08-21|"
SEED = 20260821
PERMUTATIONS = 100_000
PRICED_OUTCOMES = ("priced",)
# "We could not read the response" is not "the bidder did not price it". These outcomes
# mean the body never became a readable auction answer — measured on the exploratory half
# they are 43-46 % of every arm's rows, and they were sitting in the denominator of the
# priced-rate contrast being scored as not-priced. A price can only be OBSERVED on a
# response we could parse, so the denominator is the responses we could parse.
UNKNOWN_OUTCOMES = ("binary", "unread", "unparsed", "no-answer", "redirect", "error")


def doc_hash(path=None):
    """sha256 of the preregistration document, or None if it is not there.

    A missing document must not hash to a fixed string — an absent file that produces a
    stable digest would VERIFY, and the tool would certify a preregistration that no
    longer exists.
    """
    p = path or DOC
    if not os.path.exists(p):
        return None
    with open(p, "rb") as fh:
        return hashlib.sha256(fh.read()).hexdigest()


def read_jsonl(path):
    out = []
    try:
        with open(path, encoding="utf-8") as fh:
            for line in fh:
                line = line.strip()
                if not line or line.startswith("#"):
                    continue
                try:
                    out.append(json.loads(line))
                except json.JSONDecodeError:
                    continue
    except OSError:
        pass
    return out


def load_reg():
    if not os.path.exists(REG):
        return None
    try:
        return json.load(open(REG, encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def parse_ts(s):
    try:
        return datetime.fromisoformat(str(s).replace("Z", "+00:00"))
    except (ValueError, TypeError):
        return None


_MUST_SAY = object()


def cell_rows(half=_MUST_SAY, include_private=True):
    """[(run, arm, row)] over the paired ledgers of ONE half. Both trees: the analysis set
    is about what was COLLECTED, and a cell not yet published is collected.

    `half` HAS NO DEFAULT, on purpose. It used to iterate every cell on disk unasked, and
    on 2026-08-21 an ad-hoc script tallied priced rows over that unfiltered stream — a
    single table straddling both halves. Subtracting the exploratory counts from it handed
    the reader the holdout's own priced totals per arm, which is directional information
    about the exact contrast the holdout exists to confirm. Nothing refused, nothing was
    recorded, and `ref/HOLDOUT-READS.jsonl` stayed empty while the holdout leaked; the
    incident is written down in `ref/HOLDOUT-LEAKS.jsonl`.

    The guard was on the DOOR (`--confirm` demands a `--claim` and writes a ledger row)
    while the corpus underneath it was an open field. A protocol enforced only at the
    entrance a careful person uses is enforced against care, not against accident. So the
    default is gone: pass `"exploratory"`, `"holdout"`, or an explicit `None` that says in
    the source that straddling both halves is what you meant.
    """
    if half is _MUST_SAY:
        raise TypeError(
            "cell_rows() needs an explicit half: 'exploratory', 'holdout', or None for "
            "both. There is no default — an unfiltered read is how the holdout leaked "
            "(see ref/HOLDOUT-LEAKS.jsonl). Say which half you meant.")
    pats = [os.path.join(PUB, "hb-paired-*.jsonl")]
    if include_private:
        pats.append(os.path.join(PRIV, "hb-paired-*.jsonl"))
    seen, out = set(), []
    for p in sorted(set(sum([glob.glob(x) for x in pats], []))):
        if p.endswith(".control.jsonl"):
            continue
        base = os.path.basename(p)
        if base in seen:            # published copy already read
            continue
        seen.add(base)
        if half is not None and half_of(run_of(base)) != half:
            continue
        for r in read_jsonl(p):
            out.append((base, r.get("arm"), r))
    return out


def half_of(run_id):
    """`holdout` or `exploratory`, from the run id alone — §2.1's declared rule.

    A function of the id and nothing else, so a cell's half cannot change as the corpus
    grows and cannot be nudged by rerunning anything. The WHOLE CELL moves: the two arms
    of a pair are one observation, and splitting a pair would leak the holdout into the
    exploratory half through the pairing itself.
    """
    h = hashlib.sha256((SPLIT_SALT + str(run_id)).encode("utf-8")).digest()
    return "holdout" if h[0] % 2 == 0 else "exploratory"


def run_of(basename):
    """`hb-paired-<run_id>.<arm>.jsonl` -> run_id."""
    b = basename[len("hb-paired-"):] if basename.startswith("hb-paired-") else basename
    return b.split(".")[0]


def split_table():
    """{run_id: half} over every cell on disk."""
    return {run_of(b): half_of(run_of(b))
            for b, _arm, _r in cell_rows(None)}


# The four ways an arm can fail to be a usable half of a pair, kept APART because they
# send you to four different fixes. They were one bucket named "vantage-unproven" until
# 2026-08-21, and the name was wrong for 92 % of what it held: on the live corpus the RU
# arm's drops were 112 pages that never loaded WITH the vantage proof PASSING, against 4
# that loaded with the proof failing. A bucket named after the rarest of its causes points
# every reader at the instrument that was working.
GATE_OK = "ok"
GATE_NO_LOAD = "pair-gate:no-load"          # nothing came back at all
GATE_REFUSED = "pair-gate:refused"          # the SITE answered, and its answer was "no"
GATE_UNPROVEN = "vantage-unproven"          # it loaded, but we cannot say from where


def _sibling_rendered():
    """`adint-status`'s own `rendered`, loaded from source, or None if it cannot be read.

    None is returned rather than raised so the CALLER decides — and the caller fails the
    check. An import guard that quietly skips its own gate is the silent fallback this
    mesh has been bitten by: a rule nobody could compare would report as a rule nobody
    disagreed with.
    """
    import types as _t
    path = os.path.join(REPO, "tools", "adint-status")
    try:
        src = open(path).read().split("\ndef main(")[0]
        mod = _t.ModuleType("adint_status_partial")
        mod.__file__ = path
        exec(compile(src, path, "exec"), mod.__dict__)
        return mod.rendered
    except Exception:
        return None


def render_verdict(load_row):
    """Did this arm actually render the page it was sent to?

    A STATUS IS NOT A PAGE. The predicate here was `http_status is not None`, which reads
    as "something came back" and was taken to mean "the arm rendered" — so an HTTP 401
    refusal page counted as a valid half of a pair. rbc.ru is the live case: it answers
    401 to both foreign exits and 200 to the domestic one, so five pairs passed this gate
    with a refusal on one side, and the served side then contributed 1111 request rows
    against a partner that structurally cannot contribute any. At the PAIR unit that is
    the harmless structural zero ref/CANONICAL-FRAME already decided to keep. At the ENTRY
    unit it is a 21.9 % inflation of one arm's denominator, and the pooled contrast never
    noticed it had stopped comparing like with like.
    """
    st = load_row.get("http_status")
    if st is None:
        return GATE_NO_LOAD
    if int(st) >= 400:
        return GATE_REFUSED
    if not load_row.get("vantage_verified"):
        return GATE_UNPROVEN
    return GATE_OK


def gate_reason(arms):
    """Why this pair is not usable — named after the WORST thing that happened to it.

    Ordered by how much it tells you: a refusal is a fact about the site and belongs in
    the finding; a dead load is a fact about our link and belongs in the coverage caveat;
    an unproven vantage is a fact about the instrument and belongs in the repair queue.
    """
    if not arms:
        return "unpaired"
    if len(arms) < 2:
        return "unpaired"
    bad = [v for v in arms.values() if v != GATE_OK]
    for reason in (GATE_REFUSED, GATE_NO_LOAD, GATE_UNPROVEN):
        if reason in bad:
            return reason
    return "unpaired"


def render_gate_table(half=None):
    """Per-arm loss at the pair gate, so the asymmetry cannot be quoted away.

    The gate is not evenly lossy and a single total hides that completely: measured
    2026-08-21 the RU arm cleared it on 62 % of its renders against 94 % and 97 % for the
    two foreign arms. Every surviving pair is therefore conditioned on the fragile tether
    having been up at that moment, eight times more strongly on one side than the other —
    which is a statement about the analysis set, not about the market, and it has to
    travel WITH the numbers computed over it.
    """
    seen = {}
    for base, arm, r in cell_rows(half):
        if r.get("kind") != "load" or not r.get("pair_id"):
            continue
        d = seen.setdefault(arm, {"rendered": 0, GATE_OK: 0, GATE_NO_LOAD: 0,
                                  GATE_REFUSED: 0, GATE_UNPROVEN: 0})
        d["rendered"] += 1
        d[render_verdict(r)] += 1
    for d in seen.values():
        d["ok_rate"] = round(d[GATE_OK] / d["rendered"], 4) if d["rendered"] else None
    return seen


def analysis_set(half=None):
    """The rows usable for a contrast, and the exclusion counts that go with them.

    `half` selects `exploratory`, `holdout`, or None for everything. Exclusions are
    COUNTED and returned, never silently dropped: an exclusion count is a bias term.

    THE RULE THAT MATTERS MOST IS HERE. A load whose arm could not prove where it stood is
    EXCLUDED, and it is never folded into a bid outcome. The RU arm rides one fragile
    tether; a fortnight that recorded our own blindness as the market's silence would
    produce a confident, publishable, false result.
    """
    exc = {"wrong-half": 0, "vantage-unproven": 0, "no-arm": 0, "unpaired": 0,
           "no-load": 0, "not-a-request": 0,
           "pair-gate:no-load": 0, "pair-gate:refused": 0}
    # THE JOIN IS request -> load_id -> load -> pair_id, and it is NOT request -> pair_id.
    # A request row carries `load_id` and no pair key at all; only the load row knows which
    # pair it belongs to. The first cut read `pair_id` straight off the request row, found
    # None on every one of 13 466 of them, and filed them all as `unpaired` — an empty
    # analysis set that rendered as a tidy report with priced_total 0 and a null test.
    # It was the EXCLUSION COUNT that exposed it, which is the argument for counting
    # exclusions instead of dropping them quietly.
    rendered, pair_of, arm_of = {}, {}, {}
    for base, arm, r in cell_rows(None):
        if r.get("kind") != "load":
            continue
        lid, pid = r.get("load_id"), r.get("pair_id")
        if not pid:
            continue
        rendered.setdefault(pid, {})[arm] = render_verdict(r)
        if lid:
            pair_of[lid] = pid
            arm_of[lid] = arm
    good = {p for p, arms in rendered.items()
            if len(arms) > 1 and all(v == "ok" for v in arms.values())}
    keep = []
    for base, arm, r in cell_rows(None):
        if r.get("kind") == "load":
            continue
        if r.get("outcome") is None:
            exc["not-a-request"] += 1
            continue
        if half and half_of(run_of(base)) != half:
            exc["wrong-half"] += 1
            continue
        lid = r.get("load_id")
        # The arm is taken from the row where it is authoritative — the LOAD — falling back
        # to the request's own copy. Two writers of one field is how they come apart.
        a = arm_of.get(lid) or arm
        if not a:
            exc["no-arm"] += 1
            continue
        pid = pair_of.get(lid)
        if pid is None:
            exc["no-load"] += 1
            continue
        if pid not in good:
            exc[gate_reason(rendered.get(pid))] += 1
            continue
        keep.append((a, dict(r, pair_id=pid)))
    return keep, exc, good


def coverage(half=None):
    keep, exc, pairs = analysis_set(half)
    by_arm = {}
    for arm, r in keep:
        d = by_arm.setdefault(arm, {"entries": 0, "priced": 0, "classifiable": 0,
                                    "unreadable": 0})
        d["entries"] += 1
        if r.get("outcome") in PRICED_OUTCOMES:
            d["priced"] += 1
            d["classifiable"] += 1
        elif r.get("outcome") in UNKNOWN_OUTCOMES:
            d["unreadable"] += 1
        else:
            d["classifiable"] += 1
    return {"arms": by_arm, "exclusions": exc, "pairs_all_halves": len(pairs),
            "priced_total": sum(d["priced"] for d in by_arm.values()),
            "render_gate": render_gate_table(half)}


def holdout_reads():
    """Every read of the holdout, ever. Append-only; a read is an event, not a state."""
    return read_jsonl(READS)


def spent():
    return len(holdout_reads()) > 0

def paired_permutation(keep, ru_arm, seed=SEED, n=PERMUTATIONS):
    """§3's primary test: permute the arm label WITHIN each pair.

    Exchangeability under H0 is a within-pair claim, and that is the only thing the
    pairing buys. Permuting across pairs would destroy the site/hour/frame-position
    matching the design exists to hold fixed and would answer a question nobody asked.
    Entries nested in loads nested in sites are NOT independent draws; a test that treats
    them as such (Fisher, §3's secondary) overstates the evidence, which is why it is the
    secondary.
    """
    pairs = {}
    for arm, r in keep:
        pid = r.get("pair_id")
        if not pid:
            continue
        d = pairs.setdefault(pid, {})
        a = d.setdefault(arm, {"n": 0, "k": 0})
        a["n"] += 1
        if r.get("outcome") in PRICED_OUTCOMES:
            a["k"] += 1
    usable = [d for d in pairs.values() if len(d) == 2]
    if not usable:
        return None

    def stat(flip):
        rn = rk = fn = fk = 0
        for i, d in enumerate(usable):
            arms = sorted(d)
            ru = ru_arm if ru_arm in d else arms[0]
            fo = [a for a in arms if a != ru][0]
            a, b = (d[fo], d[ru]) if flip and flip[i] else (d[ru], d[fo])
            rn += a["n"]; rk += a["k"]; fn += b["n"]; fk += b["k"]
        return (rk / rn if rn else 0.0) - (fk / fn if fn else 0.0)

    obs = stat(None)
    rng = random.Random(seed)
    ge = 0
    for _ in range(n):
        ge += stat([rng.random() < 0.5 for _ in usable]) >= obs
    # +1/+1: a permutation p can never be 0 — with n resamples the smallest honest
    # statement is 1/(n+1), and printing 0.0 would claim more than the resampling can say.
    return {"observed_diff": round(obs, 6), "p": (ge + 1) / (n + 1),
            "pairs_used": len(usable), "permutations": n, "seed": seed}


def fisher_one_sided(a, b, c, d):
    """P(X >= a) for the 2x2 [[a,b],[c,d]] under the hypergeometric null. §3's SECONDARY."""
    from math import comb
    n1, n2, t = a + b, c + d, a + c
    tot = n1 + n2
    den = comb(tot, t)
    if den == 0:
        return None
    return sum(comb(n1, i) * comb(n2, t - i) for i in range(a, min(n1, t) + 1)) / den



def cmd_declare(args):
    h = doc_hash()
    if h is None:
        print(f"adint-holdout: {DOC} does not exist — nothing to declare", file=sys.stderr)
        return 2
    if load_reg() and not args.force:
        print("adint-holdout: already declared. Re-declaring would change the split rule "
              "after the data exists, which is exactly the fitting this file prevents — "
              "pass --force only to record a declared AMENDMENT.", file=sys.stderr)
        return 2
    rec = {"document": os.path.relpath(DOC, REPO), "sha256": h,
           "declared_ts": datetime.now(timezone.utc).isoformat(),
           "salt": SPLIT_SALT, "rule": "sha256(salt + run_id)[0] even -> holdout",
           "seed": SEED, "permutations": PERMUTATIONS}
    os.makedirs(os.path.dirname(REG), exist_ok=True)
    json.dump(rec, open(REG, "w", encoding="utf-8"), indent=2, sort_keys=True)
    print(f"declared {rec['document']}\n  sha256 {h}\n  rule   {rec['rule']}\n"
          f"  at     {rec['declared_ts']}")
    return 0


def cmd_verify(args):
    reg = load_reg()
    if not reg:
        print("adint-holdout: NOT DECLARED — the split binds nothing", file=sys.stderr)
        return 2
    h = doc_hash()
    if h is None:
        print("adint-holdout: the declared document is GONE", file=sys.stderr)
        return 1
    if h != reg.get("sha256"):
        print("adint-holdout: HASH MISMATCH — the split declaration changed since it was "
              f"declared\n  declared {reg.get('sha256')}\n  on disk  {h}\n"
              "  Not a bug to fix by re-declaring. Record a dated amendment, and never "
              "let it touch the split rule.", file=sys.stderr)
        return 1
    print(f"ok  declaration unchanged ({h[:16]}…)")
    return 0


def cmd_split(args):
    t = split_table()
    if not t:
        print("no cells on disk")
        return 0
    for half in ("exploratory", "holdout"):
        runs = sorted(r for r, hh in t.items() if hh == half)
        print(f"{half} ({len(runs)}):")
        for r in runs:
            print(f"  {r}")
    n = len(t)
    ho = sum(1 for v in t.values() if v == "holdout")
    # An imbalance is reported, never corrected. Rebalancing after seeing the data is the
    # split becoming the place the fitting happens, which §2.1 exists to prevent.
    print(f"\n{ho}/{n} holdout ({100.0*ho/n:.0f} %) — reported, never rebalanced: moving a "
          f"cell after the fact would make the split the place the fitting happens")
    print(f"holdout status: {'SPENT — ' + str(len(holdout_reads())) + ' read(s)' if spent() else 'unread'}")
    return 0


def _site(load_row):
    return str(load_row.get("site") or load_row.get("url") or "?")


def access_contrast(half, domestic):
    """Who the SITES refuse — the study's other finding, which the pair gate discards.

    A refusal is not a failed observation. `pair-gate:refused` is the right exclusion for
    the PRICE contrast (there is no auction to compare on a page one arm never saw), and
    for a while that was the only thing the bucket was read as. But the refusal is itself
    the measurement this study exists to make, and it has two properties the price contrast
    does not: it is recorded on EVERY load rather than on the rare occasions a bidder
    answers with a number, and it is nearly noise-free.

    TWO UNITS, BOTH REPORTED, BECAUSE THEY DISAGREE. Per LOAD the asymmetry is enormous and
    the p is tiny — and the loads are NOT independent: the same fourteen sites are drawn
    again every replicate, within a cell, often within one browser generation. A p computed
    over them treats correlated draws as fresh evidence and will always look decisive. Per
    SITE the same data is a sign test over discordant sites, which is what the design can
    actually support, and it is far weaker. The load-level figure is published with its
    inflation named rather than dropped, because dropping it would hide how the site-level
    count was arrived at; the SITE level is the one to quote.
    """
    tot, ref = {}, {}
    per_site = {}
    for base, arm, r in cell_rows(half):
        if r.get("kind") != "load" or not r.get("pair_id"):
            continue
        v = render_verdict(r)
        if v not in (GATE_OK, GATE_REFUSED):
            continue          # a load our own link never made says nothing about the site
        site = _site(r)
        tot[arm] = tot.get(arm, 0) + 1
        d = per_site.setdefault(site, {}).setdefault(arm, {"served": 0, "refused": 0})
        if v == GATE_REFUSED:
            ref[arm] = ref.get(arm, 0) + 1
            d["refused"] += 1
        else:
            d["served"] += 1

    by_arm = {a: {"attempted": tot[a], "refused": ref.get(a, 0),
                  "rate": round(ref.get(a, 0) / tot[a], 4)} for a in tot}

    # THE UNIT IS (CELL, SITE, FOREIGN-ARM), AND BOTH HALVES OF THAT MATTER.
    #
    # The first cut of this test asked, per SITE, "has this site ever refused a foreign
    # arm, and has it ever refused the domestic one" and ran a sign test over the sites
    # that differed. It looked principled and it is not a test at all: "ever refused"
    # LATCHES. One transient 4xx converts a site to discordant permanently, k can only
    # rise as loads accumulate, and p = 2**-k can only fall. A statistic that moves one
    # direction with more data reaches any threshold by waiting. Measured on this corpus
    # it went 2 -> 2 -> 2 -> 2 -> 3 -> 3 -> 4 across seven cells, and it would have kept
    # going whether or not the effect were real. It also made the frame look like the
    # binding constraint (14 sites, floor p = 2**-14), which was an artifact of the wrong
    # unit — the cells are the constraint, and there are twelve of those a day.
    #
    # A CELL is an independent browser generation, so (cell, site) is a fair unit, and
    # McNemar over discordant units is a real test: the domestic-only cell `c` CAN rise,
    # so the p is free to move both ways.
    #
    # AND EACH FOREIGN ARM IS COMPARED ALONE. Pooling them and asking "was the foreign
    # CLASS refused" is an OR over two arms against the domestic arm's one — two chances
    # versus one, biased toward the finding. Measured: pooled gives 7 discordant units and
    # p = 0.0078; split, it is 3 (p = 0.125) and 4 (p = 0.0625), neither significant. The
    # pooled number was three-quarters artefact of the asymmetry.
    units = {}
    for base, arm, r in cell_rows(half):
        if r.get("kind") != "load" or not r.get("pair_id"):
            continue
        v = render_verdict(r)
        if v not in (GATE_OK, GATE_REFUSED):
            continue
        d = units.setdefault((run_of(base), _site(r)), {}).setdefault(arm, [0, 0])
        d[0] += 1
        d[1] += 1 if v == GATE_REFUSED else 0

    per_arm_test = {}
    for foreign in sorted({a for arms in units.values() for a in arms} - {domestic}):
        b = c = conc = tot = 0
        for arms in units.values():
            if foreign not in arms or domestic not in arms:
                continue
            tot += 1
            f_ref, d_ref = arms[foreign][1] > 0, arms[domestic][1] > 0
            if f_ref and not d_ref:
                b += 1
            elif d_ref and not f_ref:
                c += 1
            else:
                conc += 1
        k = b + c
        # ONE-SIDED IN THE STATED DIRECTION: P(X >= b) under Binomial(k, 1/2), the
        # probability of seeing this many foreign-only refusals or more if the vantage
        # made no difference. Writing `min(b, c)` here — as the first cut did — takes
        # whichever tail is smaller, so a corpus in which the DOMESTIC arm was the refused
        # one would report p = 0.0625 and read as a confirmation of the opposite claim.
        # The gate that caught it hands the test exactly that corpus.
        p_exact = (sum(math.comb(k, i) for i in range(b, k + 1)) / (2 ** k)
                   if k else None)
        per_arm_test[foreign] = {
            "units": tot, "concordant": conc,
            "foreign_only_refused": b, "domestic_only_refused": c,
            "p_one_sided_exact": p_exact,
        }

    # THE SITE IS THE UNIT FOR A POLICY CLAIM, AND THE VISIT IS THE UNIT FOR A RATE CLAIM.
    # These are two different questions and this file has now got them wrong in two
    # different ways in one day.
    #
    # A refusal is a property of a SITE's relationship to a class of vantage. Measured on
    # the exploratory half, all seven discordant (cell, site) units come from FOUR sites,
    # and rbc.ru is 2 observed / 2 discordant — a deterministic policy. Every additional
    # cell re-observes that policy and McNemar counts it as another independent success,
    # so its p falls with elapsed time for the same reason the latching version did. It is
    # a slower monotone, not an absent one.
    #
    # So: for "does vantage affect ACCESS", the independent unit is the site, there are 14
    # of them, and the answer does NOT improve by collecting longer — only by widening the
    # frame. For "how often does site X refuse", the visit IS the unit and more cells help,
    # because that is a rate and the intermittent sites (iz.ru 3/6, gismeteo 1/7, hh 1/7)
    # genuinely resolve with repetition. Both are reported; neither is allowed to wear the
    # other's interpretation.
    site_policy = {}
    for site, arms in per_site.items():
        f_seen = sum(v["served"] + v["refused"] for a, v in arms.items() if a != domestic)
        f_ref = sum(v["refused"] for a, v in arms.items() if a != domestic)
        d_seen = sum(v["served"] + v["refused"] for a, v in arms.items() if a == domestic)
        d_ref = sum(v["refused"] for a, v in arms.items() if a == domestic)
        if not f_seen or not d_seen:
            verdict = "not-comparable"
        elif f_ref and not d_ref:
            verdict = ("refuses-foreign-always" if f_ref == f_seen
                       else "refuses-foreign-sometimes")
        elif d_ref and not f_ref:
            verdict = "refuses-domestic-only"
        elif f_ref and d_ref:
            verdict = "refuses-both"
        else:
            verdict = "refuses-neither"
        site_policy[site] = {"verdict": verdict, "foreign_refused": f_ref,
                             "foreign_loads": f_seen, "domestic_refused": d_ref,
                             "domestic_loads": d_seen}

    comparable = [v for v in site_policy.values() if v["verdict"] != "not-comparable"]
    kf = sum(1 for v in comparable if v["verdict"].startswith("refuses-foreign"))
    kd = sum(1 for v in comparable if v["verdict"] == "refuses-domestic-only")
    kk = kf + kd
    p_site = (sum(math.comb(kk, i) for i in range(kf, kk + 1)) / (2 ** kk)) if kk else None

    return {
        "UNIT_WARNING": (
            "The per-load figures below treat repeated draws of the same sites, within a "
            "cell and often within one browser generation, as independent. They are not. "
            "For the ACCESS question quote `site_level`, whose unit is the site. "
            "`cell_site_mcnemar` answers a RATE question — how often a site refuses per "
            "visit — and inflates for a site whose refusal is a fixed policy, since it "
            "scores each re-observation as independent."),
        "per_load": by_arm,
        "per_site": per_site,
        "cell_site_mcnemar": per_arm_test,
        "site_level": {
            "QUESTION": ("Does the vantage affect ACCESS? The unit is the SITE, because a "
                         "refusal is a site's policy toward a class of vantage and every "
                         "extra cell re-observes the same policy rather than sampling a "
                         "new one. This p does NOT improve by collecting longer — only by "
                         "widening the frame."),
            "sites_comparable": len(comparable),
            "refuse_foreign": kf,
            "refuse_domestic_only": kd,
            "p_one_sided_exact": p_site,
            "policies": site_policy,
        },
    }

def _report(keep, cov, ru, seed, n, half=_MUST_SAY):
    if half is _MUST_SAY:
        raise TypeError(
            "_report() needs an explicit half. Making cell_rows() strict achieved nothing "
            "while this defaulted to None, because None means BOTH halves one layer down: "
            "access_contrast straddled the split on the very commit that hardened the "
            "accessor (ref/HOLDOUT-LEAKS.jsonl, second entry). A permissive default in a "
            "CALLER re-opens a door the callee just locked.")
    perm = paired_permutation(keep, ru, seed, n)
    out = {"coverage": cov, "paired_permutation": perm,
           "access_contrast": access_contrast(half, ru)}
    # AN EMPTY ANALYSIS SET IS A FAULT, NOT A RESULT. Without this the report renders as a
    # tidy object with priced_total 0 and a null test, which reads exactly like "we looked
    # and there was nothing" — the shape a broken join wears. Measured: a wrong join key
    # produced precisely that.
    if not keep:
        out["FAULT"] = ("the analysis set is EMPTY — every row was excluded. This is not "
                        "a finding of nothing; it is a report with nothing in it. Read the "
                        "exclusion counts: whichever one holds the whole corpus is the bug.")
    elif not perm:
        out["FAULT"] = ("rows survived but NO COMPLETE PAIR did, so there is nothing to "
                        "contrast. Read the exclusions before reading anything else.")
    arms = cov["arms"]
    others = sorted(a for a in arms if a != ru)
    # ONE ROW PER FOREIGN ARM, never "the" foreign arm. The corpus carries more than two
    # arms across its generations (nl-direct and a retired us-exit), and the first cut
    # picked whichever sorted first — so the headline 2x2 silently dropped a whole arm and
    # its result depended on an alphabet. If the effect is about "not Russia" the arms
    # agree; if it tracks one country or ASN it is a different effect with a different
    # name, and folding them makes that undecidable.
    out["arms_compared"] = {"domestic": ru, "foreign": others}
    if len(others) > 1:
        out["NOTE_MULTI_ARM"] = (
            f"{len(others)} foreign arms in this set ({', '.join(others)}). They are "
            "reported SEPARATELY and never pooled: pooling would average arms captured in "
            "different weeks under different exits, and no single p over that mixture "
            "answers a question anyone asked.")
    if ru in arms:
        # The caveats live in a SIBLING key, not inside `fisher_one_sided`. Putting them
        # in there turned the arm map into {DENOMINATOR, UNIT_WARNING, nl-direct, us-exit}
        # and the "every foreign arm gets its own 2x2, none is dropped" gate went red — a
        # gate doing exactly its job, since anything iterating that map for arms would
        # then have found two arms that are not arms.
        out["fisher_one_sided_CAVEAT"] = {
            "UNIT_WARNING": (
                "DESCRIPTIVE ONLY — do not quote this p. The unit is the ad REQUEST, and "
                "requests are not independent draws: thousands of them come from tens of "
                "page loads, within cells, within browser generations. This is the same "
                "inflation that made the per-load access figures look decisive. The "
                "quotable statistic for the price contrast is `paired_permutation`, whose "
                "unit is the PAIR — one site, one moment, both arms."),
            "DENOMINATOR": (
                "classifiable responses (priced + a real no-bid), NOT all entries. A body "
                "we could not read is not a bidder declining to price; those outcomes are "
                "43-46 % of every arm's rows and are counted separately as `unreadable`."),
        }
        out["fisher_one_sided"] = {}
        a, b = arms[ru]["priced"], arms[ru]["classifiable"] - arms[ru]["priced"]
        for f in others:
            c, d = arms[f]["priced"], arms[f]["classifiable"] - arms[f]["priced"]
            out["fisher_one_sided"][f] = {"table": [a, b, c, d],
                                          "p": fisher_one_sided(a, b, c, d)}
    return out


def cmd_explore(args):
    """The exploratory half. No limit, no correction, no plan — and every figure stamped."""
    keep, exc, _p = analysis_set("exploratory")
    cov = coverage("exploratory")
    out = _report(keep, cov, args.ru_arm, args.seed or SEED,
                  args.permutations or PERMUTATIONS, half="exploratory")
    # THE LABEL IS PART OF THE OUTPUT, not part of whoever writes the sentence later. An
    # effect living only on this half is interesting and unconfirmed; it is never
    # significant, and no p here is presented as one.
    out["label"] = ("EXPLORATORY — not confirmed. This half may be mined without limit, "
                    "so any p here measures the breadth of the search as much as the "
                    "market. Check it on the holdout before calling it anything.")
    out["half"] = "exploratory"
    print(json.dumps(out, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


def cmd_confirm(args):
    """The holdout. One look, and the look is recorded."""
    if cmd_verify(argparse.Namespace()) != 0:
        print("adint-holdout: refusing to read the holdout against a changed declaration",
              file=sys.stderr)
        return 1
    if not args.claim:
        print("adint-holdout: --claim is required — a holdout read must name what it is "
              "checking, or the read cannot be told apart from a fishing trip",
              file=sys.stderr)
        return 2
    was_spent = spent()
    prior = len(holdout_reads())
    keep, exc, _p = analysis_set("holdout")
    cov = coverage("holdout")
    out = _report(keep, cov, args.ru_arm, args.seed or SEED,
                  args.permutations or PERMUTATIONS, half="holdout")
    out["half"] = "holdout"
    out["claim"] = args.claim
    out["prior_reads"] = prior
    # THE READ IS WRITTEN BEFORE IT IS REPORTED. A read recorded only on the way out could
    # be dropped by a crash, an interrupt, or a pipe closing, and the holdout would be
    # spent with nothing saying so.
    os.makedirs(os.path.dirname(READS), exist_ok=True)
    with open(READS, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({"kind": "holdout-read",
                             "ts": datetime.now(timezone.utc).isoformat(),
                             "claim": args.claim, "prior_reads": prior,
                             "pairs": out["paired_permutation"]["pairs_used"]
                             if out.get("paired_permutation") else 0}, ensure_ascii=False)
                 + "\n")
    out["label"] = ("CONFIRMATORY — first and only read of the holdout."
                    if not was_spent else
                    f"NOT A CONFIRMATION — the holdout was already read {prior} time(s). "
                    "This read is EXPLORATORY: a second look at a holdout is more "
                    "exploration wearing a holdout's name. Recorded as such.")
    out["holdout_spent"] = True
    print(json.dumps(out, indent=2, sort_keys=True, ensure_ascii=False))
    return 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--declare", action="store_true")
    ap.add_argument("--verify", action="store_true")
    ap.add_argument("--split", action="store_true")
    ap.add_argument("--explore", action="store_true")
    ap.add_argument("--confirm", action="store_true")
    ap.add_argument("--claim", default=None,
                    help="what this holdout read is checking. Required by --confirm")
    ap.add_argument("--force", action="store_true", help="re-declare a dated amendment")
    ap.add_argument("--ru-arm", default="ru-mobile")
    ap.add_argument("--seed", type=int, default=0)
    ap.add_argument("--permutations", type=int, default=0)
    ap.add_argument("--test", action="store_true")
    a = ap.parse_args()
    if a.test:
        return selftest()
    if a.declare:
        return cmd_declare(a)
    if a.verify:
        return cmd_verify(a)
    if a.split:
        return cmd_split(a)
    if a.explore:
        return cmd_explore(a)
    if a.confirm:
        return cmd_confirm(a)
    ap.print_help()
    return 0



def selftest():
    ok = True

    def check(name, got, want):
        nonlocal ok
        if got != want:
            ok = False
            print(f"FAIL {name}: got {got!r}, want {want!r}")
        else:
            print(f"ok   {name}")

    import tempfile
    global DOC, REG, READS, PUB, PRIV
    keep_globals = (DOC, REG, READS, PUB, PRIV)
    d = tempfile.mkdtemp()
    DOC = os.path.join(d, "split.md")
    REG = os.path.join(d, "split.json")
    READS = os.path.join(d, "reads.jsonl")
    PUB, PRIV = os.path.join(d, "pub"), os.path.join(d, "priv")
    os.makedirs(PUB); os.makedirs(PRIV)

    # An absent document must not hash to anything: a stable digest for a missing file
    # would VERIFY, certifying a split rule that no longer exists.
    check("an absent document has no hash", doc_hash(), None)
    open(DOC, "w").write("split by run id.\n")
    check("not declared is not a pass", cmd_verify(argparse.Namespace()), 2)
    check("declaring succeeds", cmd_declare(argparse.Namespace(force=False)), 0)
    check("verify passes on the declared text", cmd_verify(argparse.Namespace()), 0)
    open(DOC, "a").write("\nactually, split however suits the result.\n")
    check("an edited split rule fails verification", cmd_verify(argparse.Namespace()), 1)
    open(DOC, "w").write("split by run id.\n")
    check("restoring the text restores verification", cmd_verify(argparse.Namespace()), 0)
    check("re-declaring over a declaration is refused",
          cmd_declare(argparse.Namespace(force=False)), 2)

    # ── THE SPLIT ── deterministic, stable, and whole-cell.
    # Twenty repeats, not two: a split that had become random would agree with itself
    # half the time and pass a single comparison on a coin flip.
    check("the same run id always lands in the same half",
          len({half_of("2026-08-21-morning-x") for _ in range(20)}), 1)
    check("the halves are the only two answers",
          {half_of(f"r{i}") for i in range(60)}, {"exploratory", "holdout"})
    # Roughly balanced over many ids. Not asserted tightly — a hash is not a shuffler and
    # a tight bound here would be a gate on luck.
    n = sum(half_of(f"run-{i}") == "holdout" for i in range(400))
    check("the split is not lopsided over many cells", 150 <= n <= 250, True)
    check("the run id is taken from the ledger name, not the arm",
          run_of("hb-paired-2026-08-21-morning-2026082104.ru.jsonl"),
          "2026-08-21-morning-2026082104")

    # ── THE ANALYSIS SET ── the vantage rule is exercised, not merely described.
    # THE FIXTURE MUST HAVE THE REAL LEDGER'S SHAPE. The first cut gave request rows a
    # `pair_id`, which no real request row carries — they carry `load_id` and nothing else
    # that names a pair. So the fixture passed a reader that joined on the wrong key, and
    # against the live corpus that reader excluded all 13 466 request rows as `unpaired`
    # and rendered a tidy report with priced_total 0. A fixture that does not have the
    # data's shape cannot catch a miswired reader.
    def load(pid, arm, status, verified, site=None):
        # The site defaults to one PER PAIR, not one for the whole fixture. It used to be
        # a single constant url, so every row in the corpus collapsed to one site and the
        # site-level unit had exactly one member — a table that renders fine and asserts
        # nothing about a per-site verdict.
        return {"kind": "load", "pair_id": pid, "load_id": f"L-{pid}-{arm}", "arm": arm,
                "http_status": status, "vantage_verified": verified,
                "url": site or f"https://{pid.split('-')[-1]}.ru/"}
    def req(pid, arm, outcome):
        return {"kind": "request", "load_id": f"L-{pid}-{arm}", "arm": arm,
                "outcome": outcome, "bidder": "roxot"}
    # Two cells, deliberately chosen so one lands in each half.
    cells = {}
    for i in range(200):
        r = f"cell{i}"
        cells.setdefault(half_of(r), r)
        if len(cells) == 2:
            break
    expl, hold = cells["exploratory"], cells["holdout"]
    for run, priced in ((expl, 8), (hold, 8)):
        rows = {"ru-mobile": [], "nl-direct": []}
        for i in range(1, 9):
            for arm in rows:
                rows[arm].append(load(f"{run}-p{i}", arm, 200, True))
                rows[arm].append(req(f"{run}-p{i}", arm,
                                     "priced" if arm == "ru-mobile" else "no-bid"))
        # Bodies that never became a readable auction answer. Without these the fixture
        # had NO unreadable rows at all, so the classifiable/unreadable split was a
        # partition of one part — it passed while asserting nothing, and the gate that
        # demands a real share of each is what exposed it.
        for arm in rows:
            for _ in range(2):
                rows[arm].append(req(f"{run}-p1", arm, "binary"))
        # One pair per cell whose RU arm could not prove its vantage.
        rows["ru-mobile"].append(load(f"{run}-p9", "ru-mobile", 200, False))
        rows["ru-mobile"].append(req(f"{run}-p9", "ru-mobile", "no-bid"))
        rows["nl-direct"].append(load(f"{run}-p9", "nl-direct", 200, True))
        rows["nl-direct"].append(req(f"{run}-p9", "nl-direct", "no-bid"))
        # ...and one the SITE refused from abroad while serving it at home — the rbc.ru
        # shape. The served arm brings three priced rows; if the gate lets a 401 stand in
        # for a rendered partner, all three land in the contrast against a partner that
        # structurally cannot answer, and the RU arm's denominator swells for free.
        # An INTERMITTENT refuser: same site, refused on one foreign visit and served on
        # another, so `refuses-foreign-sometimes` is a reachable verdict and not a branch
        # nothing ever takes.
        for n, st in ((1, 403), (2, 200)):
            rows["ru-mobile"].append(load(f"{run}-x{n}", "ru-mobile", 200, True,
                                          site="https://inter.ru/"))
            rows["ru-mobile"].append(req(f"{run}-x{n}", "ru-mobile", "no-bid"))
            rows["nl-direct"].append(load(f"{run}-x{n}", "nl-direct", st, True,
                                          site="https://inter.ru/"))
            if st == 200:
                rows["nl-direct"].append(req(f"{run}-x{n}", "nl-direct", "no-bid"))
        rows["ru-mobile"].append(load(f"{run}-p10", "ru-mobile", 200, True))
        for _ in range(3):
            rows["ru-mobile"].append(req(f"{run}-p10", "ru-mobile", "priced"))
        rows["nl-direct"].append(load(f"{run}-p10", "nl-direct", 401, True))
        for arm, rr in rows.items():
            with open(os.path.join(PUB, f"hb-paired-{run}.{arm}.jsonl"), "w") as fh:
                for r in rr:
                    fh.write(json.dumps(r) + "\n")

    ke, exc_e, _ = analysis_set("exploratory")
    kh, exc_h, _ = analysis_set("holdout")
    check("each half sees only its own cells", (len(ke), len(kh)), (22, 22))
    check("an unproven arm's rows are EXCLUDED, never counted as no-bid",
          exc_e["vantage-unproven"], 2)
    # A STATUS IS NOT A PAGE. Assert the exclusion by its own name AND assert the served
    # arm's rows did not survive it: the count alone would still pass if the rows leaked
    # through under a different bucket.
    check("a partner that ANSWERED 401 is not a rendered arm",
          exc_e["pair-gate:refused"], 4)
    check("...and the served arm's rows do not enter the contrast alone",
          sum(1 for a, r in ke if r["pair_id"].endswith("-p10")), 0)
    check("a dead load and a refusal are told apart, not pooled",
          (exc_e["pair-gate:no-load"], "pair-gate:refused" in exc_e), (0, True))
    # THE SIBLING READER IS THE GROUND TRUTH, AND IT ALWAYS WAS. `tools/adint-status`
    # has classified a 4xx/5xx as `refused` — explicitly not rendered — since it was
    # written, and its docstring names rbc.ru's 401 as the case. This file shipped a
    # looser copy of the same rule and nothing compared them, so the published per-site
    # yield table and the statistical analysis set disagreed about which pairs exist for
    # weeks. Two trees, one filing, no gate between them. This is that gate: it fails if
    # either side moves, and it re-derives the comparison instead of restating it.
    # THE CORPUS ITSELF REFUSES A STRADDLING READ. The protocol used to live entirely on
    # the --confirm door; the corpus under it was an open field, and that is how the
    # holdout leaked to an ad-hoc tally (ref/HOLDOUT-LEAKS.jsonl).
    try:
        cell_rows()
        check("cell_rows() with no half REFUSES instead of straddling", False, True)
    except TypeError as e:
        check("cell_rows() with no half REFUSES instead of straddling",
              "explicit half" in str(e), True)
    ex_runs = {run_of(b) for b, _a, _r in cell_rows("exploratory")}
    ho_runs = {run_of(b) for b, _a, _r in cell_rows("holdout")}
    check("a half-scoped read returns that half and nothing else",
          (bool(ex_runs), bool(ho_runs), ex_runs & ho_runs), (True, True, set()))
    check("...and None still sees both, for the callers that must count the other half",
          {run_of(b) for b, _a, _r in cell_rows(None)}, ex_runs | ho_runs)

    # AND THE CALLER MUST BE STRICT TOO. cell_rows() refusing a bare call bought nothing
    # while _report defaulted half=None, because None means BOTH halves — access_contrast
    # straddled the split on the very commit that hardened the accessor. Assert the
    # refusal AND assert the resulting numbers are actually half-sized.
    try:
        _report([], {"arms": {}, "exclusions": {}, "priced_total": 0}, "ru-mobile", 1, 10)
        check("_report() with no half REFUSES, so the accessor's strictness survives its "
              "callers", False, True)
    except TypeError as e:
        check("_report() with no half REFUSES, so the accessor's strictness survives its "
              "callers", "explicit half" in str(e), True)
    # THE ACCESS TEST MUST BE ABLE TO MOVE BOTH WAYS. Its predecessor asked "has this site
    # EVER refused a foreign arm" — a latching indicator, monotone in n, so its p could
    # only fall with more data and any threshold was reachable by waiting. Assert the live
    # test is not that: hand it a corpus where the DOMESTIC arm is the refused one and
    # require the discordance to land on the domestic side.
    inv = []
    for cell in ("c0", "c1"):
        for site in ("s1", "s2"):
            inv.append((cell, site, "ru-mobile", 403))
            inv.append((cell, site, "nl-direct", 200))
    saved_rows = cell_rows
    def _fake(half=None, include_private=True):
        return [(f"hb-paired-{c}", a, {"kind": "load", "pair_id": f"{c}-{si}",
                                       "site": si, "http_status": st,
                                       "vantage_verified": True})
                for c, si, a, st in inv]
    globals()["cell_rows"] = _fake
    try:
        flipped = access_contrast("exploratory", "ru-mobile")["cell_site_mcnemar"]
    finally:
        globals()["cell_rows"] = saved_rows
    nl = flipped.get("nl-direct", {})
    check("the access test is not a latch — a domestic-refused corpus lands on the "
          "domestic side", (nl.get("foreign_only_refused"), nl.get("domestic_only_refused")),
          (0, 4))
    check("...and it reports a p for that direction too, so the test is two-way",
          nl.get("p_one_sided_exact"), 1.0)

    # THE DENOMINATOR IS THE RESPONSES WE COULD READ. Every row is either classifiable or
    # unreadable and never both, and the 2x2 must be built from the former — a body that
    # never became a readable auction answer is not a bidder declining to price it.
    cx = coverage("exploratory")["arms"]
    check("classifiable and unreadable partition the entries exactly",
          all(v["classifiable"] + v["unreadable"] == v["entries"] for v in cx.values()),
          True)
    check("...and unreadable is a real share, not an empty bucket dressed as a partition",
          all(v["unreadable"] > 0 for v in cx.values()), True)
    rr = _report(analysis_set("exploratory")[0], coverage("exploratory"), "ru-mobile", 1,
                 200, half="exploratory")
    tbl = rr["fisher_one_sided"]["nl-direct"]["table"]
    check("the 2x2 is built from classifiable responses, not from every entry",
          tbl[0] + tbl[1], cx["ru-mobile"]["classifiable"])
    check("the price contrast ships the caveat that its unit is the REQUEST",
          "paired_permutation" in rr["fisher_one_sided_CAVEAT"]["UNIT_WARNING"], True)

    # THE SITE-LEVEL VERDICT MUST ALSO BE ABLE TO POINT THE OTHER WAY, and must tell a
    # fixed policy apart from an occasional one — that distinction is the whole reason
    # this unit exists beside the per-visit one.
    globals()["cell_rows"] = _fake
    try:
        flip_site = access_contrast("exploratory", "ru-mobile")["site_level"]
    finally:
        globals()["cell_rows"] = saved_rows
    check("an inverted corpus lands on refuse_domestic_only, not refuse_foreign",
          (flip_site["refuse_foreign"], flip_site["refuse_domestic_only"]), (0, 2))
    check("...and its p reflects that direction rather than reporting the smaller tail",
          flip_site["p_one_sided_exact"], 1.0)

    ac_e = access_contrast("exploratory", "ru-mobile")
    pol = ac_e["site_level"]["policies"]
    verdicts = {v["verdict"] for v in pol.values()}
    check("a site refusing on EVERY foreign load is told apart from one refusing sometimes",
          {"refuses-foreign-always", "refuses-foreign-sometimes"} <= verdicts, True)
    check("only comparable sites enter the site-level count",
          ac_e["site_level"]["sites_comparable"],
          sum(1 for v in pol.values() if v["verdict"] != "not-comparable"))
    ac_b = access_contrast(None, "ru-mobile")
    check("a half-scoped access contrast counts fewer loads than the straddling one",
          all(ac_e["per_load"][a]["attempted"] < ac_b["per_load"][a]["attempted"]
              for a in ac_e["per_load"]), True)

    sib = _sibling_rendered()
    if sib is None:
        check("adint-status is READABLE, so the two render rules can be compared", False,
              True)
    else:
        cases = [None, 200, 204, 301, 400, 401, 403, 404, 500, 503]
        mine = [render_verdict({"http_status": c, "vantage_verified": True}) == GATE_OK
                for c in cases]
        theirs = [sib({"http_status": c}) for c in cases]
        check("this file's render rule agrees with adint-status on every status",
              mine, theirs)
        check("...and the agreement is not vacuous — the rule separates the statuses",
              (len(set(mine)), mine[cases.index(401)]), (2, False))

    gate = render_gate_table("exploratory")
    check("the per-arm gate loss is published beside the numbers it conditions",
          (gate["nl-direct"]["pair-gate:refused"], gate["ru-mobile"]["ok_rate"]),
          (2, 0.9167))
    check("the other half's rows are excluded and counted, not silently dropped",
          exc_e["wrong-half"] > 0, True)
    cov = coverage("exploratory")
    # Miss-tolerant: a mutant that empties the analysis set leaves no arm keys, and
    # subscripting them raises — the red gate that hides every gate after it. Third time
    # this pattern has bitten in this file; read through an accessor by default.
    def pr(a):
        return (cov["arms"].get(a) or {}).get("priced")
    check("the priced entries land on the RU arm", (pr("ru-mobile"), pr("nl-direct")),
          (8, 0))
    # A request row names no pair; only its load does. Assert the JOIN, not the presence of
    # a key — this is the exact wiring the fixture used to be blind to.
    check("a request is joined to its pair through load_id, not through a pair key",
          all(a and r.get("pair_id") for a, r in ke), True)
    check("...and a request whose load is missing is counted, not silently kept",
          "no-load" in exc_e, True)

    # ── THE TEST ── within pairs, and shown both to fire and NOT to fire.
    perm = paired_permutation(ke, "ru-mobile", seed=1, n=2000) or {}
    check("the permutation uses every complete pair of its half", perm.get("pairs_used"), 9)
    check("a one-sided effect gives a small p", perm.get("p", 1) < 0.05, True)
    check("the p is floor-censored at 1/(n+1), never 0", perm.get("p", 0) >= 1 / 2001, True)
    # Nothing else distinguishes a within-pair permutation from a global reshuffle on a
    # fixture this clean: both give a small p, and pairs_used counts pairs either way.
    # Their null SPACES differ — k pairs admit exactly 2**k arrangements, so a within-pair
    # p can never beat 1/2**k, while a global shuffle runs to the resampling floor.
    check("the permutation is WITHIN pairs, so p cannot beat 1/2**pairs",
          perm.get("p", 0) >= 1 / 2 ** perm.get("pairs_used", 0), True)
    flat = [(arm, dict(r, outcome="priced")) for arm, r in ke]
    check("an effect-free corpus does NOT produce a small p",
          (paired_permutation(flat, "ru-mobile", seed=1, n=2000) or {}).get("p", 0) > 0.05,
          True)

    # ── MORE THAN TWO ARMS ── The `.nl.jsonl` slot carries `us-exit` rows in 6 of the
    # corpus's 14 cells: the FILE names a slot, the ROW names the vantage. So "the foreign
    # arm" is not one thing, and picking the first one alphabetically makes the headline
    # depend on an alphabet while dropping a whole arm.
    with open(os.path.join(PUB, f"hb-paired-{expl}.us-exit.jsonl"), "w") as fh:
        for i in range(1, 9):
            fh.write(json.dumps(load(f"{expl}-p{i}", "us-exit", 200, True)) + "\n")
            fh.write(json.dumps(req(f"{expl}-p{i}", "us-exit", "no-bid")) + "\n")
    c3 = coverage("exploratory")
    check("a third arm is seen rather than folded into the second",
          sorted(c3["arms"]), ["nl-direct", "ru-mobile", "us-exit"])
    r3 = _report(analysis_set("exploratory")[0], c3, "ru-mobile", 1, 500,
                 half="exploratory")
    check("every foreign arm gets its own 2x2, none is dropped",
          sorted(r3.get("fisher_one_sided") or {}), ["nl-direct", "us-exit"])
    check("...and the report says out loud that there is more than one",
          "reported SEPARATELY and never pooled" in r3.get("NOTE_MULTI_ARM", ""), True)
    os.remove(os.path.join(PUB, f"hb-paired-{expl}.us-exit.jsonl"))

    # ── AN EMPTY ANALYSIS SET IS A FAULT, NOT A RESULT ──
    empty = _report([], {"arms": {}, "exclusions": {}, "priced_total": 0}, "ru-mobile",
                    1, 100, half="exploratory")
    check("a report with nothing in it says so instead of rendering zeroes",
          "EMPTY" in empty.get("FAULT", ""), True)

    # ── THE LANGUAGE ── stamped by the tool, not left to whoever writes the sentence.
    import io as _io, contextlib
    buf = _io.StringIO()
    with contextlib.redirect_stdout(buf):
        cmd_explore(argparse.Namespace(ru_arm="ru-mobile", seed=1, permutations=500))
    check("an exploratory figure is stamped EXPLORATORY",
          "EXPLORATORY — not confirmed" in buf.getvalue(), True)
    # Under the `label` key specifically. The stamp is the report's contract with its
    # reader, and a stamp moved to some other field still prints while every consumer that
    # looks for the label sees an unlabelled figure.
    check("...on the report's `label` field, where a consumer looks for it",
          json.loads(buf.getvalue()).get("label", "").startswith("EXPLORATORY"), True)
    # The stamp must survive PRINTING, not merely exist in the dict: json.dumps escapes
    # a non-ASCII dash to \u2014 by default, so the label a reader sees was not the label
    # the tool wrote — the first cut of this gate caught exactly that.
    check("the stamp survives being printed, dash and all",
          "EXPLORATORY " + chr(0x2014) + " not confirmed" in buf.getvalue(), True)
    check("...and is not left as an escape a reader has to decode",
          chr(92) + "u2014" in buf.getvalue(), False)
    check("an exploratory report never calls its own number significant",
          "significant" in buf.getvalue().lower(), False)

    # ── THE HOLDOUT ── one look, and the look is recorded.
    check("a holdout read must name what it checks",
          cmd_confirm(argparse.Namespace(ru_arm="ru-mobile", seed=1, permutations=500,
                                         claim=None)), 2)
    check("the holdout starts unread", spent(), False)
    buf = _io.StringIO()
    with contextlib.redirect_stdout(buf):
        cmd_confirm(argparse.Namespace(ru_arm="ru-mobile", seed=1, permutations=500,
                                       claim="prices only on the RU arm"))
    first = buf.getvalue()
    check("the first read is a confirmation", "CONFIRMATORY" in first, True)
    check("the read is recorded", len(holdout_reads()), 1)
    # Read through a miss-tolerant accessor: subscripting a ledger a mutant has just
    # emptied raises, and a raise ends the suite — the red gate that hides every later one.
    check("the recorded read names the claim, so it cannot pass as a fishing trip",
          (holdout_reads() or [{}])[0].get("claim"), "prices only on the RU arm")
    check("the holdout reports itself SPENT afterwards", spent(), True)
    # THE FAILURE THAT IS EASY TO MAKE BY ACCIDENT: a second look is not a confirmation,
    # and must SAY so rather than quietly printing the same numbers again.
    buf = _io.StringIO()
    with contextlib.redirect_stdout(buf):
        cmd_confirm(argparse.Namespace(ru_arm="ru-mobile", seed=1, permutations=500,
                                       claim="just checking"))
    second = buf.getvalue()
    check("a SECOND read refuses the word confirmation",
          "NOT A CONFIRMATION" in second and "CONFIRMATORY —" not in second, True)
    check("...and names itself exploration", "EXPLORATORY" in second, True)
    check("every read is appended, so the ledger counts glances", len(holdout_reads()), 2)

    DOC, REG, READS, PUB, PRIV = keep_globals
    print("selftest: " + ("ok" if ok else "FAIL"))
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main())
